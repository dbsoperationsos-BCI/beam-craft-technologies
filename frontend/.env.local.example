NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=
# Public read base URL of the Cloudflare R2 bucket - must match backend R2_PUBLIC_BASE_URL
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# The origin put in front of links sent to clients - a CRD document, a quotation. Set it when the app
# is served from a different host than the one people open it on, behind a proxy for instance.
# Unset, the browser's own origin is used, which is right for an ordinary deployment.
#
# This used to fall back to a hard-coded studio domain, which meant every client link on any other
# deployment pointed at the wrong host with nothing on screen to say so.
NEXT_PUBLIC_PUBLIC_APP_URL=
# An older name for the same thing, still read as a fallback.
NEXT_PUBLIC_SITE_URL=

