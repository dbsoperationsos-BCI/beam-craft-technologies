node_modules

# WhatsApp pairing credentials. These are the keys to a linked WhatsApp account: whoever holds a
# copy can send as that number, and the only revocation is unlinking the device from the phone.
# The files are encrypted at rest, which is not a reason to let them near a commit.
/.whatsapp-sessions
.whatsapp-sessions/
# Whatever WHATSAPP_SESSION_DIR / WHATSAPP_MEDIA_DIR are pointed at when they sit in the tree,
# plus the conversation media and the socket trace, which record who was messaged and when.
/whatsapp-sessions
/whatsapp-media
/.whatsapp-media
debug.log
*.log

# Every local env file, not just `.env` - `.env.production` and `.env.local` carry the same
# secrets and were not covered by the rule above.
.env
.env.*
!.env.example

# Generated by scripts/build-nebula-model.js
.nebula.Modelfile

# Runtime upload data (photo chunks, derivatives). Never git material: an unignored uploads
# tree means any `git clean`/`stash -u` tries to delete client photo files from disk.
/uploads/

# Python environment for the AI Feature face engine and the call-transcript sidecar (never committed)
.venv/
venv/

# The face engine's own Python environment (backend/scripts/face-engine-setup.sh)
.venv-face/
