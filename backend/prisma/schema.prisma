/**
 * Somebody asking for an asset that does not exist yet. Only what the requester can reasonably
 * say is captured: what they want, roughly what kind, and why. Turning a request into an actual
 * Asset is not modelled here.
 */
model AssetRequest {
  id              Int       @id @default(autoincrement())
  requestCode     String    @unique @map("request_code") @db.VarChar(30)
  assetName       String    @map("asset_name") @db.VarChar(150)
  categoryId      String    @map("category_id")
  subCategoryId   String?   @map("sub_category_id")
  remarks         String?   @db.Text
  requestedBy     Int?      @map("requested_by")
  // PENDING until an admin decides. Approving records the asset that was added for it; rejecting
  // records the reason, which is why decisionRemarks is only ever written by a rejection.
  status          String    @default("PENDING") @db.VarChar(20)
  decisionRemarks String?   @map("decision_remarks") @db.Text
  decidedBy       Int?      @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  assetId         Int?      @map("asset_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category    AssetCategory  @relation("AssetRequestCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory AssetCategory? @relation("AssetRequestSubCategory", fields: [subCategoryId], references: [id], onDelete: Restrict)
  asset       Asset?         @relation("AssetRequestAsset", fields: [assetId], references: [id], onDelete: SetNull)

  requestedByUser User? @relation("AssetRequestRequestedByUser", fields: [requestedBy], references: [id], onDelete: SetNull)
  decidedByUser   User? @relation("AssetRequestDecidedByUser", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([createdAt])
  @@index([status])
  @@index([assetId])
  @@index([requestedBy])
  @@index([decidedBy])
  @@map("asset_request")
}

model SpeakUp {
  id           Int      @id @default(autoincrement())
  /// `DBS-SPK-00001`, the code HR reads it by. Nullable because the column is added to rows
  /// already here - a row that somehow still has none is given the next code the next time it is
  /// saved. Unique either way (MySQL allows many NULLs in a unique index).
  speakUpId    String?  @unique @map("speak_up_id") @db.VarChar(30)
  employeeId   Int?     @map("employee_id")
  /// Rule 5 name copy of `employeeId` - `nameCopies.js` rewrites it on rename, `resolvedNames.js`
  /// resolves the live name back on read, and it is what HR still reads if the employee's record
  /// is ever removed.
  employeeName String   @map("employee_name") @db.VarChar(191)
  /// Team / Manager Issue | HR / People | Work Environment | Suggestion | App / System Issue |
  /// Other - a fixed Zod enum, not a configurable list, so it stays a plain validated string
  /// rather than a master-data table the way Designation or Department are.
  type         String   @db.VarChar(30)
  /// Labelled "Subject" on screen.
  title        String   @db.VarChar(191)
  /// Labelled "What happened?" on screen.
  description  String   @db.Text
  /// The R2 object key in the private bucket, never a public URL. Null when nothing was attached.
  attachmentKey      String? @map("attachment_key") @db.VarChar(500)
  /// The name it was uploaded under, so the review list can offer it as something readable.
  attachmentFileName String? @map("attachment_file_name") @db.VarChar(255)
  /// PENDING until a reviewer decides it: APPROVED, ASSIGNED (approved and made an HRM task) or
  /// REJECTED. The employee who raised it sees only this.
  status             String    @default("PENDING") @db.VarChar(20)
  /// The login that decided it. Its name is read through the relation - nothing stores it as text.
  reviewedByUserId   Int?      @map("reviewed_by_user_id")
  reviewedAt         DateTime? @map("reviewed_at")
  /// The reviewer's remark - the reason, on a rejection. Shown in Speak-up Review only.
  reviewRemark       String?   @map("review_remark") @db.Text
  /// The task an ASSIGNED speak-up became.
  taskId             Int?      @unique @map("task_id")
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee? @relation("SpeakUpEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("SpeakUpReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  task       HrmTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([createdAt])
  @@index([status])
  @@index([reviewedByUserId])
  @@map("speak_up")
}

/// Money an employee asks the studio for, and what HRM decided about it.
///
/// Four kinds — an advance on salary, an advance against expenses to come, expenses already spent,
/// and a vendor's bill — kept in one table with `type` saying which. They ask for overlapping
/// things, they are listed and searched together, and they are all decided the same way, so the
/// alternative is four tables that would each need the same status, decision and approval columns.
/// The fields only one kind asks for are nullable for that reason, exactly as `CashEntry` keeps its
/// direction-only columns.
///
/// Approving one records the Cash Entries it produced, the way approving an AssetRequest records
/// the asset it added. That link is what stops Accounts retyping an amount HRM has already
/// checked, and what lets a paid request be traced back from the books. It is held on the entry
/// (`CashEntry.paymentRequestId`) rather than here, because an approval writes one entry per shoot
/// the request itemises - see `cashEntries` below.
///
/// A **salary advance** approval writes one thing more: the `PayrollAdvance` that takes the money
/// back off a payslip. Before that, the repayment the employee agreed to was stored and never read.
model PaymentRequest {
  id              Int       @id @default(autoincrement())
  /// SAL-000001, ADV-000001, EXP-000001 or VND-000001, from the counter every identifier comes from.
  requestCode     String    @unique @map("request_code") @db.VarChar(30)
  type            String    @db.VarChar(30)
  /// Who asked. The name is kept beside the link so a decided request still reads correctly after
  /// the employee is archived, the same reason `CashEntry.handlerName` is stored.
  requestedById   Int?      @map("requested_by_id")
  requestedByName String    @map("requested_by_name") @db.VarChar(191)
  requestedByCode String?   @map("requested_by_code") @db.VarChar(50)
  branch          String    @db.VarChar(120)
  branchId        Int?      @map("branch_id")
  /// What is being asked for: the advance wanted, or the total of the expenses listed below.
  amount          Decimal   @db.Decimal(12, 2)
  reason          String?   @db.Text
  comments        String?   @db.Text
  /// Salary advance only: how the employee proposes to pay it back.
  repaymentPlan   String?   @map("repayment_plan") @db.VarChar(60)
  /// And over how many months, when the plan is "Over Several Months" rather than one payment. The
  /// form asks for it and the validation requires it with that plan, but the column was never
  /// added — so every payment request, of every kind, was refused by Prisma as an unknown field.
  repaymentMonths Int?      @map("repayment_months")
  /// Expense submission only: whether the advance left money over or is short.
  settlement      String?   @db.VarChar(30)
  /// Vendor payment only: who the studio is being asked to pay. The link is what Vendor Management
  /// reads a vendor's payments by; the two text columns beside it are the copies the request was
  /// raised with, so a decided request still reads as it was approved and a vendor since removed
  /// from the register still says who was paid.
  vendorId        Int?      @map("vendor_id")
  vendorName      String?   @map("vendor_name") @db.VarChar(191)
  vendorPhone     String?   @map("vendor_phone") @db.VarChar(30)
  /// Vendor payment only: the date on the bill. The itemising kinds date each line instead, and a
  /// salary advance dates nothing — nothing has been spent yet.
  expenseDate     DateTime? @map("expense_date")
  /// Uploads, each holding the same receipt the payment proof on a cash entry holds.
  qrCode          Json?     @map("qr_code")
  bills           Json?
  /// The request cannot be raised without agreeing to the terms, so the moment it was agreed is
  /// recorded rather than a boolean that only says it happened at some point.
  termsAcceptedAt DateTime  @map("terms_accepted_at")
  status          String    @default("PENDING") @db.VarChar(20)
  decisionRemarks String?   @map("decision_remarks") @db.Text
  decidedById     Int?      @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at")
  createdBy       Int?      @map("created_by")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  requestedBy Employee?               @relation("PaymentRequestsRaised", fields: [requestedById], references: [id], onDelete: SetNull)
  /// What the approval wrote: one entry per shoot the money was spent on, or one per project it came
  /// back for, plus one for the lines naming neither. A request itemising nothing is a single entry.
  cashEntries CashEntry[]
  /// A salary advance's payroll row, written when the request is approved: what takes the money back
  /// off a payslip. Only ever on a SALARY_ADVANCE, and at most one - see `PayrollAdvance`.
  payrollAdvance PayrollAdvance?
  expenses    PaymentRequestExpense[]

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branchRef Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vendor    Vendor? @relation("PaymentRequestVendor", fields: [vendorId], references: [id], onDelete: SetNull)

  createdByUser User? @relation("PaymentRequestCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)
  decidedByUser User? @relation("PaymentRequestDecidedByUser", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, status])
  @@index([requestedById])
  @@index([deletedAt])
  @@index([branchId])
  @@index([vendorId])
  @@index([createdBy])
  @@index([decidedById])
  @@map("payment_request")
}

/// One line of the Expenses table on a request: what was spent, when, on which shoot, for how much.
/// A row rather than JSON because the lines are totalled, reported on per shoot and per expense
/// type, and edited one at a time — none of which JSON gives without unpacking the whole column.
model PaymentRequestExpense {
  id          Int      @id @default(autoincrement())
  requestId   Int      @map("request_id")
  /// What the line was spent on, named the way a Cash Spent entry names it: the project, and one of
  /// that project's shoots. Both null is the "General" the form offers, for an expense belonging to
  /// no project at all; a project with no shoot is a project-level expense. A line can never name a
  /// shoot without the project it belongs to, which is what lets an approval attribute a request
  /// spanning several shoots of one project to that project.
  projectId   String?  @map("project_id")
  shootId     String?  @map("shoot_id")
  expenseDate DateTime @map("expense_date")
  /// What the money was, or will be, spent on. NULL on an expense submission settling an **excess**:
  /// that is unspent advance money being handed back, so there is nothing it was spent on to name,
  /// and the form does not ask. Every other itemising kind requires one.
  expenseType String?  @map("expense_type") @db.VarChar(60)
  description String?  @db.Text
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  request PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  project SalesProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shoot   ProjectShoot?  @relation(fields: [shootId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([projectId])
  @@index([shootId])
  @@map("payment_request_expense")
}

model AppSequence {
  key          String   @id @db.VarChar(100)
  currentValue Int      @default(0) @map("current_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_sequence")
}

model SalesWhatsappGroupName {
  id                 String    @id @default(cuid())
  groupType          String    @map("group_type") @db.VarChar(30)
  vertical           String    @db.VarChar(120)
  verticalId         Int?      @map("vertical_id")
  generatedName      String    @unique @map("generated_name") @db.VarChar(500)
  /// A full branch name from the locations master data (VarChar(120) there), not a code.
  branch             String    @db.VarChar(120)
  branchId           Int?      @map("branch_id")
  /// The CRM lead this name was prepared for. Nullable because names generated before the
  /// generator asked for one have none.
  enquiryId          String?   @map("enquiry_id") @db.VarChar(100)
  offerName          String?   @map("offer_name") @db.VarChar(200)
  clientName         String?   @map("client_name") @db.VarChar(200)
  groomName          String?   @map("groom_name") @db.VarChar(150)
  brideName          String?   @map("bride_name") @db.VarChar(150)
  eventName          String?   @map("event_name") @db.VarChar(200)
  socialMediaPosting String?   @map("social_media_posting") @db.VarChar(10)
  houseType          String?   @map("house_type") @db.VarChar(10)
  gou                Boolean?
  place              String    @db.VarChar(200)
  mainEventDate      DateTime? @map("main_event_date")
  generatorPayload   Json?     @map("generator_payload")
  status             String    @default("Available") @db.VarChar(20)
  expiresAt          DateTime? @map("expires_at")
  usedAt             DateTime? @map("used_at")
  usedByProjectId    String?   @map("used_by_project_id") @db.VarChar(191)
  createdByUserId    Int?      @map("created_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branchRef   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  verticalRef Vertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  createdByUser User? @relation("SalesWhatsappGroupNameCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// The enquiry the name was generated for, where there is one. A key since 20260924150000; a name generated for a lead goes with it.
  lead SalesCrmLead? @relation("SalesWhatsappGroupNameLead", fields: [enquiryId], references: [enquiryId], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([branch])
  @@index([usedByProjectId])
  @@index([branchId])
  @@index([verticalId])
  @@index([enquiryId])
  @@index([createdByUserId])
  @@map("sales_whatsapp_group_name")
}

