generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectServiceQuantityMode {
  NONE
  INTEGER
}

enum ProjectServiceTimingMode {
  NONE
  HALF_SESSION
  FULL_SESSION
  HOURS_MINUTES
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  username String? @unique @db.VarChar(50)
  /// The number a password-reset code is sent to, for a login with no employee record behind it.
  ///
  /// Recovery is by OTP, and the number normally comes from the employee's own `contact_number` -
  /// the one given during onboarding. An account with no employee has none, and the studio's Super
  /// Admin is exactly that: without somewhere to put a number it would be permanently unable to
  /// reset its own password. Set on the login instead, from Admin -> User Management.
  ///
  /// The employee's number wins where there is one, so this is not a second copy to keep in step.
  mobile   String? @db.VarChar(30)
  password String

  // BRANCH ASSIGNMENT (for IAM system)
  branchId        Int?                 @map("branch_id")
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  aiConversations AiConversation[]
  aiActionPlans   AiActionPlan[]
  /// The days this person's attendance has been written down for. Derived from their measured
  /// sessions where there is no row; see `EmployeeAttendance`.
  attendance      EmployeeAttendance[] @relation("EmployeeAttendanceUser")

  // Legacy role support (deprecated after 3 months)
  role String @default("SUPER_ADMIN")

  status             String    @default("ACTIVE")
  linkedEmployeeId   Int?      @unique @map("linked_employee_id")
  accessDepartment   String?   @map("access_department") @db.VarChar(100)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// Whether this login must have WhatsApp linked before it may use the application.
  ///
  /// Off for every account, and switched on per person: an administrator ticks **Allow WhatsApp** in
  /// Login Credentials -> WhatsApp for the people who should be held to it. Nobody is held until
  /// somebody says so, which is what makes it safe to ship - and unticking releases a person whose
  /// phone is lost or broken, with no deploy and no code change.
  ///
  /// An administrator - a Super Admin, or any role carrying the Administrator tick - is never held
  /// whatever this says, so the studio cannot be locked out of the screen that would let it back in.
  ///
  /// See `whatsappStanding()` in the WhatsApp chat module.
  whatsappRequired   Boolean   @default(false) @map("whatsapp_required")
  /// The bcrypt hashes of the passwords this login has had before the current one, newest first
  /// and capped by `passwordHistory.js`, so a password change can refuse one used before.
  passwordHistory    Json?     @map("password_history")
  /// The login's own photograph, for accounts with no employee record to keep one on (the
  /// standalone Super Admin). A linked employee's photo lives on the employee row instead.
  profilePhotoUrl    String?   @map("profile_photo_url") @db.MediumText
  credentialsSentAt  DateTime? @map("credentials_sent_at")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // IAM Relations
  roles UserRole[]

  passwordResetTokens PasswordResetToken[]
  passwordResetOtps   PasswordResetOtp[]
  authSessions        AuthSession[]
  preferences         UserPreference[]

  /// Tasks this login gave to somebody, and tasks somebody gave it. Both sides are here because
  /// the Tasks screen asks the same question twice - what am I owed, and what do I owe - and each
  /// is one indexed lookup rather than a scan of every task in the studio.
  tasksGiven     HrmTask[]         @relation("HrmTasksGiven")
  tasksReceived  HrmTask[]         @relation("HrmTasksReceived")
  /// Required inverse of HrmTaskHolder.user. Adds no column; the link is on the holder row.
  tasksHeld      HrmTaskHolder[]   @relation("HrmTaskHolders")
  taskActivities HrmTaskActivity[]
  notifications  Notification[]

  @@index([branchId])
  @@index([accessDepartment])
  @@index([role])
  @@map("user")
}

// A persistent sign-in (the desktop app's "stay signed in"): one row per issued refresh token,
// valid for a fixed window from creation — no rolling extension. The raw token exists only in
// the client's OS credential store; only its SHA-256 lands here, so a database read never
// yields a usable credential. Revocation is a stamp, not a delete, so a stolen-token story can
// still be read afterwards.
/// One continuous stretch of somebody actually using the application.
///
/// The usage reports used to infer time on task from the gaps between recorded lead actions, which
/// answers a different question from the one the studio asks: a person who saved a lead, spent
/// twelve minutes in their inbox and saved another read as thirteen minutes of work here. What is
/// wanted is time in *this* application - the tab in front of them, being used.
///
/// So it is measured rather than inferred. The browser beats while the tab is visible and the
/// person has interacted recently; each beat extends the open stretch, and a beat that arrives
/// after too long a silence starts a new one. Nothing is written while the tab is in the
/// background, and nothing is written by a tab left open on an empty desk.
///
/// `context` is what they were using: "app" for the application at large, "whatsapp" while the chat
/// panel is open. One person can have both open at once, which is why they are separate rows rather
/// than one with a label - the WhatsApp usage report reads its own context and the application
/// report reads all of them.
model AppUsageSession {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  context   String   @default("app") @db.VarChar(30)
  startedAt DateTime @map("started_at")
  /// Moved forward by every beat, so the row is the stretch so far rather than a finished one.
  endedAt   DateTime @map("ended_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, context, endedAt])
  @@index([endedAt])
  @@map("app_usage_session")
}

/// One person's attendance for one day.
///
/// ── Why a row exists at all, when the sessions already say ──
///
/// `AppUsageSession` beside this already measures when somebody was working and for how long, and
/// the Work Hours report reads it as a timesheet. That answers "were they in the application", which
/// is most of attendance and none of the rest: it cannot say that a day was approved leave, a public
/// holiday, a half day, or a day somebody spent on a shoot with no laptop open.
///
/// So attendance is *derived* from the sessions by default and this table is what overrides it. A
/// day with no row here reads as whatever the person's own activity says - present, with the hours
/// they worked - and a day with one reads as what somebody wrote down. Nothing has to be entered
/// for the ordinary case, which is what makes the register right rather than merely present.
///
/// ── One row per person per day ──
///
/// `@@unique([userId, day])` is the whole integrity of this table. Attendance answers one question
/// per day, and two rows for one day is two answers with no rule for which wins - so marking a day
/// twice updates the day rather than adding to it.
///
/// `day` is a date and not a moment on purpose. A day is the unit attendance is kept in, and storing
/// a timestamp would make "the 5th" depend on the timezone it was read in.
model EmployeeAttendance {
  id     String   @id @default(cuid())
  userId Int      @map("user_id")
  day    DateTime @db.Date

  /// PRESENT, ABSENT, HALF_DAY, LEAVE, HOLIDAY or WEEK_OFF. Held as text rather than as an enum for
  /// the reason every other status in this schema is: the studio adds one, and an enum is a
  /// migration to do it.
  status String @default("PRESENT") @db.VarChar(20)

  /// When they started and finished, where anybody knows. Filled from the day's measured sessions
  /// when attendance is taken automatically, and editable when it is corrected by hand - somebody
  /// who was on a shoot until six has hours nothing in this application could have measured.
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")

  /// The minutes actually worked, as the register understands them. Stored rather than recomputed so
  /// a corrected day keeps the figure somebody agreed to, and so the register does not have to read
  /// the session table to draw a month.
  workedMinutes Int? @map("worked_minutes")

  /// Why the day reads as it does - "Sick leave", "Site visit". The one field a register is
  /// worthless without: an absence with no reason is a question rather than a record.
  note String? @db.Text

  /// Who wrote it down. Null for a day nobody has corrected, which is how a stored row can still be
  /// told from a derived one after the fact.
  markedByUserId Int?     @map("marked_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation("EmployeeAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  /// The register reads a month for everybody, and the calendar reads a range - both lead with the
  /// day, so it leads the index.
  @@index([day])
  @@map("employee_attendance")
}

/// How the application decides somebody has stopped using it.
///
/// One row, keyed "default", the same shape as ImageSelectionSettings and SalesQuotationSettings:
/// these are the studio's settings rather than a user's, so there is nothing to key them by.
///
/// The timeout was a constant compiled into the browser bundle, which meant changing it was a
/// deploy and every tab could disagree with every other until they were all reloaded. Held here it
/// is one number the whole studio reads, and the heartbeat asks for it rather than assuming it.
model AppMonitoringSettings {
  id                  String   @id @default("default") @db.VarChar(30)
  /// How long after somebody's last interaction they still count as using the application.
  /// Minutes, because that is the unit an administrator thinks in and types.
  usageTimeoutMinutes Int      @default(3) @map("usage_timeout_minutes")
  updatedByUserId     Int?     @map("updated_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("app_monitoring_settings")
}

model AuthSession {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  client     String    @default("desktop") @db.VarChar(30)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("auth_session")
}

/// How one login has arranged the application for itself: the order its columns were dragged into,
/// which of them it hid, how many it froze, how wide it pulled them, the density it reads at, and
/// the tab each screen was left on.
///
/// This is per user rather than per browser because the studio works from more than one machine
/// and expects the layout it built to be waiting on the next one. It is one row per `key` rather
/// than a single blob on `user` so two tabs arranging two different tables cannot overwrite each
/// other, and so a single table can be reset without rewriting everything else.
///
/// Nothing here is business data. A row lost, or never written because storage was refused, costs
/// the reader a layout and nothing more - which is why every read of it falls back rather than
/// failing.
model UserPreference {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the value describes, namespaced by kind: `table:<slug>` for one table's layout,
  /// `app:compactView` for the density every table follows, `tab:<screen>` for a remembered tab.
  /// The namespaces are the frontend's; this column only holds them.
  key   String @db.VarChar(120)
  /// The preference itself, whatever shape its key implies. Validated on the way in by
  /// `modules/user/preferences/service.js`, never trusted on the way out.
  value Json

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preference")
}

model Employee {
  id                           Int                     @id @default(autoincrement())
  employeeId                   String                  @unique @map("employee_id") @db.VarChar(50)
  employeeName                 String                  @map("employee_name") @db.VarChar(150)
  /// The login username of the account this employee holds - `User.username`, mirrored onto this
  /// row the moment an account is created (`createLoginCredentials`) or the login changes its own
  /// username (`PATCH /api/user/profile`), the only two places `User.username` is ever written.
  /// NULL until an account exists.
  ///
  /// Not a second place a username is *decided* - it is still created and changed on `User` alone,
  /// which is what keeps one account from having two answers to "what is my username." This is a
  /// read copy, kept in step by the same code that writes the original, so that everything that
  /// only needs to *look up* an employee by their login - the CRM's Google Sheet sync foremost -
  /// reads one table instead of joining to `User` for it. See `referenceMatchers.js`.
  loginUsername                String?                 @unique @map("login_username") @db.VarChar(50)
  employmentStatus             String                  @default("pending") @map("employment_status") @db.VarChar(30)
  gender                       String?                 @db.VarChar(30)
  contactNumber                String?                 @map("contact_number") @db.VarChar(30)
  emailId                      String?                 @map("email_id") @db.VarChar(191)
  workEmailId                  String?                 @map("work_email_id") @db.VarChar(191)
  dateOfJoining                DateTime?               @map("date_of_joining")
  designation                  String?                 @db.VarChar(150)
  /// Several, joined by ", " the way `skills` and `languagesKnown` are - the form asks for them
  /// with the same searchable multi-select, and fifteen of them do not fit a VarChar(150).
  department                   String?                 @db.Text
  skills                       String?                 @db.Text
  vertical                     String?                 @db.VarChar(150)
  verticalId                   Int?                    @map("vertical_id")
  workBaseLocation             String?                 @map("work_base_location") @db.VarChar(150)
  currentWorkLocation          String?                 @map("current_work_location") @db.VarChar(150)
  /// The branch as a reference. NULL until the match report decides how the two text columns above
  /// map onto `branch` (DATA-SCOPE.md, Stage 6); readers honour it where set and fall back to the
  /// text where not.
  branchId                     Int?                    @map("branch_id")
  photoShooter                 Boolean?                @map("photo_shooter")
  workType                     String?                 @map("work_type") @db.VarChar(100)
  languagesKnown               String?                 @map("languages_known") @db.Text
  /// Wide enough for whatever the studio puts on the Blood Groups list, not just the eight the
  /// browser used to offer: the list is maintained in Settings -> Field Settings and a name
  /// there may run to 120 characters, so a ten-character column would have taken "AB Positive"
  /// and stored eleven characters of it. Sized like `marital_status` beside it.
  bloodGroup                   String?                 @map("blood_group") @db.VarChar(50)
  emergencyContactName         String?                 @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactNumber       String?                 @map("emergency_contact_number") @db.VarChar(30)
  emergencyContactRelationship String?                 @map("emergency_contact_relationship") @db.VarChar(100)
  aadharCardNumber             String?                 @map("aadhar_card_number") @db.VarChar(50)
  panCardNumber                String?                 @map("pan_card_number") @db.VarChar(50)
  /// The Aadhaar and PAN photographs a candidate uploads during onboarding. Normally a link into
  /// object storage, but wide enough for the compressed data URI that stands in for one when object
  /// storage is not configured, the way the asset photo column does.
  aadharCardImageUrl           String?                 @map("aadhar_card_image_url") @db.MediumText
  panCardImageUrl              String?                 @map("pan_card_image_url") @db.MediumText
  /// The employee's own photograph, taken during onboarding and stored the same way as the two
  /// proofs beside it: a link into object storage, wide enough for the compressed data URI that
  /// stands in when object storage is not configured.
  profilePhotoUrl              String?                 @map("profile_photo_url") @db.MediumText
  fatherName                   String?                 @map("father_name") @db.VarChar(150)
  fatherOccupation             String?                 @map("father_occupation") @db.VarChar(150)
  motherName                   String?                 @map("mother_name") @db.VarChar(150)
  motherOccupation             String?                 @map("mother_occupation") @db.VarChar(150)
  spouseName                   String?                 @map("spouse_name") @db.VarChar(150)
  dateOfBirth                  DateTime?               @map("date_of_birth")
  maritalStatus                String?                 @map("marital_status") @db.VarChar(50)
  weddingAnniversary           DateTime?               @map("wedding_anniversary")
  currentAddress               String?                 @map("current_address") @db.Text
  permanentAddress             String?                 @map("permanent_address") @db.Text
  reference1PersonName         String?                 @map("reference1_person_name") @db.VarChar(150)
  reference1PersonPhone        String?                 @map("reference1_person_phone") @db.VarChar(30)
  reference1PersonAddress      String?                 @map("reference1_person_address") @db.Text
  reference2PersonName         String?                 @map("reference2_person_name") @db.VarChar(150)
  reference2PersonPhone        String?                 @map("reference2_person_phone") @db.VarChar(30)
  reference2PersonAddress      String?                 @map("reference2_person_address") @db.Text
  nominee1PersonName           String?                 @map("nominee1_person_name") @db.VarChar(150)
  nominee1PersonPhone          String?                 @map("nominee1_person_phone") @db.VarChar(30)
  nominee2PersonName           String?                 @map("nominee2_person_name") @db.VarChar(150)
  nominee2PersonPhone          String?                 @map("nominee2_person_phone") @db.VarChar(30)
  /// The two colleagues who cover this person's work while they are away. Employees rather than
  /// typed names, unlike the references and nominees above, because the cover is somebody the OS
  /// already holds a record of — and `onDelete: SetNull` so removing one of them empties the slot
  /// rather than refusing the deletion.
  alternative1EmployeeId       Int?                    @map("alternative1_employee_id")
  alternative2EmployeeId       Int?                    @map("alternative2_employee_id")
  /// Up to three colleagues who approve this person's leave requests, in order. Employee
  /// references like the alternatives above, set from the Leave Approval section of the
  /// credential form.
  leaveApprover1EmployeeId     Int?                    @map("leave_approver1_employee_id")
  leaveApprover2EmployeeId     Int?                    @map("leave_approver2_employee_id")
  leaveApprover3EmployeeId     Int?                    @map("leave_approver3_employee_id")
  /// The one colleague who approves this person's permission requests — an hour or two out of a
  /// single day, which the studio settles with one person rather than the queue of three a leave
  /// goes through. Left empty the permission falls to the leave approvers above, so a record nobody
  /// has filled this in on still has somebody who can decide.
  permissionApproverEmployeeId Int?                    @map("permission_approver_employee_id")
  /// The person this employee reports to — one manager, which is what makes the reporting map a
  /// tree rather than a graph. A self-relation like the alternatives above, and `onDelete: SetNull`
  /// so removing a manager leaves their reports without one rather than refusing the deletion.
  /// A row with this empty is a root of the chart.
  reportsToEmployeeId          Int?                    @map("reports_to_employee_id")
  bankName                     String?                 @map("bank_name") @db.VarChar(150)
  bankLocation                 String?                 @map("bank_location") @db.VarChar(150)
  accountNumber                String?                 @map("account_number") @db.VarChar(100)
  ifscCode                     String?                 @map("ifsc_code") @db.VarChar(30)
  bankAccountStatus            String?                 @map("bank_account_status") @db.VarChar(50)
  addedAccounts                String?                 @map("added_accounts") @db.Text
  companyMentionedName         String?                 @map("company_mentioned_name") @db.VarChar(150)
  dateOfRelieving              DateTime?               @map("date_of_relieving")
  relievingRemarks             String?                 @map("relieving_remarks") @db.Text
  totalSalary                  Decimal?                @map("total_salary") @db.Decimal(12, 2)
  joiningSalary                Decimal?                @map("joining_salary") @db.Decimal(12, 2)
  lastReviewDate               DateTime?               @map("last_review_date")
  nextReviewDate               DateTime?               @map("next_review_date")
  totalIncrement               Decimal?                @map("total_increment") @db.Decimal(12, 2)
  remarksDetails               String?                 @map("remarks_details") @db.Text
  appreciationDetails          String?                 @map("appreciation_details") @db.Text
  policyAgreementAccepted      Boolean                 @default(false) @map("policy_agreement_accepted")
  policyAgreementAcceptedAt    DateTime?               @map("policy_agreement_accepted_at")
  /// The Login Credentials page of onboarding, half-filled and put down.
  ///
  /// Creating a login is one screen's worth of decisions - the username and address, the roles, the
  /// branch, who covers for this person - and it was routinely interrupted. Nothing on that page
  /// belonged anywhere until the account existed, so closing the panel threw all of it away. This is
  /// where it waits: what was chosen, not an account. No `User` row is created, nothing is emailed,
  /// and none of it is in force until **Create User & Send Email** is pressed.
  ///
  /// Cleared the moment that happens - the account is then the truth, and a draft left beside it
  /// would be a second, staler answer to the same question.
  ///
  /// It holds the starting password, which is why the two endpoints that touch it ask for
  /// `ADMIN / User Management` write - the same permission creating the account asks for - rather
  /// than the HRM permission the rest of this record answers to.
  loginCredentialsDraft        Json?                   @map("login_credentials_draft")
  /// Why somebody in the InActive tab was brought back to work, and by whom.
  ///
  /// Asked for at the moment it is done, because the offboarding record it takes back is *deleted*
  /// by the same action: without this the only trace of a departure that was reversed would be a
  /// status quietly reading Active again. Overwritten if it happens twice - what is wanted is why
  /// this person is at work now, not a history of every reversal.
  reactivationReason           String?                 @map("reactivation_reason") @db.Text
  reactivatedAt                DateTime?               @map("reactivated_at")
  reactivatedByUserId          Int?                    @map("reactivated_by_user_id")
  archivedAt                   DateTime?               @map("archived_at")
  createdAt                    DateTime                @default(now()) @map("created_at")
  updatedAt                    DateTime                @updatedAt @map("updated_at")
  assignedAssets               Asset[]                 @relation("AssetAssignee")
  /// Required inverse of Asset.manager. Adds no column; the manager is stored on the asset.
  managedAssets                Asset[]                 @relation("AssetManager")
  /// Required inverse of ClientStorage.assignedTo. Adds no column; the link is on the record.
  assignedClientStorage        ClientStorage[]         @relation("ClientStorageAssignee")
  /// Required inverses of AssetStatusLog's custody columns. Add no columns; the links are on the log.
  assetLogsAssignedFrom        AssetStatusLog[]        @relation("AssetLogAssignedFrom")
  assetLogsAssignedTo          AssetStatusLog[]        @relation("AssetLogAssignedTo")
  separations                  EmployeeSeparation[]    @relation("EmployeeSeparations")
  reviews                      EmployeeReview[]        @relation("EmployeeReviews")
  /// The three repeating lists an employee carries: a married employee's children, what they
  /// studied, and where they have worked. Rows rather than columns, for the reason the reviews are
  /// rows - each is several facts about one thing, and there is no fixed number of them.
  children                     EmployeeChild[]         @relation("EmployeeChildren")
  qualifications               EmployeeQualification[] @relation("EmployeeQualifications")
  experiences                  EmployeeExperience[]    @relation("EmployeeExperiences")
  referralsMade                EmployeeReferral[]      @relation("EmployeeReferralsMade")
  referral                     EmployeeReferral?       @relation("EmployeeReferralReceived")
  cashEntriesHandled           CashEntry[]             @relation("CashEntriesHandled")
  paymentRequestsRaised        PaymentRequest[]        @relation("PaymentRequestsRaised")
  assetMaintenanceRepaired     AssetMaintenance[]      @relation("AssetMaintenanceRepairedBy")
  assetMaintenanceSubmitted    AssetMaintenance[]      @relation("AssetMaintenanceSubmittedBy")
  assetMaintenanceChecked      AssetMaintenance[]      @relation("AssetMaintenanceCheckedBy")
  alternative1                 Employee?               @relation("EmployeeAlternative1", fields: [alternative1EmployeeId], references: [id], onDelete: SetNull)
  alternative2                 Employee?               @relation("EmployeeAlternative2", fields: [alternative2EmployeeId], references: [id], onDelete: SetNull)
  reportsTo                    Employee?               @relation("EmployeeReportsTo", fields: [reportsToEmployeeId], references: [id], onDelete: SetNull)
  branch                       Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Required inverse of the column above. Adds no column; who reports to somebody is read from the
  /// other rows pointing at them.
  directReports                Employee[]              @relation("EmployeeReportsTo")
  /// Required inverses of the two columns above. Add no columns; who somebody covers *for* is read
  /// from the slots on the other person's row.
  coversAsAlternative1         Employee[]              @relation("EmployeeAlternative1")
  coversAsAlternative2         Employee[]              @relation("EmployeeAlternative2")
  /// Required inverses of the attendance tables. Add no columns; the links are on the session and
  /// the request. `attendanceRequestsDecided` is the approver's side — who answered, not who asked.
  attendanceSessions           AttendanceSession[]     @relation("AttendanceSessions")
  attendanceRequests           AttendanceRequest[]     @relation("AttendanceRequests")
  attendanceRequestsDecided    AttendanceRequest[]     @relation("AttendanceRequestsDecided")
  /// What this employee owns, for TEAM and SELF scope. Added by 20260906150000, filled by the backfill.
  ownedCrmLeads                SalesCrmLead[]          @relation("CrmLeadOwner")
  ownedQuotations              SalesQuotation[]        @relation("QuotationOwner")
  ownedTasks                   HrmTask[]               @relation("HrmTaskOwner")

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  verticalRef Vertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  @@index([employmentStatus])
  @@index([employeeName])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([branchId])
  @@index([verticalId])
  @@index([alternative1EmployeeId])
  @@index([alternative2EmployeeId])
  /// Walking the chart reads "everyone reporting to this person" once per node, which is this index.
  @@index([reportsToEmployeeId])
  /// An approver's queue asks "whose approver am I" across all three slots on every load, which is
  /// three index lookups rather than a scan of the employee table.
  @@index([leaveApprover1EmployeeId])
  @@index([leaveApprover2EmployeeId])
  @@index([leaveApprover3EmployeeId])
  /// And the same question for permissions, which the approver's queue asks beside those three.
  @@index([permissionApproverEmployeeId])
  @@map("employee")
}

/// One child of one employee, asked for on the onboarding form once the candidate says they are
/// married and editable afterwards on their record.
///
/// A table rather than a text column on Employee for the same reason EmployeeReview is one: a name
/// and a date of birth are two facts about one child, there is no fixed number of children, and a
/// comma-separated column could hold neither the pairing nor a real date. `onDelete: Cascade`
/// because a child row is a fact *about* an employee record and means nothing without one.
model EmployeeChild {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  name        String    @db.VarChar(150)
  /// Nullable so a row can never be the reason a submission is refused, though both forms ask for
  /// it and refuse a half-filled row of their own accord.
  dateOfBirth DateTime? @map("date_of_birth")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  employee    Employee  @relation("EmployeeChildren", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Always read as "this employee's children", never on their own.
  @@index([employeeId])
  @@map("employee_child")
}

/// One qualification an employee holds — a school, a diploma, a degree — asked for on the
/// onboarding form and editable afterwards on their record.
///
/// A table rather than a text column because somebody has several of these and each is four facts
/// that only mean anything together: a degree, its branch, where it was read, and when it finished.
/// Everything but the degree is nullable — a school year has no branch, and a candidate part way
/// through a course has no passing year yet.
model EmployeeQualification {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  degree        String   @db.VarChar(150)
  branch        String?  @db.VarChar(150)
  college       String?  @db.VarChar(200)
  /// The year alone, not a date: nobody knows the day they passed out, and a year is what a résumé
  /// and every verification call actually use.
  passedOutYear Int?     @map("passed_out_year")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  employee      Employee @relation("EmployeeQualifications", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Always read as "this employee's qualifications", never on their own.
  @@index([employeeId])
  @@map("employee_qualification")
}

/// One job an employee held before this one, with the letter that evidences it.
///
/// A table for the reason the qualifications are one: a career is a list, and a company, where it
/// was, how long it lasted and the role held are facts about one job rather than about the person.
/// Only the company is required — an old job whose exact length nobody remembers is still worth
/// recording, and a refusal here would be the reason somebody could not finish onboarding.
model EmployeeExperience {
  id              Int      @id @default(autoincrement())
  employeeId      Int      @map("employee_id")
  companyName     String   @map("company_name") @db.VarChar(200)
  companyLocation String?  @map("company_location") @db.VarChar(200)
  role            String?  @db.VarChar(150)
  /// How long they were there, in years, to one decimal — "2.5" is how a résumé says it. A number
  /// rather than two dates because that is the granularity anybody actually remembers.
  years           Decimal? @db.Decimal(4, 1)
  /// The experience or relieving letter for *this* company. Stored the way the separation letter
  /// beside it is: the file's own name, plus the link it was uploaded to — or the inline document
  /// itself where object storage is not configured, which is why the column is a MediumText.
  attachmentName  String?  @map("attachment_name") @db.VarChar(255)
  attachmentUrl   String?  @map("attachment_url") @db.MediumText
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  employee        Employee @relation("EmployeeExperiences", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Always read as "this employee's experience", never on its own.
  @@index([employeeId])
  @@map("employee_experience")
}

/// One salary review, replacing the ten numbered increment columns on Employee that could only ever
/// hold ten of them. The employee's total increment, total salary, last review date and next review
/// date are all worked out from these rows rather than typed in, so they cannot drift from the
/// reviews they are meant to summarise.
model EmployeeReview {
  id              Int       @id @default(autoincrement())
  employeeId      Int       @map("employee_id")
  reviewDate      DateTime  @map("review_date")
  /// How the review went: `Shine` or `Shadow`.
  ///
  /// The one thing a salary review records that the money does not say. An increment is the mark's
  /// consequence and a poor reading of the mark itself: a review that shone in a year the studio
  /// held salaries reads as identical to one that did not, and now that the amount is optional a
  /// blank would have read as a shadow rather than as unrecorded.
  ///
  /// Null on a review raised before this column, and on one nobody judged - shown with no colour at
  /// all, which is why there is no third middle mark: unmarked already means "nobody said".
  outcome         String?   @db.VarChar(20)
  /// What the review awarded, where it awarded anything.
  ///
  /// Optional, because plenty of reviews are held without one - a confirmation, a review in a year
  /// with no raises, a conversation recorded before the figure is agreed - and requiring it meant
  /// typing a 0 that then counted as a real increment of zero in the employee's totals. Null and
  /// zero are different facts and the totals treat them so: null contributes nothing.
  incrementAmount Decimal?  @map("increment_amount") @db.Decimal(12, 2)
  nextReviewDate  DateTime? @map("next_review_date")
  remarks         String?   @db.Text
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  employee        Employee  @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, reviewDate])
  @@map("employee_review")
}

/// Studio-wide HR settings, as one row keyed "default" — the same shape as
/// `SalesQuotationSettings` and `ImageSelectionSettings`, and for the same reason: these are the
/// studio's numbers, not a user's, so there is nothing to key them by.
model HrmSettings {
  id                       String   @id @default("default") @db.VarChar(30)
  /// What a referral is worth in total, divided equally across the months below: 6,000 over months
  /// 3 and 6 is 3,000 at the referred employee's third month and 3,000 at their sixth.
  ///
  /// Only the total is configured here. The split belongs to the instalment rows, which each keep
  /// the figure they were created with - so raising this never reprices a referral already promised.
  referralAmount           Decimal  @default(0) @map("referral_amount") @db.Decimal(12, 2)
  /// The months after joining that a referral is settled over, as the offsets themselves: "3,6" is
  /// the pair the studio started with, "3,6,12" pays in thirds across a year.
  ///
  /// The offsets rather than a count, because `EmployeeReferralPayout.monthOffset` is what an
  /// instalment *is* - the register reads "3rd month" off it and `@@unique([referralId,
  /// monthOffset])` keeps a schedule from being generated twice. A count would have to invent the
  /// spacing, and the studio's own two months are not evenly spaced from zero.
  ///
  /// Changing this is never retrospective: a referral already recorded keeps the offsets it was
  /// created with, so only referrals made from then on are settled over the new months.
  referralInstalmentMonths String   @default("3,6") @map("referral_instalment_months") @db.VarChar(100)
  updatedByUserId          Int?     @map("updated_by_user_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("hrm_settings")
}

/// Who referred a new employee, and what the studio owes them for it.
///
/// One row per person referred — `referredEmployeeId` is unique — while a referrer may hold many,
/// which is the whole reason this is a table rather than columns on `Employee`.
///
/// `referredOn` is the referred employee's joining date, copied here rather than read live: the
/// payout dates are counted from it, and the joining date stays editable long after.
model EmployeeReferral {
  id                 Int      @id @default(autoincrement())
  /// `DBS-REF-000001`, the code the register quotes a referral by.
  ///
  /// Nullable because the column was added to rows that were already here — `renumberIdentifiers`
  /// fills those in, and one that somehow still has none is given the next code the next time it is
  /// saved. Unique either way, so two referrals can never be quoted under one code; MySQL allows
  /// many NULLs in a unique index, which is what let the column be added before it was filled.
  referralId         String?  @unique @map("referral_id") @db.VarChar(30)
  /// Nullable, with the name kept beside it, the same way `CashEntry` keeps `handlerName`: a
  /// referrer who is deleted must not take the record of what they were owed with them.
  referrerEmployeeId Int?     @map("referrer_employee_id")
  referrerName       String   @map("referrer_name") @db.VarChar(150)
  referredEmployeeId Int      @unique @map("referred_employee_id")
  referredOn         DateTime @map("referred_on")
  remarks            String?  @db.Text
  createdByUserId    Int?     @map("created_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  referrer Employee?                @relation("EmployeeReferralsMade", fields: [referrerEmployeeId], references: [id], onDelete: SetNull)
  referred Employee                 @relation("EmployeeReferralReceived", fields: [referredEmployeeId], references: [id], onDelete: Cascade)
  payouts  EmployeeReferralPayout[]

  @@index([referrerEmployeeId])
  @@map("employee_referral")
}

/// One instalment of a referral: the third month, and the sixth.
///
/// A row per instalment rather than a pair of columns on the referral, because each carries its own
/// date, amount and state — and because this row *is* the payslip line the upcoming payroll will
/// read. "What referral money is due to this person this month?" is then an indexed query over
/// `status` and `dueOn` rather than a scan with a case for every instalment anybody ever adds.
///
/// `amount` is stamped when the referral is created and never recalculated. Raising the studio's
/// referral amount afterwards applies to referrals made from then on; somebody referred under the
/// old figure is paid the old figure, at both instalments.
model EmployeeReferralPayout {
  id           Int       @id @default(autoincrement())
  referralId   Int       @map("referral_id")
  /// Months after `referredOn` that this instalment falls due: 3, then 6.
  monthOffset  Int       @map("month_offset")
  dueOn        DateTime  @map("due_on")
  amount       Decimal   @db.Decimal(12, 2)
  /// Pending until it is handed over, Paid once it has been, Cancelled if the employee left first.
  status       String    @default("Pending") @db.VarChar(20)
  paidOn       DateTime? @map("paid_on")
  paidByUserId Int?      @map("paid_by_user_id")
  remarks      String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  referral EmployeeReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  /// One instalment per offset per referral, so regenerating a schedule cannot double-pay.
  @@unique([referralId, monthOffset])
  /// The question payroll will ask: what is outstanding and due by now.
  @@index([status, dueOn])
  @@map("employee_referral_payout")
}

/// How an employee left, whichever of the eight ways it was. Resignation is one separation type
/// among them, so the employee's own submission — the date they resigned and the letter they sent —
/// is optional here rather than the spine of the record: nobody submits a termination, a layoff or
/// a death. Kept apart from the employee row so every separation stays on the record instead of
/// being overwritten by the relieving details on Employee itself.
model EmployeeSeparation {
  id                       Int     @id @default(autoincrement())
  employeeId               Int     @map("employee_id")
  separationType           String  @map("separation_type") @db.VarChar(40)
  separationReason         String  @map("separation_reason") @db.VarChar(150)
  detailedReason           String? @map("detailed_reason") @db.Text
  /// The status the employee was moved to when this separation was recorded, and the one they held
  /// before it, so removing a separation entered by mistake puts them back where they were.
  employmentStatus         String  @map("employment_status") @db.VarChar(30)
  previousEmploymentStatus String? @map("previous_employment_status") @db.VarChar(30)

  /// Only a resignation or a mutual separation has these: the employee's own submission.
  resignationDate       DateTime? @map("resignation_date")
  resignationLetterName String?   @map("resignation_letter_name") @db.VarChar(255)
  /// The link the letter was uploaded to, or the inline document itself when object storage is not
  /// configured, which is why this is not a short column.
  resignationLetterUrl  String?   @map("resignation_letter_url") @db.MediumText

  proposedLastWorkingDate DateTime @map("proposed_last_working_date")
  /// Notice in days. Required minus served is the shortfall; waived is how much of it was forgiven.
  noticePeriodRequired    Int?     @map("notice_period_required")
  noticePeriodServed      Int?     @map("notice_period_served")
  noticePeriodWaived      Int?     @map("notice_period_waived")
  waiverReason            String?  @map("waiver_reason") @db.Text
  /// Whether the employee asked to go early, kept apart from whether HR agreed.
  earlyReleaseRequested   Boolean  @default(false) @map("early_release_requested")
  earlyReleaseReason      String?  @map("early_release_reason") @db.Text
  hrRemarks               String?  @map("hr_remarks") @db.Text

  /// The signed-in user who recorded the separation and whoever last touched it.
  createdBy Int?     @map("created_by")
  updatedBy Int?     @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  employee  Employee @relation("EmployeeSeparations", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([separationType])
  @@map("employee_separation")
}

/**
 * A live "forgot password" request.
 * Only a SHA-256 hash of the token is kept, the way `EmployeeOnboardingInvite` keeps its own: the
 * token itself goes out in the email and exists nowhere else, so a copy of this table is not a set
 * of working reset links.
 * `usedAt` makes it single-use, and every other live token for the same user is spent when one is
 * redeemed - a reset link that still worked after the password changed would be a way back in for
 * whoever had the older email.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// A password reset asked for by mobile rather than by email.
///
/// Separate from `PasswordResetToken` because the two are different secrets with different rules. A
/// token is 32 random bytes in a link and is safe for an hour; an OTP is six digits somebody reads
/// off a phone and types, which is a million guesses - so it lives for two minutes, is single use,
/// and counts its own attempts. Verifying one mints an ordinary `PasswordResetToken`, so the reset
/// itself is the same path the emailed link has always taken.
///
/// Only the hash is stored, like the token beside it: a copy of this table is not a set of working
/// codes.
model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  /// sha256 of the six digits. Not unique - two accounts may hold the same code at once, and
  /// making it unique would leak that by refusing the second.
  codeHash  String    @map("code_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// Wrong guesses so far. The code is spent at `OTP_MAX_ATTEMPTS`, so a six-digit secret cannot be
  /// worked through: without this, a script has a million tries inside the two minutes.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_otp")
}

model EmployeeOnboardingInvite {
  id                  String    @id @default(cuid())
  candidateName       String    @map("candidate_name") @db.VarChar(150)
  candidateEmail      String    @map("candidate_email") @db.VarChar(191)
  candidatePhone      String    @map("candidate_phone") @db.VarChar(30)
  intendedDesignation String?   @map("intended_designation") @db.VarChar(150)
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  tokenPreview        String?   @map("token_preview") @db.VarChar(32)
  /// The raw token, kept so Send Back can email the candidate the same link again. A deliberate
  /// softening of the hash-only design: an onboarding token opens one form, not an account, and
  /// resending the identical link is a product requirement. Null on invites created before this.
  token               String?   @db.VarChar(64)
  shortCode           String?   @unique @map("short_code") @db.VarChar(8)
  status              String    @default("Created") @db.VarChar(20)
  expiresAt           DateTime  @map("expires_at")
  verifiedAt          DateTime? @map("verified_at")
  submittedAt         DateTime? @map("submitted_at")
  employeeId          String?   @map("employee_id") @db.VarChar(50)
  cancelledAt         DateTime? @map("cancelled_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@index([candidateEmail])
  @@index([createdAt])
  @@map("employee_onboarding_invite")
}

/// The one row that says what a working day is: when the shift starts, how late is still on time,
/// which weekdays are off, and how many minutes a full day owes. Attendance status used to be
/// decided in the browser against a hardcoded 9:45 and a fixed 42h30 week, so every employee was
/// judged by the same numbers and nobody could change them. A singleton rather than a per-employee
/// roster: the studio runs one shift, and the day a second one appears this grows a shift table
/// that these columns become the default for.
model AttendanceSettings {
  id                   Int    @id @default(1)
  /// Local wall-clock "HH:MM", not a timestamp — a shift starts at 09:30 every day, and storing an
  /// instant would drag a date along with it.
  shiftStart           String @default("09:30") @map("shift_start") @db.VarChar(5)
  shiftEnd             String @default("18:30") @map("shift_end") @db.VarChar(5)
  /// Minutes after `shiftStart` that still count as on time. 15 reproduces the 9:45 the old screen
  /// had baked in, so the change of behaviour is opt-in rather than immediate.
  lateGraceMinutes     Int    @default(15) @map("late_grace_minutes")
  /// What one full working day owes, in minutes. Weekly and monthly targets are this multiplied by
  /// the working days actually in the range — weekends and holidays removed — rather than two more
  /// fixed numbers that drift every time a month is short or a festival lands midweek.
  dailyTargetMinutes   Int    @default(510) @map("daily_target_minutes")
  /// The weekdays nobody is expected in, as `Date.getDay()` numbers joined by commas: 0 is Sunday.
  /// A string rather than seven booleans because it is read whole and never queried by day.
  weeklyOffDays        String @default("0") @map("weekly_off_days") @db.VarChar(20)
  /// The longest single permission request anybody may raise, in minutes. Beyond it the day is a
  /// half day or a leave, which is a different request with a different approver conversation.
  maxPermissionMinutes Int    @default(180) @map("max_permission_minutes")

  /// How far from a branch's office somebody may still mark their day, in metres, for any branch
  /// that has not set a radius of its own. A default rather than a fixed number because a city
  /// office and a rented studio floor do not deserve the same circle.
  defaultRadiusMeters   Int     @default(200) @map("default_radius_meters")
  /// The worst GPS accuracy still worth believing, in metres. A browser reporting ±2km has not
  /// located anybody, and treating that as "inside the office" would make the geofence decorative.
  /// A reading worse than this is recorded and left unverified rather than being called a pass.
  maxGpsAccuracyMeters  Int     @default(150) @map("max_gps_accuracy_meters")
  /// Whether a day may be marked from outside the circle at all. Off means an outside login is
  /// recorded and flagged for HR; on means it is refused and the employee raises a request instead.
  /// Held here rather than assumed, because a studio with field crews wants the opposite of one
  /// whose staff are all in the building.
  enforceGeofence       Boolean @default(false) @map("enforce_geofence")
  /// The half-day band, in minutes worked: at least the first and no more than the second.
  ///
  /// A band rather than a single threshold, because a threshold cannot say the thing a studio
  /// actually means. "Under four hours is a half day" credits somebody who was here for twenty
  /// minutes with half a day, and it makes four hours exactly a *full* one. Four to five hours is a
  /// half day; below four is too short to credit and reads as an absence; above five is a full day,
  /// judged then on when they arrived and left.
  ///
  /// `halfDayMinMinutes` at zero switches both rules off — no floor and no band — which is the
  /// behaviour before either column existed.
  halfDayMinMinutes     Int     @default(240) @map("half_day_min_minutes")
  halfDayMaxMinutes     Int     @default(300) @map("half_day_max_minutes")
  /// Leaving earlier than `shiftEnd` by more than this many minutes reads as an early exit. Its own
  /// number rather than `lateGraceMinutes` reused: arriving late and leaving early are not the same
  /// forgiveness.
  earlyExitGraceMinutes Int     @default(15) @map("early_exit_grace_minutes")

  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("attendance_settings")
}

/// A day the studio is closed. Kept apart from the settings row because holidays are a list that
/// grows every year, and a working-day count has to be able to ask "is this date one of them"
/// for a whole range at once.
model AttendanceHoliday {
  id          Int      @id @default(autoincrement())
  /// Midnight local time on the day itself. Unique, so the same festival cannot be entered twice.
  holidayDate DateTime @unique @map("holiday_date") @db.Date
  name        String   @db.VarChar(150)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([holidayDate])
  @@map("attendance_holiday")
}

/// One employee's one attendance day: when they logged in, from where, with which selfie, and when
/// they logged out. This is the record the whole module exists for, and it lives here rather than
/// in the browser's localStorage — where it was device-specific, lost with the site data, and
/// editable from the console by the person it judged.
model AttendanceSession {
  id                Int       @id @default(autoincrement())
  employeeId        Int       @map("employee_id")
  employee          Employee  @relation("AttendanceSessions", fields: [employeeId], references: [id], onDelete: Cascade)
  /// The calendar day the session belongs to, at midnight local. Carried as its own column rather
  /// than derived from `loginAt` so the uniqueness below can be a database constraint: one login
  /// per person per day, enforced where it cannot be talked out of.
  workDate          DateTime  @map("work_date") @db.Date
  loginAt           DateTime  @map("login_at")
  logoutAt          DateTime? @map("logout_at")
  workMode          String    @default("office") @map("work_mode") @db.VarChar(30)
  /// The login selfie. A link into object storage, or the compressed data URI that stands in for
  /// one when object storage is not configured — the same arrangement the employee photo columns
  /// use, and the reason this is MediumText rather than VarChar.
  loginSelfieUrl    String?   @map("login_selfie_url") @db.MediumText
  /// Whether a real face detector confirmed a face in that selfie, as opposed to nobody having
  /// checked. False is not an accusation: browsers without `FaceDetector` cannot check at all, and
  /// the honest record of that is an unverified selfie for HR to look at, not a guess dressed as
  /// a verification.
  loginFaceVerified Boolean   @default(false) @map("login_face_verified")
  loginLatitude     Decimal?  @map("login_latitude") @db.Decimal(10, 7)
  loginLongitude    Decimal?  @map("login_longitude") @db.Decimal(10, 7)
  loginAccuracyM    Int?      @map("login_accuracy_m")
  logoutLatitude    Decimal?  @map("logout_latitude") @db.Decimal(10, 7)
  logoutLongitude   Decimal?  @map("logout_longitude") @db.Decimal(10, 7)
  logoutAccuracyM   Int?      @map("logout_accuracy_m")

  /// The selfies as object keys rather than links.
  ///
  /// `loginSelfieUrl` above is the original column and stays, because rows already hold links in
  /// it and a data URI is still what a server with no object storage produces. New captures write
  /// the key here instead and the link is never handed out: an attendance selfie is a photograph of
  /// somebody at a place at a time, and the rest of this application's images are served from a
  /// public bucket. `GET /api/hrm/attendance/selfie/:eventId` is the only way to see one.
  loginSelfieKey     String? @map("login_selfie_key") @db.VarChar(255)
  /// The checkout selfie, which the day had no way to record before. Marking the end of a day is
  /// as much a claim about where somebody was as marking the start of it.
  logoutSelfieKey    String? @map("logout_selfie_key") @db.VarChar(255)
  logoutFaceVerified Boolean @default(false) @map("logout_face_verified")

  /// Where the geofence decided the person was, per end of the day. The branch is the one the
  /// distance was measured to - normally the employee's own, recorded so a later reading does not
  /// silently re-measure against a branch that has since moved.
  loginBranchId          Int?    @map("login_branch_id")
  loginDistanceMeters    Int?    @map("login_distance_meters")
  loginLocationVerified  Boolean @default(false) @map("login_location_verified")
  logoutBranchId         Int?    @map("logout_branch_id")
  logoutDistanceMeters   Int?    @map("logout_distance_meters")
  logoutLocationVerified Boolean @default(false) @map("logout_location_verified")

  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  events    AttendanceEvent[] @relation("AttendanceSessionEvents")

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([employeeId, loginAt])
  @@map("attendance_session")
}

/// Where a branch's office actually is, so "was this person at work" can be answered rather than
/// assumed.
///
/// Its own table rather than two columns on `Branch`: a branch is an accounting and addressing
/// concept that half this schema points at, and a circle on a map with a radius is an attendance
/// rule that only this module reads. Keeping them apart also means a branch can exist with no
/// office location recorded, which is the honest state of every branch the day this ships - and a
/// branch without one simply has no geofence rather than a geofence at latitude zero.
model AttendanceOfficeLocation {
  id       Int    @id @default(autoincrement())
  /// One office per branch. Unique, so "the office for this branch" is a lookup and not a choice.
  branchId Int    @unique @map("branch_id")
  branch   Branch @relation("AttendanceOfficeLocations", fields: [branchId], references: [id], onDelete: Cascade)
  /// What to call this place on screen - "Coimbatore Studio", not the branch's registered name,
  /// which is often a company name rather than somewhere you can stand.
  name     String @db.VarChar(150)

  /// Seven decimal places is roughly a centimetre, which is far finer than any phone reports and
  /// costs nothing; the same precision the session columns already use so a distance is not
  /// computed between two differently-rounded points.
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  /// How far from that point still counts as being here. Null falls back to the studio-wide
  /// `defaultRadiusMeters`, so a branch that has never thought about it still has a circle.
  allowedRadiusMeters Int? @map("allowed_radius_meters")

  /// A location switched off is ignored by the geofence entirely, and its branch behaves as one
  /// with no office recorded. Deactivating is how an office is retired without losing the rows
  /// that measured distances to it.
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int?     @map("created_by_id")
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive], map: "attendance_office_location_is_active_idx")
  @@map("attendance_office_location")
}

/// Every attendance capture that has ever happened, exactly as it happened.
///
/// `AttendanceSession` holds the day as it currently reads and is updated - a logout fills in
/// columns on the row the login created, and HR correcting a day will overwrite them. This table is
/// never updated and never deleted: one row per capture, holding the photograph, the coordinates,
/// the accuracy and the distance as they were measured at that moment. It is what makes a
/// correction auditable rather than a quiet overwrite, and it is what the selfie endpoint reads,
/// because permission to see a photograph is a question about one capture and not about a day.
model AttendanceEvent {
  id         Int               @id @default(autoincrement())
  sessionId  Int               @map("session_id")
  session    AttendanceSession @relation("AttendanceSessionEvents", fields: [sessionId], references: [id], onDelete: Cascade)
  /// Denormalised from the session so "this person's captures" is one index rather than a join,
  /// and so a row still names its subject if the session is ever rebuilt.
  employeeId Int               @map("employee_id")
  /// CHECK_IN or CHECK_OUT. Text rather than an enum for the reason every other status here is:
  /// adding a third kind of capture should not be a migration.
  type       String            @db.VarChar(20)

  /// The server's clock at the moment of capture. Never the browser's - a clock the person being
  /// judged can set is not evidence of when they arrived.
  capturedAt   DateTime @map("captured_at")
  /// The object key, not a link. See `AttendanceSession.loginSelfieKey`.
  selfieKey    String?  @map("selfie_key") @db.VarChar(255)
  /// The compressed data URI, used only where object storage is not configured - a local machine,
  /// or a server missing its R2 keys. MediumText for the same reason the employee photo columns are.
  selfieData   String?  @map("selfie_data") @db.MediumText
  faceVerified Boolean  @default(false) @map("face_verified")

  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  accuracyM        Int?     @map("accuracy_m")
  /// The branch the distance below was measured to, and the reading. Both null where the branch has
  /// no office location recorded, which is not a failure - it is a geofence that does not exist yet.
  branchId         Int?     @map("branch_id")
  distanceMeters   Int?     @map("distance_meters")
  locationVerified Boolean  @default(false) @map("location_verified")
  /// Why the location was not verified, in words: outside the radius, accuracy too poor, no office
  /// recorded for the branch. Stored rather than re-derived, because the settings it was judged
  /// against can change afterwards and the row should still say what happened at the time.
  locationNote     String?  @map("location_note") @db.VarChar(255)

  /// Where those coordinates actually are, in words - "Perundurai Road, Erode, Tamil Nadu".
  ///
  /// Resolved once, after the capture is safely recorded, and then never again: an address is a
  /// fact about a moment, and re-reading it later would let a renamed street rewrite history. NULL
  /// for every capture taken before this column existed, and for any where the lookup did not
  /// answer - a missing address is a line that falls back to coordinates, never a failed check-in.
  locationAddress String? @map("location_address") @db.VarChar(300)

  /// The user agent, trimmed. Not identification - a browser string is trivially forged - but it is
  /// what tells somebody reviewing a strange day that it was marked from a different device.
  deviceInfo String?  @map("device_info") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  // Named explicitly so the schema states the name the migration actually created, rather than
  // Prisma's default, which is longer and would read as drift on every `migrate diff`.
  @@index([sessionId, capturedAt], map: "attendance_event_session_captured_idx")
  @@index([employeeId, capturedAt], map: "attendance_event_employee_captured_idx")
  @@map("attendance_event")
}

/// The line somebody reads after marking their day.
///
/// A table rather than a constant because the studio will want to change these without a deploy,
/// and several per weekday rather than one because the same sentence every Monday stops being read
/// by the second week. Which one shows is decided from the date, so everybody sees the same line on
/// the same day and it does not change when somebody reloads the page.
model AttendanceQuote {
  id        Int     @id @default(autoincrement())
  /// `Date.getDay()`: 0 is Sunday. Not a date - these repeat every week, and a quote pinned to one
  /// Monday would need writing again for the next.
  dayOfWeek Int     @map("day_of_week")
  quote     String  @db.VarChar(400)
  /// Switched off rather than deleted, so a line that turned out badly can come back without being
  /// typed again, and so the day it was shown on still points at something.
  isActive  Boolean @default(true) @map("is_active")

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([dayOfWeek, isActive], map: "attendance_quote_day_active_idx")
  @@map("attendance_quote")
}

/// A leave, permission or on-duty request, and what was decided about it.
///
/// One table for the three because they are the same conversation — somebody asks to be away, an
/// approver says yes or no — differing only in what they name: a leave names dates, a permission
/// names an hour inside one day, an on-duty names where the work is instead. The status is only
/// ever what a person decided; "Upcoming" is not stored, because an approved leave starting on
/// Monday is the same row on Sunday as it is on Tuesday and only the reading changes.
model AttendanceRequest {
  id              Int                         @id @default(autoincrement())
  employeeId      Int                         @map("employee_id")
  employee        Employee                    @relation("AttendanceRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  type            String                      @db.VarChar(20)
  status          String                      @default("PENDING") @db.VarChar(20)
  /// Both dates are set for every type. A permission and an on-duty put the same day in both, so
  /// "which requests cover this date" is one range test rather than three per-type ones.
  fromDate        DateTime                    @map("from_date") @db.Date
  toDate          DateTime                    @map("to_date") @db.Date
  /// Local "HH:MM", set on permissions only. The server refuses a `toTime` that is not after
  /// `fromTime`, which the browser-only version could not do.
  fromTime        String?                     @map("from_time") @db.VarChar(5)
  toTime          String?                     @map("to_time") @db.VarChar(5)
  reason          String                      @db.Text
  /// The request this one re-raises. "Apply again" writes a new row pointing back at the rejected
  /// one instead of resetting that row's status, so the refusal and the second attempt both survive.
  supersedesId    Int?                        @map("supersedes_id")
  supersedes      AttendanceRequest?          @relation("AttendanceRequestSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    AttendanceRequest[]         @relation("AttendanceRequestSupersedes")
  decidedById     Int?                        @map("decided_by_id")
  decidedBy       Employee?                   @relation("AttendanceRequestsDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?                   @map("decided_at")
  decisionRemarks String?                     @map("decision_remarks") @db.Text
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  events          AttendanceRequestEvent[]    @relation("AttendanceRequestEvents")
  approvals       AttendanceRequestApproval[] @relation("AttendanceRequestApprovals")

  @@index([employeeId, status])
  @@index([type, status])
  /// "Was this person away on that date" — asked for every day of every attendance summary.
  @@index([employeeId, fromDate, toDate])
  @@map("attendance_request")
}

/// One named approver's answer on one request.
///
/// A leave goes to everybody on the employee's list and needs **all** of them; a permission goes to
/// the one permission approver. Either way the list is written down when the request is raised, so
/// "who has answered and who has not" is a query rather than a reconstruction — and so changing
/// somebody's approvers later cannot rewrite who was asked about a leave last month.
///
/// This is what `AttendanceRequestEvent` beside it could not do. That log records the *login* that
/// acted, which is the honest record of an action but cannot say which of three approvers a person
/// is, nor list the two who have not answered yet.
model AttendanceRequestApproval {
  id        Int               @id @default(autoincrement())
  requestId Int               @map("request_id")
  request   AttendanceRequest @relation("AttendanceRequestApprovals", fields: [requestId], references: [id], onDelete: Cascade)

  /// The employee whose answer this is. Not a login: approvers are named on an employee record, and
  /// somebody can hold two logins or none.
  approverEmployeeId Int    @map("approver_employee_id")
  /// PENDING until they answer, then APPROVED or REJECTED. Their own answer, not the request's —
  /// one rejection settles the whole request while the others may still read PENDING, and that is
  /// the honest record of what each person actually did.
  decision           String @default("PENDING") @db.VarChar(20)

  remarks   String?   @db.Text
  decidedAt DateTime? @map("decided_at")
  createdAt DateTime  @default(now()) @map("created_at")

  /// One answer per approver per request. A second press is changing an answer, not adding one.
  @@unique([requestId, approverEmployeeId])
  @@index([approverEmployeeId, decision])
  @@map("attendance_request_approval")
}

/// Everything that has ever happened to a request, in order. Raising, approving, rejecting and
/// cancelling each append a row and none of them overwrite one, so the history reads as what was
/// asked and who answered rather than as a status field's last value.
model AttendanceRequestEvent {
  id          Int               @id @default(autoincrement())
  requestId   Int               @map("request_id")
  request     AttendanceRequest @relation("AttendanceRequestEvents", fields: [requestId], references: [id], onDelete: Cascade)
  action      String            @db.VarChar(20)
  actorUserId Int?              @map("actor_user_id")
  /// The actor's name as it read at the time. Kept as text beside the id because a log that says
  /// "approved by user 42" stops meaning anything once user 42 is renamed or removed.
  actorName   String            @map("actor_name") @db.VarChar(150)
  remarks     String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("attendance_request_event")
}

model SalesProject {
  id                                  String                                    @id @default(cuid())
  enquiryId                           String                                    @map("enquiry_id") @db.VarChar(100)
  eventId                             String                                    @unique @map("event_id") @db.VarChar(30)
  whatsappGroupNameId                 String?                                   @map("whatsapp_group_name_id") @db.VarChar(191)
  whatsappGroupName                   String                                    @map("whatsapp_group_name") @db.VarChar(500)
  clientMainNumber                    String                                    @map("client_main_number") @db.VarChar(30)
  vertical                            String?                                   @db.VarChar(30)
  verticalId                          Int?                                      @map("vertical_id")
  sourceBranch                        String                                    @map("source_branch") @db.VarChar(30)
  branchId                            Int?                                      @map("branch_id")
  deliverables                        String                                    @db.VarChar(100)
  deliverablesDetails                 String?                                   @map("deliverables_details") @db.Text
  salesPreProductionRemarks           String?                                   @map("sales_pre_production_remarks") @db.Text
  salesProductionRemarks              String?                                   @map("sales_production_remarks") @db.Text
  salesPostProductionRemarks          String?                                   @map("sales_post_production_remarks") @db.Text
  mainEventDateKnown                  Boolean                                   @default(false) @map("main_event_date_known")
  mainEventDate                       DateTime?                                 @map("main_event_date")
  initialConvertedValue               Decimal                                   @map("initial_converted_value") @db.Decimal(12, 2)
  /// The quotation version this project converted at — a `SalesQuotation.quotationId`, "QUT039-02".
  ///
  /// Not a relation, and deliberately so: a quotation may be soft-deleted while the project that
  /// converted at it stands, and a foreign key would either block that or take the project's own
  /// record of what it sold with it. The id is the reference a person quotes anyway.
  ///
  /// Null for a project converted without one — the amount can still be typed straight into
  /// Initial Converted Value — and for every project created before this column existed, which is
  /// why the quotation register reads an absent marker as "not finalized" rather than as an error.
  quotationId                         String?                                   @map("quotation_id") @db.VarChar(30)
  crmName                             String                                    @map("crm_name") @db.VarChar(191)
  crmEmployeeId                       Int?                                      @map("crm_employee_id")
  groupType                           String?                                   @map("group_type") @db.VarChar(30)
  groupNameGeneratorJson              Json?                                     @map("group_name_generator_json")
  projectStatus                       String                                    @default("Yet to Start") @map("project_status") @db.VarChar(60)
  projectManager                      String?                                   @map("project_manager") @db.VarChar(191)
  projectManagerEmployeeId            Int?                                      @map("project_manager_employee_id")
  preProductionCoordinator            String?                                   @map("pre_production_coordinator") @db.VarChar(191)
  preProductionCoordinatorEmployeeId  Int?                                      @map("pre_production_coordinator_employee_id")
  creativeManager                     String?                                   @map("creative_manager") @db.VarChar(191)
  creativeManagerEmployeeId           Int?                                      @map("creative_manager_employee_id")
  postProductionCoordinator           String?                                   @map("post_production_coordinator") @db.VarChar(191)
  postProductionCoordinatorEmployeeId Int?                                      @map("post_production_coordinator_employee_id")
  /// The two client gifts, each "Applicable" or "Not Applicable". Applicable means somebody is
  /// named for it: `*Assignee` is the employee's name at the time it was assigned, `*EmployeeId`
  /// the employee it was taken from - the same name-plus-id pair every other project assignment
  /// uses, so a renamed employee does not rewrite history.
  welcomeGift                         String?                                   @map("welcome_gift") @db.VarChar(30)
  welcomeGiftEmployeeId               Int?                                      @map("welcome_gift_employee_id")
  welcomeGiftAssignee                 String?                                   @map("welcome_gift_assignee") @db.VarChar(191)
  /// Where the gift has got to: "Yet To Receive", "Sent", or "Received by Client" - the three tabs
  /// of Client Zone. Null until the gift is marked Applicable; the two timestamps are stamped as
  /// the status is moved on, and are what the screen sorts by.
  welcomeGiftStatus                   String?                                   @map("welcome_gift_status") @db.VarChar(30)
  welcomeGiftSentAt                   DateTime?                                 @map("welcome_gift_sent_at")
  welcomeGiftReceivedAt               DateTime?                                 @map("welcome_gift_received_at")
  shootCompletedGift                  String?                                   @map("shoot_completed_gift") @db.VarChar(30)
  shootCompletedGiftEmployeeId        Int?                                      @map("shoot_completed_gift_employee_id")
  shootCompletedGiftAssignee          String?                                   @map("shoot_completed_gift_assignee") @db.VarChar(191)
  shootCompletedGiftStatus            String?                                   @map("shoot_completed_gift_status") @db.VarChar(30)
  shootCompletedGiftSentAt            DateTime?                                 @map("shoot_completed_gift_sent_at")
  shootCompletedGiftReceivedAt        DateTime?                                 @map("shoot_completed_gift_received_at")
  projectValidityMonths               Int?                                      @map("project_validity_months")
  storageNeeded                       String?                                   @map("storage_needed") @db.VarChar(10)
  crdDocumentStatus                   String?                                   @map("crd_document_status") @db.VarChar(50)
  createdByUserId                     Int?                                      @map("created_by_user_id")
  deletedAt                           DateTime?                                 @map("deleted_at")
  createdAt                           DateTime                                  @default(now()) @map("created_at")
  updatedAt                           DateTime                                  @updatedAt @map("updated_at")
  shoots                              ProjectShoot[]
  productionDeliverables              ProjectShootDeliverable[]
  postProductionAllocations           ProjectPostProductionAllocation[]
  postProductionWorkflowAllocations   ProjectPostProductionWorkflowAllocation[]
  clientStorageRecords                ClientStorage[]
  cashEntries                         CashEntry[]
  paymentRequestExpenses              PaymentRequestExpense[]
  imageSelectionProjects              ImageSelectionProject[]
  imageSelectionWhatsAppNotifications ImageSelectionWhatsAppNotification[]
  attachments                         ProjectAttachment[]
  extraQuotations                     ProjectExtraQuotation[]

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  verticalRef Vertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([projectStatus])
  @@index([deletedAt])
  @@index([enquiryId])
  @@index([whatsappGroupNameId])
  @@index([crmEmployeeId])
  @@index([projectManagerEmployeeId])
  @@index([preProductionCoordinatorEmployeeId])
  @@index([creativeManagerEmployeeId])
  @@index([postProductionCoordinatorEmployeeId])
  /// Client Zone reads one gift's applicable projects at a time, narrowed by the status tab above
  /// the table, so each gift is indexed by the pair the screen actually asks for.
  @@index([welcomeGift, welcomeGiftStatus])
  @@index([shootCompletedGift, shootCompletedGiftStatus])
  @@index([createdByUserId])
  /// The quotation register asks "which projects converted at these versions?" on every read.
  @@index([branchId])
  @@index([verticalId])
  @@index([quotationId])
  @@map("sales_project")
}

/// The numbers the Quotation Generator prices with, held as one row.
///
/// A single row keyed "default", the same shape as ImageSelectionSettings: these are the studio's
/// settings, not a user's, so there is nothing to key them by. The rates were constants in the
/// generator, which meant a price change was a code change.
///
/// A quotation stamps the rates and the GST it was raised under into its own payload, so editing
/// these never rewrites what a client has already been sent.
/// A message the studio sends, written once in Settings and filled in per record.
///
/// The studio says the same things to clients over and over - a receipt for a payment, a reminder -
/// and each was being retyped, so the wording drifted and the figures were copied by hand. A
/// template is that message with its facts left as `{placeholders}`; the module that has the record
/// fills them in. See `services/messageTemplate.js` for what each one may hold.
///
/// `key` is the id: `CASH_RECEIVED` is the one the accounts screen renders after a receipt. A new
/// message is a new row with its own key and the module that knows how to fill it, never a column
/// added here.
///
/// The body is the studio's to edit, so nothing in the application depends on its wording - only on
/// which placeholders it may use, and an unknown one is left as it was typed rather than blanked.
model MessageTemplate {
  /// `CASH_RECEIVED`, and whatever else the studio comes to send.
  key             String   @id @db.VarChar(60)
  /// What it is called on the Settings rail.
  name            String   @db.VarChar(120)
  body            String   @db.Text
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("message_template")
}

model SalesQuotationSettings {
  id                     String   @id @default("default") @db.VarChar(30)
  serviceRate            Decimal  @default(2000) @map("service_rate") @db.Decimal(12, 2)
  deliverableRate        Decimal  @default(1000) @map("deliverable_rate") @db.Decimal(12, 2)
  defaultDiscountPercent Decimal  @default(20) @map("default_discount_percent") @db.Decimal(5, 2)
  gstPercent             Decimal  @default(18) @map("gst_percent") @db.Decimal(5, 2)
  servicePricing         Json?    @map("service_pricing")
  deliverablePricing     Json?    @map("deliverable_pricing")
  /// The words every brand's quotation shares - the Additional Notes and trademark cards, the
  /// Journey & Legacy and Our Infrastructure headings - as a JSON object of overrides over the
  /// defaults in `modules/sales/quotation-brands/defaults.js`. Settings -> Quotation Settings ->
  /// General. Null means nothing overridden.
  pdfContent             Json?    @map("pdf_content")
  /// The pictures and the timeline every brand's quotation shares: the India map, the collage per
  /// branch and the Journey & Legacy rows. Same JSON shape as a brand's `pdf_assets`, minus the
  /// pictures that are a brand's own (cover, Thank You).
  pdfAssets              Json?    @map("pdf_assets")
  /// Which of the four shared sections the client's copy prints - notes, trademark, journey,
  /// infrastructure - as a JSON object of booleans. Only a stored `false` hides one, so null
  /// prints all four. Snapshotted onto each version as it is raised.
  pdfSections            Json?    @map("pdf_sections")
  updatedByUserId        Int?     @map("updated_by_user_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("sales_quotation_settings")
}

/// One version of the quotation raised for an enquiry.
///
/// A quotation is never edited in place: every edit writes the next version of the same chain, so
/// what a client was sent stays exactly as it was sent. `quotationNumber` names the chain
/// ("QUT039"), `version` is the version within it, and `quotationId` is the two together
/// ("QUT039-01") — the reference a person quotes over the phone.
///
/// A chain is one quotation's own history, not the enquiry's. Raising a new quotation starts a
/// chain of its own whether or not that enquiry has been quoted before — only an edit adds to an
/// existing one — because a single enquiry is regularly quoted for Dum Dum, Qua Qua and Corp at
/// once, and none of those three is a revision of the other two.
///
/// Each version keeps its own public link and its own five-day clock. A new version does not kill
/// the older links — a client holding v1 can still open it until its own five days run out, which
/// is what lets two versions be compared — and an expired link can be re-enabled for five more.
model SalesQuotation {
  id                     String    @id @default(cuid())
  /// The chain this version belongs to, shared by every version of it: "DBS-QO-DD-ERD-000001".
  /// One per quotation rather than per enquiry, counted per vertical by `services/identifiers.js`
  /// like every other identifier the studio hands out - this is the document's number and
  /// `quotationId` below is the individual version's.
  quotationNumber        String    @map("quotation_number") @db.VarChar(30)
  /// Chain and version together: "DBS-QO-DD-ERD-000001-01". Unique, and the id shown everywhere.
  quotationId            String    @unique @map("quotation_id") @db.VarChar(30)
  /// What the studio calls it: `Quotation - Vertical - Branch - Client Name - Venue`.
  ///
  /// Stamped when the version is raised and never recomputed, for the same reason its figures are
  /// not: a quotation is never rewritten, so what a version was called when it was sent stays what
  /// it was called. Composing it on read would rename a document already in a client's inbox the
  /// moment a venue was renamed in master data. Built by `services/quotationName.js`; null only on
  /// rows raised before the column existed, which the backfill script names.
  quotationName          String?   @map("quotation_name") @db.VarChar(300)
  version                Int       @default(1)
  publicToken            String    @unique @map("public_token") @db.VarChar(16)
  enquiryId              String?   @map("enquiry_id") @db.VarChar(100)
  clientName             String?   @map("client_name") @db.VarChar(191)
  clientMainNumber       String?   @map("client_main_number") @db.VarChar(30)
  sourceBranch           String?   @map("source_branch") @db.VarChar(30)
  branchId               Int?      @map("branch_id")
  eventVenue             String?   @map("event_venue") @db.VarChar(500)
  followedBy             String?   @map("followed_by") @db.VarChar(191)
  ownerEmployeeId        Int?      @map("owner_employee_id")
  /// The login that created this quotation - one of the names the data scope reads.
  createdByUserId        Int?      @map("created_by_user_id")
  referredBy             String?   @map("referred_by") @db.VarChar(191)
  secondaryContactNumber String?   @map("secondary_contact_number") @db.VarChar(30)
  /// Whatever this quotation has to say beyond its services, deliverables and price — an
  /// inclusion agreed on a call, a caveat about a date. Client-facing: it prints on the
  /// client's copy above Terms & Conditions, so a blank one shows nothing rather than an
  /// empty heading. Held per version, not per chain, because a note answering one round of a
  /// negotiation belongs to the version that answered it and not to the two raised before it.
  additionalNotes        String?   @map("additional_notes") @db.Text
  quotationDate          DateTime  @default(now()) @map("quotation_date")
  validUntil             DateTime? @map("valid_until")
  /// When this version's public link stops opening. Five days from the moment it was generated or
  /// last re-enabled; null only for a row written before links had a clock.
  linkExpiresAt          DateTime? @map("link_expires_at")
  /// When somebody last re-enabled the link, so the register can say a lapsed link was reopened
  /// rather than silently showing a fresh five days.
  linkRenewedAt          DateTime? @map("link_renewed_at")
  subtotal               Decimal   @default(0) @db.Decimal(12, 2)
  discount               Decimal   @default(0) @db.Decimal(5, 2)
  amount                 Decimal   @default(0) @db.Decimal(12, 2)
  status                 String    @default("Generated") @db.VarChar(30)
  serviceCount           Int       @default(0) @map("service_count")
  deliverableCount       Int       @default(0) @map("deliverable_count")
  payload                Json
  /// The Global Logo this version was issued under, copied from Settings when the row was created
  /// and never updated: what the client was sent stays what they were sent, whatever the studio's
  /// logo becomes later. Null on versions raised before the column existed, which show the
  /// bundled default mark. See `src/services/documentBranding.js`.
  logoUrl                String?   @map("logo_url") @db.VarChar(500)
  /// Which of the studio's three brands this version was raised under - DUM_DUM, QUA_QUA or CORP.
  ///
  /// The brand is the vertical the generator was filled in for (`payload.vertical`), lifted into a
  /// column so the register can filter and badge on it without opening every payload. Written by
  /// `modules/sales/quotation-brands/service.js` as the version is raised; every row from before
  /// the column existed was backfilled from its payload, and reads DUM_DUM where the payload named
  /// nothing. The brand's services, terms, logo and PDF wording as they stood at that moment are
  /// frozen into `payload.brandSnapshot` - a later change to the brand's settings never reaches a
  /// version already sent.
  quotationBrand         String    @default("DUM_DUM") @map("quotation_brand") @db.VarChar(20)
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branch Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  owner  Employee? @relation("QuotationOwner", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)

  @@unique([quotationNumber, version])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([enquiryId])
  @@index([publicToken])
  @@index([branchId])
  @@index([ownerEmployeeId])
  @@index([createdByUserId])
  @@index([quotationNumber])
  @@index([quotationBrand])
  @@map("sales_quotation")
}

/// One of the three brands a quotation is raised under: Dum Dum, Qua Qua or Corp.
///
/// The brand decides what the Quotation Generator offers - which services and deliverables, which
/// packages, which terms, which event types, what the client's copy says at the top of the event
/// section and the foot of the page - while the generator, the register and the PDF stay one screen,
/// one table and one template. `code` is what `sales_quotation.quotation_brand` stores;
/// `verticalName` is the spelling the generator, the CRM and the identifier counter already use, so
/// the two vocabularies meet here rather than in every reader.
///
/// Everything nullable is an *override*: a brand with no logo prints the studio's Global Logo, one
/// with no terms prints the studio's standard terms, one with no GST rate uses the rate in
/// `sales_quotation_settings`. That is what keeps a fresh database quoting exactly as it did before
/// brands existed. Maintained from Settings -> Quotation Settings.
model SalesQuotationBrand {
  code                   String   @id @db.VarChar(20)
  name                   String   @db.VarChar(120)
  verticalName           String   @map("vertical_name") @db.VarChar(50)
  /// Unused. A quotation prints the Global Logo from Settings -> Organization (the bundled mark
  /// when none is set) and never a mark of the brand's own; the admin API no longer accepts this
  /// field. Kept because dropping a column is not a change a migration here makes.
  logoUrl                String?  @map("logo_url") @db.VarChar(500)
  /// Unused. Add Shoot offers the same shared list on every brand; a per-brand list was built and
  /// then withdrawn at the studio's request, and dropping a column is not a change a migration here
  /// makes. Always null.
  eventTypes             Json?    @map("event_types")
  /// The client-facing wording this brand changes - event section label and title, closing lines,
  /// contact details, footer - as a JSON object of overrides over the defaults in
  /// `modules/sales/quotation-brands/defaults.js`. Null means nothing overridden.
  pdfContent             Json?    @map("pdf_content")
  /// The pictures and the timeline the brand's quotation prints - the cover and Thank You
  /// photographs per group of shoots (`coverSets`), the India map, the infrastructure collage per
  /// branch and the Journey & Legacy entries - as one JSON object of stored URLs and rows.
  /// A quotation prints the set its main event falls in, and the first set answers for anything the
  /// sets do not name; a brand configured before sets existed reads back as one such first set.
  /// Uploaded from Settings -> Quotation Settings -> PDF Content; null means nothing uploaded yet.
  /// Only the pair a version resolved to is snapshotted onto it, never the whole configuration.
  pdfAssets              Json?    @map("pdf_assets")
  gstPercent             Decimal? @map("gst_percent") @db.Decimal(5, 2)
  defaultDiscountPercent Decimal? @map("default_discount_percent") @db.Decimal(5, 2)
  /// Whether the client reading this brand's quotation may save it as a PDF - Settings ->
  /// Quotation Settings -> <brand> -> PDF Content -> Allow Client Download. False, the default,
  /// hides the download control on the public page *and* refuses
  /// `GET /api/public/quotations/:token/pdf`, so a client who kept the address cannot save it
  /// either. Read live rather than from a version's snapshot: switching it off is meant to reach
  /// the links already sent. The studio's own download from Sales -> Quotations is a different,
  /// signed-in route and is not touched by this.
  allowClientDownload    Boolean  @default(false) @map("allow_client_download")
  isActive               Boolean  @default(true) @map("is_active")
  sortOrder              Int      @default(0) @map("sort_order")
  updatedByUserId        Int?     @map("updated_by_user_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  services     SalesQuotationBrandService[]
  shoots       SalesQuotationBrandShoot[]
  deliverables SalesQuotationBrandDeliverable[]
  packages     SalesQuotationBrandPackage[]
  terms        SalesQuotationBrandTerm[]

  @@index([isActive, sortOrder])
  @@map("sales_quotation_brand")
}

/// A service one brand quotes for, with the price it starts at.
///
/// Usually a pointer at a `ProjectServiceDefinition` - that is what carries the timing and size
/// columns the generator's service table draws, and what lets the quoted row become a project
/// allocation when the sale is booked. `serviceDefinitionId` is deliberately not a relation: the
/// definitions are retired rather than deleted, and a brand row naming a retired one is left
/// standing so the history reads. Null means a plain priced line the brand sells that the project
/// catalogue does not describe - it prints on the quotation and is skipped when a project is planned.
///
/// A brand with no rows here offers the whole project service catalogue, priced by
/// `sales_quotation_settings` - which is exactly what every brand offered before this table existed.
/// The shoots a brand quotes for, maintained in Settings → Field Settings → Quotation → Shoot Type.
///
/// It was the constant `BRAND_SHOOTS` in `quotation-brands/defaults.js` - fourteen for Dum Dum,
/// thirteen for Qua Qua, two for Corp - so a studio could not say that Dum Dum had started doing a
/// new kind of shoot without a code change. Each brand's list is its own: the studio names the
/// shoots it quotes for under each brand rather than picking from one shared vocabulary.
///
/// Read in three places, which is the point of storing it once: the Quotation Generator's Add Shoot
/// offers the brand's own shoots, the picture sets in Quotation Settings are chosen from them, and
/// this screen edits them.
model SalesQuotationBrandShoot {
  id        String   @id @default(cuid())
  brandCode String   @map("brand_code") @db.VarChar(20)
  name      String   @db.VarChar(191)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand SalesQuotationBrand @relation(fields: [brandCode], references: [code], onDelete: Cascade)

  /// One name per brand: the same shoot listed twice under one brand is the picture sets being
  /// unable to say which set it belongs to.
  @@unique([brandCode, name], map: "sqb_shoot_brand_name_key")
  @@index([brandCode, isActive, sortOrder], map: "sqb_shoot_brand_active_sort_idx")
  @@map("sales_quotation_brand_shoot")
}

model SalesQuotationBrandService {
  id                  String   @id @default(cuid())
  brandCode           String   @map("brand_code") @db.VarChar(20)
  serviceDefinitionId String?  @map("service_definition_id") @db.VarChar(191)
  name                String   @db.VarChar(191)
  defaultPrice        Decimal? @map("default_price") @db.Decimal(12, 2)
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  brand SalesQuotationBrand @relation(fields: [brandCode], references: [code], onDelete: Cascade)

  @@index([brandCode, isActive, sortOrder], map: "sqb_service_brand_active_sort_idx")
  @@index([serviceDefinitionId], map: "sqb_service_definition_idx")
  @@map("sales_quotation_brand_service")
}

/// A deliverable one brand quotes for. The same shape and the same rules as a brand service, over
/// `ProjectDeliverableDefinition`.
model SalesQuotationBrandDeliverable {
  id                      String   @id @default(cuid())
  brandCode               String   @map("brand_code") @db.VarChar(20)
  deliverableDefinitionId String?  @map("deliverable_definition_id") @db.VarChar(191)
  name                    String   @db.VarChar(191)
  defaultPrice            Decimal? @map("default_price") @db.Decimal(12, 2)
  isActive                Boolean  @default(true) @map("is_active")
  sortOrder               Int      @default(0) @map("sort_order")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  brand SalesQuotationBrand @relation(fields: [brandCode], references: [code], onDelete: Cascade)

  @@index([brandCode, isActive, sortOrder], map: "sqb_deliverable_brand_active_sort_idx")
  @@index([deliverableDefinitionId], map: "sqb_deliverable_definition_idx")
  @@map("sales_quotation_brand_deliverable")
}

/// A named bundle of one brand's services and deliverables, applied to a shoot in one move.
///
/// Applying a package adds its items to the shoot's rows exactly as picking them one by one would -
/// the quotation then holds rows, not a package reference, so the snapshot rule holds without any
/// special case: what was applied is what the rows say, whatever the package becomes later.
model SalesQuotationBrandPackage {
  id          String   @id @default(cuid())
  brandCode   String   @map("brand_code") @db.VarChar(20)
  name        String   @db.VarChar(191)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  brand SalesQuotationBrand              @relation(fields: [brandCode], references: [code], onDelete: Cascade)
  items SalesQuotationBrandPackageItem[]

  @@index([brandCode, isActive, sortOrder], map: "sqb_package_brand_active_sort_idx")
  @@map("sales_quotation_brand_package")
}

/// One line of a package: a brand service or a brand deliverable, how many, and the price the
/// package sells it at when that differs from the master's own default.
model SalesQuotationBrandPackageItem {
  id           String   @id @default(cuid())
  packageId    String   @map("package_id") @db.VarChar(191)
  /// `SERVICE` or `DELIVERABLE`, saying which master table `masterId` names.
  itemType     String   @map("item_type") @db.VarChar(20)
  masterId     String   @map("master_id") @db.VarChar(191)
  quantity     Int      @default(1)
  defaultPrice Decimal? @map("default_price") @db.Decimal(12, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  package SalesQuotationBrandPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder], map: "sqb_package_item_package_sort_idx")
  @@index([masterId], map: "sqb_package_item_master_idx")
  @@map("sales_quotation_brand_package_item")
}

/// One clause of a brand's Terms & Conditions. A brand with none prints the studio's standard
/// three clauses; either way the clauses printed are frozen into the version's snapshot.
model SalesQuotationBrandTerm {
  id        String   @id @default(cuid())
  brandCode String   @map("brand_code") @db.VarChar(20)
  title     String   @db.VarChar(191)
  body      String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand SalesQuotationBrand @relation(fields: [brandCode], references: [code], onDelete: Cascade)

  @@index([brandCode, isActive, sortOrder], map: "sqb_term_brand_active_sort_idx")
  @@map("sales_quotation_brand_term")
}

/// The public CRD document link for one Sales Manager project, and whatever the client sent back
/// through it.
///
/// `projectId` names the SalesProject but is deliberately not a Prisma relation, so adding this
/// table changes nothing about SalesProject itself - the same way SalesCrmMeeting and
/// SalesCrmLeadWatch point at a lead. The project is read when the link is opened and is never
/// written to: a client's answers live here, in `submission`, so nothing the client types can
/// overwrite what Sales Manager holds.
///
/// One row per project, which is what makes Send Link idempotent - pressing it again hands back the
/// link that was already issued rather than minting a second one the client has not been given.
model SalesProjectCrdDocument {
  id              String    @id @default(cuid())
  /// DBS-CRD-DD-000001 - the identifier the studio reads this document by, counted per vertical.
  /// Nullable only for the rows that predate it having one; every document issued since carries it.
  /// No branch: a CRD is asked of a wedding or a child's shoot and belongs to the vertical, not to
  /// the office that sold it. Minted by `services/identifiers.js`.
  documentCode    String?   @unique @map("document_code") @db.VarChar(40)
  /// Null on a standalone document — one raised from Create CRD Document before any project
  /// exists. MySQL allows any number of nulls under a unique index, so one document per project
  /// still holds for the project-backed rows.
  projectId       String?   @unique @map("project_id") @db.VarChar(191)
  publicToken     String    @unique @map("public_token") @db.VarChar(16)
  /// The read-only link to the submitted answers, issued separately from `publicToken` and only on
  /// request. `publicToken` is a credential to *fill* the document, so it cannot be the thing that
  /// gets forwarded around once the client has submitted; this one opens nothing but the response.
  shareToken      String?   @unique @map("share_token") @db.VarChar(16)
  status          String    @default("Sent") @db.VarChar(30)
  /// Which form the public link renders: WED (Dum Dum) or QQ (Qua Qua). Null on a document that
  /// hangs off a project, which answers with the project's own vertical instead.
  vertical        String?   @db.VarChar(10)
  verticalId      Int?      @map("vertical_id")
  /// What a standalone document was created with. A project-backed document leaves these null and
  /// reads the same facts off the project and its lead.
  enquiryId       String?   @map("enquiry_id") @db.VarChar(100)
  clientName      String?   @map("client_name") @db.VarChar(191)
  groomName       String?   @map("groom_name") @db.VarChar(150)
  brideName       String?   @map("bride_name") @db.VarChar(150)
  contactNumber   String?   @map("contact_number") @db.VarChar(30)
  /// The Client Details block exactly as the client submitted it. Null until they submit.
  submission      Json?
  submittedAt     DateTime? @map("submitted_at")
  createdByUserId Int?      @map("created_by_user_id")
  /// The Global Logo the link was issued under, copied from Settings when the row was created and
  /// never updated, so the document the client opens keeps the mark it was sent with. Null on links
  /// issued before the column existed, which show the bundled default mark. See
  /// `src/services/documentBranding.js`.
  logoUrl         String?   @map("logo_url") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  verticalRef Vertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([publicToken])
  @@index([verticalId])
  @@index([enquiryId])
  @@map("sales_project_crd_document")
}

/// The terms & conditions text shown on each vertical's public CRD document, editable from the CRD
/// Documents screen instead of being hardcoded. One row, keyed "default", the same idiom as
/// `app_monitoring_settings`, `image_selection_settings` and `sales_quotation_settings` — this is the
/// studio's own wording, not a user's setting, so there is nothing else to key it by. A blank column
/// means nothing has been saved yet; the read path falls back to the wording that shipped with the
/// feature rather than showing an empty box.
model SalesCrdTermsSettings {
  id              String   @id @default("default") @db.VarChar(30)
  dumDumTerms     String?  @map("dum_dum_terms") @db.Text
  quaQuaTerms     String?  @map("qua_qua_terms") @db.Text
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sales_crd_terms_settings")
}

model SalesCrmLead {
  enquiryId             String    @id @map("enquiry_id") @db.VarChar(100)
  name                  String?   @db.Text
  phone                 String?   @db.Text
  /// The number the client is messaged on, which is not always the one they enquired from.
  whatsappNumber        String?   @map("whatsapp_number") @db.Text
  /// The vertical's name as text - "Dum Dum", "Qua Qua", "Corp". It was called `branch` until
  /// September 2026 and never held one; the lead's branch is `assignedBranch`. `verticalId` beside
  /// it is the reference, and this column goes once every read has moved to it.
  verticalName          String?   @map("vertical") @db.Text
  verticalId            Int?      @map("vertical_id")
  status                String?   @db.Text
  crm                   String?   @db.Text
  ownerEmployeeId       Int?      @map("owner_employee_id")
  /// The login that created this record. A plain user id, like every other creator column here:
  /// who did it stays true once that login is gone. One of the names the data scope reads.
  createdByUserId       Int?      @map("created_by_user_id")
  addedTime             String?   @map("added_time") @db.Text
  createdDate           String?   @map("created_date") @db.Text
  relationship          String?   @db.Text
  referredFrom          String?   @map("referred_from") @db.Text
  offerType             String?   @map("offer_type") @db.Text
  campaignName          String?   @map("campaign_name") @db.Text
  adsetName             String?   @map("adset_name") @db.Text
  adName                String?   @map("ad_name") @db.Text
  preferredBudget       String?   @map("preferred_budget") @db.Text
  estimatedValue        String?   @map("estimated_value") @db.Text
  city                  String?   @db.Text
  state                 String?   @db.Text
  source                String?   @db.Text
  assignedBranch        String?   @map("assigned_branch") @db.Text
  branchId              Int?      @map("branch_id")
  eventPlannedType      String?   @map("event_planned_type") @db.Text
  eventPlannedDate      String?   @map("event_planned_date") @db.Text
  groomName             String?   @map("groom_name") @db.Text
  groomContact          String?   @map("groom_contact") @db.Text
  groomLocation         String?   @map("groom_location") @db.Text
  brideName             String?   @map("bride_name") @db.Text
  brideContact          String?   @map("bride_contact") @db.Text
  brideLocation         String?   @map("bride_location") @db.Text
  referenceName         String?   @map("reference_name") @db.Text
  referenceContact      String?   @map("reference_contact") @db.Text
  remarks               String?   @db.Text
  contactRepeated       String?   @map("contact_repeated") @db.Text
  shootType             String?   @map("shoot_type") @db.Text
  location              String?   @db.Text
  ihOh                  String?   @map("ih_oh") @db.Text
  lastFollowUpDate      String?   @map("last_follow_up_date") @db.Text
  nextFollowUpDate      String?   @map("next_follow_up_date") @db.Text
  lastConvertedDate     String?   @map("last_converted_date") @db.Text
  // Unanswered call attempts against this lead. Text like every other column on this table;
  // read back as a number. Six are allowed, and the seventh rejects the lead.
  cnaSequence           String?   @map("cna_sequence") @db.Text
  shootId               String?   @map("shoot_id") @db.Text
  date                  String?   @db.Text
  babyOrMotherName      String?   @map("baby_or_mother_name") @db.Text
  dateOfBirthOrEdod     String?   @map("date_of_birth_or_edod") @db.Text
  companyName           String?   @map("company_name") @db.Text
  primaryDecisionMaker  String?   @map("primary_decision_maker") @db.Text
  designation           String?   @db.Text
  contactNumber         String?   @map("contact_number") @db.Text
  alternateMobileNumber String?   @map("alternate_mobile_number") @db.Text
  officialEmailId       String?   @map("official_email_id") @db.Text
  companyWebsite        String?   @map("company_website") @db.Text
  companyType           String?   @map("company_type") @db.Text
  companySize           String?   @map("company_size") @db.Text
  branches              String?   @db.Text
  projectType           String?   @map("project_type") @db.Text
  shootCity             String?   @map("shoot_city") @db.Text
  expectedBudget        String?   @map("expected_budget") @db.Text
  /// What the CRM's Quotation Calculator last quoted this lead, applied from the calculator: the
  /// total, and the quantities, base package, extras and discount it was built from, so the
  /// calculator reopens where it was left. Converting the lead prefills Create Project's Signed
  /// Quotation with the total, ahead of the budget the lead was entered with.
  quotedAmount          Decimal?  @map("quoted_amount") @db.Decimal(12, 2)
  quotedDraft           Json?     @map("quoted_draft")
  competitions          String?   @db.Text
  sourceEnquiryId       String?   @map("source_enquiry_id") @db.Text
  sourceRowNumber       String?   @map("source_row_number") @db.Text
  spreadsheetId         String?   @map("spreadsheet_id") @db.Text
  gid                   String?   @db.Text
  targetTab             String?   @map("target_tab") @db.Text
  systemTableId         String?   @map("system_table_id") @db.Text
  lastSourceSyncAt      String?   @map("last_source_sync_at") @db.Text
  nextFollowUpTime      String?   @map("next_follow_up_time") @db.Text
  // JSON arrays: Event Details rows, remark history and attachment metadata.
  shoots                String?   @db.LongText
  remarkEntries         String?   @map("remark_entries") @db.LongText
  attachments           String?   @db.LongText
  // JSON object keyed by SalesCrmDynamicColumn.key, holding this lead's answers to the
  // fields built in Table Settings. Kept as one column rather than a column per field so
  // adding a field stays a data change instead of an ALTER TABLE on a 14k-row table.
  customFields          String?   @map("custom_fields") @db.LongText
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  /// ── The keys the board is read by ───────────────────────────────────────────────────────────
  ///
  /// Six columns MySQL fills in itself, declared here so Prisma knows the table has them.
  ///
  /// Everything above is `@db.Text`, written by four different producers - the app, CSV import,
  /// Google Sheets and the Callyzer webhook - so the board's queries had to normalise as they
  /// read: `LOWER(REPLACE(TRIM(branch)))` to decide the vertical, `STR_TO_DATE(...)` to compare a
  /// follow-up date. A function wrapped around a column is one MySQL must evaluate for every row
  /// before it can decide anything, so no index could help and every board query read the whole
  /// table. At 500,000 leads the first page took 4.1 seconds and the tab counts 6.3, and the board
  /// ran both on every request.
  ///
  /// These are the same normalisations done once, on write, by STORED generated columns. They are
  /// derived - nothing writes them, and nothing may: the migration declares them
  /// `GENERATED ALWAYS AS (...) STORED`, so MySQL refuses an INSERT or UPDATE that names one. They
  /// cannot drift from the text they are computed from, which is the whole reason for preferring
  /// them to columns the application would have had to remember to maintain on six write paths.
  ///
  /// `boardKey` is NULL for a soft-deleted lead, which is deliberate and load-bearing: a deleted
  /// lead is on no board, so naming a board excludes it and the queries no longer say
  /// `deleted_at IS NULL` at all. While they did, MySQL kept choosing the `deleted_at` index -
  /// one entry per lead in a table where all but a handful are live - and counting one board took
  /// 3.5s instead of 62ms. No hint or ANALYZE would talk it out of it; removing the choice did.
  ///
  /// The definitions live in the migration and are mirrored by `BRANCH_SQL_SOURCE` and the view
  /// clauses in `leadQueryService.js`, which `crm-lead-board-key.test.js` holds together.
  boardKey    String?   @map("board_key") @db.VarChar(10)
  statusKey   String?   @map("status_key") @db.VarChar(60)
  createdDay  DateTime? @map("created_day") @db.Date
  followUpDay DateTime? @map("follow_up_day") @db.Date
  dobEdodDay  DateTime? @map("dob_edod_day") @db.Date
  /// The last ten digits of each number the lead carries - the same `phoneMatchKey` rule the
  /// duplicate check, the Callyzer webhook and the contact directory all compare on. Indexed, so
  /// "is this number already a lead?" is a lookup rather than a scan of every row.
  phoneKey    String?   @map("phone_key") @db.VarChar(10)
  contactKey  String?   @map("contact_key") @db.VarChar(10)

  vertical Vertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  owner    Employee? @relation("CrmLeadOwner", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)

  @@index([verticalId])
  @@index([branchId])
  @@index([ownerEmployeeId])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@index([createdAt])
  /// One wide covering index rather than several narrow ones, and that is a measurement rather
  /// than a preference. With separate `(board_key, follow_up_day)` and `(board_key, created_day)`
  /// indexes present, MySQL chose the narrowest for `ORDER BY enquiry_id` and then filesorted
  /// 226,000 rows - a page reached by scrolling took 4.0s. With only this one it reports
  /// `Backward index scan; Using index` and the same page takes 95ms.
  ///
  /// The column order is what makes it serve both shapes: `(board_key, enquiry_id)` is the board's
  /// default sort, so a page is an ordered range with no sort step; and every column the twelve tab
  /// counts read is in here too, so counting a board never touches a row.
  @@index([boardKey, enquiryId, statusKey, createdDay, followUpDay, dobEdodDay], map: "sales_crm_lead_board_main_idx")
  @@index([phoneKey], map: "sales_crm_lead_phone_key_idx")
  @@index([contactKey], map: "sales_crm_lead_contact_key_idx")
  /// For the version poll alone - every open tab asks "has anything changed?" every four seconds,
  /// and that read was a full scan of the table. Covering, so it never touches a row.
  @@index([deletedAt, updatedAt], map: "sales_crm_lead_version_idx")
  @@map("sales_crm_lead")
}

// One custom field on one vertical's CRM form, built in Table Settings. `sortOrder` is the
// order the builder left them in, and is what Add Lead and the table render by.
model SalesCrmDynamicColumn {
  id          Int      @id @default(autoincrement())
  vertical    String   @db.VarChar(30)
  key         String   @db.VarChar(120)
  label       String   @db.VarChar(191)
  fieldType   String   @default("text") @map("field_type") @db.VarChar(30)
  placeholder String?  @db.VarChar(191)
  required    Boolean  @default(false)
  // JSON array of choices, for the dropdown, checkbox-group and radio-group types only.
  options     String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([vertical, key])
  @@index([vertical, sortOrder])
  @@map("sales_crm_dynamic_column")
}

/// One occasion of one Qua Qua lead, and how that call is going.
///
/// Qua Qua shoots children, and the same client is worth calling more than once. Two occasions say
/// so: a **newborn** window around the estimated delivery date, and a **birthday** window before the
/// child's next birthday. Both are read off "Date of Birth (or) EDOD", both put the lead back into
/// Yet to connect when they open, and both are a fresh enquiry rather than a continuation of
/// whatever was sold before.
///
/// Writing that call's status onto the lead's own `status` would do two wrong things at once: it
/// would overwrite what the previous shoot ended as, and the lead would never come back to Yet to
/// connect next year, because this year's status would still be sitting there. So an occasion is
/// stored as its own occurrence, keyed by the lead, which occasion it is, and the year it falls in.
///
/// A lead inside a window reads and writes its occurrence instead of its own status columns;
/// outside them nothing here is consulted and the lead's own status stands throughout. A year with
/// no row is an occasion nobody has connected about - exactly what Yet to connect lists - so an
/// occasion that has been ignored needs no row to say so.
///
/// The windows and the years are decided by `occasionLeadService.js`, which is the one place that
/// knows the rule; the board's SQL and the write path both go through it.
model SalesCrmLeadOccasion {
  id               Int       @id @default(autoincrement())
  enquiryId        String    @map("enquiry_id") @db.VarChar(100)
  /// "NEWBORN" or "BIRTHDAY" - which of the two calls this row is about.
  occasion         String    @db.VarChar(20)
  /// The calendar year the occasion falls in: the delivery's year for a newborn, the birthday's own
  /// year for a birthday. Not the year of birth.
  occasionYear     Int       @map("occasion_year")
  status           String?   @db.VarChar(191)
  /// The trimmed, lowercased status, exactly as `sales_crm_lead.status_key` holds it - so the
  /// board's tab clauses can compare an occurrence and a lead the same way. Written by the
  /// application rather than generated, because unlike the lead's copy nothing else writes here.
  statusKey        String?   @map("status_key") @db.VarChar(60)
  /// Unanswered attempts against this occasion, counted from zero each time one comes round.
  cnaSequence      Int       @default(0) @map("cna_sequence")
  nextFollowUpDate String?   @map("next_follow_up_date") @db.VarChar(40)
  nextFollowUpTime String?   @map("next_follow_up_time") @db.VarChar(20)
  /// `nextFollowUpDate` as a real date, so the follow-up tabs compare it the way they compare the
  /// lead's own `follow_up_day`. A date that cannot be parsed is left NULL and never matches.
  followUpDay      DateTime? @map("follow_up_day") @db.Date
  updatedByUserId  Int?      @map("updated_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  /// One occurrence per lead per occasion per year - the key every read and write addresses one by.
  @@unique([enquiryId, occasion, occasionYear], map: "sales_crm_lead_occasion_lead_key")
  @@map("sales_crm_lead_occasion")
}

// A meeting scheduled against a CRM lead, mirrored from the Google Calendar event that
// carries its Meet link. The row is the CRM's own record: the event lives in the organiser's
// calendar, but the lead's meeting history must survive that event being deleted there, and
// must be readable without a Google round trip every time the panel opens.
/// A CRM lead put on the Watchers list.
///
/// The row keeps its own copy of the lead as it read when it was added, rather than pointing
/// at the live lead. Watchers is a place to keep an eye on a handful of enquiries without
/// touching them, so what it shows must not drift as the lead is worked on elsewhere - and it
/// is never edited from there.
model SalesCrmLeadWatch {
  id            String   @id @default(cuid())
  enquiryId     String   @unique @map("enquiry_id") @db.VarChar(100)
  vertical      String?  @db.VarChar(60)
  leadName      String?  @map("lead_name") @db.VarChar(191)
  phone         String?  @db.VarChar(60)
  leadStatus    String?  @map("lead_status") @db.VarChar(60)
  /// The whole lead as JSON, exactly as it stood when it was added.
  snapshot      String   @db.LongText
  addedByUserId Int?     @map("added_by_user_id")
  addedByName   String?  @map("added_by_name") @db.VarChar(191)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([vertical])
  @@map("sales_crm_lead_watch")
}

model SalesCrmMeeting {
  id               String   @id @default(cuid())
  enquiryId        String   @map("enquiry_id") @db.VarChar(100)
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  startAt          DateTime @map("start_at")
  endAt            DateTime @map("end_at")
  // JSON array of invited email addresses.
  attendees        String?  @db.Text
  // The Google account hosting the Meet, which is not the same identity as createdByUserId.
  organizerEmail   String?  @map("organizer_email") @db.VarChar(191)
  googleEventId    String?  @map("google_event_id") @db.VarChar(191)
  googleCalendarId String?  @map("google_calendar_id") @db.VarChar(191)
  meetLink         String?  @map("meet_link") @db.VarChar(500)
  htmlLink         String?  @map("html_link") @db.VarChar(500)
  status           String   @default("SCHEDULED") @db.VarChar(30)
  createdByUserId  Int?     @map("created_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([enquiryId, startAt])
  @@index([googleEventId])
  @@index([status])
  @@map("sales_crm_meeting")
}

model SalesGoogleSheetLink {
  id                        String    @id @default(cuid())
  googleAccountConnectionId String?   @map("google_account_connection_id") @db.VarChar(191)
  systemTableName           String    @map("system_table_name") @db.VarChar(191)
  systemTableId             String    @default("") @map("system_table_id") @db.VarChar(191)
  vertical                  String    @default("") @db.VarChar(191)
  sheetUrl                  String    @map("sheet_url") @db.VarChar(1000)
  spreadsheetId             String?   @map("spreadsheet_id") @db.VarChar(191)
  spreadsheetName           String?   @map("spreadsheet_name") @db.VarChar(255)
  targetedTab               String    @map("targeted_tab") @db.VarChar(191)
  status                    String    @default("ACTIVE") @db.VarChar(30)
  // Stamped after every sync of this link, so the Preview Import panel can say when the
  // sheet was last read without keeping a row per run - the poller syncs every 30 seconds.
  lastSyncedAt              DateTime? @map("last_synced_at")
  lastSyncStatus            String?   @map("last_sync_status") @db.VarChar(30)
  lastSyncSummary           String?   @map("last_sync_summary") @db.Text
  createdByUserId           Int?      @map("created_by_user_id")
  deletedAt                 DateTime? @map("deleted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@index([googleAccountConnectionId])
  @@index([systemTableName])
  @@index([systemTableId])
  @@index([vertical])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("sales_google_sheet_link")
}

/// Who a sheet row's lead belongs to, as a rule the studio writes once per linked sheet.
///
/// A spreadsheet says who a lead is; it almost never says whose lead it is. The studio's answer has
/// always been a person reading a column - "anything from the Coimbatore page is Divya's" - and
/// assigning by hand, which nobody can keep up with on a sheet the poller re-reads every two
/// minutes. One row here is that reading written down: a column, a value to look for, and the
/// employee whose lead it is when the two meet.
///
/// Matched against the sheet's **own header text**, not against the CRM field the importer maps it
/// to. The columns a studio routes by - Page Name, Form Name, Team, Ad Account - are exactly the
/// ones `CRM_FIELD_ALIASES` has no name for, so they arrive in `unmappedHeaders` and a rule written
/// against a mapped field could never see them.
///
/// A rule is one column matching one value, and nothing else. `priority` is the order they are
/// asked in, and the first match wins - two rules matching one row is not an error to report, it is
/// a question the studio answers by ordering them, which is why the order is stored.
///
/// `targetEmployeeName` sits beside `targetEmployeeId` deliberately. The id is the rule's real
/// subject, and what makes "which rules point at the person who just left?" answerable at all. The
/// name is what goes into the lead's `crm` column, which holds an employee's name - the board's own
/// picker is built from names. Reads refresh the name from the roster, so renaming an employee
/// follows through; the stored copy is the fallback for an employee row that is gone.
///
/// No foreign keys, matching `SalesGoogleSheetLink` and `SalesGoogleSheetRow` beside it: these
/// tables are written through raw SQL and index their references rather than constraining them.
model SalesGoogleSheetAssignmentRule {
  id           String   @id @default(cuid())
  linkId       String   @map("link_id") @db.VarChar(191)
  /// Ascending. The first rule that matches a row assigns it, and evaluation stops.
  priority     Int      @default(0)
  /// The spreadsheet column's heading, as the sheet spells it. Compared case- and
  /// punctuation-insensitively, the way every other header in this module is.
  columnHeader String   @default("") @map("column_header") @db.VarChar(255)
  /// The value that column must hold. Compared the same forgiving way as the heading above, and
  /// exactly - there are no operators: two values going to one person is two rules.
  matchValue   String   @default("") @map("match_value") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([linkId])
  @@map("sales_google_sheet_assignment_rule")
}

/// One person on an assignment rule, and the share of its leads they take.
///
/// A rule named a single employee, so a column value two people work between them could not be
/// written down: the studio picked one and moved leads by hand afterwards, which is the job these
/// rules exist to end. `percent` is exactly what the studio typed - nothing computes or adjusts it,
/// on leave or otherwise - and the shares on one rule add to 100.
///
/// `assignedCount` is how the percentage is actually honoured. A lead cannot be split 60/40; only a
/// run of leads can, so the allocator has to remember what it has handed out: each new lead goes to
/// whoever is furthest below their share (`assignedCount / percent` smallest), which converges on
/// the configured proportions rather than drifting.
///
/// Stored rather than held in memory, because the poller re-reads every two minutes - a counter
/// that restarted each pass would give a sheet gaining three rows at a time all three to the first
/// person, forever. And stored rather than counted off the leads, because a manager reassigning a
/// lead by hand is expected here: counting owners would make the split chase those edits instead of
/// following what was configured.
model SalesGoogleSheetAssignmentRuleTarget {
  id            String   @id @default(cuid())
  ruleId        String   @map("rule_id") @db.VarChar(191)
  /// The order the people are listed in, and the tie-break when two are equally far below share.
  position      Int      @default(0)
  employeeId    Int?     @map("employee_id")
  /// The name written into the lead's `crm` column, refreshed from the roster on every read; the
  /// stored copy is the fallback for an employee row that is gone. Same rule the rule itself used.
  employeeName  String   @default("") @map("employee_name") @db.VarChar(150)
  percent       Int      @default(100)
  /// Leads this target has been given by this rule. Never decremented when a lead is deleted - it
  /// is a fairness counter rather than an audit, and re-balancing on deletions would hand the next
  /// several leads to one person to make up a gap nobody asked to be filled.
  assignedCount Int      @default(0) @map("assigned_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// One person appears once on a rule: two rows for the same person are one total typed twice.
  @@unique([ruleId, employeeId], map: "sales_google_sheet_rule_target_rule_employee")
  @@index([ruleId])
  /// Answers "which splits name this employee" when somebody is offboarded.
  @@index([employeeId])
  @@map("sales_google_sheet_assignment_rule_target")
}

/// A sheet row this application has already imported, remembered apart from the lead it made.
///
/// The sync decides what to do with a row by looking for its lead: found, the row is an edit;
/// not found, the row is new and is imported. That reading has no way to tell "never seen" from
/// "seen, and the studio deleted it" - so a deleted lead came back on the next pass, two minutes
/// later, and deleting a synced lead was simply not something a person could do.
///
/// This is the missing half of the answer. One row per sheet row ever imported, kept whether or not
/// its lead still exists, so the three cases separate cleanly:
///
///   lead exists            -> an edit; update it, exactly as before
///   no lead, row known     -> the studio deleted it; leave it deleted
///   no lead, row unknown   -> genuinely new; import it
///
/// `rowKey` is the row's own identity as the importer already computes it: the sheet's Enquiry ID
/// column where it has one, and `<spreadsheet>:<tab>:row:<n>` where it does not. Reused rather than
/// invented, so the ledger and the lead's `source_enquiry_id` cannot disagree about what a row is.
///
/// Deleting the link deletes its ledger with it, which is what makes re-linking a sheet import it
/// afresh - the studio's own way of saying "start over".
model SalesGoogleSheetRow {
  id          String   @id @default(cuid())
  linkId      String   @map("link_id") @db.VarChar(191)
  /// The row's identity within its link. Long enough for a sheet id, a tab name and a row number.
  rowKey      String   @map("row_key") @db.VarChar(255)
  /// The lead this row created, as it was at the time. Left behind when that lead is deleted - it
  /// is a note of what happened, not a reference, and nothing reads it to find a live lead.
  enquiryId   String?  @map("enquiry_id") @db.VarChar(100)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  /// One entry per row per link, and the key every read looks it up by.
  @@unique([linkId, rowKey], map: "sales_google_sheet_row_link_key")
  @@index([enquiryId])
  @@map("sales_google_sheet_row")
}

model SalesGoogleAccountConnection {
  id                    String    @id @default(cuid())
  userId                Int       @unique @map("user_id")
  googleAccountId       String    @map("google_account_id") @db.VarChar(191)
  googleEmail           String    @map("google_email") @db.VarChar(191)
  googleDisplayName     String?   @map("google_display_name") @db.VarChar(191)
  accessTokenEncrypted  String?   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?   @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime? @map("token_expires_at")
  scopes                String    @db.Text
  status                String    @default("CONNECTED") @db.VarChar(30)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([googleAccountId])
  @@index([googleEmail])
  @@index([status])
  @@map("sales_google_account_connection")
}

model SalesGoogleOAuthState {
  id         String    @id @default(cuid())
  stateHash  String    @unique @map("state_hash") @db.Char(64)
  userId     Int       @map("user_id")
  purpose    String    @default("connect") @db.VarChar(30)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, expiresAt])
  @@map("sales_google_oauth_state")
}

model ProjectAttachment {
  id               String       @id @default(cuid())
  projectId        String       @map("project_id")
  originalName     String       @map("original_name") @db.VarChar(255)
  storedName       String       @map("stored_name") @db.VarChar(255)
  mimeType         String?      @map("mime_type") @db.VarChar(191)
  size             Int
  filePath         String       @map("file_path") @db.VarChar(500)
  uploadedByUserId Int?         @map("uploaded_by_user_id")
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  project          SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
  @@index([createdAt])
  @@map("project_attachment")
}

model ImageSelectionProject {
  id                       String                               @id @default(cuid())
  /// DBS-VCIS-000001 - one run of numbers for the studio. A gallery belongs to the client, and the
  /// sales project behind it already says which branch and vertical it came from, so this carries
  /// neither. Nullable only for the rows that predate it. Minted by `services/identifiers.js`.
  projectCode              String?                              @unique @map("project_code") @db.VarChar(40)
  projectName              String                               @map("project_name") @db.VarChar(500)
  sourceType               String                               @default("Manual") @map("source_type") @db.VarChar(20)
  // Which section of the module owns this project: false = the Projects page, true = Album
  // Proofing. The two sidebars share one table and one API but list disjoint sets, so the
  // Album Proofing page starts empty rather than mirroring every Image Selection project.
  albumProofing            Boolean                              @default(false) @map("album_proofing")
  // Unique per section, not per table: the same Sales Manager project can back one Projects-page
  // project AND one Album Proofing project, which live in disjoint sidebars.
  salesProjectId           String?                              @map("sales_project_id")
  // Client details for a project with no linked Sales Manager project. A "Manual" or
  // "Duplicate" project has no SalesProject to read the client from, so the studio enters
  // the name and WhatsApp number here instead. Both stay null on a "Sales" project, which
  // always reads the linked SalesProject so the two can never disagree.
  clientName               String?                              @map("client_name") @db.VarChar(191)
  clientMainNumber         String?                              @map("client_main_number") @db.VarChar(30)
  status                   String                               @default("New") @db.VarChar(30)
  // Which workspace tabs a manually named project was created with, chosen on the Create New
  // Project form. A linked project earns its tabs from the Post Production Allocation and the
  // Deliverables table instead, so all three stay null there. Null on an older manual project
  // means the default it always had: Photo Selection on, the other two off.
  photoSelectionTab        Boolean?                             @map("photo_selection_tab")
  photoCullingTab          Boolean?                             @map("photo_culling_tab")
  signatureAlbumTab        Boolean?                             @map("signature_album_tab")
  selectionValidUntil      DateTime?                            @map("selection_valid_until")
  selectionValidityEnabled Boolean                              @default(true) @map("selection_validity_enabled")
  allowPhotoSelection      Boolean                              @default(true) @map("allow_photo_selection")
  publicSlug               String?                              @unique @map("public_slug") @db.VarChar(191)
  archivedAt               DateTime?                            @map("archived_at")
  lastOpenedAt             DateTime?                            @map("last_opened_at")
  // When the studio last took the client's selected originals out - the server copying them to
  // the Selected Output Path, or the browser's Download Selected finishing. Read by the dashboard
  // against the latest submission; null on every project from before it existed.
  selectedDownloadedAt     DateTime?                            @map("selected_downloaded_at")
  totalPhotoSize           BigInt                               @default(0) @map("total_photo_size")
  publishVersion           Int                                  @default(1) @map("publish_version")
  // The WhatsApp group the gallery invite is sent into: the group the studio already runs with
  // this client, picked in the Selection Settings rail from the groups the coordinator's own
  // paired WhatsApp is in - by default the one named like the project. The subject is what the
  // group was called when it was linked, kept so the rail can say which group without asking
  // WhatsApp. One live project per group, held by the service rather than a unique index, so an
  // archived or deleted project does not keep a group from its successor.
  whatsappGroupJid         String?                              @map("whatsapp_group_jid") @db.VarChar(64)
  whatsappGroupSubject     String?                              @map("whatsapp_group_subject") @db.VarChar(500)
  whatsappGroupLinkedAt    DateTime?                            @map("whatsapp_group_linked_at")
  createdByUserId          Int?                                 @map("created_by_user_id")
  deletedAt                DateTime?                            @map("deleted_at")
  createdAt                DateTime                             @default(now()) @map("created_at")
  updatedAt                DateTime                             @updatedAt @map("updated_at")
  salesProject             SalesProject?                        @relation(fields: [salesProjectId], references: [id], onDelete: Restrict)
  folders                  ImageSelectionFolder[]
  albumProofs              AlbumProof[]
  uploads                  ImageSelectionUpload[]
  galleryPublication       ImageSelectionGalleryPublication?
  uploadBatches            ImageSelectionUploadBatch[]
  deliverableConfigs       ImageSelectionDeliverableConfig[]
  whatsAppNotifications    ImageSelectionWhatsAppNotification[]
  // The People filter's own rows (faces/). Back-relations only: nothing here changes what a
  // project is, and the rows cascade from the project so a purge can never strand them.
  faceScans                ImageSelectionFaceScan[]
  facePeople               ImageSelectionFacePerson[]
  faceMappings             ImageSelectionFaceMapping[]

  @@unique([salesProjectId, albumProofing], map: "image_selection_project_sales_section_unique")
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([status, archivedAt])
  @@index([whatsappGroupJid])
  @@map("image_selection_project")
}

model ImageSelectionGalleryPublication {
  id                   String                @id @default(cuid())
  projectId            String                @unique @map("project_id")
  tokenHash            String                @unique @map("token_hash") @db.Char(64)
  tokenCipher          String                @map("token_cipher") @db.Text
  // The public identifier in the short client URL (gallery.dontblinkstudioz.com/<code>). Random,
  // never derived from ids, and permanent for the life of the publication row — republishing
  // upserts around it, so a client's saved link keeps working. It is NOT a credential: the PIN,
  // publish status and expiry still gate the gallery exactly as they do for the long token.
  shortCode            String?               @unique @map("short_code") @db.VarChar(8)
  pinHash              String?               @map("pin_hash") @db.Char(64)
  pinCipher            String?               @map("pin_cipher") @db.Text
  status               String                @default("PUBLISHED") @db.VarChar(30)
  publishedByUserId    Int?                  @map("published_by_user_id")
  publishedAt          DateTime              @default(now()) @map("published_at")
  expiresAt            DateTime?             @map("expires_at")
  revokedAt            DateTime?             @map("revoked_at")
  selectionSubmittedAt DateTime?             @map("selection_submitted_at")
  // When the client first and last opened the gallery link (any load of their page), and when
  // they last did something in it — picked or unpicked a photo, or sent a selection item. Stamped
  // by the public gallery routes, read by the Image Selection dashboard's Needs Attention rows.
  // Null on every publication from before they existed, which reads as "not recorded".
  galleryFirstOpenedAt DateTime?             @map("gallery_first_opened_at")
  galleryLastOpenedAt  DateTime?             @map("gallery_last_opened_at")
  lastClientActivityAt DateTime?             @map("last_client_activity_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  project              ImageSelectionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([publishedAt])
  @@map("image_selection_gallery_publication")
}

model ImageSelectionFolder {
  id              String                      @id @default(cuid())
  projectId       String                      @map("project_id")
  parentId        String?                     @map("parent_id")
  projectShootId  String?                     @unique @map("project_shoot_id")
  name            String                      @db.VarChar(191)
  sortOrder       Int                         @default(0) @map("sort_order")
  createdByUserId Int?                        @map("created_by_user_id")
  deletedAt       DateTime?                   @map("deleted_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  project         ImageSelectionProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectShoot    ProjectShoot?               @relation(fields: [projectShootId], references: [id], onDelete: SetNull)
  parent          ImageSelectionFolder?       @relation("ImageSelectionFolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        ImageSelectionFolder[]      @relation("ImageSelectionFolderHierarchy")
  uploads         ImageSelectionUpload[]
  uploadBatches   ImageSelectionUploadBatch[]
  albumProofRoot  AlbumProof?

  @@index([projectId, parentId, deletedAt])
  @@index([projectId, parentId, sortOrder])
  @@index([parentId])
  @@index([createdAt])
  @@map("image_selection_folder")
}

model ImageSelectionDeliverableConfig {
  id                                String                           @id @default(cuid())
  imageSelectionProjectId           String                           @map("image_selection_project_id")
  projectPostProductionAllocationId String?                          @map("project_post_production_allocation_id")
  projectShootDeliverableId         String?                          @map("project_shoot_deliverable_id")
  // Set only on a selection item the studio typed itself, which is how a manually named project
  // gets any: it has no Post Production Allocation to derive them from, so both ids above are null
  // and this is the item's name. An allocation-derived row leaves it null and reads its name from
  // the deliverable it points at.
  name                              String?                          @db.VarChar(191)
  // The shoot group a typed item was filed under — "Pre Wedding", "Wedding" — typed alongside it
  // in Selection Settings. Null on allocation-derived rows, whose shoot is the deliverable's, and
  // on typed items from before groups existed, which list under "Other deliverables".
  manualShootName                   String?                          @map("manual_shoot_name") @db.VarChar(191)
  enabled                           Boolean                          @default(true)
  selectionLimitOverride            Int?                             @map("selection_limit_override")
  displayOrder                      Int                              @default(0) @map("display_order")
  // When the client sent this item's selection to the studio. Submission happens one shoot at a
  // time — engagement photos are picked months before the wedding is even shot — so the flag lives
  // per selection item rather than on the publication, and a submitted item refuses further changes.
  selectionSubmittedAt              DateTime?                        @map("selection_submitted_at")
  inactiveAt                        DateTime?                        @map("inactive_at")
  createdAt                         DateTime                         @default(now()) @map("created_at")
  updatedAt                         DateTime                         @updatedAt @map("updated_at")
  imageSelectionProject             ImageSelectionProject            @relation(fields: [imageSelectionProjectId], references: [id], onDelete: Cascade)
  postProductionAllocation          ProjectPostProductionAllocation? @relation(fields: [projectPostProductionAllocationId], references: [id], onDelete: Restrict)
  shootDeliverable                  ProjectShootDeliverable?         @relation(fields: [projectShootDeliverableId], references: [id], onDelete: Restrict)
  photoSelections                   ImageSelectionPhotoSelection[]

  @@unique([imageSelectionProjectId, projectPostProductionAllocationId], map: "image_selection_config_project_allocation_unique")
  @@unique([imageSelectionProjectId, projectShootDeliverableId], map: "image_selection_config_shoot_deliverable_unique")
  @@index([imageSelectionProjectId, enabled, inactiveAt, displayOrder])
  @@index([projectPostProductionAllocationId])
  @@index([projectShootDeliverableId])
  @@map("image_selection_deliverable_config")
}

model ImageSelectionWhatsAppNotification {
  id                      String                @id @default(cuid())
  // Null for an Image Selection project that is not linked to a Sales Manager project: the
  // invite is addressed from the project's own clientName/clientMainNumber instead. Every
  // notification still carries imageSelectionProjectId, which is what the module reads.
  salesProjectId          String?               @map("sales_project_id")
  imageSelectionProjectId String                @map("image_selection_project_id")
  provider                String                @db.VarChar(50)
  template                String                @db.VarChar(191)
  recipientMasked         String                @map("recipient_masked") @db.VarChar(64)
  messageSnapshot         String                @map("message_snapshot") @db.Text
  providerMessageId       String?               @map("provider_message_id") @db.VarChar(191)
  idempotencyKey          String                @unique @map("idempotency_key") @db.VarChar(191)
  status                  String                @default("PENDING") @db.VarChar(30)
  errorCode               String?               @map("error_code") @db.VarChar(100)
  errorMessage            String?               @map("error_message") @db.Text
  sentAt                  DateTime?             @map("sent_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  salesProject            SalesProject?         @relation(fields: [salesProjectId], references: [id], onDelete: Restrict)
  imageSelectionProject   ImageSelectionProject @relation(fields: [imageSelectionProjectId], references: [id], onDelete: Cascade)

  @@index([salesProjectId, createdAt])
  @@index([imageSelectionProjectId, status, createdAt])
  @@index([providerMessageId])
  @@map("image_selection_whatsapp_notification")
}

model ImageSelectionUpload {
  id                    String                         @id @default(cuid())
  projectId             String                         @map("project_id")
  folderId              String?                        @map("folder_id")
  batchId               String?                        @map("batch_id")
  fileName              String                         @map("file_name") @db.VarChar(500)
  storageName           String                         @unique @map("storage_name") @db.VarChar(191)
  // Where the master file actually lives, on the studio's own drive or NAS — the source of truth
  // this server only ever reads. Set for every photo registered from the Original Storage Path,
  // which is how photos arrive now; null only for one uploaded through the browser before that
  // existed, which still lives under IMAGE_SELECTION_UPLOAD_ROOT and is addressed by `storageName`.
  originalPath          String?                        @map("original_path") @db.VarChar(1024)
  // Which named storage root `originalPath` is relative to, for photos the desktop app registers.
  // Null means the older flows: a browser-picked folder's trail, a server-side registration
  // against the studio-wide Original Storage Path, or a chunk-uploaded file.
  storageRootId         String?                        @map("storage_root_id")
  mimeType              String                         @map("mime_type") @db.VarChar(191)
  sizeBytes             BigInt                         @map("size_bytes")
  uploadedBytes         BigInt                         @default(0) @map("uploaded_bytes")
  chunkSize             Int                            @map("chunk_size")
  totalChunks           Int                            @map("total_chunks")
  uploadedChunks        Int                            @default(0) @map("uploaded_chunks")
  status                String                         @default("PENDING") @db.VarChar(30)
  processingError       String?                        @map("processing_error") @db.Text
  width                 Int?
  height                Int?
  imageFormat           String?                        @map("image_format") @db.VarChar(30)
  orientation           Int?
  capturedAt            DateTime?                      @map("captured_at")
  thumbnailName         String?                        @map("thumbnail_name") @db.VarChar(191)
  processedName         String?                        @map("processed_name") @db.VarChar(191)
  compressedName        String?                        @map("compressed_name") @db.VarChar(191)
  compressedSizeBytes   BigInt?                        @map("compressed_size_bytes")
  // R2 object keys. Null means the derivative still lives on local disk, which is how
  // every image uploaded before the move to object storage is served.
  thumbnailKey          String?                        @map("thumbnail_key") @db.VarChar(1024)
  previewKey            String?                        @map("preview_key") @db.VarChar(1024)
  processingAttempts    Int                            @default(0) @map("processing_attempts")
  processingStartedAt   DateTime?                      @map("processing_started_at")
  processingCompletedAt DateTime?                      @map("processing_completed_at")
  selected              Boolean                        @default(false)
  selectedAt            DateTime?                      @map("selected_at")
  createdByUserId       Int?                           @map("created_by_user_id")
  completedAt           DateTime?                      @map("completed_at")
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  project               ImageSelectionProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder                ImageSelectionFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  batch                 ImageSelectionUploadBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  storageRoot           ImageSelectionStorageRoot?     @relation(fields: [storageRootId], references: [id], onDelete: SetNull)
  photoSelections       ImageSelectionPhotoSelection[]
  // The People filter (faces/) hangs off the photo by these back-relations alone. The photo row
  // stays the source of truth; deleting it cascades its scan and its mappings away in the
  // database, so the existing delete paths need no knowledge of face data.
  faceScan              ImageSelectionFaceScan?
  faceMappings          ImageSelectionFaceMapping[]
  facePersonCovers      ImageSelectionFacePerson[]     @relation("ImageSelectionFacePersonCover")

  @@index([projectId, folderId, status])
  @@index([batchId, status])
  @@index([createdAt])
  @@index([projectId, folderId, selected])
  // Registering a photo asks "is this trail already in this folder?" once per photo, so a folder of
  // a few thousand frames asks it a few thousand times. A prefix index is all MySQL will take on a
  // 1024-character column, and 191 characters is more than enough to narrow it to one row.
  @@index([projectId, folderId, originalPath(length: 191)])
  @@map("image_selection_upload")
}

model ImageSelectionPhotoSelection {
  id                                String                          @id @default(cuid())
  imageSelectionUploadId            String                          @map("image_selection_upload_id")
  imageSelectionDeliverableConfigId String                          @map("image_selection_deliverable_config_id")
  selectedAt                        DateTime                        @default(now()) @map("selected_at")
  image                             ImageSelectionUpload            @relation(fields: [imageSelectionUploadId], references: [id], onDelete: Cascade)
  deliverableConfig                 ImageSelectionDeliverableConfig @relation(fields: [imageSelectionDeliverableConfigId], references: [id], onDelete: Cascade)

  @@unique([imageSelectionUploadId, imageSelectionDeliverableConfigId])
  @@index([imageSelectionDeliverableConfigId, selectedAt])
  @@map("image_selection_photo_selection")
}

/// The People filter in the client gallery (Image Selection → faces/). Phase 1: faces are detected
/// in the photos a project already holds, described as vectors, grouped into people, and each
/// person is remembered as the set of existing photo ids they appear in. Nothing is copied: the
/// gallery filters its own photos by these mappings, and the photo row stays the source of truth.
///
/// One row per photo that has been handed to the face worker, holding where its processing got to.
/// NOT_PROCESSED (queued, not started), PROCESSING, COMPLETED or FAILED. Absent for a photo the
/// worker was never asked about, which is how every photo from before this existed reads.
model ImageSelectionFaceScan {
  id          String                @id @default(cuid())
  projectId   String                @map("project_id")
  imageId     String                @unique @map("image_id")
  status      String                @default("NOT_PROCESSED") @db.VarChar(20)
  faceCount   Int                   @default(0) @map("face_count")
  attempts    Int                   @default(0)
  error       String?               @db.Text
  startedAt   DateTime?             @map("started_at")
  completedAt DateTime?             @map("completed_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  project     ImageSelectionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  image       ImageSelectionUpload  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("image_selection_face_scan")
}

/// A cluster of faces the worker believes are one person: "Person 3" in the gallery's People row.
/// Numbered by creation order on the way out, never named here — Phase 1 guesses no names.
model ImageSelectionFacePerson {
  id           String                      @id @default(cuid())
  projectId    String                      @map("project_id")
  /// Running mean of the member face vectors, base64 of unit-normalised little-endian float32.
  /// Compared in the worker only; never serialised to a browser.
  centroid     String                      @db.Text
  faceCount    Int                         @default(0) @map("face_count")
  /// The photo whose face stands for this person in the People row, and where in that frame it
  /// is (`{ x, y, w, h }` as fractions), so the circle is cut from the photo's existing thumbnail
  /// rather than from a stored crop. Null once that photo is deleted; the next best face steps in.
  coverImageId String?                     @map("cover_image_id")
  coverBox     Json?                       @map("cover_box")
  coverQuality Float                       @default(0) @map("cover_quality")
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  project      ImageSelectionProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coverImage   ImageSelectionUpload?       @relation("ImageSelectionFacePersonCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  mappings     ImageSelectionFaceMapping[]

  @@index([projectId, createdAt])
  @@index([coverImageId])
  @@map("image_selection_face_person")
}

/// "This person is in this photo" — the whole of what the People filter reads. One row per person
/// per photo; `confidence` is the face's similarity to the person's centroid when it joined (1 for
/// the face that started the person). The box and quality are kept so a person whose cover photo
/// is deleted can be given another without re-running the engine.
model ImageSelectionFaceMapping {
  id         String                   @id @default(cuid())
  projectId  String                   @map("project_id")
  personId   String                   @map("person_id")
  imageId    String                   @map("image_id")
  confidence Float
  box        Json
  quality    Float
  createdAt  DateTime                 @default(now()) @map("created_at")
  project    ImageSelectionProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person     ImageSelectionFacePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  image      ImageSelectionUpload     @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([personId, imageId], map: "image_selection_face_mapping_person_image_unique")
  @@index([projectId, imageId])
  @@index([imageId])
  @@map("image_selection_face_mapping")
}

model ImageSelectionUploadBatch {
  id              String                 @id @default(cuid())
  projectId       String                 @map("project_id")
  folderId        String?                @map("folder_id")
  totalFiles      Int                    @map("total_files")
  uploadedFiles   Int                    @default(0) @map("uploaded_files")
  compressedFiles Int                    @default(0) @map("compressed_files")
  failedFiles     Int                    @default(0) @map("failed_files")
  /// UPLOADING while files are still arriving, PROCESSING once they all have, then COMPLETED or
  /// COMPLETED_WITH_ERRORS when `compressedFiles + failedFiles` reaches `totalFiles`.
  ///
  /// ABANDONED is the fifth, and the only one no photograph puts it in: the total is what the
  /// browser said it was about to send, so a closed tab or a dropped connection leaves counters
  /// that can never add up and a batch that calls itself active for ever. `closeAbandonedBatches`
  /// in `modules/image-selection/uploads/batchRepository.js` closes those — quiet for fifteen
  /// minutes AND holding no upload still pending or processing, the second half being what keeps
  /// a batch waiting behind a backlog safe. Retrying reopens any of them at PROCESSING.
  status          String                 @default("UPLOADING") @db.VarChar(30)
  createdByUserId Int?                   @map("created_by_user_id")
  startedAt       DateTime               @default(now()) @map("started_at")
  completedAt     DateTime?              @map("completed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  project         ImageSelectionProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder          ImageSelectionFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploads         ImageSelectionUpload[]

  @@index([projectId, status])
  @@index([folderId])
  @@index([createdAt])
  @@map("image_selection_upload_batch")
}

/// A named place the studio keeps original photos — "STUDIO_NAS_MAIN", "ARCHIVE_HDD_2026". The
/// name is the durable identity photo records point at; where that storage is mounted on any
/// given workstation (Z:\Photography on one machine, Y:\StudioPhotos on another) is that
/// machine's own configuration and deliberately not stored here. Soft-deleted, because photo
/// rows keep referring to a root long after the studio retires it.
model ImageSelectionStorageRoot {
  id         String                 @id @default(cuid())
  name       String                 @unique @db.VarChar(100)
  notes      String?                @db.VarChar(500)
  /// Where the root is mounted — stored here rather than in the desktop's local settings, so the
  /// mapping survives reinstalls. The server itself never opens this path.
  mappedPath String?                @map("mapped_path") @db.VarChar(1024)
  deletedAt  DateTime?              @map("deleted_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  uploads    ImageSelectionUpload[]

  @@index([deletedAt])
  @@map("image_selection_storage_root")
}

/// Studio-wide Image Selection settings: one row, shared by every project, holding the values that
/// used to be hard-coded constants. Per-project answers stay on ImageSelectionProject — these are
/// only the ones that are the same everywhere. The id is fixed so there can never be a second row
/// to disagree with the first; the service upserts it and falls back to these defaults until a
/// Super Admin saves the form for the first time.
model ImageSelectionSettings {
  id                    String   @id @default("default") @db.VarChar(30)
  galleryValidityMonths Int      @default(6) @map("gallery_validity_months")
  defaultSelectionLimit Int      @default(50) @map("default_selection_limit")
  // The two server-side paths. Originals are read from under `originalStoragePath` and never
  // copied anywhere by the app; a selected original is copied into `selectedOutputPath` only when
  // staff ask for it. Both are resolved on the machine running this backend — a drive letter or a
  // UNC share — and every path the app touches must sit inside one of them.
  originalStoragePath   String?  @map("original_storage_path") @db.VarChar(500)
  selectedOutputPath    String?  @map("selected_output_path") @db.VarChar(500)
  // No *browser* download location is stored here. Where a browser saves a file is the folder the
  // user picked through its own folder picker, which only that browser can hold — a path string on
  // this row could name a folder but never grant permission to write it. That is the Target
  // Download Path, and it is the fallback for when `selectedOutputPath` is not configured.
  studioName            String   @default("Don't Blink Studios") @map("studio_name") @db.VarChar(191)
  /// What this system is called in the email that hands a new employee their username and password.
  /// The studio's own name for the thing they are being given access to; null falls back to the
  /// name the template ships with, so an unset field never reaches somebody as a blank.
  loginCredentialName   String?  @map("login_credential_name") @db.VarChar(120)
  galleryLogoUrl        String?  @map("gallery_logo_url") @db.VarChar(500)
  // The mark the browser tab shows, on every tab whatever its theme. One file, because a studio's
  // icon carries its own background - a white rounded square, say - and reads correctly on a light
  // strip and a dark one alike; asking for a pair was asking the same question twice. Null leaves
  // the bundled pair in /brand, which is per-theme because the shipped wordmark has no background
  // of its own. Held as a URL like the logo, and public for the same reason: a client's tab needs it.
  faviconUrl            String?  @map("favicon_url") @db.VarChar(500)
  // The pictures the login page turns through, as a JSON list of public image URLs in display
  // order. Null or empty means the page shows its plain slides.
  loginSlides           Json?    @map("login_slides")
  updatedByUserId       Int?     @map("updated_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("image_selection_settings")
}

/// One album under proofing, belonging to an existing Image Selection project (which supplies
/// every client/project detail — no master data is duplicated here). Its pages live as ordinary
/// ImageSelectionUpload rows registered by originalPath under `rootFolderId`'s folder subtree, so
/// import, sharp processing, progress and R2 previews are all the platform's own. `status` walks
/// the Album Proofing state machine and is moved only by the service — never free-typed. The
/// original album images are NEVER stored here or anywhere server-side: only paths and metadata.
/// `currentVersionId`/`approvedVersionId` are maintained columns, not circular foreign keys.
model AlbumProof {
  id                String                        @id @default(cuid())
  projectId         String                        @map("project_id")
  rootFolderId      String?                       @unique @map("root_folder_id")
  name              String                        @db.VarChar(191)
  albumType         String?                       @map("album_type") @db.VarChar(100)
  status            String                        @default("DRAFT") @db.VarChar(40)
  viewerMode        String                        @default("SPREAD") @map("viewer_mode") @db.VarChar(20)
  // Client correction rounds allowed; null means unlimited. `revisionsUsed` only ever grows —
  // granting an extra round raises the limit (audited), it never resets the count.
  revisionLimit     Int?                          @default(3) @map("revision_limit")
  revisionsUsed     Int                           @default(0) @map("revisions_used")
  proofExpiryDays   Int                           @default(30) @map("proof_expiry_days")
  currentVersionId  String?                       @map("current_version_id")
  approvedVersionId String?                       @map("approved_version_id")
  completedAt       DateTime?                     @map("completed_at")
  createdByUserId   Int?                          @map("created_by_user_id")
  archivedAt        DateTime?                     @map("archived_at")
  deletedAt         DateTime?                     @map("deleted_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  project           ImageSelectionProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootFolder        ImageSelectionFolder?         @relation(fields: [rootFolderId], references: [id], onDelete: SetNull)
  versions          AlbumProofVersion[]
  corrections       AlbumProofCorrection[]
  qcRounds          AlbumProofQcRound[]
  publications      AlbumProofClientPublication[]
  submissions       AlbumProofClientSubmission[]
  activities        AlbumProofActivity[]

  @@index([projectId, deletedAt])
  @@index([status, archivedAt])
  @@index([createdAt])
  @@map("album_proof")
}

/// One immutable proofing round. DRAFT while pages are being assembled or revised; FROZEN the
/// moment it is sent to QC, from which point its page snapshots never change — the next round is
/// a new version. The unique (albumId, versionNumber) makes concurrent creation of "V2 twice"
/// impossible at the database, whatever the frontend sends.
model AlbumProofVersion {
  id              String                        @id @default(cuid())
  albumId         String                        @map("album_id")
  /// The CLIENT's version: V1, V2, V3. It goes up only when a client correction round is answered
  /// with a revised upload — never for a QC round, however many passes QC takes.
  versionNumber   Int                           @map("version_number")
  /// The QC pass inside that client version. Each revised upload during QC freezes its own
  /// immutable snapshot under the same `versionNumber`, so what QC reviewed on an earlier pass is
  /// still there to look at, while the version list the studio reads shows one card per client
  /// version. 1 on every row that predates this column, which is exactly what they were.
  iteration       Int                           @default(1)
  status          String                        @default("DRAFT") @db.VarChar(30)
  pageCount       Int                           @default(0) @map("page_count")
  changeSummary   String?                       @map("change_summary") @db.Text
  frozenAt        DateTime?                     @map("frozen_at")
  createdByUserId Int?                          @map("created_by_user_id")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  album           AlbumProof                    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  pages           AlbumProofVersionPage[]
  corrections     AlbumProofCorrection[]
  qcRounds        AlbumProofQcRound[]
  publications    AlbumProofClientPublication[]
  submissions     AlbumProofClientSubmission[]

  @@unique([albumId, versionNumber, iteration])
  @@index([albumId, status])
  @@index([albumId, versionNumber])
  @@map("album_proof_version")
}

/// One page/spread of a frozen version — a snapshot, never a live pointer. `originalPath` is the
/// ONLY representation of the original image (local drive/NAS); no bytes, no base64, ever.
/// `previewKey`/`thumbnailKey` are version-scoped R2 copies made at freeze time, so re-deriving a
/// page for the next version can never mutate what an earlier version showed. `uploadId` and
/// `folderId` are plain reference columns: history must outlive the live rows they point at.
model AlbumProofVersionPage {
  id                  String                 @id @default(cuid())
  versionId           String                 @map("version_id")
  uploadId            String?                @map("upload_id")
  folderId            String?                @map("folder_id")
  folderName          String?                @map("folder_name") @db.VarChar(191)
  pageNumber          Int                    @map("page_number")
  sortOrder           Int                    @map("sort_order")
  fileName            String                 @map("file_name") @db.VarChar(500)
  originalPath        String                 @map("original_path") @db.VarChar(1024)
  previewKey          String?                @map("preview_key") @db.VarChar(1024)
  thumbnailKey        String?                @map("thumbnail_key") @db.VarChar(1024)
  width               Int?
  height              Int?
  fileSize            BigInt?                @map("file_size")
  checksum            String?                @db.VarChar(64)
  // Marks the spreads this version actually changed, so QC and the client can review
  // "changed spreads only" instead of the whole album every round.
  changedFromPrevious Boolean                @default(false) @map("changed_from_previous")
  createdAt           DateTime               @default(now()) @map("created_at")
  version             AlbumProofVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  corrections         AlbumProofCorrection[]

  @@unique([versionId, pageNumber])
  @@index([versionId, sortOrder])
  @@map("album_proof_version_page")
}

/// A correction pinned to an exact spot on one page of one version — QC's or the client's. The
/// coordinates are normalized 0..1 so the pin lands identically at any screen size. A correction
/// belongs forever to the version it was raised on: the next version references its resolution,
/// it never migrates. Client corrections lock (`lockedAt`) when their round is submitted.
model AlbumProofCorrection {
  id               String                @id @default(cuid())
  albumId          String                @map("album_id")
  versionId        String                @map("version_id")
  versionPageId    String                @map("version_page_id")
  source           String                @default("QC") @db.VarChar(10)
  xNormalized      Float                 @map("x_normalized")
  yNormalized      Float                 @map("y_normalized")
  radiusNormalized Float?                @map("radius_normalized")
  // A painted correction: strokes of normalized points, as JSON. Null for a pin or a circle.
  pathNormalized   String?               @map("path_normalized") @db.Text
  comment          String                @db.Text
  status           String                @default("OPEN") @db.VarChar(20)
  submissionId     String?               @map("submission_id")
  publicationId    String?               @map("publication_id")
  createdByUserId  Int?                  @map("created_by_user_id")
  createdByLabel   String?               @map("created_by_label") @db.VarChar(191)
  resolvedByUserId Int?                  @map("resolved_by_user_id")
  resolvedAt       DateTime?             @map("resolved_at")
  resolutionNote   String?               @map("resolution_note") @db.Text
  lockedAt         DateTime?             @map("locked_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  album            AlbumProof            @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version          AlbumProofVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionPage      AlbumProofVersionPage @relation(fields: [versionPageId], references: [id], onDelete: Cascade)

  @@index([albumId, status])
  @@index([versionId, source, status])
  @@index([versionPageId])
  @@map("album_proof_correction")
}

/// One QC review round of one version: sent, then decided — APPROVED or CHANGES_REQUESTED, with
/// the scope QC reviewed (the full album or only the spreads that changed). Unique per
/// (versionId, roundNumber) so a double-clicked resubmit cannot file the same round twice.
model AlbumProofQcRound {
  id                String            @id @default(cuid())
  albumId           String            @map("album_id")
  versionId         String            @map("version_id")
  roundNumber       Int               @map("round_number")
  scope             String            @default("FULL") @db.VarChar(20)
  submittedByUserId Int?              @map("submitted_by_user_id")
  submittedAt       DateTime          @default(now()) @map("submitted_at")
  decision          String?           @db.VarChar(30)
  decidedByUserId   Int?              @map("decided_by_user_id")
  decidedAt         DateTime?         @map("decided_at")
  note              String?           @db.Text
  album             AlbumProof        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version           AlbumProofVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, roundNumber])
  @@index([albumId, submittedAt])
  @@map("album_proof_qc_round")
}

/// One secure client proof of one version: the gallery publication's exact credential mechanics —
/// random token stored as SHA-256 hash (AES-GCM cipher so staff can re-copy the link), bcrypt PIN
/// (cipher for Show PIN), expiry and revocation. `revisionNumber` says which client round this
/// proof belongs to. Sequential database ids never appear in the public URL.
model AlbumProofClientPublication {
  id                String            @id @default(cuid())
  albumId           String            @map("album_id")
  versionId         String            @map("version_id")
  revisionNumber    Int               @map("revision_number")
  /// The short public identifier in the client's URL (/p/AB7KX2). Random, never derived from an
  /// id, and never rotated once issued. Null on links published before this column existed: those
  /// keep resolving by their original 43-character token, so nothing already shared stops working.
  shortCode         String?           @unique @map("short_code") @db.VarChar(8)
  tokenHash         String            @unique @map("token_hash") @db.Char(64)
  tokenCipher       String            @map("token_cipher") @db.Text
  pinHash           String            @map("pin_hash") @db.VarChar(191)
  pinCipher         String            @map("pin_cipher") @db.Text
  expiresAt         DateTime?         @map("expires_at")
  revokedAt         DateTime?         @map("revoked_at")
  publishedByUserId Int?              @map("published_by_user_id")
  publishedAt       DateTime          @default(now()) @map("published_at")
  lastAccessAt      DateTime?         @map("last_access_at")
  accessCount       Int               @default(0) @map("access_count")
  album             AlbumProof        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version           AlbumProofVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([albumId, publishedAt])
  @@map("album_proof_client_publication")
}

/// What the client sent back for one version: exactly one CORRECTIONS batch (consuming one
/// revision round) and/or one APPROVAL — the unique (versionId, type) makes a double-click
/// physically unable to consume two rounds or approve twice. Immutable once written.
model AlbumProofClientSubmission {
  id                   String            @id @default(cuid())
  albumId              String            @map("album_id")
  versionId            String            @map("version_id")
  publicationId        String?           @map("publication_id")
  type                 String            @db.VarChar(20)
  revisionNumber       Int?              @map("revision_number")
  correctionCount      Int               @default(0) @map("correction_count")
  approvedConfirmation String?           @map("approved_confirmation") @db.Text
  ipAddress            String?           @map("ip_address") @db.VarChar(64)
  userAgent            String?           @map("user_agent") @db.VarChar(500)
  submittedAt          DateTime          @default(now()) @map("submitted_at")
  album                AlbumProof        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version              AlbumProofVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, type])
  @@index([albumId, submittedAt])
  @@map("album_proof_client_submission")
}

/// The album's audit timeline: who did what, to which version/page, when. Version, page and
/// correction ids are plain columns so history outlives its subjects; secrets and PINs are never
/// written here by construction.
model AlbumProofActivity {
  id           String     @id @default(cuid())
  albumId      String     @map("album_id")
  versionId    String?    @map("version_id")
  pageId       String?    @map("page_id")
  correctionId String?    @map("correction_id")
  actorType    String     @default("STAFF") @map("actor_type") @db.VarChar(20)
  actorUserId  Int?       @map("actor_user_id")
  actorLabel   String?    @map("actor_label") @db.VarChar(191)
  event        String     @db.VarChar(50)
  detail       String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  album        AlbumProof @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, createdAt])
  @@index([createdAt])
  @@map("album_proof_activity")
}

model ProjectShoot {
  id                                String                                    @id @default(cuid())
  shootId                           String                                    @unique @map("shoot_id") @db.VarChar(30)
  projectId                         String                                    @map("project_id")
  /// The day the shoot runs, or null when it has not been fixed yet.
  ///
  /// A shoot is regularly booked before its date is - a wedding sold in January whose reception
  /// date the family has not settled - and the form asks "Shoot Date Known" before it asks for
  /// one. Null means "not scheduled yet", which is not the same as a date nobody can read: the
  /// Image Selection gate treats an undated shoot as one that has not happened, so its folders
  /// stay closed until a date is put on it.
  dateCreated                       DateTime?                                 @map("date_created")
  shoot                             String                                    @db.VarChar(100)
  shootPlace                        String                                    @map("shoot_place") @db.VarChar(191)
  shootType                         String                                    @default("Studio / In-House") @map("shoot_type") @db.VarChar(30)
  shootTypes                        Json?                                     @map("shoot_types")
  isMainEvent                       Boolean                                   @default(false) @map("is_main_event")
  district                          String                                    @db.VarChar(191)
  state                             String                                    @db.VarChar(191)
  eventStartTime                    String?                                   @map("event_start_time") @db.VarChar(5)
  eventEndTime                      String?                                   @map("event_end_time") @db.VarChar(5)
  sessionTiming                     String?                                   @map("session_timing") @db.VarChar(20)
  sessionTimings                    Json?                                     @map("session_timings")
  sessionDurationHours              Int?                                      @map("session_duration_hours")
  sessionDurationMinutes            Int?                                      @map("session_duration_minutes")
  foodTakenCareBy                   String                                    @default("Studio") @map("food_taken_care_by") @db.VarChar(20)
  accommodation                     String                                    @default("Studio") @db.VarChar(20)
  travel                            String                                    @default("Studio") @db.VarChar(20)
  preference                        String?                                   @db.VarChar(20)
  deletedAt                         DateTime?                                 @map("deleted_at")
  createdAt                         DateTime                                  @default(now()) @map("created_at")
  updatedAt                         DateTime                                  @updatedAt @map("updated_at")
  project                           SalesProject                              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables                      ProjectShootDeliverable[]
  imageSelectionRootFolder          ImageSelectionFolder?
  postProductionAllocations         ProjectPostProductionAllocation[]
  postProductionWorkflowAllocations ProjectPostProductionWorkflowAllocation[]
  clientStorageRecords              ClientStorage[]
  cashEntries                       CashEntry[]
  paymentRequestExpenses            PaymentRequestExpense[]
  extraQuotations                   ProjectExtraQuotation[]

  @@index([projectId, deletedAt])
  @@index([createdAt])
  @@map("project_shoot")
}

model ProjectServiceDefinition {
  id                        String                                   @id @default(cuid())
  code                      String                                   @unique @db.VarChar(100)
  name                      String                                   @unique @db.VarChar(191)
  quantityMode              ProjectServiceQuantityMode?              @map("quantity_mode")
  /// How many of this service a project starts with, and whether it has a quantity at all.
  ///
  /// Null means the service is not counted - a drone either comes or it does not. A number means it
  /// is, and that number is what a new allocation begins with. `quantityMode` is kept in step with
  /// it (INTEGER when this is set, NONE when it is null) so everything already reading the mode
  /// keeps working; this is the field a person actually fills in.
  /// What the studio charges for one of these, before anything a quotation does to it. Nullable
  /// because a service the studio has not priced yet is a real state, and zero is not the same thing.
  price                     Decimal?                                 @db.Decimal(12, 2)
  defaultQuantity           Int?                                     @map("default_quantity")
  defaultDurationHours      Int?                                     @map("default_duration_hours")
  defaultDurationMinutes    Int?                                     @map("default_duration_minutes")
  /// The one timing a project is asked for, kept as the first of `timingModes`.
  ///
  /// Left in place because the quotation calculator and the allocation builder both branch on it.
  timingMode                ProjectServiceTimingMode?                @map("timing_mode")
  /// Every timing this service may be booked with, as a JSON array of the same enum's names.
  ///
  /// A service can be offered hourly *and* by the session - "Candid Photo" is booked both ways -
  /// and a single mode forced the studio to choose one when setting it up. Null or empty means
  /// whatever `timingMode` says, so rows written before this existed still read correctly.
  timingModes               Json?                                    @map("timing_modes")
  /// Which shoot types this service is offered for: STUDIO, OUTDOOR, or both.
  ///
  /// Null or empty means it is offered for any shoot, which is what every service written before
  /// this existed means.
  shootTypes                Json?                                    @map("shoot_types")
  /// What the service costs per shoot type and session timing, as
  /// `[{ shootType, timingMode, price }]` - Studio + Half Session at one figure, Studio + Full
  /// Session at another. A session row carries `duration`, the length it reads as on screen
  /// ("4-5 Hours (Half)" unless typed over). An HOURS_MINUTES row carries `hours` and is the price for a booking of
  /// that many - several may stand side by side for different lengths - and is a studio row only.
  /// The rows are the studio's own list, not tied to the service's `shootTypes` or `timingModes`. A
  /// quotation line added for a shoot takes the row that matches the shoot's type and timing as its
  /// unit price; `price` above is the flat figure this falls back to. With `sizeEnabled`, every row
  /// also carries `size` as typed - and `sizeOptionValueId` beside it where the words match an entry
  /// of the studio's service size lists - so the same booking is priced per size, and a quotation
  /// line takes the row matching its size once one is picked.
  pricing                   Json?
  /// Whether this service is sold by size: Yes puts a Size on every pricing row and a Size picker
  /// on the project and quotation lines that use it. Null reads as No.
  sizeEnabled               Boolean?                                 @map("size_enabled")
  /// Whether this service brings deliverables with it. Only TRUE does, so a service saved before
  /// this was asked - and every service nobody has answered it for - brings none, which is exactly
  /// how they all behaved before. The mapping itself is not here: it belongs to the *booking*, and
  /// rides on each row of `pricing` as `deliverables: [{ deliverableId, brandId, variantId }]`,
  /// because the 12x18 line brings a 12x18 print and the 8x12 line does not.
  deliverableAdded          Boolean?                                 @map("deliverable_added")
  /// Whether this is given rather than charged for. Only TRUE is: a record saved before this was
  /// asked, and every one nobody has answered it for, reads as No - which is how they all behaved
  /// before. It is the *master's* answer, and a quotation copies it onto a line once, when the line
  /// is added; changing it here never moves a quotation already raised, and changing it on a
  /// quotation never writes back here.
  complimentary             Boolean?
  timingOptionSetId         String?                                  @map("timing_option_set_id")
  sizeOptionSetId           String?                                  @map("size_option_set_id")
  /// A note the studio writes about the service, typed. It was a Yes/No switch deciding whether a
  /// project's service line carried a remarks box at all; it decides nothing now, and the line
  /// always has one - which is what all but one service already did. Reading a note as an answer
  /// was the thing to remove: the rule was "an answer starting with no is No", so an ordinary note
  /// beginning "Not applicable" would have taken that box away across every project using it.
  remarksEnabled            String?                                  @map("remarks_enabled") @db.Text
  isActive                  Boolean                                  @default(true) @map("is_active")
  sortOrder                 Int                                      @default(0) @map("sort_order")
  createdAt                 DateTime                                 @default(now()) @map("created_at")
  updatedAt                 DateTime                                 @updatedAt @map("updated_at")
  timingOptionSet           ProjectOptionSet?                        @relation("ProjectServiceTimingOptionSet", fields: [timingOptionSetId], references: [id], onDelete: SetNull)
  sizeOptionSet             ProjectOptionSet?                        @relation("ProjectServiceSizeOptionSet", fields: [sizeOptionSetId], references: [id], onDelete: SetNull)
  postProductionAllocations ProjectPostProductionAllocation[]
  workflowDefinition        ProjectPostProductionWorkflowDefinition?

  @@index([isActive, sortOrder])
  @@index([timingOptionSetId])
  @@index([sizeOptionSetId])
  @@map("project_service_definition")
}

model ProjectPostProductionWorkflowDefinition {
  id                  String                                    @id @default(cuid())
  serviceDefinitionId String                                    @unique @map("service_definition_id")
  rawFileIn           Boolean                                   @default(true) @map("raw_file_in")
  photoSelection      Boolean?                                  @map("photo_selection")
  output01            String?                                   @map("output_01") @db.VarChar(191)
  output02            String?                                   @map("output_02") @db.VarChar(191)
  output03            String?                                   @map("output_03") @db.VarChar(191)
  output04            String?                                   @map("output_04") @db.VarChar(191)
  finalFilesOut       Boolean                                   @default(true) @map("final_files_out")
  isActive            Boolean                                   @default(true) @map("is_active")
  createdAt           DateTime                                  @default(now()) @map("created_at")
  updatedAt           DateTime                                  @updatedAt @map("updated_at")
  serviceDefinition   ProjectServiceDefinition                  @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)
  allocations         ProjectPostProductionWorkflowAllocation[]

  @@index([isActive])
  @@map("project_post_production_workflow_definition")
}

model ProjectOptionSet {
  id                         String                         @id @default(cuid())
  code                       String                         @unique @db.VarChar(100)
  name                       String                         @db.VarChar(191)
  isActive                   Boolean                        @default(true) @map("is_active")
  sortOrder                  Int                            @default(0) @map("sort_order")
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")
  values                     ProjectOptionSetValue[]
  serviceTimingDefinitions   ProjectServiceDefinition[]     @relation("ProjectServiceTimingOptionSet")
  serviceSizeDefinitions     ProjectServiceDefinition[]     @relation("ProjectServiceSizeOptionSet")
  deliverableSizeDefinitions ProjectDeliverableDefinition[] @relation("ProjectDeliverableSizeOptionSet")

  @@index([isActive, sortOrder])
  @@map("project_option_set")
}

model ProjectOptionSetValue {
  id                         String                            @id @default(cuid())
  optionSetId                String                            @map("option_set_id")
  code                       String                            @db.VarChar(100)
  value                      String                            @db.VarChar(191)
  label                      String                            @db.VarChar(191)
  description                String?                           @db.VarChar(191)
  /// What one unit of this size costs — a 12x6 album is not priced like a 36x18 one, so the price
  /// belongs to the size rather than to the deliverable that offers it.
  pricePerQuantity           Decimal?                          @map("price_per_quantity") @db.Decimal(12, 2)
  isActive                   Boolean                           @default(true) @map("is_active")
  sortOrder                  Int                               @default(0) @map("sort_order")
  createdAt                  DateTime                          @default(now()) @map("created_at")
  updatedAt                  DateTime                          @updatedAt @map("updated_at")
  optionSet                  ProjectOptionSet                  @relation(fields: [optionSetId], references: [id], onDelete: Cascade)
  sessionServiceAllocations  ProjectPostProductionAllocation[] @relation("ProjectServiceSessionOption")
  sizeServiceAllocations     ProjectPostProductionAllocation[] @relation("ProjectServiceSizeOption")
  sizeDeliverableAllocations ProjectShootDeliverable[]         @relation("ProjectDeliverableSizeOption")

  @@unique([optionSetId, code])
  @@index([optionSetId, isActive, sortOrder])
  @@map("project_option_set_value")
}

model ProjectDeliverableDefinition {
  id                     String                    @id @default(cuid())
  code                   String                    @unique @db.VarChar(100)
  name                   String                    @unique @db.VarChar(191)
  /// What the studio charges for one of these. Nullable for the same reason as a service's.
  price                  Decimal?                  @db.Decimal(12, 2)
  /// No. of Count, Image Selection and Remarks: the three questions asked of every deliverable,
  /// whatever its type. They were a Yes/No dropdown each and are typed words now, so a studio can
  /// write what it actually does — "50 photos", "2 sets", "only the album". The words still decide
  /// things, by the one rule `deliverableAnswers` holds: an answer starting with "no" is No,
  /// anything else typed is Yes, and blank is unanswered. Every `Yes` and `No` written before this
  /// therefore reads exactly as it did.
  photoCountEnabled      String?                   @map("photo_count_enabled") @db.VarChar(191)
  /// Whether this deliverable is offered as a selection item in Image Selection — the only thing
  /// that decides it; nothing is hard-coded in the app. Blank keeps it out, as it always has.
  /// Migration 20260820090000 stamped Yes onto the definitions the retired built-in list admitted.
  imageSelectionEnabled  String?                   @map("image_selection_enabled") @db.VarChar(191)
  sizeOptionSetId        String?                   @map("size_option_set_id")
  /// Whether this is given rather than charged for - the deliverable's own answer, independent of
  /// any service's. See the same field on `ProjectServiceDefinition`.
  complimentary          Boolean?
  remarksEnabled         String?                   @map("remarks_enabled") @db.Text
  /// What the deliverable is: an IMAGE or a VIDEO. Null on a deliverable saved before this was
  /// asked. `kind` is no longer written and stays only so older rows read.
  mediaType              String?                   @map("media_type") @db.VarChar(20)
  kind                   String?                   @db.VarChar(30)
  /// How the deliverable is described on Settings → Project → Deliverables, as typed. Words for
  /// the screen and the table; nothing prices or filters on them, and `price` above is what it
  /// costs.
  ///
  /// `imageSize` and `frameInches` are an image deliverable's - how big the print is and the
  /// frame around it - and `videoLength` is a video's. They are kept apart rather than shared, so
  /// a deliverable switched from one type to the other and back still holds what it was given;
  /// what the type does not ask for is cleared on save, so a video never carries a frame size.
  ///
  /// One brand and one variant's worth each, and they are no longer what the dialog fills in:
  /// `brands` below is. They are kept, and rewritten from the first brand's first variant on every
  /// save, because the CRM Quotation Calculator quotes one figure per deliverable and reads them —
  /// see `quotation-calculator/controller.js`. A deliverable with no brands keeps whatever it holds.
  brandName              String?                   @map("brand_name") @db.VarChar(191)
  imageSize              String?                   @map("image_size") @db.VarChar(100)
  videoLength            String?                   @map("video_length") @db.VarChar(100)
  frameInches            String?                   @map("frame_inches") @db.VarChar(60)
  /// No longer written by the deliverable dialog, which asks one `price` for the deliverable; kept
  /// so a deliverable priced under kinds earlier still prices its quotation lines as it did.
  /// What the deliverable cost, one row per kind and booking: `[{ kind, ...booking, price }]`. An
  /// image kind (FRAMES / ALBUM / CALENDAR) is priced per size - `size` as typed, with
  /// `sizeOptionValueId` beside it where the words match an entry of the kind's own size list;
  /// FULL_LENGTH per session, `timingMode` HALF_SESSION or FULL_SESSION; TEASER or
  /// CANDID as one figure. A deliverable may be priced under several kinds at once. A quotation
  /// line takes the row matching its size, or its shoot's session, or the one figure where a
  /// single kind is all that is priced; `price` above is the flat figure it falls back to.
  /// `sizeOptionSetId` is pointed at the first priced image kind's list, for the screens that read
  /// one list; the line pickers offer every priced size.
  pricing                Json?
  /// The one shoot type this deliverable is offered for, as a one-item list - the shape a
  /// service's `shootTypes` has. Null or empty means every shoot, which is what a deliverable saved
  /// before this existed means.
  shootTypes             Json?                     @map("shoot_types")
  /// The timings this deliverable is offered with, as a service's `timingModes`: HALF_SESSION,
  /// FULL_SESSION, HOURS_MINUTES, or ["NONE"] for none.
  timingModes            Json?                     @map("timing_modes")
  /// How long an Hours / Minutes deliverable usually runs, in the two parts a shoot stores.
  defaultDurationHours   Int?                      @map("default_duration_hours")
  defaultDurationMinutes Int?                      @map("default_duration_minutes")
  isActive               Boolean                   @default(true) @map("is_active")
  sortOrder              Int                       @default(0) @map("sort_order")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  sizeOptionSet          ProjectOptionSet?         @relation("ProjectDeliverableSizeOptionSet", fields: [sizeOptionSetId], references: [id], onDelete: SetNull)
  deliverables           ProjectShootDeliverable[]
  brands                 ProjectDeliverableBrand[]

  @@index([isActive, sortOrder])
  @@index([sizeOptionSetId])
  @@map("project_deliverable_definition")
}

/// One company a deliverable is sold by — Canvera, Pictoo, the studio itself. A deliverable has as
/// many as it is sold by, and each holds the variants it is sold in. Replaced by whatever the
/// dialog sends on each save, so it is owned entirely by its deliverable and goes with it.
model ProjectDeliverableBrand {
  id           String                       @id @default(cuid())
  definitionId String                       @map("definition_id")
  /// As typed. A brand may be left unnamed — a studio selling its own albums has nobody to name —
  /// and its variants are still its own.
  name         String                       @default("") @db.VarChar(191)
  sortOrder    Int                          @default(0) @map("sort_order")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")
  definition   ProjectDeliverableDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  variants     ProjectDeliverableVariant[]

  @@index([definitionId, sortOrder])
  @@map("project_deliverable_brand")
}

/// One way a brand sells a deliverable, and what it costs. What it is asked for follows the
/// deliverable's type and nothing else: an image's variant carries `size` and `frameInches`, a
/// video's carries `videoLength`, and `price` belongs to both. The columns the type does not ask
/// for are written null on every save, so a video variant can never be left carrying a frame size.
model ProjectDeliverableVariant {
  id          String                  @id @default(cuid())
  brandId     String                  @map("brand_id")
  size        String?                 @db.VarChar(100)
  frameInches String?                 @map("frame_inches") @db.VarChar(60)
