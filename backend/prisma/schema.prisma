  @@index([projectId, parentId, deletedAt])
  @@index([projectId, parentId, sortOrder])
  @@index([parentId])
  @@index([createdAt])
  @@index([createdByUserId])
  @@map("image_selection_folder")
}

model ImageSelectionDeliverableConfig {
  id                                String                           @id @default(cuid())
  imageSelectionProjectId           String                           @map("image_selection_project_id")
  projectPostProductionAllocationId String?                          @map("project_post_production_allocation_id")
  projectShootDeliverableId         String?                          @map("project_shoot_deliverable_id")
  // Set only on a selection item the studio typed itself, which is how a manually named project
  // gets any: it has no Post Production Allocation to derive them from, so both ids above are null
  // and this is the item's name. An allocation-derived row leaves it null and reads its name from
  // the deliverable it points at.
  name                              String?                          @db.VarChar(191)
  // The shoot group a typed item was filed under — "Pre Wedding", "Wedding" — typed alongside it
  // in Selection Settings. Null on allocation-derived rows, whose shoot is the deliverable's, and
  // on typed items from before groups existed, which list under "Other deliverables". Only a copy
  // of the folder's name where `manualShootFolderId` is set: renaming the folder rewrites it.
  manualShootName                   String?                          @map("manual_shoot_name") @db.VarChar(191)
  // On a manual project, the root folder this item's shoot group IS - the link by id, so renaming
  // the folder keeps its items, limits and picks with it, and deleting the folder deletes them
  // (CASCADE - no item outlives its folder). Null for a derived item and for an item filed under no
  // shoot at all.
  manualShootFolderId               String?                          @map("manual_shoot_folder_id")
  enabled                           Boolean                          @default(true)
  selectionLimitOverride            Int?                             @map("selection_limit_override")
  displayOrder                      Int                              @default(0) @map("display_order")
  // When the client sent this item's selection to the studio. Submission happens one shoot at a
  // time — engagement photos are picked months before the wedding is even shot — so the flag lives
  // per selection item rather than on the publication, and a submitted item refuses further changes.
  selectionSubmittedAt              DateTime?                        @map("selection_submitted_at")
  /// When this item's submitted picks were last copied out, by the browser's Download Selected or
  /// the desktop copy - a run stamps only the items it covered, so downloading Retouches leaves
  /// Frames on Yet to Download. The project's own stamp moves only once every submitted item is up
  /// to date (and alone serves a gallery without items).
  selectedDownloadedAt              DateTime?                        @map("selected_downloaded_at")
  inactiveAt                        DateTime?                        @map("inactive_at")
  createdAt                         DateTime                         @default(now()) @map("created_at")
  updatedAt                         DateTime                         @updatedAt @map("updated_at")
  imageSelectionProject             ImageSelectionProject            @relation(fields: [imageSelectionProjectId], references: [id], onDelete: Cascade)
  postProductionAllocation          ProjectPostProductionAllocation? @relation(fields: [projectPostProductionAllocationId], references: [id], onDelete: Restrict)
  shootDeliverable                  ProjectShootDeliverable?         @relation(fields: [projectShootDeliverableId], references: [id], onDelete: Restrict)
  manualShootFolder                 ImageSelectionFolder?            @relation("DeliverableConfigManualShootFolder", fields: [manualShootFolderId], references: [id], onDelete: Cascade)
  photoSelections                   ImageSelectionPhotoSelection[]

  @@unique([imageSelectionProjectId, projectPostProductionAllocationId], map: "image_selection_config_project_allocation_unique")
  @@unique([imageSelectionProjectId, projectShootDeliverableId], map: "image_selection_config_shoot_deliverable_unique")
  @@index([imageSelectionProjectId, enabled, inactiveAt, displayOrder])
  @@index([projectPostProductionAllocationId])
  @@index([projectShootDeliverableId])
  @@index([manualShootFolderId])
  @@map("image_selection_deliverable_config")
}

model ImageSelectionWhatsAppNotification {
  id                      String                @id @default(cuid())
  // Null for an Image Selection project that is not linked to a Sales Manager project: the
  // invite is addressed from the project's own clientName/clientMainNumber instead. Every
  // notification still carries imageSelectionProjectId, which is what the module reads.
  salesProjectId          String?               @map("sales_project_id")
  imageSelectionProjectId String                @map("image_selection_project_id")
  provider                String                @db.VarChar(50)
  template                String                @db.VarChar(191)
  recipientMasked         String                @map("recipient_masked") @db.VarChar(64)
  messageSnapshot         String                @map("message_snapshot") @db.Text
  providerMessageId       String?               @map("provider_message_id") @db.VarChar(191)
  idempotencyKey          String                @unique @map("idempotency_key") @db.VarChar(191)
  status                  String                @default("PENDING") @db.VarChar(30)
  errorCode               String?               @map("error_code") @db.VarChar(100)
  errorMessage            String?               @map("error_message") @db.Text
  sentAt                  DateTime?             @map("sent_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  salesProject            SalesProject?         @relation(fields: [salesProjectId], references: [id], onDelete: Restrict)
  imageSelectionProject   ImageSelectionProject @relation(fields: [imageSelectionProjectId], references: [id], onDelete: Cascade)

  whatsappActivities      WhatsAppActivity[]

  @@index([salesProjectId, createdAt])
  @@index([imageSelectionProjectId, status, createdAt])
  @@index([providerMessageId])
  @@map("image_selection_whatsapp_notification")
}

model ImageSelectionUpload {
  id                          String                         @id @default(cuid())
  projectId                   String                         @map("project_id")
  folderId                    String?                        @map("folder_id")
  batchId                     String?                        @map("batch_id")
  fileName                    String                         @map("file_name") @db.VarChar(500)
  storageName                 String                         @unique @map("storage_name") @db.VarChar(191)
  // Where the master file actually lives, on the studio's own drive or NAS — the source of truth
  // this server only ever reads. Set for every photo registered from the Original Storage Path,
  // which is how photos arrive now; null only for one uploaded through the browser before that
  // existed, which still lives under IMAGE_SELECTION_UPLOAD_ROOT and is addressed by `storageName`.
  originalPath                String?                        @map("original_path") @db.VarChar(1024)
  // Which named storage root `originalPath` is relative to, for photos the desktop app registers.
  // Null means the older flows: a browser-picked folder's trail, a server-side registration
  // against the studio-wide Original Storage Path, or a chunk-uploaded file.
  storageRootId               String?                        @map("storage_root_id")
  // BLAKE3 of the original's bytes (lowercase hex), written by the desktop app when it read the
  // file to build the derivatives and verified by it before any local analysis or edit: a file
  // found at the trail with another checksum is LOCAL_SOURCE_CHANGED, never silently used. Null
  // for the browser flows and for photos an older desktop added.
  sourceChecksum              String?                        @map("source_checksum") @db.VarChar(64)
  mimeType                    String                         @map("mime_type") @db.VarChar(191)
  sizeBytes                   BigInt                         @map("size_bytes")
  uploadedBytes               BigInt                         @default(0) @map("uploaded_bytes")
  chunkSize                   Int                            @map("chunk_size")
  totalChunks                 Int                            @map("total_chunks")
  uploadedChunks              Int                            @default(0) @map("uploaded_chunks")
  status                      String                         @default("PENDING") @db.VarChar(30)
  processingError             String?                        @map("processing_error") @db.Text
  width                       Int?
  height                      Int?
  imageFormat                 String?                        @map("image_format") @db.VarChar(30)
  orientation                 Int?
  capturedAt                  DateTime?                      @map("captured_at")
  thumbnailName               String?                        @map("thumbnail_name") @db.VarChar(191)
  processedName               String?                        @map("processed_name") @db.VarChar(191)
  compressedName              String?                        @map("compressed_name") @db.VarChar(191)
  compressedSizeBytes         BigInt?                        @map("compressed_size_bytes")
  // R2 object keys. Null means the derivative still lives on local disk, which is how
  // every image uploaded before the move to object storage is served.
  thumbnailKey                String?                        @map("thumbnail_key") @db.VarChar(1024)
  previewKey                  String?                        @map("preview_key") @db.VarChar(1024)
  processingAttempts          Int                            @default(0) @map("processing_attempts")
  processingStartedAt         DateTime?                      @map("processing_started_at")
  processingCompletedAt       DateTime?                      @map("processing_completed_at")
  selected                    Boolean                        @default(false)
  selectedAt                  DateTime?                      @map("selected_at")
  // Stamped when a FINALIZED culling session excluded this photo from Photo Selection; null means
  // eligible — and stays null forever on a project that never culls, which is the whole backward
  // compatibility story. Written wholesale at finalize (never for a photo the client already
  // selected) and cleared wholesale on reopen. The photo itself is never deleted or moved.
  cullRejectedAt              DateTime?                      @map("cull_rejected_at")
  // Which finalized session left that stamp. Finalize writes its own id beside the date and
  // reopen clears only its own, so a shoot-scoped run and a project-wide run finalized over the
  // same photos can no longer undo each other. SetNull: a deleted session never orphan-hides.
  cullRejectedSessionId       String?                        @map("cull_rejected_session_id")
  // Set when the photo was added through the AI Culling tab: it goes through culling before Photo
  // Selection, so - like a culled photo - it is off every Photo Selection surface until a FINALIZED
  // run releases it (its Keeps appear) or the studio sends it on without culling. Null for every
  // photo added through Photo Selection, and for every photo that existed before this column.
  cullingHoldAt               DateTime?                      @map("culling_hold_at")
  // Set when the photo is in the AI Editing bay before Photo Selection has seen it: added through
  // the AI Editing tab, or sent there from AI Culling while still held. Off every Photo Selection
  // surface until the studio sends it on from AI Editing (unedited: the hold clears; edited: a
  // compressed copy is made and this row stays the untouched source). Null for every photo that
  // existed before this column and for every photo added through Photo Selection.
  editingHoldAt               DateTime?                      @map("editing_hold_at")
  // The source photo this row is the AI-edited, compressed copy of (ai-editing/). Set only on a
  // row AI Editing made for Photo Selection; the source itself is never overwritten. SetNull: a
  // deleted source leaves its edited copy standing.
  editOfUploadId              String?                        @map("edit_of_upload_id")
  createdByUserId             Int?                           @map("created_by_user_id")
  completedAt                 DateTime?                      @map("completed_at")
  createdAt                   DateTime                       @default(now()) @map("created_at")
  updatedAt                   DateTime                       @updatedAt @map("updated_at")
  project                     ImageSelectionProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder                      ImageSelectionFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  batch                       ImageSelectionUploadBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  storageRoot                 ImageSelectionStorageRoot?     @relation(fields: [storageRootId], references: [id], onDelete: SetNull)
  cullRejectedSession         ImageSelectionCullingSession?  @relation("CullingRejectedBy", fields: [cullRejectedSessionId], references: [id], onDelete: SetNull)
  photoSelections             ImageSelectionPhotoSelection[]
  // The People filter (faces/) hangs off the photo by these back-relations alone. The photo row
  // stays the source of truth; deleting it cascades its scan and its mappings away in the
  // database, so the existing delete paths need no knowledge of face data.
  faceScan                    ImageSelectionFaceScan?
  faceMappings                ImageSelectionFaceMapping[]
  facePersonCovers            ImageSelectionFacePerson[]     @relation("ImageSelectionFacePersonCover")
  // The Signature Album's references to this photo (signature-album/). Back-relations only: an
  // album item is a pointer at this row, never a copy of the file, and every one of them cascades
  // away (or, for a cover, is set null) when the photo is deleted through the existing paths.
  signatureAlbumCovers        SignatureAlbum[]               @relation("SignatureAlbumCover")
  signatureAlbumChapterCovers SignatureAlbumChapter[]        @relation("SignatureAlbumChapterCover")
  signatureAlbumItems         SignatureAlbumItem[]
  signatureAlbumCopies        SignatureAlbumPhoto[]          @relation("SignatureAlbumPhotoSource")
  cullingResults              ImageSelectionCullingResult[]
  sceneCache                  ImageSelectionUploadScene[]
  // AI Editing (ai-editing/): the edit record of this photo as a source, and the compressed
  // edited copies made from it for Photo Selection.
  edit                        ImageSelectionEdit?
  editOf                      ImageSelectionUpload?          @relation("ImageSelectionUploadEditOf", fields: [editOfUploadId], references: [id], onDelete: SetNull)
  editedCopies                ImageSelectionUpload[]         @relation("ImageSelectionUploadEditOf")
  editsSentHere               ImageSelectionEdit[]           @relation("ImageSelectionEditSentToPhotos")

  createdByUser User? @relation("ImageSelectionUploadCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, folderId, status])
  @@index([batchId, status])
  @@index([createdAt])
  @@index([projectId, folderId, selected])
  // Registering a photo asks "is this trail already in this folder?" once per photo, so a folder of
  // a few thousand frames asks it a few thousand times. A prefix index is all MySQL will take on a
  // 1024-character column, and 191 characters is more than enough to narrow it to one row.
  @@index([projectId, folderId, originalPath(length: 191)])
  @@index([createdByUserId])
  @@index([cullRejectedSessionId])
  @@index([editOfUploadId])
  @@map("image_selection_upload")
}

/// AI Editing: one record per source photo, holding the recipe (the adjustments, style, AI tools
/// and reference the photographer chose) and the latest rendered output. The source row and its
/// derivatives are never written to; a render writes new objects under the edit's own prefix and
/// bumps `version`. `status`: DRAFT (recipe saved, nothing rendered yet), QUEUED, RENDERING,
/// RENDERED, FAILED. `sourceKind` says what the render read: ORIGINAL (the studio's master, when
/// this server can open it) or PREVIEW (the uploaded preview, the largest file the server holds).
/// `sentToPhotosUploadId` / `sentToAlbumPhotoId` record where the current version went, so a
/// second press asks before sending the same version again.
model ImageSelectionEdit {
  id                   String                @id @default(cuid())
  projectId            String                @map("project_id")
  uploadId             String                @unique @map("upload_id")
  status               String                @default("DRAFT") @db.VarChar(20)
  version              Int                   @default(0)
  recipe               Json?
  // What the last render actually applied: the recipe with every "auto" value and reference
  // analysis filled in, so the sliders can show what the AI chose.
  appliedRecipe        Json?                 @map("applied_recipe")
  sourceKind           String?               @map("source_kind") @db.VarChar(20)
  // The full-resolution edited JPEG (the edit master, up to AI_EDITING_MAX_EDGE on the long edge)
  // and its own display pair, all under image-selection/ai-editing/.
  outputKey            String?               @map("output_key") @db.VarChar(1024)
  outputPreviewKey     String?               @map("output_preview_key") @db.VarChar(1024)
  outputThumbnailKey   String?               @map("output_thumbnail_key") @db.VarChar(1024)
  outputWidth          Int?                  @map("output_width")
  outputHeight         Int?                  @map("output_height")
  outputBytes          Int?                  @map("output_bytes")
  // A reference photo whose look the recipe copies (the "Upload Reference" tool), stored once.
  referenceKey         String?               @map("reference_key") @db.VarChar(1024)
  error                String?               @db.Text
  // Why the desktop could not render this edit from the original (one of the LOCAL_SOURCE_* codes
  // in ai-culling/constants.js), beside the studio words in `error`; null for every other failure.
  errorCode            String?               @map("error_code") @db.VarChar(40)
  // What the render is doing right now ("Retouching skin"), written by the worker as the engine
  // reports it, so the screen says what is happening rather than spinning.
  stage                String?               @db.VarChar(60)
  engineVersion        String?               @map("engine_version") @db.VarChar(60)
  renderedAt           DateTime?             @map("rendered_at")
  // Where the current version went: the Photo Selection copy it made and the album photo it made.
  // Real links (SetNull): a copy the studio deleted no longer counts as "already sent".
  sentToPhotosUploadId String?               @map("sent_to_photos_upload_id")
  sentToPhotosVersion  Int?                  @map("sent_to_photos_version")
  sentToAlbumPhotoId   String?               @map("sent_to_album_photo_id")
  sentToAlbumVersion   Int?                  @map("sent_to_album_version")
  /// AI Culling's "AI Editing + Signature Album": when this photo was enrolled for automatic album
  /// sync (null = not enrolled). Each successfully saved render is then compressed to the album's
  /// preset and written into the photo's one album copy (`signature_album_photo.source_upload_id`),
  /// recorded in `sentToAlbumPhotoId` / `sentToAlbumVersion` once it is persisted.
  albumSyncAt          DateTime?             @map("album_sync_at")
  /// Why the last automatic album sync failed (cleared by the next one that succeeds); null when fine.
  albumSyncError       String?               @map("album_sync_error") @db.VarChar(500)
  createdByUserId      Int?                  @map("created_by_user_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  project              ImageSelectionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  upload               ImageSelectionUpload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  sentToPhotosUpload   ImageSelectionUpload? @relation("ImageSelectionEditSentToPhotos", fields: [sentToPhotosUploadId], references: [id], onDelete: SetNull)
  sentToAlbumPhoto     SignatureAlbumPhoto?  @relation("ImageSelectionEditSentToAlbum", fields: [sentToAlbumPhotoId], references: [id], onDelete: SetNull)
  createdByUser        User?                 @relation("ImageSelectionEditCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([createdByUserId])
  @@index([sentToPhotosUploadId])
  @@index([sentToAlbumPhotoId])
  @@map("image_selection_edit")
}

model ImageSelectionPhotoSelection {
  id                                String                          @id @default(cuid())
  imageSelectionUploadId            String                          @map("image_selection_upload_id")
  imageSelectionDeliverableConfigId String                          @map("image_selection_deliverable_config_id")
  selectedAt                        DateTime                        @default(now()) @map("selected_at")
  image                             ImageSelectionUpload            @relation(fields: [imageSelectionUploadId], references: [id], onDelete: Cascade)
  deliverableConfig                 ImageSelectionDeliverableConfig @relation(fields: [imageSelectionDeliverableConfigId], references: [id], onDelete: Cascade)

  @@unique([imageSelectionUploadId, imageSelectionDeliverableConfigId])
  @@index([imageSelectionDeliverableConfigId, selectedAt])
  @@map("image_selection_photo_selection")
}

/// The People filter in the client gallery (Image Selection → faces/). Phase 1: faces are detected
/// in the photos a project already holds, described as vectors, grouped into people, and each
/// person is remembered as the set of existing photo ids they appear in. Nothing is copied: the
/// gallery filters its own photos by these mappings, and the photo row stays the source of truth.
///
/// One row per photo that has been handed to the face worker, holding where its processing got to.
/// NOT_PROCESSED (queued, not started), PROCESSING, COMPLETED or FAILED. Absent for a photo the
/// worker was never asked about, which is how every photo from before this existed reads.
model ImageSelectionFaceScan {
  id          String                @id @default(cuid())
  projectId   String                @map("project_id")
  imageId     String                @unique @map("image_id")
  status      String                @default("NOT_PROCESSED") @db.VarChar(20)
  faceCount   Int                   @default(0) @map("face_count")
  attempts    Int                   @default(0)
  error       String?               @db.Text
  startedAt   DateTime?             @map("started_at")
  completedAt DateTime?             @map("completed_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  project     ImageSelectionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  image       ImageSelectionUpload  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("image_selection_face_scan")
}

/// A cluster of faces the worker believes are one person: "Person 3" in the gallery's People row.
/// Numbered by creation order on the way out, never named here — Phase 1 guesses no names.
model ImageSelectionFacePerson {
  id           String                      @id @default(cuid())
  projectId    String                      @map("project_id")
  /// Running mean of the member face vectors, base64 of unit-normalised little-endian float32.
  /// Compared in the worker only; never serialised to a browser.
  centroid     String                      @db.Text
  faceCount    Int                         @default(0) @map("face_count")
  /// The photo whose face stands for this person in the People row, and where in that frame it
  /// is (`{ x, y, w, h }` as fractions), so the circle is cut from the photo's existing thumbnail
  /// rather than from a stored crop. Null once that photo is deleted; the next best face steps in.
  coverImageId String?                     @map("cover_image_id")
  coverBox     Json?                       @map("cover_box")
  coverQuality Float                       @default(0) @map("cover_quality")
  /// Who this person is to the shoot, in the photographer's words (AI culling): PRIMARY, FAMILY,
  /// IMPORTANT or BACKGROUND. Null lets the photographs decide by how often they appear.
  role         String?                     @db.VarChar(30)
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  project      ImageSelectionProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coverImage   ImageSelectionUpload?       @relation("ImageSelectionFacePersonCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  mappings     ImageSelectionFaceMapping[]
  cullingSubjectOf ImageSelectionCullingResult[] @relation("CullingSubject")

  @@index([projectId, createdAt])
  @@index([coverImageId])
  @@map("image_selection_face_person")
}

/// "This person is in this photo" — the whole of what the People filter reads. One row per person
/// per photo; `confidence` is the face's similarity to the person's centroid when it joined (1 for
/// the face that started the person). The box and quality are kept so a person whose cover photo
/// is deleted can be given another without re-running the engine.
model ImageSelectionFaceMapping {
  id         String                   @id @default(cuid())
  projectId  String                   @map("project_id")
  personId   String                   @map("person_id")
  imageId    String                   @map("image_id")
  confidence Float
  box        Json
  quality    Float
  createdAt  DateTime                 @default(now()) @map("created_at")
  project    ImageSelectionProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person     ImageSelectionFacePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  image      ImageSelectionUpload     @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([personId, imageId], map: "image_selection_face_mapping_person_image_unique")
  @@index([projectId, imageId])
  @@index([imageId])
  @@map("image_selection_face_mapping")
}

model ImageSelectionUploadBatch {
  id              String                 @id @default(cuid())
  projectId       String                 @map("project_id")
  folderId        String?                @map("folder_id")
  totalFiles      Int                    @map("total_files")
  uploadedFiles   Int                    @default(0) @map("uploaded_files")
  compressedFiles Int                    @default(0) @map("compressed_files")
  failedFiles     Int                    @default(0) @map("failed_files")
  /// UPLOADING while files are still arriving, PROCESSING once they all have, then COMPLETED or
  /// COMPLETED_WITH_ERRORS when `compressedFiles + failedFiles` reaches `totalFiles`.
  ///
  /// ABANDONED is the fifth, and the only one no photograph puts it in: the total is what the
  /// browser said it was about to send, so a closed tab or a dropped connection leaves counters
  /// that can never add up and a batch that calls itself active for ever. `closeAbandonedBatches`
  /// in `modules/image-selection/uploads/batchRepository.js` closes those — quiet for fifteen
  /// minutes AND holding no upload still pending or processing, the second half being what keeps
  /// a batch waiting behind a backlog safe. Retrying reopens any of them at PROCESSING.
  status          String                 @default("UPLOADING") @db.VarChar(30)
  createdByUserId Int?                   @map("created_by_user_id")
  startedAt       DateTime               @default(now()) @map("started_at")
  completedAt     DateTime?              @map("completed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  project         ImageSelectionProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder          ImageSelectionFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploads         ImageSelectionUpload[]

  createdByUser User? @relation("ImageSelectionUploadBatchCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([folderId])
  @@index([createdAt])
  @@index([createdByUserId])
  @@map("image_selection_upload_batch")
}

/// A named place the studio keeps original photos — "STUDIO_NAS_MAIN", "ARCHIVE_HDD_2026". The
/// name is the durable identity photo records point at; where that storage is mounted on any
/// given workstation (Z:\Photography on one machine, Y:\StudioPhotos on another) is that
/// machine's own configuration and deliberately not stored here. Soft-deleted, because photo
/// rows keep referring to a root long after the studio retires it.
model ImageSelectionStorageRoot {
  id         String                 @id @default(cuid())
  name       String                 @unique @db.VarChar(100)
  notes      String?                @db.VarChar(500)
  /// Where the root is mounted — stored here rather than in the desktop's local settings, so the
  /// mapping survives reinstalls. The server itself never opens this path.
  mappedPath String?                @map("mapped_path") @db.VarChar(1024)
  deletedAt  DateTime?              @map("deleted_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  uploads    ImageSelectionUpload[]

  @@index([deletedAt])
  @@map("image_selection_storage_root")
}

/// Studio-wide Image Selection settings: one row, shared by every project, holding the values that
/// used to be hard-coded constants. Per-project answers stay on ImageSelectionProject — these are
/// only the ones that are the same everywhere. The id is fixed so there can never be a second row
/// to disagree with the first; the service upserts it and falls back to these defaults until a
/// Super Admin saves the form for the first time.
model ImageSelectionSettings {
  id                    String   @id @default("default") @db.VarChar(30)
  galleryValidityMonths Int      @default(6) @map("gallery_validity_months")
  defaultSelectionLimit Int      @default(50) @map("default_selection_limit")
  // The two server-side paths. Originals are read from under `originalStoragePath` and never
  // copied anywhere by the app; a selected original is copied into `selectedOutputPath` only when
  // staff ask for it. Both are resolved on the machine running this backend — a drive letter or a
  // UNC share — and every path the app touches must sit inside one of them.
  originalStoragePath   String?  @map("original_storage_path") @db.VarChar(500)
  selectedOutputPath    String?  @map("selected_output_path") @db.VarChar(500)
  // No *browser* download location is stored here. Where a browser saves a file is the folder the
  // user picked through its own folder picker, which only that browser can hold — a path string on
  // this row could name a folder but never grant permission to write it. That is the Target
  // Download Path, and it is the fallback for when `selectedOutputPath` is not configured.
  studioName            String   @default("Don't Blink Studios") @map("studio_name") @db.VarChar(191)
  /// What this system is called in the email that hands a new employee their username and password.
  /// The studio's own name for the thing they are being given access to; null falls back to the
  /// name the template ships with, so an unset field never reaches somebody as a blank.
  loginCredentialName   String?  @map("login_credential_name") @db.VarChar(120)
  galleryLogoUrl        String?  @map("gallery_logo_url") @db.VarChar(500)
  /// The Global Logo for the application's dark themes, uploaded beside the one above. The column
  /// above stays the light-theme mark and is what every white surface reads - a PDF, a quotation
  /// page, a client gallery, a document's frozen snapshot - so nothing printed can ever pick this
  /// up. Null means the dark themes wear the light mark, inverted by the top bar's own rule.
  galleryLogoDarkUrl    String?  @map("gallery_logo_dark_url") @db.VarChar(500)
  // The mark the browser tab shows, on every tab whatever its theme. One file, because a studio's
  // icon carries its own background - a white rounded square, say - and reads correctly on a light
  // strip and a dark one alike; asking for a pair was asking the same question twice. Null leaves
  // the bundled pair in /brand, which is per-theme because the shipped wordmark has no background
  // of its own. Held as a URL like the logo, and public for the same reason: a client's tab needs it.
  faviconUrl            String?  @map("favicon_url") @db.VarChar(500)
  /// The tab mark for a dark browser strip, uploaded beside the one above, which is the light
  /// strip's. Either alone serves both strips; null here means the light mark, or the bundled one.
  faviconDarkUrl        String?  @map("favicon_dark_url") @db.VarChar(500)
  // The pictures the login page turns through, as a JSON list of public image URLs in display
  // order. Null or empty means the page shows its plain slides.
  loginSlides           Json?    @map("login_slides")
  /// The studio's compression presets for uploads, one object per module:
  /// `{ imageSelection: { previewPreset, thumbnailPreset }, albumProofing: {...}, signatureAlbum: {...} }`,
  /// each key one of the preset names in `src/services/imagePresets.js`. Null, or a module left
  /// out, is that module's recommended default. The AI Feature keeps its pair on its own Event
  /// Default Settings `media` group. Read by `modules/image-selection/compression`; a change applies
  /// to future uploads only.
  compression           Json?    @map("compression")
  // The pictures the client sign-in page's film strip carries (Settings → Project Management →
  // Client page images), the same way: public image URLs in display order. Null or empty means
  // the strip shows its plain frames.
  clientLoginSlides     Json?    @map("client_login_slides")
  updatedByUserId       Int?     @map("updated_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("ImageSelectionSettingsUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  /// The studio's opt-in to its finalized culling runs being exported for training (off by default).
  cullingTrainingConsent         Boolean   @default(false) @map("culling_training_consent")
  /// When, and by whom, the consent last changed.
  cullingTrainingConsentAt       DateTime? @map("culling_training_consent_at")
  cullingTrainingConsentByUserId Int?      @map("culling_training_consent_by_user_id")
  cullingTrainingConsentByUser   User?     @relation("ImageSelectionSettingsCullingConsentBy", fields: [cullingTrainingConsentByUserId], references: [id], onDelete: SetNull, map: "image_selection_settings_culling_consent_by_user_id_fkey")

  @@index([updatedByUserId])
  @@index([cullingTrainingConsentByUserId], map: "image_selection_settings_culling_consent_by_user_id_idx")
  @@map("image_selection_settings")
}

/// One album under proofing, belonging to an existing Image Selection project (which supplies
/// every client/project detail — no master data is duplicated here). Its pages live as ordinary
/// ImageSelectionUpload rows registered by originalPath under `rootFolderId`'s folder subtree, so
/// import, sharp processing, progress and R2 previews are all the platform's own. `status` walks
/// the Album Proofing state machine and is moved only by the service — never free-typed. The
/// original album images are NEVER stored here or anywhere server-side: only paths and metadata.
/// `currentVersionId`/`approvedVersionId` are maintained columns, not circular foreign keys.
model AlbumProof {
  id                String                        @id @default(cuid())
  projectId         String                        @map("project_id")
  rootFolderId      String?                       @unique @map("root_folder_id")
  name              String                        @db.VarChar(191)
  albumType         String?                       @map("album_type") @db.VarChar(100)
  status            String                        @default("DRAFT") @db.VarChar(40)
  viewerMode        String                        @default("SPREAD") @map("viewer_mode") @db.VarChar(20)
  // Client correction rounds allowed; null means unlimited. `revisionsUsed` only ever grows —
  // granting an extra round raises the limit (audited), it never resets the count.
  revisionLimit     Int?                          @default(3) @map("revision_limit")
  revisionsUsed     Int                           @default(0) @map("revisions_used")
  proofExpiryDays   Int                           @default(30) @map("proof_expiry_days")
  currentVersionId  String?                       @map("current_version_id")
  approvedVersionId String?                       @map("approved_version_id")
  completedAt       DateTime?                     @map("completed_at")
  createdByUserId   Int?                          @map("created_by_user_id")
  archivedAt        DateTime?                     @map("archived_at")
  deletedAt         DateTime?                     @map("deleted_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  project           ImageSelectionProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootFolder        ImageSelectionFolder?         @relation(fields: [rootFolderId], references: [id], onDelete: SetNull)
  versions          AlbumProofVersion[]
  corrections       AlbumProofCorrection[]
  qcRounds          AlbumProofQcRound[]
  publications      AlbumProofClientPublication[]
  submissions       AlbumProofClientSubmission[]
  activities        AlbumProofActivity[]

  createdByUser User? @relation("AlbumProofCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, deletedAt])
  @@index([status, archivedAt])
  @@index([createdAt])
  @@index([createdByUserId])
  @@map("album_proof")
}

/// One immutable proofing round. DRAFT while pages are being assembled or revised; FROZEN the
/// moment it is sent to QC, from which point its page snapshots never change — the next round is
/// a new version. The unique (albumId, versionNumber) makes concurrent creation of "V2 twice"
/// impossible at the database, whatever the frontend sends.
model AlbumProofVersion {
  id              String                        @id @default(cuid())
  albumId         String                        @map("album_id")
  /// The CLIENT's version: V1, V2, V3. It goes up only when a client correction round is answered
  /// with a revised upload — never for a QC round, however many passes QC takes.
  versionNumber   Int                           @map("version_number")
  /// The QC pass inside that client version. Each revised upload during QC freezes its own
  /// immutable snapshot under the same `versionNumber`, so what QC reviewed on an earlier pass is
  /// still there to look at, while the version list the studio reads shows one card per client
  /// version. 1 on every row that predates this column, which is exactly what they were.
  iteration       Int                           @default(1)
  status          String                        @default("DRAFT") @db.VarChar(30)
  pageCount       Int                           @default(0) @map("page_count")
  changeSummary   String?                       @map("change_summary") @db.Text
  frozenAt        DateTime?                     @map("frozen_at")
  createdByUserId Int?                          @map("created_by_user_id")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  album           AlbumProof                    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  pages           AlbumProofVersionPage[]
  corrections     AlbumProofCorrection[]
  qcRounds        AlbumProofQcRound[]
  publications    AlbumProofClientPublication[]
  submissions     AlbumProofClientSubmission[]

  createdByUser User? @relation("AlbumProofVersionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([albumId, versionNumber, iteration])
  @@index([albumId, status])
  @@index([albumId, versionNumber])
  @@index([createdByUserId])
  @@map("album_proof_version")
}

/// One page/spread of a frozen version — a snapshot, never a live pointer. `originalPath` is the
/// ONLY representation of the original image (local drive/NAS); no bytes, no base64, ever.
/// `previewKey`/`thumbnailKey` are version-scoped R2 copies made at freeze time, so re-deriving a
/// page for the next version can never mutate what an earlier version showed. `uploadId` and
/// `folderId` are plain reference columns: history must outlive the live rows they point at.
model AlbumProofVersionPage {
  id                  String                 @id @default(cuid())
  versionId           String                 @map("version_id")
  uploadId            String?                @map("upload_id")
  folderId            String?                @map("folder_id")
  folderName          String?                @map("folder_name") @db.VarChar(191)
  pageNumber          Int                    @map("page_number")
  sortOrder           Int                    @map("sort_order")
  fileName            String                 @map("file_name") @db.VarChar(500)
  originalPath        String                 @map("original_path") @db.VarChar(1024)
  previewKey          String?                @map("preview_key") @db.VarChar(1024)
  thumbnailKey        String?                @map("thumbnail_key") @db.VarChar(1024)
  width               Int?
  height              Int?
  fileSize            BigInt?                @map("file_size")
  checksum            String?                @db.VarChar(64)
  // Marks the spreads this version actually changed, so QC and the client can review
  // "changed spreads only" instead of the whole album every round.
  changedFromPrevious Boolean                @default(false) @map("changed_from_previous")
  createdAt           DateTime               @default(now()) @map("created_at")
  version             AlbumProofVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  corrections         AlbumProofCorrection[]

  @@unique([versionId, pageNumber])
  @@index([versionId, sortOrder])
  @@map("album_proof_version_page")
}

/// A correction pinned to an exact spot on one page of one version — QC's or the client's. The
/// coordinates are normalized 0..1 so the pin lands identically at any screen size. A correction
/// belongs forever to the version it was raised on: the next version references its resolution,
/// it never migrates. Client corrections lock (`lockedAt`) when their round is submitted.
model AlbumProofCorrection {
  id               String                @id @default(cuid())
  albumId          String                @map("album_id")
  versionId        String                @map("version_id")
  versionPageId    String                @map("version_page_id")
  source           String                @default("QC") @db.VarChar(10)
  xNormalized      Float                 @map("x_normalized")
  yNormalized      Float                 @map("y_normalized")
  radiusNormalized Float?                @map("radius_normalized")
  // A painted correction: strokes of normalized points, as JSON. Null for a pin or a circle.
  pathNormalized   String?               @map("path_normalized") @db.Text
  comment          String                @db.Text
  status           String                @default("OPEN") @db.VarChar(20)
  submissionId     String?               @map("submission_id")
  publicationId    String?               @map("publication_id")
  createdByUserId  Int?                  @map("created_by_user_id")
  createdByLabel   String?               @map("created_by_label") @db.VarChar(191)
  resolvedByUserId Int?                  @map("resolved_by_user_id")
  resolvedAt       DateTime?             @map("resolved_at")
  resolutionNote   String?               @map("resolution_note") @db.Text
  lockedAt         DateTime?             @map("locked_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  album            AlbumProof            @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version          AlbumProofVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionPage      AlbumProofVersionPage @relation(fields: [versionPageId], references: [id], onDelete: Cascade)

  createdByUser  User? @relation("AlbumProofCorrectionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedByUser User? @relation("AlbumProofCorrectionResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([albumId, status])
  @@index([versionId, source, status])
  @@index([versionPageId])
  @@index([createdByUserId])
  @@index([resolvedByUserId])
  @@map("album_proof_correction")
}

/// One QC review round of one version: sent, then decided — APPROVED or CHANGES_REQUESTED, with
/// the scope QC reviewed (the full album or only the spreads that changed). Unique per
/// (versionId, roundNumber) so a double-clicked resubmit cannot file the same round twice.
model AlbumProofQcRound {
  id                String            @id @default(cuid())
  albumId           String            @map("album_id")
  versionId         String            @map("version_id")
  roundNumber       Int               @map("round_number")
  scope             String            @default("FULL") @db.VarChar(20)
  submittedByUserId Int?              @map("submitted_by_user_id")
  submittedAt       DateTime          @default(now()) @map("submitted_at")
  decision          String?           @db.VarChar(30)
  decidedByUserId   Int?              @map("decided_by_user_id")
  decidedAt         DateTime?         @map("decided_at")
  note              String?           @db.Text
  album             AlbumProof        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version           AlbumProofVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  decidedByUser   User? @relation("AlbumProofQcRoundDecidedByUser", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  submittedByUser User? @relation("AlbumProofQcRoundSubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@unique([versionId, roundNumber])
  @@index([albumId, submittedAt])
  @@index([decidedByUserId])
  @@index([submittedByUserId])
  @@map("album_proof_qc_round")
}

/// One secure client proof of one version: the gallery publication's exact credential mechanics —
/// random token stored as SHA-256 hash (AES-GCM cipher so staff can re-copy the link), bcrypt PIN
/// (cipher for Show PIN), expiry and revocation. `revisionNumber` says which client round this
/// proof belongs to. Sequential database ids never appear in the public URL.
model AlbumProofClientPublication {
  id                String            @id @default(cuid())
  albumId           String            @map("album_id")
  versionId         String            @map("version_id")
  revisionNumber    Int               @map("revision_number")
  /// The short public identifier in the client's URL (/p/AB7KX2). Random, never derived from an
  /// id, and never rotated once issued. Null on links published before this column existed: those
  /// keep resolving by their original 43-character token, so nothing already shared stops working.
  shortCode         String?           @unique @map("short_code") @db.VarChar(8)
  tokenHash         String            @unique @map("token_hash") @db.Char(64)
  tokenCipher       String            @map("token_cipher") @db.Text
  pinHash           String            @map("pin_hash") @db.VarChar(191)
  pinCipher         String            @map("pin_cipher") @db.Text
  expiresAt         DateTime?         @map("expires_at")
  revokedAt         DateTime?         @map("revoked_at")
  publishedByUserId Int?              @map("published_by_user_id")
  publishedAt       DateTime          @default(now()) @map("published_at")
  lastAccessAt      DateTime?         @map("last_access_at")
  accessCount       Int               @default(0) @map("access_count")
  album             AlbumProof        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version           AlbumProofVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  publishedByUser User? @relation("AlbumProofClientPublicationPublishedByUser", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@index([albumId, publishedAt])
  @@index([publishedByUserId])
  @@map("album_proof_client_publication")
}

/// What the client sent back for one version: exactly one CORRECTIONS batch (consuming one
/// revision round) and/or one APPROVAL — the unique (versionId, type) makes a double-click
/// physically unable to consume two rounds or approve twice. Immutable once written.
model AlbumProofClientSubmission {
  id                   String            @id @default(cuid())
  albumId              String            @map("album_id")
  versionId            String            @map("version_id")
  publicationId        String?           @map("publication_id")
  type                 String            @db.VarChar(20)
  revisionNumber       Int?              @map("revision_number")
  correctionCount      Int               @default(0) @map("correction_count")
  approvedConfirmation String?           @map("approved_confirmation") @db.Text
  ipAddress            String?           @map("ip_address") @db.VarChar(64)
  userAgent            String?           @map("user_agent") @db.VarChar(500)
  submittedAt          DateTime          @default(now()) @map("submitted_at")
  album                AlbumProof        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  version              AlbumProofVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, type])
  @@index([albumId, submittedAt])
  @@map("album_proof_client_submission")
}

/// The album's audit timeline: who did what, to which version/page, when. Version, page and
/// correction ids are plain columns so history outlives its subjects; secrets and PINs are never
/// written here by construction.
model AlbumProofActivity {
  id           String     @id @default(cuid())
  albumId      String     @map("album_id")
  versionId    String?    @map("version_id")
  pageId       String?    @map("page_id")
  correctionId String?    @map("correction_id")
  actorType    String     @default("STAFF") @map("actor_type") @db.VarChar(20)
  actorUserId  Int?       @map("actor_user_id")
  actorLabel   String?    @map("actor_label") @db.VarChar(191)
  event        String     @db.VarChar(50)
  detail       String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  album        AlbumProof @relation(fields: [albumId], references: [id], onDelete: Cascade)

  actorUser User? @relation("AlbumProofActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([albumId, createdAt])
  @@index([createdAt])
  @@index([actorUserId])
  @@map("album_proof_activity")
}

/// The Signature Album: Image Selection → Project → Signature Album tab (signature-album/).
///
/// One per project, and a *consumer* of the project's existing photos: every picture it shows is
/// a reference to an `ImageSelectionUpload` row, the same R2 preview the client gallery serves,
/// and the original stays wherever the studio keeps it. Nothing here is Photo Selection state -
/// the album carries its own status, short code, PIN, expiry and client permissions, so publishing
/// or expiring an album changes nothing about the selection gallery or the project.
///
/// `status` is written as DRAFT or PUBLISHED, and EXPIRED once an expired album has been taken
/// down; READY (publishable but not yet published) is derived by the service and never stored.
/// Design columns that are null fall back to the theme's own answer, so a theme change never has
/// to rewrite them.
model SignatureAlbum {
  id                String                  @id @default(cuid())
  projectId         String                  @unique @map("project_id")
  title             String                  @db.VarChar(191)
  subtitle          String?                 @db.VarChar(191)
  eventDate         DateTime?               @map("event_date")
  coverImageId      String?                 @map("cover_image_id")
  coverAlignment    String                  @default("CENTER") @map("cover_alignment") @db.VarChar(10)
  theme             String                  @default("EDITORIAL") @db.VarChar(20)
  coverStyle        String                  @default("FULL_SCREEN") @map("cover_style") @db.VarChar(20)
  layoutStyle       String                  @default("CURATED") @map("layout_style") @db.VarChar(20)
  backgroundColor   String?                 @map("background_color") @db.VarChar(9)
  textColor         String?                 @map("text_color") @db.VarChar(9)
  accentColor       String?                 @map("accent_color") @db.VarChar(9)
  headingFont       String?                 @map("heading_font") @db.VarChar(60)
  bodyFont          String?                 @map("body_font") @db.VarChar(60)
  imageSpacing      String                  @default("STANDARD") @map("image_spacing") @db.VarChar(12)
  /// Which Global Logo the album's pages draw: AUTO picks the dark-ground or light-ground mark from
  /// the album's effective background; DARK and LIGHT pin it. See `LOGO_VARIANTS`.
  logoVariant       String                  @default("AUTO") @map("logo_variant") @db.VarChar(8)
  status            String                  @default("DRAFT") @db.VarChar(12)
  publishedAt       DateTime?               @map("published_at")
  publishedByUserId Int?                    @map("published_by_user_id")
  expiresAt         DateTime?               @map("expires_at")
  /// The public name in the client URL (/a/X7K9P2): random, never an id, and never rotated once
  /// issued - "Regenerate link" mints a new token AND a new code, and the old URL stops answering.
  shortCode         String?                 @unique @map("short_code") @db.VarChar(8)
  tokenHash         String?                 @unique @map("token_hash") @db.Char(64)
  tokenCipher       String?                 @map("token_cipher") @db.Text
  requirePin        Boolean                 @default(true) @map("require_pin")
  pinHash           String?                 @map("pin_hash") @db.VarChar(191)
  pinCipher         String?                 @map("pin_cipher") @db.Text
  /// The client may download the whole album as one ZIP of its web previews (never originals).
  allowDownload     Boolean                 @default(true) @map("allow_download")
  allowShare        Boolean                 @default(true) @map("allow_share")
  endingMessage     String?                 @map("ending_message") @db.Text
  /// How the cover photo sits in its frame: FIT shows the whole photograph, FILL fills the frame
  /// and crops around the focal point (`coverFocalX` / `coverFocalY`, 0-100, where the photo is
  /// pinned) at `coverZoom` (1-2). Presentation only - the photo and its previews are never
  /// touched - and null means the default the frame always had: FILL, centred, no zoom.
  coverDisplayMode  String?                 @map("cover_display_mode") @db.VarChar(8)
  coverFocalX       Int?                    @map("cover_focal_x")
  coverFocalY       Int?                    @map("cover_focal_y")
  coverZoom         Float?                  @map("cover_zoom")
  /// The studio name and logo as they stood when the album was published, so a published album
  /// keeps its branding if Settings changes later. Null until the first publish.
  brandingSnapshot   Json?                     @map("branding_snapshot")
  createdByUserId    Int?                      @map("created_by_user_id")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  project            ImageSelectionProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coverImage         ImageSelectionUpload?     @relation("SignatureAlbumCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  /// The cover when it is one of the album's own uploads - which is every cover chosen now. At most
  /// one of this and `coverImageId` is set; `coverImageId` stays only on albums whose cover was a
  /// project photo, and keeps drawing until the studio chooses another.
  coverAlbumPhotoId  String?                   @map("cover_album_photo_id")
  coverAlbumPhoto    SignatureAlbumPhoto?      @relation("SignatureAlbumCoverPhoto", fields: [coverAlbumPhotoId], references: [id], onDelete: SetNull)
  chapters           SignatureAlbumChapter[]
  items              SignatureAlbumItem[]
  photos             SignatureAlbumPhoto[]

  @@index([status])
  @@index([coverImageId])
  @@index([coverAlbumPhotoId])
  @@map("signature_album")
}

/// One chapter of the story - Engagement, Haldi, The Wedding. Its photos are the items below it;
/// its cover is one of the project's photos, set null when that photo goes. `layoutStyle` null
/// means "the album's".
model SignatureAlbumChapter {
  id               String                @id @default(cuid())
  albumId          String                @map("album_id")
  name             String                @db.VarChar(191)
  subtitle         String?               @db.VarChar(255)
  coverImageId     String?               @map("cover_image_id")
  layoutStyle      String?               @map("layout_style") @db.VarChar(20)
  /// How the chapter's cover photo sits in its band, the same four values the album's cover
  /// carries: FIT shows the whole photograph, FILL fills the band and crops around the focal point
  /// (`coverFocalX` / `coverFocalY`, 0-100) at `coverZoom` (1-2). Presentation only - the upload
  /// row and its previews are never written - and null is what the band always drew: FILL,
  /// centred, 1×. Cleared when the cover photo is replaced.
  coverDisplayMode String?               @map("cover_display_mode") @db.VarChar(8)
  coverFocalX      Int?                  @map("cover_focal_x")
  coverFocalY      Int?                  @map("cover_focal_y")
  coverZoom        Float?                @map("cover_zoom")
  sortOrder        Int                   @default(0) @map("sort_order")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  album            SignatureAlbum        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  coverImage       ImageSelectionUpload? @relation("SignatureAlbumChapterCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  items            SignatureAlbumItem[]

  @@index([albumId, sortOrder])
  @@index([coverImageId])
  @@map("signature_album_chapter")
}

/// "This photo is in this chapter, at this position": a reference and nothing more. One row per
/// photo per album, so a photo cannot appear twice; `isHighlight` puts it in the Favourite Moments
/// section too, in `highlightOrder`. Cascades from the photo, the chapter and the album, so a
/// photo deleted through the existing Image Selection paths simply leaves the album.
model SignatureAlbumItem {
  id             String                @id @default(cuid())
  albumId        String                @map("album_id")
  chapterId      String                @map("chapter_id")
  /// What the item shows: one of the project's photos (`imageId`), or a photo uploaded to this
  /// album alone (`albumPhotoId`). Exactly one is set - the service writes no other shape, and
  /// MySQL refuses a CHECK on a column whose foreign key cascades.
  imageId        String?               @map("image_id")
  albumPhotoId   String?               @map("album_photo_id")
  sortOrder      Int                   @default(0) @map("sort_order")
  isHighlight    Boolean               @default(false) @map("is_highlight")
  highlightOrder Int?                  @map("highlight_order")
  /// How this photo sits in a designed frame, for this album item alone: FIT shows the whole
  /// photograph, FILL fills the frame and crops around the focal point (`focalX` / `focalY`,
  /// 0-100) at `zoom` (1-2). Presentation metadata only - the upload row, its previews and the
  /// original are never written - and null means what the frame always did: FILL, centred, 1×.
  displayMode    String?               @map("display_mode") @db.VarChar(8)
  focalX         Int?                  @map("focal_x")
  focalY         Int?                  @map("focal_y")
  zoom           Float?
  createdAt      DateTime              @default(now()) @map("created_at")
  album          SignatureAlbum        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  chapter        SignatureAlbumChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  image          ImageSelectionUpload? @relation(fields: [imageId], references: [id], onDelete: Cascade)
  albumPhoto     SignatureAlbumPhoto?  @relation(fields: [albumPhotoId], references: [id], onDelete: Cascade)

  @@unique([albumId, imageId], map: "signature_album_item_album_image_unique")
  @@unique([albumId, albumPhotoId], map: "signature_album_item_album_photo_unique")
  @@index([chapterId, sortOrder])
  @@index([albumId, isHighlight, highlightOrder])
  @@index([imageId])
  @@index([albumPhotoId])
  @@map("signature_album_item")
}

/// A photo uploaded to one Signature Album directly, rather than taken from the project's photos.
///
/// The album's own library: it never becomes an `image_selection_upload`, so Photo Selection, the
/// client gallery, the People filter and every project count are untouched by it. Only the two
/// web derivatives the browser built are stored, in R2 under the album's own prefix - the original
/// never leaves the studio machine, exactly as for a project photo. Deleting the photo removes it
/// from every chapter it was placed in (the items cascade).
model SignatureAlbumPhoto {
  id           String               @id @default(cuid())
  albumId      String               @map("album_id")
  fileName     String               @map("file_name") @db.VarChar(255)
  /// The original's type and size as the browser reported them; the original itself is not held.
  mimeType     String               @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt               @map("size_bytes")
  width        Int?
  height       Int?
  thumbnailKey String               @map("thumbnail_key") @db.VarChar(1024)
  previewKey   String               @map("preview_key") @db.VarChar(1024)
  previewBytes Int                  @map("preview_bytes")
  /// The project photo this one was made from, when the desktop compressed a culling Keep's
  /// original with the album's own preset (AI Culling -> Send Photos). One copy per photo per
  /// album: a retried send answers with the copy already there. Null for a photo uploaded to the
  /// album directly or an AI edit; set to null if the project photo is deleted later.
  sourceUploadId String?            @map("source_upload_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  album        SignatureAlbum       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  sourceUpload ImageSelectionUpload? @relation("SignatureAlbumPhotoSource", fields: [sourceUploadId], references: [id], onDelete: SetNull)
  items        SignatureAlbumItem[]
  coverOf      SignatureAlbum[]     @relation("SignatureAlbumCoverPhoto")
  // The AI edits whose current version this photo is (ai-editing/): a link, so a deleted album
  // photo no longer counts as "already sent".
  editsSentHere ImageSelectionEdit[] @relation("ImageSelectionEditSentToAlbum")

  @@unique([albumId, sourceUploadId], map: "signature_album_photo_album_id_source_upload_id_key")
  @@index([albumId, createdAt])
  @@index([sourceUploadId])
  @@map("signature_album_photo")
}

/// Studio-wide Signature Album defaults: one row, fixed id, read when an album is *created* and
/// never pushed onto an album already configured. Settings → Image Selection → Signature Album.
/// A null text column means "use the shipped default", which the service supplies.
model SignatureAlbumSettings {
  id                       String   @id @default("default") @db.VarChar(30)
  defaultTheme             String   @default("EDITORIAL") @map("default_theme") @db.VarChar(20)
  defaultLayoutStyle       String   @default("CURATED") @map("default_layout_style") @db.VarChar(20)
  defaultCoverStyle        String   @default("FULL_SCREEN") @map("default_cover_style") @db.VarChar(20)
  defaultExpiryMonths      Int      @default(6) @map("default_expiry_months")
  useGlobalLogo            Boolean  @default(true) @map("use_global_logo")
  showStudioName           Boolean  @default(true) @map("show_studio_name")
  showStudioLogo           Boolean  @default(true) @map("show_studio_logo")
  showBrandingFooter       Boolean  @default(true) @map("show_branding_footer")
  footerText               String?  @map("footer_text") @db.VarChar(255)
  allowDownloadDefault     Boolean  @default(true) @map("allow_download_default")
  allowShareDefault        Boolean  @default(true) @map("allow_share_default")
  showImageNumbers         Boolean  @default(false) @map("show_image_numbers")
  requirePin               Boolean  @default(true) @map("require_pin")
  pinLength                Int      @default(4) @map("pin_length")
  autoUnpublishAfterExpiry Boolean  @default(true) @map("auto_unpublish_after_expiry")
  defaultBackground        String   @default("WHITE") @map("default_background") @db.VarChar(12)
  imageSpacing             String   @default("STANDARD") @map("image_spacing") @db.VarChar(12)
  initialPhotosLoaded      Int      @default(30) @map("initial_photos_loaded")
  lazyLoadBatch            Int      @default(30) @map("lazy_load_batch")
  preloadNextImages        Boolean  @default(true) @map("preload_next_images")
  defaultEndingMessage     String?  @map("default_ending_message") @db.Text
  endingShowLogo           Boolean  @default(true) @map("ending_show_logo")
  endingShowWebsite        Boolean  @default(true) @map("ending_show_website")
  endingShowInstagram      Boolean  @default(true) @map("ending_show_instagram")
  websiteUrl               String?  @map("website_url") @db.VarChar(255)
  instagramUrl             String?  @map("instagram_url") @db.VarChar(255)
  updatedByUserId          Int?     @map("updated_by_user_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("signature_album_settings")
}

/// One AI culling run over a project's processed photos: the staff-facing triage that happens
/// before the client ever sees a gallery. A session is the unit of everything — progress, results,
/// groups, finalization — so a re-run is a new session and an old one keeps its answers. Statuses:
/// QUEUED → ANALYZING → GROUPING → RANKING → REVIEW_READY → FINALIZED, or FAILED / CANCELLED.
/// Nothing here ever touches the photos themselves; a REJECT only hides a photo from Photo
/// Selection after the photographer finalizes, and only for sessions that reach FINALIZED.
model ImageSelectionCullingSession {
  id                    String                        @id @default(cuid())
  projectId             String                        @map("project_id")
  // The shoot this run covers: a root folder and its subtree. Null means the whole project —
  // which is every session from before shoot-scoped culling, so nothing old changes meaning.
  // Cascade: a deleted shoot folder takes its culling runs with it; a session must never
  // silently widen to the whole project by losing its scope.
  folderId              String?                       @map("folder_id")
  status                String                        @default("QUEUED") @db.VarChar(30)
  // How opinionated the engine is: ASSISTED scores without deciding, BALANCED and STRICT assign
  // KEEP / MAYBE / REJECT, TARGET_COUNT aims near `targetCount`. Phase 1 stores the choice; the
  // behaviours arrive with the analysis phases.
  mode                  String                        @default("ASSISTED") @db.VarChar(30)
  targetCount           Int?                          @map("target_count")
  totalImages           Int                           @default(0) @map("total_images")
  processedImages       Int                           @default(0) @map("processed_images")
  keepCount             Int                           @default(0) @map("keep_count")
  maybeCount            Int                           @default(0) @map("maybe_count")
  rejectCount           Int                           @default(0) @map("reject_count")
  currentStage          String?                       @map("current_stage") @db.VarChar(30)
  progressPercent       Int                           @default(0) @map("progress_percent")
  // Which engine and scoring profile produced the results, so a photo analyzed by an old engine
  // can be told apart from one the current engine has confirmed — re-runs skip unchanged work.
  engineVersion         String?                       @map("engine_version") @db.VarChar(30)
  scoringProfileVersion String?                       @map("scoring_profile_version") @db.VarChar(30)
  // Paid provider calls (Rekognition) made for this session, for cost visibility.
  providerRequestCount  Int                           @default(0) @map("provider_request_count")
  // Where the technical signals come from: SERVER (the worker reads previews) or DESKTOP (the
  // workstation analyzes the originals where they live and posts numbers; the server fills any
  // gap from previews, then groups and ranks). A DESKTOP session waits in QUEUED, unqueued,
  // until the desktop hands it over with `run`.
  analysisSource        String                        @default("SERVER") @map("analysis_source") @db.VarChar(20)
  // A run that began with the import: created while its photos were still arriving, it waits
  // unqueued (the desktop analyzes each photo as its preview lands) and is handed to the server's
  // stages only once every photo of its scope has landed - the photographer never starts it.
  awaitsUploads         Boolean                       @default(false) @map("awaits_uploads")
  // The engines that produced this session's signals ({ technical, preprocess, faces }), so a
  // later model change never silently reinterprets an old run.
  engineVersions        Json?                         @map("engine_versions")
  // Phase 8: the photographer's learned preferences this run used, snapshotted at start.
  preferenceProfile     Json?                         @map("preference_profile")
  error                 String?                       @db.Text
  startedAt             DateTime?                     @map("started_at")
  // Stamped once the worker holds a result row for every photo the run covers. A retried job
  // past this point never seeds again, so a photo uploaded after the run began is reported as
  // "not in this session" rather than silently joining it mid-flight.
  seededAt              DateTime?                     @map("seeded_at")
  completedAt           DateTime?                     @map("completed_at")
  finalizedAt           DateTime?                     @map("finalized_at")
  createdByUserId       Int?                          @map("created_by_user_id")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")
  project               ImageSelectionProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy             User?                         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  folder                ImageSelectionFolder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  results               ImageSelectionCullingResult[]
  groups                ImageSelectionCullingGroup[]
  rejectedUploads       ImageSelectionUpload[]        @relation("CullingRejectedBy")

  decisionEvents        ImageSelectionCullingDecisionEvent[]
  shadowResults         ImageSelectionCullingShadowResult[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
  // Named by hand — the generated name would blow MySQL's 64-character identifier limit.
  @@index([projectId, folderId, createdAt], map: "image_selection_culling_session_scope_created_idx")
  @@index([createdByUserId], map: "image_selection_culling_session_created_by_user_id_idx")
  @@map("image_selection_culling_session")
}

/// Per-photo AI verdict inside one culling session. The upload row stays the master photo record —
/// this only annotates it. Scores are null until their analysis stage has run. Three decisions are
/// kept apart on purpose: what the AI recommended, what the photographer said, and the effective
/// answer (photographer always wins) — so an override is visible, reversible, and can later train
/// a preference model. Deleting a photo deletes its results; deleting a session deletes the run.
model ImageSelectionCullingResult {
  id                String                        @id @default(cuid())
  sessionId         String                        @map("session_id")
  uploadId          String                        @map("upload_id")
  blurScore         Float?                        @map("blur_score")
  exposureScore     Float?                        @map("exposure_score")
  technicalScore    Float?                        @map("technical_score")
  faceCount         Int?                          @map("face_count")
  faceQualityScore  Float?                        @map("face_quality_score")
  eyesOpenScore     Float?                        @map("eyes_open_score")
  expressionScore   Float?                        @map("expression_score")
  similarityScore   Float?                        @map("similarity_score")
  aestheticScore    Float?                        @map("aesthetic_score")
  uniquenessScore   Float?                        @map("uniqueness_score")
  finalScore        Float?                        @map("final_score")
  duplicateGroupId  String?                       @map("duplicate_group_id")
  burstGroupId      String?                       @map("burst_group_id")
  isGroupBest       Boolean                       @default(false) @map("is_group_best")
  // KEEP / MAYBE / REJECT. `aiDecision` is the recommendation, `userDecision` the photographer's
  // override, `effectiveDecision` the resolved answer — PENDING until either side has spoken.
  aiDecision        String?                       @map("ai_decision") @db.VarChar(20)
  userDecision      String?                       @map("user_decision") @db.VarChar(20)
  effectiveDecision String                        @default("PENDING") @map("effective_decision") @db.VarChar(20)
  confidence        Float?
  // Machine-readable explanations — SEVERE_BLUR, BEST_IN_BURST, PRIMARY_SUBJECT_BLINK — the UI
  // renders as badges. A JSON array of short code strings, never free text.
  reasonCodes       Json?                         @map("reason_codes")
  // 64-bit DCT perceptual hash of the preview, as 16 hex characters — the cheap first pass the
  // duplicate/burst grouping stage screens candidates with before anything heavier runs.
  perceptualHash    String?                       @map("perceptual_hash") @db.VarChar(16)
  // Similarity v2: the layout-aware signature beside the hash (analysis/structure.js), and where
  // the frame ranks inside its duplicate and burst groups (1 = the keeper).
  structureSignature String?                      @map("structure_signature") @db.VarChar(64)
  duplicateRank     Int?                          @map("duplicate_rank")
  burstRank         Int?                          @map("burst_rank")
  // Culling V2: the visually similar series this frame belongs to (the same set-up or pose, from
  // the CLIP image embedding) and its place in it - relative, never a reason to reject.
  similarGroupId    String?                       @map("similar_group_id")
  similarRank       Int?                          @map("similar_rank")
  // Phase 6: the scene engine's reading (scene/scene_engine.py) and the composition maths. The
  // aesthetic score lands in `aestheticScore` above, a column the first culling migration created.
  sceneLabel        String?                       @map("scene_label") @db.VarChar(30)
  sceneConfidence   Float?                        @map("scene_confidence")
  compositionScore  Float?                        @map("composition_score")
  // Culling V2. `qualityScore` is the photo's own quality - no group rank, no photographer taste -
  // so an alternate of a better frame is never shown as a worse photograph; `finalScore` stays
  // the score the decision is made from (quality + taste + group). `preferenceAdjustment` is the
  // photographer's taste applied to this run (±8), kept so a later re-derivation reuses it.
  qualityScore         Float?                     @map("quality_score")
  preferenceAdjustment Float?                     @map("preference_adjustment")
  // Face V2 (the local face engine's landmarks and expression model): the sharpness inside the
  // main face, how frontal it is (0-100), and the expression it shows ("happy", "neutral", ...).
  faceSharpnessScore   Float?                     @map("face_sharpness_score")
  headPoseScore        Float?                     @map("head_pose_score")
  expressionLabel      String?                    @map("expression_label") @db.VarChar(20)
  analyzedAt        DateTime?                     @map("analyzed_at")
  // The face stage's own stamp and which provider produced it ("aws-rekognition@1"). Kept apart
  // from `analyzedAt` (the technical stage) so each stage resumes independently, and so a later
  // session can reuse a photo's face signals instead of paying the provider again.
  faceAnalyzedAt    DateTime?                     @map("face_analyzed_at")
  faceProvider      String?                       @map("face_provider") @db.VarChar(30)
  // Which side stamped the technical signals: SERVER or DESKTOP. Null on rows from before.
  analysisSource    String?                       @map("analysis_source") @db.VarChar(20)
  // The subject stage: how many of the People filter's persons are in the frame, which one the
  // frame is about, and a 0-100 presence-and-importance score the ranking nudges by. The face
  // stage's per-face details (boxes, eye claims) are kept so a blink can be weighed by who blinked.
  subjectScore      Float?                        @map("subject_score")
  peopleCount       Int?                          @map("people_count")
  subjectPersonId   String?                       @map("subject_person_id")
  faceDetails       Json?                         @map("face_details")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  session           ImageSelectionCullingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  upload            ImageSelectionUpload          @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  subjectPerson     ImageSelectionFacePerson?     @relation("CullingSubject", fields: [subjectPersonId], references: [id], onDelete: SetNull)
  duplicateGroup    ImageSelectionCullingGroup?   @relation("CullingDuplicateGroup", fields: [duplicateGroupId], references: [id], onDelete: SetNull)
  burstGroup        ImageSelectionCullingGroup?   @relation("CullingBurstGroup", fields: [burstGroupId], references: [id], onDelete: SetNull)
  similarGroup      ImageSelectionCullingGroup?   @relation("CullingSimilarGroup", fields: [similarGroupId], references: [id], onDelete: SetNull)
  feedback          ImageSelectionCullingFeedback[]

  decisionEvents    ImageSelectionCullingDecisionEvent[]
  shadowResults     ImageSelectionCullingShadowResult[]

  @@unique([sessionId, uploadId], map: "image_selection_culling_result_session_upload_unique")
  // Named by hand: the generated name lands exactly on MySQL's 64-character identifier limit.
  @@index([sessionId, effectiveDecision], map: "image_selection_culling_result_session_decision_idx")
  @@index([uploadId])
  @@index([duplicateGroupId])
  @@index([burstGroupId])
  @@index([similarGroupId])
  @@index([sessionId, perceptualHash])
  @@index([sessionId, sceneLabel])
  // The cross-session face cache asks "has this photo been face-analyzed by this provider
  // before?" once per photo per new run. Named by hand — the generated name would blow MySQL's
  // 64-character identifier limit.
  @@index([uploadId, faceProvider, faceAnalyzedAt], map: "image_selection_culling_result_face_cache_idx")
  @@index([subjectPersonId])
  @@map("image_selection_culling_result")
}

/// One photographer's switch for learned culling preferences, and the point they last asked culling
/// to forget: overrides before `resetAt` are not learned from (analysis/preferences.js).
model ImageSelectionCullingPreference {
  id        String    @id @default(cuid())
  userId    Int       @unique @map("user_id")
  enabled   Boolean   @default(true)
  resetAt   DateTime? @map("reset_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("image_selection_culling_preference")
}

/// What the culling scene engine said about one photo, per engine version — the cross-session
/// cache: a photo is embedded once and every later run reads it. `embedding` is the unit CLIP
/// ViT-B/32 image embedding quantized to int8, base64 (684 characters); `aesthetic_raw` is the
/// LAION head's own scale. Goes with the photo.
model ImageSelectionUploadScene {
  id              String               @id @default(cuid())
  uploadId        String               @map("upload_id")
  engineVersion   String               @map("engine_version") @db.VarChar(80)
  sceneLabel      String?              @map("scene_label") @db.VarChar(30)
  sceneConfidence Float?               @map("scene_confidence")
  accidental      Boolean              @default(false)
  aestheticRaw    Float?               @map("aesthetic_raw")
  embedding       String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")
  upload          ImageSelectionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, engineVersion])
  @@map("image_selection_upload_scene")
}

/// A cluster the engine found inside one session: DUPLICATE (near-identical frames), BURST
/// (rapid sequence of one moment) or SIMILAR (same scene, meaningful variation). Members point
/// here from their result rows; regrouping deletes groups without touching scores (SetNull).
model ImageSelectionCullingGroup {
  id                     String                        @id @default(cuid())
  sessionId              String                        @map("session_id")
  type                   String                        @db.VarChar(20)
  representativeUploadId String?                       @map("representative_upload_id")
  memberCount            Int                           @default(0) @map("member_count")
  groupScore             Float?                        @map("group_score")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  session                ImageSelectionCullingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  duplicateResults       ImageSelectionCullingResult[] @relation("CullingDuplicateGroup")
  burstResults           ImageSelectionCullingResult[] @relation("CullingBurstGroup")
  similarResults         ImageSelectionCullingResult[] @relation("CullingSimilarGroup")

  decisionEvents ImageSelectionCullingDecisionEvent[]

  @@index([sessionId, type])
  @@map("image_selection_culling_group")
}

/// One photographer override of an AI decision, kept as history rather than state — the state
/// lives on the result row. This is the raw material for a later photographer-preference model:
/// every row is "the AI said X, this person said Y".
model ImageSelectionCullingFeedback {
  id               String                      @id @default(cuid())
  resultId         String                      @map("result_id")
  userId           Int?                        @map("user_id")
  previousDecision String?                     @map("previous_decision") @db.VarChar(20)
  newDecision      String                      @map("new_decision") @db.VarChar(20)
  createdAt        DateTime                    @default(now()) @map("created_at")
  result           ImageSelectionCullingResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user             User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resultId, createdAt])
  @@index([userId, createdAt], map: "image_selection_culling_feedback_user_id_created_at_idx")
  @@map("image_selection_culling_feedback")
}

model ProjectShoot {
  id                                String                                    @id @default(cuid())
  shootId                           String                                    @unique @map("shoot_id") @db.VarChar(30)
  /// The Shoot ID this shoot carried in the studio's old spreadsheet ("DBS-SID-2519"), kept only so
  /// Pre Production → Import can find it again on a second upload. `shootId` is the app's own.
  sheetShootId                      String?                                   @unique @map("sheet_shoot_id") @db.VarChar(30)
  projectId                         String                                    @map("project_id")
  /// The day the shoot runs, or null when it has not been fixed yet.
  ///
  /// A shoot is regularly booked before its date is - a wedding sold in January whose reception
  /// date the family has not settled - and the form asks "Shoot Date Known" before it asks for
  /// one. Null means "not scheduled yet", which is not the same as a date nobody can read: the
  /// Image Selection gate treats an undated shoot as one that has not happened, so its folders
  /// stay closed until a date is put on it.
  dateCreated                       DateTime?                                 @map("date_created")
  /// Where the shoot sits in its project's Shoot List when somebody has dragged it there - the forms
  /// that edit a project's shoots (Bookings & Converted, Create / Edit / Start Project) read it. Null
  /// until the list is first arranged by hand, and on a shoot added after, which then follows the
  /// arranged ones by date. Only the list's order: every other screen keeps listing shoots by date.
  sortOrder                         Int?                                      @map("sort_order")
  /// Several shoots ticked in Add Shoot are one shoot named for all of them - "Haldi + Mehandi" -
  /// so the column holds 191 characters rather than 100: five of the studio's longest names and
  /// their separators come to 107, and the dialog refuses anything past this in words.
  shoot                             String                                    @db.VarChar(191)
  /// Empty where the studio has not said yet - an old sheet imported by Pre Production → Import often
  /// does not - and filled in on the shoot form, which asks for it, when it is known.
  shootPlace                        String?                                   @map("shoot_place") @db.VarChar(191)
  shootType                         String?                                   @default("Studio / In-House") @map("shoot_type") @db.VarChar(30)
  shootTypes                        Json?                                     @map("shoot_types")
  isMainEvent                       Boolean                                   @default(false) @map("is_main_event")
  district                          String?                                   @db.VarChar(191)
  state                             String?                                   @db.VarChar(191)
  /// A "Haldi + Mehandi" shoot held at several places: one { shoot, shootPlace, district, state } per
  /// name, in the name's order, with the three columns above joined from them. Null is one place.
  /// Written only through `services/shootLocations.js`.
  shootLocations                    Json?                                     @map("shoot_locations")
  eventStartTime                    String?                                   @map("event_start_time") @db.VarChar(5)
  eventEndTime                      String?                                   @map("event_end_time") @db.VarChar(5)
  sessionTiming                     String?                                   @map("session_timing") @db.VarChar(20)
  sessionTimings                    Json?                                     @map("session_timings")
  sessionDurationHours              Int?                                      @map("session_duration_hours")
  sessionDurationMinutes            Int?                                      @map("session_duration_minutes")
  foodTakenCareBy                   String                                    @default("Studio") @map("food_taken_care_by") @db.VarChar(20)
  accommodation                     String                                    @default("Studio") @db.VarChar(20)
  travel                            String                                    @default("Studio") @db.VarChar(20)
  preference                        String?                                   @db.VarChar(20)
  /// Sale Extras: this row as the finalized quotation booked it - its scope fields (see
  /// `sale-extras/rules.js` SCOPE_FIELDS) - or null when it was added afterwards, which makes it an
  /// extra. Filled for every row that existed before 20261101160000.
  saleBaseline                      Json?                                     @map("sale_baseline")
  deletedAt                         DateTime?                                 @map("deleted_at")
  createdAt                         DateTime                                  @default(now()) @map("created_at")
  updatedAt                         DateTime                                  @updatedAt @map("updated_at")
  project                           SalesProject                              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables                      ProjectShootDeliverable[]
  imageSelectionRootFolder          ImageSelectionFolder?
  postProductionAllocations         ProjectPostProductionAllocation[]
  activities                        ProjectActivity[]
  postProductionWorkflowAllocations ProjectPostProductionWorkflowAllocation[]
  clientStorageRecords              ClientStorage[]
  cashEntries                       CashEntry[]
  paymentRequestExpenses            PaymentRequestExpense[]
  extraQuotations                   ProjectExtraQuotation[]
  saleExtras                        ProjectSaleExtra[]
  preProduction                     ProjectPreProduction?
  production                        ProjectProduction?
  feedback                          ProjectFeedback[]

  /// Payments whose due date follows this shoot.
  duePayments ProjectPaymentSchedule[] @relation("ProjectPaymentScheduleDueShoot")

  changeRequests       ProjectChangeRequest[] @relation("ProjectChangeRequestShoot")
  changeRequestCreated ProjectChangeRequest[] @relation("ProjectChangeRequestCreatedShoot")

  /// The shoot crew notice sweeps a three-day window of this column every minute (`shoot-crew-notice/due.js`).
  @@index([dateCreated])
  @@index([projectId, deletedAt])
  @@index([createdAt])
  @@map("project_shoot")
}

/// Project Management → Feedback: one person's review of one shoot.
///
/// Linked to the shoot by its key, never by the `SH-…` code typed on screen, so a shoot renamed or
/// re-coded keeps its feedback. The project is reached through the shoot rather than copied here: a
/// feedback row is part of the shoot it reviews, and is seen exactly when that project is
/// (`projectAccessWhere`), so it carries no branch of its own.
model ProjectFeedback {
  id              String       @id @default(cuid())
  /// The Feedback ID the studio reads and searches by: the project's (`SalesProject.feedbackCode`) and
  /// this feedback's version, DBS-FB-00001-01. Given when the feedback is saved.
  feedbackCode    String       @unique @map("feedback_code") @db.VarChar(30)
  /// Which of the project's feedbacks this is, in the ID's last two digits: 1 for the New Project
  /// Feedback always, then the next after the highest given - the Overall Feedback last, as it opens
  /// only once every shoot's feedback is given.
  feedbackVersion Int          @map("feedback_version")
  /// The project it is about.
  projectId       String       @map("project_id")
  /// Which of the project's feedbacks it is: NEW_PROJECT (asked for as soon as the project is created
  /// in Bookings & Converted) or SHOOT_COMPLETION (one per shoot, once Production has completed it).
  /// PRODUCTION_COMPLETION and PROJECT_COMPLETED were asked for once and are only read now. The list
  /// and its labels live in the feedback service. One per project per stage per shoot, held by the
  /// unique key - and, since a key does not compare a missing shoot, by the save locking the project.
  stage           String       @default("NEW_PROJECT") @db.VarChar(40)
  /// The shoot a Shoot Completion Feedback is about; null for every other stage.
  shootId         String?      @map("shoot_id")
  /// One of Excellent, Good, Average, Poor - the list lives in the feedback module's service.
  review          String       @db.VarChar(20)
  /// What the reviewer wrote. A Production Completion Feedback has none of its own - it is written
  /// per area, in `areas` - so it is null there.
  feedback        String?      @db.Text
  /// Production Completion Feedback's Referral Details: somebody the client recommends, both optional.
  referralName    String?      @map("referral_name") @db.VarChar(150)
  /// As the shared phone field writes it: "+91 9876543210".
  referralMobile  String?      @map("referral_mobile") @db.VarChar(25)
  /// Project Completed Feedback's Overall Experience: Excellent, Good, Average or Poor.
  overallExperience String?    @map("overall_experience") @db.VarChar(20)
  /// Project Completed Feedback's Suggestion, optional.
  suggestion      String?      @db.Text
  /// Where the feedback has got to: Yet to be done, Issues, Issues sorted, Completed or Rejected -
  /// the list lives in the feedback module's service. Set from the review when the feedback is given
  /// (Excellent and Good are Completed, Average and Poor are Issues); older rows read Yet to be done.
  status          String       @default("Yet to be done") @db.VarChar(20)
  /// Who wrote it. Kept when the login is removed, as "no longer on the system" rather than lost.
  createdByUserId Int?         @map("created_by_user_id")
  /// Why a feedback under Issues was moved to Issues sorted or Rejected - required for Rejected,
  /// optional for Issues sorted. Null while it is still under Issues, or where none was given.
  issueRemarks    String?      @map("issue_remarks") @db.Text
  /// Who moved it on from Issues, and when. Kept when the login is removed.
  issueResolvedByUserId Int?   @map("issue_resolved_by_user_id")
  issueResolvedAt DateTime?    @map("issue_resolved_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  project         SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot           ProjectShoot? @relation(fields: [shootId], references: [id], onDelete: Cascade)
  createdByUser   User?        @relation("ProjectFeedbackCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  issueResolvedByUser User?    @relation("ProjectFeedbackIssueResolvedByUser", fields: [issueResolvedByUserId], references: [id], onDelete: SetNull)
  areas           ProjectFeedbackArea[]
  employees       ProjectFeedbackEmployee[]
  issues          ProjectFeedbackIssue[]

  @@unique([projectId, stage, shootId])
  @@unique([projectId, feedbackVersion])
  @@index([shootId])
  @@index([createdByUserId])
  @@index([issueResolvedByUserId])
  @@index([createdAt])
  @@map("project_feedback")
}

/// One area of the work a feedback rates, with its own rating and words: SALES, PRE_PRODUCTION and
/// PRODUCTION on a Production Completion Feedback, POST_PRODUCTION on a Project Completed Feedback (the
/// list is the feedback service's).
model ProjectFeedbackArea {
  id              String          @id @default(cuid())
  feedbackId      String          @map("feedback_id")
  area            String          @db.VarChar(20)
  /// One of Excellent, Good, Average, Poor.
  review          String          @db.VarChar(20)
  feedback        String          @db.Text
  projectFeedback ProjectFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, area])
  @@map("project_feedback_area")
}

/// One Average or Poor review in a feedback, given to somebody to answer: `reviewKey` names which
/// review (REVIEW for a New Project Feedback's one; SALES, PRE_PRODUCTION, PRODUCTION; POST_PRODUCTION,
/// OVERALL_EXPERIENCE - the feedback service's list), and the work is an HRM task (`taskId`), whose
/// assignee answers it Issues sorted (SORTED) or Rejected (REJECTED), with a remark. Who holds it is
/// the task's - a reassigned task takes the issue with it. The feedback leaves Issues once every issue
/// is answered.
model ProjectFeedbackIssue {
  id               Int             @id @default(autoincrement())
  feedbackId       String          @map("feedback_id")
  reviewKey        String          @map("review_key") @db.VarChar(30)
  /// Average or Poor.
  review           String          @db.VarChar(20)
  taskId           Int             @unique @map("task_id")
  /// OPEN, SORTED or REJECTED.
  status           String          @default("OPEN") @db.VarChar(20)
  remarks          String?         @db.Text
  answeredByUserId Int?            @map("answered_by_user_id")
  answeredAt       DateTime?       @map("answered_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  projectFeedback  ProjectFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// A feedback task is never deleted (the Tasks module refuses it), so nothing may take it away.
  task             HrmTask         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  answeredByUser   User?           @relation("ProjectFeedbackIssueAnsweredBy", fields: [answeredByUserId], references: [id], onDelete: SetNull)

  @@unique([feedbackId, reviewKey])
  @@index([answeredByUserId])
  @@map("project_feedback_issue")
}

/// An employee a Production Completion Feedback names: APPRECIATED, or NOT_SATISFIED - never both -
/// chosen from the people who worked on the project in Sales, Pre Production and Production.
model ProjectFeedbackEmployee {
  id              Int             @id @default(autoincrement())
  feedbackId      String          @map("feedback_id")
  employeeId      Int             @map("employee_id")
  kind            String          @db.VarChar(20)
  projectFeedback ProjectFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  employee        Employee        @relation("ProjectFeedbackEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, employeeId])
  @@index([employeeId])
  @@map("project_feedback_employee")
}

/// The pre production coordinator's own record of a shoot.
///
/// One row per `ProjectShoot`, raised automatically the moment a started project has a Pre
/// Production Coordinator, so the work reaches whoever was named without anybody creating it by
/// hand. Everything the studio already knows — the client, the branch, the coordinators, the shoot
/// and its date — is read back through `shoot` and `project` rather than copied here, so this row
/// can never disagree with the sale. What it holds is only what pre production finds out
/// afterwards: where the event actually is, when the crew leaves, and how the chasing is going.
///
/// The two event clock times are deliberately NOT here — they are `ProjectShoot.eventStartTime`
/// and `.eventEndTime`, which have always existed and were never written by anything. They are the
/// shoot's own timing, wanted by Production too, and pre production is simply the stage that
/// finally knows them.
model ProjectPreProduction {
  id                              String    @id @default(cuid())
  shootId                         String    @unique @map("shoot_id")
  projectId                       String    @map("project_id")
  locationAddress                 String?   @map("location_address") @db.Text
  locationLink                    String?   @map("location_link") @db.VarChar(2048)
  /// A shoot held at several places (`ProjectShoot.shootLocations`) has a venue per name: `{ shoot,
  /// locationAddress, locationLink }` in the name's order, with the two columns above holding them
  /// labelled one per line. Null is one place. Written only through `services/shootLocations.js`.
  locations                       Json?     @map("locations")
  reportingTime                   String?   @map("reporting_time") @db.VarChar(5)
  /// Deprecated: the Studio Start Date and Time moved to the Production Manager's plan
  /// (`ProjectProduction.studioStartDate`). Kept for the shoots whose production is not raised yet,
  /// whose answer is carried over once when it is (`ensureProjectProduction`).
  studioStartDate                 DateTime? @map("studio_start_date")
  studioStartTime                 String?   @map("studio_start_time") @db.VarChar(5)
  scheduleRemarks                 String?   @map("schedule_remarks") @db.Text
  /// Whether this shoot is being shot to a concept. Asked as a plain yes/no, and only when the
  /// answer is yes does it ask what the concept is: the reference the crew shoots against and the
  /// notes that go with it. Both are pre production's own — the coordinator agrees the concept with
  /// the client and records it here.
  conceptsNeeded                  Boolean   @default(false) @map("concepts_needed")
  /// Superseded by `concepts` below, which holds as many as the shoot needs. Carried into it by
  /// migration `20260926130000_add_pre_production_concepts_list`; kept so the historic values
  /// survive, and nothing reads or writes them any more.
  conceptReference                String?   @map("concept_reference") @db.VarChar(2048)
  conceptRemarks                  String?   @map("concept_remarks") @db.Text
  /// Whether this shoot needs travel and accommodation arranged at all. A different question from
  /// `ProjectShoot.travel` / `.accommodation`, which say who *pays* for it (Studio or Client).
  travelAccommodationNeeded       Boolean   @default(false) @map("travel_accommodation_needed")
  /// DEPRECATED — travel lives on the production plan now (`ProjectProduction.travelMode` and its
  /// detail). These four are only read once, by `ensureProjectProduction`, to carry an existing
  /// answer over to the plan; nothing writes them. Dropped by the same follow-up migration as the
  /// deprecated production coordinator columns below.
  travelMode                      String?   @map("travel_mode") @db.VarChar(30)
  travelModeOther                 String?   @map("travel_mode_other") @db.VarChar(191)
  travelVehicleAssetId            Int?      @map("travel_vehicle_asset_id")
  travelVehicleName               String?   @map("travel_vehicle_name") @db.VarChar(191)
  accommodationAddress            String?   @map("accommodation_address") @db.Text
  accommodationLink               String?   @map("accommodation_link") @db.VarChar(2048)
  accommodationRemarks            String?   @map("accommodation_remarks") @db.Text
  /// DEPRECATED — chasing the client is done once for the project, not once per shoot, so these
  /// moved to `ProjectPreProductionFollowup`. Kept so the historic values survive; nothing reads
  /// them. `followupRemarks` below went the same way.
  lastFollowupDate                DateTime? @map("last_followup_date")
  nextFollowupDate                DateTime? @map("next_followup_date")
  /// Pre production's own progress, which is not the project's. `SalesProject.projectStatus` is the
  /// whole-project lifecycle the Production and Post Production boards filter on; overloading it
  /// here would move a project between those boards every time a coordinator ticked something off.
  completionStatus                String    @default("Not Started") @map("completion_status") @db.VarChar(40)
  /// The shoot's pre production status set by hand: WCR (waiting for the client's reply - asked with a
  /// next follow-up), HOLD or REJECTED, each with its remarks. Null is automatic: Yet to Start, Work in
  /// Progress or Planned, worked out from the details on every read. A HOLD here shows across the
  /// project as "On Hold (Pre-Production)".
  shootStatus                     String?   @map("shoot_status") @db.VarChar(20)
  shootStatusRemarks              String?   @map("shoot_status_remarks") @db.Text
  shootStatusAt                   DateTime? @map("shoot_status_at")
  shootStatusByUserId             Int?      @map("shoot_status_by_user_id")
  /// DEPRECATED — the Production Coordinator lives on `ProjectProduction` now. These two are only
  /// read once, by `ensureProjectProduction`, to carry an existing answer over as the plan's starting
  /// coordinator; nothing writes them. Dropped by a follow-up migration once every eligible shoot
  /// has its production row.
  productionCoordinator           String?   @map("production_coordinator") @db.VarChar(191)
  productionCoordinatorEmployeeId Int?      @map("production_coordinator_employee_id")

  // ---- Vertical checklists ----
  // Each vertical's pre production sheet asks its own questions on top of the shared ones, and the
  // superset lives here as nullable columns: the row is still one per shoot, and a Dum Dum shoot
  // simply leaves the Qua Qua-only answers empty. A progress column holds "Pending"/"Completed";
  // null means the question has not been taken up at all. A Boolean column is a plain yes/no
  // question instead, drawn as the radio pair `yesNoField` builds, and left null the same way.
  // "Received The Storage" and "Storage ID" are NOT columns anywhere — they are read from the
  // Client Storage record the project already raises, so the disc's whereabouts has one source of
  // truth.
  // Shared by Dum Dum and Qua Qua:
  introCallRemarks         String?                       @map("intro_call_remarks") @db.Text
  gettingDressesImages     Boolean?                      @map("getting_dresses_images")
  productionMaster         String?                       @map("production_master") @db.VarChar(20)
  productionTeamAllocation String?                       @map("production_team_allocation") @db.VarChar(20)
  shootCompletionMessage   Boolean                       @default(false) @map("shoot_completion_message")
  followupRemarks          String?                       @map("followup_remarks") @db.Text
  // Dum Dum only — a wedding has two sides, so the intro call is asked once per side:
  groomAddress             String?                       @map("groom_address") @db.Text
  brideAddress             String?                       @map("bride_address") @db.Text
  introCallGroom           String?                       @map("intro_call_groom") @db.VarChar(20)
  introCallBride           String?                       @map("intro_call_bride") @db.VarChar(20)
  eventScheduleMeeting     Boolean                       @default(false) @map("event_schedule_meeting")
  meetingDate              DateTime?                     @map("meeting_date")
  meetingTime              String?                       @map("meeting_time") @db.VarChar(5)
  meetingLink              String?                       @map("meeting_link") @db.VarChar(2048)
  invitationSoftCopy       Boolean                       @default(false) @map("invitation_soft_copy")
  invitationLink           String?                       @map("invitation_link") @db.VarChar(2048)
  gettingDecorImages       Boolean?                      @map("getting_decor_images")
  siteVisit                Boolean                       @default(false) @map("site_visit")
  teamReachedMessage       Boolean                       @default(false) @map("team_reached_message")
  postWeddingGift          Boolean?                      @map("post_wedding_gift")
  // Qua Qua only — one client, one intro call:
  introCall                String?                       @map("intro_call") @db.VarChar(20)
  googleReview             Boolean                       @default(false) @map("google_review")
  /// The shoot's cover picture, optional: compressed on the server and stored in R2, this is its link.
  coverImageUrl            String?                       @map("cover_image_url") @db.Text
  /// When the team sent this shoot's details to the client to fill in the Beam Craft app (null: not
  /// sent), and which answers the client has saved there - each one locks once saved.
  clientFormSentAt         DateTime?                     @map("client_form_sent_at")
  clientAnswered           Json?                         @map("client_answered")
  clientImages             ProjectPreProductionImage[]
  /// An indoor (Studio / In-House) shoot's branch: the studio it happens at, asked in place of its location.
  shootBranchId            Int?                          @map("shoot_branch_id")
  updatedByUserId          Int?                          @map("updated_by_user_id")
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")
  shoot                    ProjectShoot                  @relation(fields: [shootId], references: [id], onDelete: Cascade)
  travelVehicleAsset       Asset?                        @relation("ProjectPreProductionTravelVehicle", fields: [travelVehicleAssetId], references: [id], onDelete: SetNull)
  project                  SalesProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedByUser            User?                         @relation("ProjectPreProductionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  shootStatusByUser        User?                         @relation("ProjectPreProductionShootStatusBy", fields: [shootStatusByUserId], references: [id], onDelete: SetNull)
  shootBranch              Branch?                       @relation("ProjectPreProductionShootBranch", fields: [shootBranchId], references: [id], onDelete: SetNull)
  concepts                 ProjectPreProductionConcept[]

  @@index([shootBranchId])
  @@index([projectId])
  @@index([completionStatus])
  @@index([nextFollowupDate])
  @@index([productionCoordinatorEmployeeId])
  @@index([shootStatusByUserId])
  @@map("project_pre_production")
}

/// One concept agreed with the client for a shoot: the reference the crew shoots against and the
/// notes that go with it. A shoot can have several, added one by one; `position` keeps them in the
/// order they were entered. Always read as "this shoot's concepts", never on their own.
/// A file the client added to a shoot's pre production in the app - the invitation, the dresses or the
/// decor (`kind`), several of each: photos (compressed, like the cover) and documents (PDF, Word...).
model ProjectPreProductionImage {
  id              String               @id @default(cuid())
  preProductionId String               @map("pre_production_id")
  kind            String               @db.VarChar(20)
  url             String               @db.Text
  /// The file as the client named it, and what it is (a photo, a PDF, a Word document...).
  fileName        String?              @map("file_name") @db.VarChar(255)
  mimeType        String?              @map("mime_type") @db.VarChar(120)
  createdAt       DateTime             @default(now()) @map("created_at")
  preProduction   ProjectPreProduction @relation(fields: [preProductionId], references: [id], onDelete: Cascade)

  @@index([preProductionId, kind])
  @@map("project_pre_production_image")
}

model ProjectPreProductionConcept {
  id              String               @id @default(cuid())
  preProductionId String               @map("pre_production_id")
  reference       String?              @db.VarChar(2048)
  remarks         String?              @db.Text
  position        Int                  @default(0)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  preProduction   ProjectPreProduction @relation(fields: [preProductionId], references: [id], onDelete: Cascade)

  @@index([preProductionId, position])
  @@map("project_pre_production_concept")
}

/// Production's record of one shoot: the Production Manager's plan and the Production
/// Coordinator's steps on the day.
///
/// One row per `ProjectShoot`, raised by `production/service.js` the moment a started project has
/// a Production Manager - in the same two places pre production rows are raised. The project, the
/// shoot and the manager are read back through the links; only what production itself decides or
/// records lives here. `currentStep` walks STARTED_FROM_STUDIO … PHOTO_COPY and then DONE, one step
/// at a time (`production/steps.js`); each step's completion time has its own column, and who
/// completed it is the STEP_COMPLETED line in `activities`.
model ProjectProduction {
  id                              String    @id @default(cuid())
  shootId                         String    @unique @map("shoot_id")
  salesProjectId                  String    @map("sales_project_id")
  /// The project's branch, copied when the row is raised and kept in step on every project save
  /// (`ensureProjectProduction`), so `dataScope` narrows this table by branch without a join.
  branchId                        Int?      @map("branch_id")
  productionCoordinatorEmployeeId Int?      @map("production_coordinator_employee_id")
  /// The coordinator's name as the studio's old sheet gave it, kept only where it names nobody working
  /// here now - somebody who has left. Written only when no employee is linked; a linked coordinator
  /// is read from `productionCoordinatorEmployee`, so this is never a second copy of a live name.
  productionCoordinatorName       String?   @map("production_coordinator_name") @db.VarChar(191)
  /// How the crew travels, one of `TRAVEL_MODES` in production/travel.js. Each mode asks its own
  /// detail: Other spells it out in `travelModeOther`, Own / Car give `vehicleNumberPlate`, Office
  /// Vehicle names the vehicle in Asset Management; Bus / Train / Flight carry TICKET files instead.
  /// A save clears the detail the mode does not use. Carried over once from pre production's
  /// answer when the row is raised (`ensureProjectProduction`).
  travelMode                      String?   @map("travel_mode") @db.VarChar(30)
  travelModeOther                 String?   @map("travel_mode_other") @db.VarChar(191)
  /// Bus, Train or Flight only: YET_TO_TAKE, TAKEN (the tickets are attached) or ON_THE_FLY (bought on
  /// the way). Null on any other mode, and on a plan saved before it was asked.
  ticketStatus                    String?   @map("ticket_status") @db.VarChar(20)
  /// Office Vehicle only: an asset in a vehicle category (`VEHICLE_CATEGORY_NAMES`). No name copy -
  /// the asset's name and code are read through the link.
  travelVehicleAssetId            Int?      @map("travel_vehicle_asset_id")
  /// Own / Car only: trimmed and upper-cased, no fixed format.
  vehicleNumberPlate              String?   @map("vehicle_number_plate") @db.VarChar(20)
  /// When the crew leaves the studio for the shoot: a day and an HH:MM time. Outdoor shoots only - an
  /// indoor one never leaves. Moved here from pre production's form; carried over once from its
  /// answer when the row is raised (`ensureProjectProduction`).
  studioStartDate                 DateTime? @map("studio_start_date")
  studioStartTime                 String?   @map("studio_start_time") @db.VarChar(5)
  remarks                         String?   @db.Text
  planSubmittedAt                 DateTime? @map("plan_submitted_at")
  planSubmittedByUserId           Int?      @map("plan_submitted_by_user_id")
  currentStep                     String    @default("STARTED_FROM_STUDIO") @map("current_step") @db.VarChar(30)
  startedFromStudioAt             DateTime? @map("started_from_studio_at")
  reachedShootPlaceAt             DateTime? @map("reached_shoot_place_at")
  pineappleMeetingAt              DateTime? @map("pineapple_meeting_at")
  shootStartedAt                  DateTime? @map("shoot_started_at")
  happeningNowAt                  DateTime? @map("happening_now_at")
  happyClientsAt                  DateTime? @map("happy_clients_at")
  /// When the shoot status was set to Completed, which is what finishes the Shoot status step.
  shootStatusAt                   DateTime? @map("shoot_status_at")
  /// The trip back: when the team left the venue, after the shoot status was set to Completed.
  startedFromVenueAt              DateTime? @map("started_from_venue_at")
  reachedStudioAt                 DateTime? @map("reached_studio_at")
  photoCopyAt                     DateTime? @map("photo_copy_at")
  /// Optional remarks on the steps that ask nothing else; Pineapple meeting's are required.
  startedFromStudioRemarks        String?   @map("started_from_studio_remarks") @db.Text
  reachedShootPlaceRemarks        String?   @map("reached_shoot_place_remarks") @db.Text
  pineappleRemarks                String?   @map("pineapple_remarks") @db.Text
  shootStartedRemarks             String?   @map("shoot_started_remarks") @db.Text
  happeningNowRemarks             String?   @map("happening_now_remarks") @db.Text
  happyClientsRemarks             String?   @map("happy_clients_remarks") @db.Text
  startedFromVenueRemarks         String?   @map("started_from_venue_remarks") @db.Text
  reachedStudioRemarks            String?   @map("reached_studio_remarks") @db.Text
  /// PAUSED, HOLD, REJECT or COMPLETED; null until first set.
  shootStatus                     String?   @map("shoot_status") @db.VarChar(20)
  shootStatusRemarks              String?   @map("shoot_status_remarks") @db.Text
  /// The plan's own status set by hand - HOLD or REJECTED, with its remarks - apart from the shoot day's
  /// (`shootStatus`, set on the Shoot status step). Null is automatic: Yet to Start, WIP or Planned from
  /// the plan. A plan on HOLD shows across the project as "On Hold (Production)".
  planStatus                      String?   @map("plan_status") @db.VarChar(20)
  planStatusRemarks               String?   @map("plan_status_remarks") @db.Text
  planStatusAt                    DateTime? @map("plan_status_at")
  planStatusByUserId              Int?      @map("plan_status_by_user_id")
  /// WCR's next follow-up with the client - when the plan was set to WCR (waiting for the client's
  /// reply), the date to chase them by. NULL for every other status.
  planFollowupDate                DateTime? @map("plan_followup_date")
  footageUrl                      String?   @map("footage_url") @db.VarChar(2048)
  footageBackupByEmployeeId       Int?      @map("footage_backup_by_employee_id")
  footageRemarks                  String?   @map("footage_remarks") @db.Text
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  shoot                         ProjectShoot                      @relation(fields: [shootId], references: [id], onDelete: Cascade)
  salesProject                  SalesProject                      @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)
  branch                        Branch?                           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  productionCoordinatorEmployee Employee?                         @relation("ProjectProductionCoordinator", fields: [productionCoordinatorEmployeeId], references: [id], onDelete: SetNull)
  footageBackupByEmployee       Employee?                         @relation("ProjectProductionFootageBackup", fields: [footageBackupByEmployeeId], references: [id], onDelete: SetNull)
  planSubmittedByUser           User?                             @relation("ProjectProductionPlanSubmittedBy", fields: [planSubmittedByUserId], references: [id], onDelete: SetNull)
  planStatusByUser              User?                             @relation("ProjectProductionPlanStatusBy", fields: [planStatusByUserId], references: [id], onDelete: SetNull)
  travelVehicleAsset            Asset?                            @relation("ProjectProductionTravelVehicle", fields: [travelVehicleAssetId], references: [id], onDelete: SetNull)
  teamMembers                   ProjectProductionTeamMember[]
  serviceCrew                   ProjectProductionServiceCrew[]
  crewNotices                   ProjectShootCrewNotice[]
  vendorNotices                 ProjectShootVendorNotice[]
  handovers                     EmployeeHandover[]
  footage                       ProjectProductionFootage[]
  files                         ProjectProductionFile[]
  activities                    ProjectProductionActivity[]
  messages                      ProjectProductionMessage[]

  whatsappActivities            WhatsAppActivity[]

  @@index([salesProjectId])
  @@index([branchId])
  @@index([productionCoordinatorEmployeeId])
  @@index([footageBackupByEmployeeId])
  @@index([planSubmittedByUserId])
  @@index([planStatusByUserId])
  @@index([travelVehicleAssetId])
  @@index([currentStep])
  @@map("project_production")
}

/// The production team named on a shoot's plan. Replaced whole on every plan save.
model ProjectProductionTeamMember {
  id           String   @id @default(cuid())
  productionId String   @map("production_id")
  /// A team member is an employee or an external vendor (shown as "EXT - name"), never both - or, for
  /// somebody who has left, a name alone (`employeeName`, with neither linked), from the old sheet.
  employeeId   Int?     @map("employee_id")
  employeeName String?  @map("employee_name") @db.VarChar(191)
  vendorId     Int?     @map("vendor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  production ProjectProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  employee   Employee?         @relation("ProjectProductionTeamMemberEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  vendor     Vendor?           @relation("ProjectProductionTeamMemberVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([productionId, employeeId])
  @@unique([productionId, vendorId])
  @@index([employeeId])
  @@index([vendorId])
  @@map("project_production_team_member")
}

/// Who works each service of a shoot. One row per service and role: the service's own person
/// (`LEAD`), who also takes a camera from Asset Management's "Cameras" category, and on a candid
/// service (its name contains "Candid") `ASSISTANT_1` and `ASSISTANT_2`, who take no camera. Keyed
/// by the service definition rather than the shoot's allocation row, because Edit Project replaces
/// those rows on every save and the assignments must outlive that.
/// Photo copy, per service of the shoot: where its footage went, who backed it up, how many files, how
/// big, the first and last file names - all required - and optional remarks, written once when the Photo copy
/// step completes. `serviceDefinitionId` is null only for a shoot with no services booked (one row for
/// the whole shoot); a service definition deleted later leaves its row, unnamed. Shoots that finished
/// Photo copy before this table keep their single answer on `project_production.footage_*`.
model ProjectProductionFootage {
  id                   String   @id @default(cuid())
  productionId         String   @map("production_id")
  serviceDefinitionId  String?  @map("service_definition_id")
  /// Every answer is nullable because File in can be saved part way (Mark as pending): the row holds
  /// the service's answers as they stand, and what has not been filled in yet is null rather than an
  /// empty string. Completing the step still wants all of them (`execution.photoCopyRows`).
  footageUrl           String?  @map("footage_url") @db.VarChar(2048)
  backedUpByEmployeeId Int?     @map("backed_up_by_employee_id")
  /// The backup person's name from the old sheet, only where no employee is linked (they have left).
  backedUpByName       String?  @map("backed_up_by_name") @db.VarChar(191)
  fileCount            Int?     @map("file_count")
  /// As typed ("128 GB"): free text by the studio's choice.
  size                 String?  @db.VarChar(50)
  firstFileName        String?  @map("first_file_name") @db.VarChar(255)
  lastFileName         String?  @map("last_file_name") @db.VarChar(255)
  remarks              String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  production         ProjectProduction         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  serviceDefinition  ProjectServiceDefinition? @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  backedUpByEmployee Employee?                 @relation("ProjectProductionFootageBackedBy", fields: [backedUpByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([productionId, serviceDefinitionId])
  @@index([serviceDefinitionId])
  @@index([backedUpByEmployeeId])
  @@map("project_production_footage")
}

model ProjectProductionServiceCrew {
  id                  String    @id @default(cuid())
  productionId        String    @map("production_id")
  serviceDefinitionId String    @map("service_definition_id")
  /// LEAD, ASSISTANT_1 or ASSISTANT_2.
  role                String    @db.VarChar(20)
  /// The person is an employee or an external vendor (shown as "EXT - name"), never both.
  employeeId          Int?      @map("employee_id")
  vendorId            Int?      @map("vendor_id")
  /// Where a **vendor** on this service stands: WAITING until they confirm the shoot, CONFIRMED once
  /// they have. Null for an employee, who is asked for a camera instead. A service whose person is a
  /// vendor still waiting is not planned (`planCompleteness`).
  vendorStatus        String?   @map("vendor_status") @db.VarChar(20)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  production        ProjectProduction        @relation(fields: [productionId], references: [id], onDelete: Cascade)
  serviceDefinition ProjectServiceDefinition @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)
  employee          Employee?                @relation("ProjectProductionServiceCrewEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  vendor            Vendor?                  @relation("ProjectProductionServiceCrewVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  /// The cameras this seat takes - a service's own person may carry more than one. Each is a row of
  /// `ProjectProductionServiceCrewCamera`, so a camera is a link and never a list in a column.
  cameras           ProjectProductionServiceCrewCamera[]
  handovers         EmployeeHandover[]

  @@unique([productionId, serviceDefinitionId, role])
  @@index([serviceDefinitionId])
  @@index([employeeId])
  @@index([vendorId])
  @@map("project_production_service_crew")
}

/// One camera on one seat of a service's crew. A seat may take several - a photographer carrying two
/// bodies - and the pair is unique, so the same camera cannot be added to a seat twice. A camera
/// still goes to only one service of a shoot, which `crewRefusal` holds to across the whole
/// selection; other shoots may use it.
model ProjectProductionServiceCrewCamera {
  id            Int      @id @default(autoincrement())
  crewId        String   @map("crew_id")
  cameraAssetId Int      @map("camera_asset_id")
  createdAt     DateTime @default(now()) @map("created_at")

  crew        ProjectProductionServiceCrew @relation(fields: [crewId], references: [id], onDelete: Cascade, map: "service_crew_camera_crew_id_fkey")
  cameraAsset Asset                        @relation("ProjectProductionServiceCrewCamera", fields: [cameraAssetId], references: [id], onDelete: Cascade, map: "service_crew_camera_camera_asset_id_fkey")

  // Named, because the name Prisma would derive from this table and these two columns is 66
  // characters and MySQL takes 64.
  @@unique([crewId, cameraAssetId], map: "service_crew_camera_crew_id_camera_asset_id_key")
  @@index([cameraAssetId], map: "service_crew_camera_camera_asset_id_idx")
  @@map("project_production_service_crew_camera")
}

/// A file on a shoot: a ticket (image or PDF, the manager's) or a photo (the coordinator's).
model ProjectProductionFile {
  id               String   @id @default(cuid())
  productionId     String   @map("production_id")
  /// TICKET, PINEAPPLE_GROUP or HAPPENING_NOW.
  kind             String   @db.VarChar(20)
  /// The public link - or, on a machine with no object storage, the inline data URI, which is why
  /// this is MediumText like the employee photo columns.
  url              String   @db.MediumText
  fileName         String   @map("file_name") @db.VarChar(255)
  mimeType         String?  @map("mime_type") @db.VarChar(100)
  uploadedByUserId Int?     @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  production     ProjectProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  uploadedByUser User?             @relation("ProjectProductionFileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([productionId, kind])
  @@index([uploadedByUserId])
  @@map("project_production_file")
}

/// Everything done on a shoot's production, oldest first - modelled on `HrmTaskActivity`.
/// `userName` is who did it at the time; a log is not a name copy (see nameCopies.js).
model ProjectProductionActivity {
  id           Int      @id @default(autoincrement())
  productionId String   @map("production_id")
  /// PLAN_SAVED, PLAN_SUBMITTED, FOOTAGE_SAVED, STEP_COMPLETED, SHOOT_STATUS_CHANGED, FILE_ADDED, FILE_REMOVED,
  /// WHATSAPP_SENT, WHATSAPP_FAILED or WHATSAPP_RETRIED.
  action       String   @db.VarChar(40)
  detail       String?  @db.Text
  userId       Int?     @map("user_id")
  userName     String   @map("user_name") @db.VarChar(191)
  createdAt    DateTime @default(now()) @map("created_at")

  production ProjectProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  user       User?             @relation("ProjectProductionActivityUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([productionId, createdAt])
  @@index([userId])
  @@map("project_production_activity")
}

/// The one WhatsApp message a step posts to the project's group, and how it went.
model ProjectProductionMessage {
  id             String    @id @default(cuid())
  productionId   String    @map("production_id")
  /// STARTED_FROM_STUDIO, REACHED_SHOOT_PLACE or SHOOT_COMPLETED.
  step           String    @db.VarChar(30)
  /// SENT or FAILED; SENDING while a send (first try or retry) is in flight or claimed; OFF for one
  /// that was still waiting when the studio switched the message off, which closes it for good.
  status         String    @db.VarChar(10)
  error          String?   @db.Text
  /// The short safe wording shown to any viewer on FAILED ("No WhatsApp group linked",
  /// "WhatsApp not connected", "Chat switched off for the studio/sender", "Send failed"). The
  /// raw `error` text is never returned by the API - server log and this column only.
  reason         String?   @db.VarChar(60)
  sentAt         DateTime? @map("sent_at")
  sentFromUserId Int?      @map("sent_from_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  production   ProjectProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  sentFromUser User?             @relation("ProjectProductionMessageSentFrom", fields: [sentFromUserId], references: [id], onDelete: SetNull)

  @@unique([productionId, step])
  @@index([sentFromUserId])
  @@map("project_production_message")
}

/// Superseded by `ProjectPreProductionFollowupEntry`: one row per project could hold only a single
/// next date, and the board now keeps a list of them. Its rows were carried into the entries by
/// migration `20260926120000_add_pre_production_followup_entries`; kept so the historic values
/// survive, and nothing reads or writes it any more.
model ProjectPreProductionFollowup {
  id               String       @id @default(cuid())
  projectId        String       @unique @map("project_id")
  lastFollowupDate DateTime?    @map("last_followup_date")
  nextFollowupDate DateTime?    @map("next_followup_date")
  remarks          String?      @db.Text
  updatedByUserId  Int?         @map("updated_by_user_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  project          SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedByUser    User?        @relation("ProjectPreProductionFollowupUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([nextFollowupDate])
  @@map("project_pre_production_followup")
}

/// One change to whether something applies to a project — Welcome Kit, Shoot Completed Gift, Storage
/// Needed (the hard disk) or CRD Document — and the reason given for it.
///
/// A gift dropped or a hard disk no longer needed is a decision somebody will ask about later, so the
/// answer is kept with who changed it, when, from what and why. Written by the same save that makes
/// the change, and never edited afterwards.
model ProjectApplicabilityChange {
  id              String       @id @default(cuid())
  projectId       String       @map("project_id")
  /// Which answer changed: welcomeGift, shootCompletedGift, storageNeeded or crdDocumentStatus.
  item            String       @db.VarChar(40)
  fromValue       String?      @map("from_value") @db.VarChar(40)
  toValue         String?      @map("to_value") @db.VarChar(40)
  remarks         String?      @db.Text
  changedByUserId Int?         @map("changed_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  project         SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([changedByUserId])
  @@map("project_applicability_change")
}

/// One follow-up owed to a project's client — the project's, never a single shoot's.
///
/// Adding one is naming the date the client is to be chased next; it stays pending until it is
/// marked done. The earliest pending date is the project's Next Followup Date and the latest
/// `doneAt` its Last Followup Date, so neither is ever typed in.
model ProjectPreProductionFollowupEntry {
  id              String       @id @default(cuid())
  projectId       String       @map("project_id")
  followupDate    DateTime     @map("followup_date")
  remarks         String?      @db.Text
  /// NULL while pending; when it was marked done.
  doneAt          DateTime?    @map("done_at")
  createdByUserId Int?         @map("created_by_user_id")
  doneByUserId    Int?         @map("done_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  project         SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser   User?        @relation("ProjectPreProductionFollowupEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  doneByUser      User?        @relation("ProjectPreProductionFollowupEntryDoneBy", fields: [doneByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, doneAt])
  @@index([followupDate])
  @@index([createdByUserId])
  @@index([doneByUserId])
  @@map("project_pre_production_followup_entry")
}

model ProjectServiceDefinition {
  id                        String                                   @id @default(cuid())
  code                      String                                   @unique @db.VarChar(100)
  name                      String                                   @unique @db.VarChar(191)
  quantityMode              ProjectServiceQuantityMode?              @map("quantity_mode")
  /// How many of this service a project starts with, and whether it has a quantity at all.
  ///
  /// Null means the service is not counted - a drone either comes or it does not. A number means it
  /// is, and that number is what a new allocation begins with. `quantityMode` is kept in step with
  /// it (INTEGER when this is set, NONE when it is null) so everything already reading the mode
  /// keeps working; this is the field a person actually fills in.
  /// What the studio charges for one of these, before anything a quotation does to it. Nullable
  /// because a service the studio has not priced yet is a real state, and zero is not the same thing.
  price                     Decimal?                                 @db.Decimal(12, 2)
  defaultQuantity           Int?                                     @map("default_quantity")
  defaultDurationHours      Int?                                     @map("default_duration_hours")
  defaultDurationMinutes    Int?                                     @map("default_duration_minutes")
  /// The one timing a project is asked for, kept as the first of `timingModes`.
  ///
  /// Left in place because the quotation calculator and the allocation builder both branch on it.
  timingMode                ProjectServiceTimingMode?                @map("timing_mode")
  /// Every timing this service may be booked with, as a JSON array of the same enum's names.
  ///
  /// A service can be offered hourly *and* by the session - "Candid Photo" is booked both ways -
  /// and a single mode forced the studio to choose one when setting it up. Null or empty means
  /// whatever `timingMode` says, so rows written before this existed still read correctly.
  timingModes               Json?                                    @map("timing_modes")
  /// Which shoot types this service is offered for: STUDIO, OUTDOOR, or both.
  ///
  /// Null or empty means it is offered for any shoot, which is what every service written before
  /// this existed means.
  shootTypes                Json?                                    @map("shoot_types")
  /// No longer read for a price: Settings now asks one `price` per service and the Quotation
  /// Generator and calculator quote that on every shoot. Kept, untouched, as it was saved.
  ///
  /// What the service costs per shoot type and session timing, as
  /// `[{ shootType, timingMode, price }]` - Studio + Half Session at one figure, Studio + Full
  /// Session at another. A session row carries `duration`, the length it reads as on screen
  /// ("4-5 Hours (Half)" unless typed over). An HOURS_MINUTES row carries `hours` and is the price for a booking of
  /// that many - several may stand side by side for different lengths - and is a studio row only.
  /// The rows are the studio's own list, not tied to the service's `shootTypes` or `timingModes`. A
  /// quotation line added for a shoot takes the row that matches the shoot's type and timing as its
  /// unit price; `price` above is the flat figure this falls back to. With `sizeEnabled`, every row
  /// also carries `size` as typed - and `sizeOptionValueId` beside it where the words match an entry
  /// of the studio's service size lists - so the same booking is priced per size, and a quotation
  /// line takes the row matching its size once one is picked.
  pricing                   Json?
  /// Whether this service is sold by size: Yes puts a Size on every pricing row and a Size picker
  /// on the project and quotation lines that use it. Null reads as No.
  sizeEnabled               Boolean?                                 @map("size_enabled")
  /// Whether this service brings deliverables with it. Only TRUE does, so a service saved before
  /// this was asked - and every service nobody has answered it for - brings none, which is exactly
  /// how they all behaved before. The variants it brings are `deliverables` below.
  deliverableAdded          Boolean?                                 @map("deliverable_added")
  /// The deliverable variants this service brings with it whenever it is added to a shoot, as
  /// `[{ deliverableId, brandId, variantId }]`. Null on a service saved before this existed, which
  /// reads as every variant its `pricing` rows named - where the mapping used to ride, per row.
  deliverables              Json?
  /// Whether this is given rather than charged for. Only TRUE is: a record saved before this was
  /// asked, and every one nobody has answered it for, reads as No - which is how they all behaved
  /// before. It is the *master's* answer, and a quotation copies it onto a line once, when the line
  /// is added; changing it here never moves a quotation already raised, and changing it on a
  /// quotation never writes back here.
  complimentary             Boolean?
  timingOptionSetId         String?                                  @map("timing_option_set_id")
  sizeOptionSetId           String?                                  @map("size_option_set_id")
  /// A note the studio writes about the service, typed. It was a Yes/No switch deciding whether a
  /// project's service line carried a remarks box at all; it decides nothing now, and the line
  /// always has one - which is what all but one service already did. Reading a note as an answer
  /// was the thing to remove: the rule was "an answer starting with no is No", so an ordinary note
  /// beginning "Not applicable" would have taken that box away across every project using it.
  remarksEnabled            String?                                  @map("remarks_enabled") @db.Text
  isActive                  Boolean                                  @default(true) @map("is_active")
  sortOrder                 Int                                      @default(0) @map("sort_order")
  createdAt                 DateTime                                 @default(now()) @map("created_at")
  updatedAt                 DateTime                                 @updatedAt @map("updated_at")
  timingOptionSet           ProjectOptionSet?                        @relation("ProjectServiceTimingOptionSet", fields: [timingOptionSetId], references: [id], onDelete: SetNull)
  sizeOptionSet             ProjectOptionSet?                        @relation("ProjectServiceSizeOptionSet", fields: [sizeOptionSetId], references: [id], onDelete: SetNull)
  postProductionAllocations ProjectPostProductionAllocation[]
  workflowDefinition        ProjectPostProductionWorkflowDefinition?

  productionServiceCrew ProjectProductionServiceCrew[]
  shootCrewNotices      ProjectShootCrewNotice[]
  shootVendorNotices    ProjectShootVendorNotice[]
  productionFootage     ProjectProductionFootage[]
  changeRequestItems ProjectChangeRequestItem[]

  @@index([isActive, sortOrder])
  @@index([timingOptionSetId])
  @@index([sizeOptionSetId])
  @@map("project_service_definition")
}

model ProjectPostProductionWorkflowDefinition {
  id                  String                                    @id @default(cuid())
  serviceDefinitionId String                                    @unique @map("service_definition_id")
  rawFileIn           Boolean                                   @default(true) @map("raw_file_in")
  photoSelection      Boolean?                                  @map("photo_selection")
  output01            String?                                   @map("output_01") @db.VarChar(191)
  output02            String?                                   @map("output_02") @db.VarChar(191)
  output03            String?                                   @map("output_03") @db.VarChar(191)
  output04            String?                                   @map("output_04") @db.VarChar(191)
  finalFilesOut       Boolean                                   @default(true) @map("final_files_out")
  isActive            Boolean                                   @default(true) @map("is_active")
  createdAt           DateTime                                  @default(now()) @map("created_at")
  updatedAt           DateTime                                  @updatedAt @map("updated_at")
  serviceDefinition   ProjectServiceDefinition                  @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)
  allocations         ProjectPostProductionWorkflowAllocation[]

  @@index([isActive])
  @@map("project_post_production_workflow_definition")
}

model ProjectOptionSet {
  id                         String                         @id @default(cuid())
  code                       String                         @unique @db.VarChar(100)
  name                       String                         @db.VarChar(191)
  isActive                   Boolean                        @default(true) @map("is_active")
  sortOrder                  Int                            @default(0) @map("sort_order")
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")
  values                     ProjectOptionSetValue[]
  serviceTimingDefinitions   ProjectServiceDefinition[]     @relation("ProjectServiceTimingOptionSet")
  serviceSizeDefinitions     ProjectServiceDefinition[]     @relation("ProjectServiceSizeOptionSet")
  deliverableSizeDefinitions ProjectDeliverableDefinition[] @relation("ProjectDeliverableSizeOptionSet")

  @@index([isActive, sortOrder])
  @@map("project_option_set")
}

model ProjectOptionSetValue {
  id                         String                            @id @default(cuid())
  optionSetId                String                            @map("option_set_id")
  code                       String                            @db.VarChar(100)
  value                      String                            @db.VarChar(191)
  label                      String                            @db.VarChar(191)
  description                String?                           @db.VarChar(191)
  /// What one unit of this size costs — a 12x6 album is not priced like a 36x18 one, so the price
  /// belongs to the size rather than to the deliverable that offers it.
  pricePerQuantity           Decimal?                          @map("price_per_quantity") @db.Decimal(12, 2)
  isActive                   Boolean                           @default(true) @map("is_active")
  sortOrder                  Int                               @default(0) @map("sort_order")
  createdAt                  DateTime                          @default(now()) @map("created_at")
  updatedAt                  DateTime                          @updatedAt @map("updated_at")
  optionSet                  ProjectOptionSet                  @relation(fields: [optionSetId], references: [id], onDelete: Cascade)
  sessionServiceAllocations  ProjectPostProductionAllocation[] @relation("ProjectServiceSessionOption")
  sizeServiceAllocations     ProjectPostProductionAllocation[] @relation("ProjectServiceSizeOption")
  sizeDeliverableAllocations ProjectShootDeliverable[]         @relation("ProjectDeliverableSizeOption")

  @@unique([optionSetId, code])
  @@index([optionSetId, isActive, sortOrder])
  @@map("project_option_set_value")
}

model ProjectDeliverableDefinition {
  id                     String                    @id @default(cuid())
  code                   String                    @unique @db.VarChar(100)
  name                   String                    @unique @db.VarChar(191)
  /// What the studio charges for one of these. Nullable for the same reason as a service's.
  price                  Decimal?                  @db.Decimal(12, 2)
  /// No. of Count, Image Selection and Remarks: the three questions asked of every deliverable,
  /// whatever its type. They were a Yes/No dropdown each and are typed words now, so a studio can
  /// write what it actually does — "50 photos", "2 sets", "only the album". The words still decide
  /// things, by the one rule `deliverableAnswers` holds: an answer starting with "no" is No,
  /// anything else typed is Yes, and blank is unanswered. Every `Yes` and `No` written before this
  /// therefore reads exactly as it did.
  photoCountEnabled      String?                   @map("photo_count_enabled") @db.VarChar(191)
  /// Whether this deliverable is offered as a selection item in Image Selection — the only thing
  /// that decides it; nothing is hard-coded in the app. Blank keeps it out, as it always has.
  /// Migration 20260820090000 stamped Yes onto the definitions the retired built-in list admitted.
  imageSelectionEnabled  String?                   @map("image_selection_enabled") @db.VarChar(191)
  sizeOptionSetId        String?                   @map("size_option_set_id")
  /// Whether this is given rather than charged for - the deliverable's own answer, independent of
  /// any service's. See the same field on `ProjectServiceDefinition`.
  complimentary          Boolean?
  remarksEnabled         String?                   @map("remarks_enabled") @db.Text
  /// What the deliverable is: an IMAGE or a VIDEO. Null on a deliverable saved before this was
  /// asked. `kind` is no longer written and stays only so older rows read.
  mediaType              String?                   @map("media_type") @db.VarChar(20)
  kind                   String?                   @db.VarChar(30)
  /// How the deliverable is described on Settings → Project → Deliverables, as typed. Words for
  /// the screen and the table; nothing prices or filters on them, and `price` above is what it
  /// costs.
  ///
  /// `imageSize` and `frameInches` are an image deliverable's - how big the print is and the
  /// frame around it - and `videoLength` is a video's. They are kept apart rather than shared, so
  /// a deliverable switched from one type to the other and back still holds what it was given;
  /// what the type does not ask for is cleared on save, so a video never carries a frame size.
  ///
  /// One brand and one variant's worth each, and they are no longer what the dialog fills in:
  /// `brands` below is. They are kept, and rewritten from the first brand's first variant on every
  /// save, because the CRM Quotation Calculator quotes one figure per deliverable and reads them —
  /// see `quotation-calculator/controller.js`. A deliverable with no brands keeps whatever it holds.
  brandName              String?                   @map("brand_name") @db.VarChar(191)
  imageSize              String?                   @map("image_size") @db.VarChar(100)
  videoLength            String?                   @map("video_length") @db.VarChar(100)
  frameInches            String?                   @map("frame_inches") @db.VarChar(60)
  /// No longer written by the deliverable dialog, which asks one `price` for the deliverable; kept
  /// so a deliverable priced under kinds earlier still prices its quotation lines as it did.
  /// What the deliverable cost, one row per kind and booking: `[{ kind, ...booking, price }]`. An
  /// image kind (FRAMES / ALBUM / CALENDAR) is priced per size - `size` as typed, with
  /// `sizeOptionValueId` beside it where the words match an entry of the kind's own size list;
  /// FULL_LENGTH per session, `timingMode` HALF_SESSION or FULL_SESSION; TEASER or
  /// CANDID as one figure. A deliverable may be priced under several kinds at once. A quotation
  /// line takes the row matching its size, or its shoot's session, or the one figure where a
  /// single kind is all that is priced; `price` above is the flat figure it falls back to.
  /// `sizeOptionSetId` is pointed at the first priced image kind's list, for the screens that read
  /// one list; the line pickers offer every priced size.
  pricing                Json?
  /// The one shoot type this deliverable is offered for, as a one-item list - the shape a
  /// service's `shootTypes` has. Null or empty means every shoot, which is what a deliverable saved
  /// before this existed means.
  shootTypes             Json?                     @map("shoot_types")
  /// The timings this deliverable is offered with, as a service's `timingModes`: HALF_SESSION,
  /// FULL_SESSION, HOURS_MINUTES, or ["NONE"] for none.
  timingModes            Json?                     @map("timing_modes")
  /// How long an Hours / Minutes deliverable usually runs, in the two parts a shoot stores.
  defaultDurationHours   Int?                      @map("default_duration_hours")
  defaultDurationMinutes Int?                      @map("default_duration_minutes")
  isActive               Boolean                   @default(true) @map("is_active")
  sortOrder              Int                       @default(0) @map("sort_order")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  sizeOptionSet          ProjectOptionSet?         @relation("ProjectDeliverableSizeOptionSet", fields: [sizeOptionSetId], references: [id], onDelete: SetNull)
  deliverables           ProjectShootDeliverable[]
  brands                 ProjectDeliverableBrand[]
  changeRequestItems ProjectChangeRequestItem[]

  @@index([isActive, sortOrder])
  @@index([sizeOptionSetId])
  @@map("project_deliverable_definition")
}

/// One company a deliverable is sold by — Canvera, Pictoo, the studio itself. A deliverable has as
/// many as it is sold by, and each holds the variants it is sold in. Owned entirely by its
/// deliverable and goes with it. A save keeps every brand and variant the form kept, by id - a
/// service maps its bookings to variants by id - and removes only what the form removed; see
/// `saveDeliverableBrands`.
model ProjectDeliverableBrand {
  id           String                       @id @default(cuid())
  definitionId String                       @map("definition_id")
  /// As typed. A brand may be left unnamed — a studio selling its own albums has nobody to name —
  /// and its variants are still its own.
  name         String                       @default("") @db.VarChar(191)
  sortOrder    Int                          @default(0) @map("sort_order")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")
  definition   ProjectDeliverableDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade, map: "pd_brand_definition_fk")
  variants     ProjectDeliverableVariant[]

  @@index([definitionId, sortOrder], map: "pd_brand_definition_sort_idx")
  @@map("project_deliverable_brand")
}

/// One way a brand sells a deliverable, and what it costs. What it is asked for follows the
/// deliverable's type and nothing else: an image's variant carries `size` and `frameInches`, a
/// video's carries `videoLength`, and `price` belongs to both. The columns the type does not ask
/// for are written null on every save, so a video variant can never be left carrying a frame size.
model ProjectDeliverableVariant {
  id          String                  @id @default(cuid())
  brandId     String                  @map("brand_id")
  size        String?                 @db.VarChar(100)
  frameInches String?                 @map("frame_inches") @db.VarChar(60)
  videoLength String?                 @map("video_length") @db.VarChar(100)
  /// Nullable for the same reason the deliverable's own price is: a variant nobody has priced yet
  /// is a real state, and a zero would claim it is free.
  price       Decimal?                @db.Decimal(12, 2)
  sortOrder   Int                     @default(0) @map("sort_order")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  brand       ProjectDeliverableBrand @relation(fields: [brandId], references: [id], onDelete: Cascade, map: "pd_variant_brand_fk")

  @@index([brandId, sortOrder], map: "pd_variant_brand_sort_idx")
  @@map("project_deliverable_variant")
}

model ProjectShootDeliverable {
  id                               String                            @id @default(cuid())
  projectId                        String                            @map("project_id")
  shootId                          String                            @map("shoot_id")
  deliverableDefinitionId          String?                           @map("deliverable_definition_id")
  deliverableName                  String                            @map("deliverable_name") @db.VarChar(191)
  quantity                         Int                               @default(1)
  numberOfPhotos                   Int?                              @map("number_of_photos")
  // How many photos the client may pick for this deliverable in Image Selection. Kept apart from
  // `quantity`, which is how much of the deliverable was ordered — five calendars is five calendars
  // however many photos go into choosing them — so one cannot be edited by changing the other.
  // This is the single answer both screens read and write: Post Production Allocation sets it, the
  // Selection Items table in Image Selection sets it, and neither holds a copy of its own. Null
  // means it has never been set, and the limit falls back to `quantity` and then to the studio-wide
  // default, which is how every deliverable allocated before this column existed still works.
  selectionLimit                   Int?                              @map("selection_limit")
  // The variant this line was added as, as it read when it was added: whose it is (`brandName`),
  // and what distinguishes it - an image's `size` and `frameInches`, a video's `videoLength`.
  // Written only from a variant, so null on a line added as the deliverable alone and on every
  // line from before variants reached projects; a size picked from the deliverable's own list is
  // `sizeOptionValueId`, not this. A snapshot and not a key, because a variant can be resized,
  // repriced or removed in Settings after the sale and the line still says what was sold - the
  // quotation keeps its copy for the same reason - and deliberately not a name copy in
  // `nameCopies.js`: what a line was sold as does not change when Settings does.
  brandName                        String?                           @map("brand_name") @db.VarChar(191)
  size                             String?                           @db.VarChar(100)
  frameInches                      String?                           @map("frame_inches") @db.VarChar(60)
  videoLength                      String?                           @map("video_length") @db.VarChar(100)
  sizeOptionValueId                String?                           @map("size_option_value_id")
  remarks                          String?                           @db.Text
  // Where the line stands among its shoot's deliverables - the same rule as a service line's.
  sortOrder                        Int?                              @map("sort_order")
  /// Sale Extras: this row as the finalized quotation booked it - its scope fields (see
  /// `sale-extras/rules.js` SCOPE_FIELDS) - or null when it was added afterwards, which makes it an
  /// extra. Filled for every row that existed before 20261101160000.
  saleBaseline                     Json?                             @map("sale_baseline")
  deletedAt                        DateTime?                         @map("deleted_at")
  createdAt                        DateTime                          @default(now()) @map("created_at")
  updatedAt                        DateTime                          @updatedAt @map("updated_at")
  project                          SalesProject                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot                            ProjectShoot                      @relation(fields: [shootId], references: [id], onDelete: Cascade)
  deliverableDefinition            ProjectDeliverableDefinition?     @relation(fields: [deliverableDefinitionId], references: [id], onDelete: SetNull)
  sizeOptionValue                  ProjectOptionSetValue?            @relation("ProjectDeliverableSizeOption", fields: [sizeOptionValueId], references: [id], onDelete: SetNull)
  imageSelectionDeliverableConfigs ImageSelectionDeliverableConfig[]
  saleExtras                       ProjectSaleExtra[]

  @@index([projectId, deletedAt])
  @@index([shootId, deletedAt])
  @@index([deliverableDefinitionId])
  @@index([sizeOptionValueId])
  @@index([createdAt])
  @@map("project_shoot_deliverable")
}

model ProjectPostProductionAllocation {
  id                               String                                    @id @default(cuid())
  projectId                        String                                    @map("project_id")
  shootId                          String                                    @map("shoot_id")
  serviceDefinitionId              String?                                   @map("service_definition_id")
  serviceName                      String                                    @map("service_name") @db.VarChar(191)
  serviceDetails                   String?                                   @map("service_details") @db.Text
  quantitySessionTiming            String?                                   @map("quantity_session_timing") @db.VarChar(191)
  quantity                         Int?
  sessionOptionId                  String?                                   @map("session_option_id")
  durationHours                    Int?                                      @map("duration_hours")
  durationMinutes                  Int?                                      @map("duration_minutes")
  workDays                         Int?                                      @map("work_days")
  timingMinutes                    Int?                                      @map("timing_minutes")
  sizeOptionValueId                String?                                   @map("size_option_value_id")
  remarks                          String?                                   @db.Text
  selectionLimit                   Int?                                      @map("selection_limit")
  // Where the line stands among its shoot's services, set by dragging it on Create Project, Edit
  // Project or Start Project. NULL until someone does: those lines keep the order they were added
  // in (`createdAt`), and a line added after a drag lands at the end.
  sortOrder                        Int?                                      @map("sort_order")
  /// Sale Extras: this row as the finalized quotation booked it - its scope fields (see
  /// `sale-extras/rules.js` SCOPE_FIELDS) - or null when it was added afterwards, which makes it an
  /// extra. Filled for every row that existed before 20261101160000.
  saleBaseline                     Json?                                     @map("sale_baseline")
  deletedAt                        DateTime?                                 @map("deleted_at")
  createdAt                        DateTime                                  @default(now()) @map("created_at")
  updatedAt                        DateTime                                  @updatedAt @map("updated_at")
  project                          SalesProject                              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot                            ProjectShoot                              @relation(fields: [shootId], references: [id], onDelete: Cascade)
  serviceDefinition                ProjectServiceDefinition?                 @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  sessionOption                    ProjectOptionSetValue?                    @relation("ProjectServiceSessionOption", fields: [sessionOptionId], references: [id], onDelete: SetNull)
  sizeOptionValue                  ProjectOptionSetValue?                    @relation("ProjectServiceSizeOption", fields: [sizeOptionValueId], references: [id], onDelete: SetNull)
  workflowAllocations              ProjectPostProductionWorkflowAllocation[]
  imageSelectionDeliverableConfigs ImageSelectionDeliverableConfig[]
  saleExtras                       ProjectSaleExtra[]

  @@index([projectId, deletedAt])
  @@index([shootId, deletedAt])
  @@index([serviceDefinitionId])
  @@index([sessionOptionId])
  @@index([sizeOptionValueId])
  @@index([createdAt])
  @@map("project_post_production_allocation")
}

