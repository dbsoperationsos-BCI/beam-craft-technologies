model Branch {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(120)
  /// The other spellings the studio has used for this branch, as a list of strings: every name it
  /// was called before a rename (written by `nameCopies.renameBranchCopies` at the moment of the
  /// rename) and any short form worth teaching the matcher. `referenceMatchers` resolves each of them
  /// to this row, so a Google Sheet or CSV still saying the old name lands on the right branch and is
  /// rewritten to the current spelling instead of losing its link. Never a name another branch holds.
  aliases     Json?
  description String? @db.Text

  /// Where the branch trades from, in the parts a postal address is actually made of rather than as
  /// one box of text. Kept apart so a document can print the city or the state on its own, and so
  /// two branches in the same city can be told apart by what is above it. Each part is optional,
  /// like everything else here: the parts arrive as they become known.
  addressLine1 String? @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)
  city         String? @db.VarChar(120)
  state        String? @db.VarChar(120)
  postalCode   String? @map("postal_code") @db.VarChar(10)
  isActive     Boolean @default(true) @map("is_active")

  /// The one branch the studio is registered from. At most one branch holds it, which the branches
  /// service keeps rather than a constraint - MySQL has no partial unique index.
  isHeadOffice Boolean @default(false) @map("is_head_office")

  /// What the branch is registered as, and how to reach it. All optional: a branch scoped a record
  /// long before it had any of this, and the register stays usable while it is filled in.
  gstNumber      String? @map("gst_number") @db.VarChar(15)
  panNumber      String? @map("pan_number") @db.VarChar(10)
  phone          String? @db.VarChar(20)
  /// A second number for the same branch - the landline beside the mobile, or whoever answers when
  /// the first does not. Optional like the first, and held to the same format.
  alternatePhone String? @map("alternate_phone") @db.VarChar(20)
  email          String? @db.VarChar(150)
  /// The branch's own web address, for the documents that print one. Optional like the email beside
  /// it, and stored exactly as it is written - the scheme, the case and any path are the studio's.
  websiteUrl     String? @map("website_url") @db.VarChar(255)
  /// Where the branch is on a map - its Google Maps link. Optional; given https:// when typed without
  /// a scheme, like the social media links.
  locationUrl    String? @map("location_url") @db.VarChar(500)

  /// The page a client is asked to review the branch on (External URLs → Google Review URL), used by the Feedback
  /// thank-you message. Optional; given https:// when typed without a scheme.
  googleReviewUrl String? @map("google_review_url") @db.VarChar(500)
  /// The branch's social media links, added with "+ Add social media link": a JSON list of
  /// `{ label, url }` in the studio's order, like `upiIds` - owned by the branch, never looked up by.
  /// NULL or `[]` is none (`modules/admin/branches/validation.js`).
  customSocialLinks Json?  @map("custom_social_links")

  /// Where the branch banks is held in `BranchBankAccount`, one row per account, because a branch is
  /// commonly paid into more than one. It was four columns on this row until 20261007090000, which
  /// could hold exactly one.

  /// The branch's payment QR code, as the link `storeImage` hands back once it has uploaded the
  /// picture - never the picture itself where object storage is configured. Optional like the
  /// account it stands beside: a branch that is paid by transfer alone has no QR to show.
  ///
  /// Text rather than a VarChar(500) because of the one case where it *is* the picture: a machine
  /// with no R2 keys gets the compressed image back as a data URI, which is a couple of hundred
  /// kilobytes and would be truncated by any VarChar. The gallery logo beside it holds a
  /// VarChar(500) and so cannot be saved at all on such a machine; this column does not repeat
  /// that.
  qrCodeUrl String? @map("qr_code_url") @db.MediumText
  /// The UPI IDs a client may pay this branch through - `name@bank` - in the order the studio lists
  /// them, the first being the one it leads with. A list because a branch is commonly paid into
  /// more than one handle, and the QR beside it encodes only one of them.
  ///
  /// A JSON list of strings, like `aliases` above and for the same reason: these are values the
  /// branch owns rather than rows anything else points at, nothing ever looks a branch up *by*
  /// one, and the order is the studio's. Each is stored trimmed and exactly as written; the list
  /// holds no blanks and no two spellings of one handle (`modules/admin/branches/validation.js`).
  /// Empty - `[]`, or NULL on a row written before the column - means the branch takes no UPI
  /// payment. Read by the register and by the client's quotation payment page
  /// (`/q/<token>/payment`), which prints each one beside the QR.
  upiIds    Json?   @map("upi_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  assets             Asset[]
  users              User[]
  employees          Employee[]
  roleBranches       RoleBranch[]
  /// The references added by 20260906150000, each beside a text column still in use.
  crmLeads           SalesCrmLead[]
  salesProjects      SalesProject[]
  quotations         SalesQuotation[]
  cashEntries        CashEntry[]             @relation("CashEntryBranch")
  /// Branch transfers this branch received - the other end of `CashEntry.toBranchId`.
  cashTransfersIn    CashEntry[]             @relation("CashEntryToBranch")
  paymentRequests    PaymentRequest[]
  tasks              HrmTask[]
  whatsappGroupNames SalesWhatsappGroupName[]
  attendanceOffice   AttendanceOfficeLocation[] @relation("AttendanceOfficeLocations")

  /// Inverses of the branch references given a foreign key by 20260924100000. Add no columns.
  aiEventBranchRef               AiEvent[]               @relation("AiEventBranchRef")
  attendanceEventBranch          AttendanceEvent[]       @relation("AttendanceEventBranch")
  attendanceSessionLoginBranch   AttendanceSession[]     @relation("AttendanceSessionLoginBranch")
  attendanceSessionLogoutBranch  AttendanceSession[]     @relation("AttendanceSessionLogoutBranch")
  hrmInterviewCandidateBranchRef HrmInterviewCandidate[] @relation("HrmInterviewCandidateBranchRef")
  /// The vendors that support this branch - `VendorBranch`, the vendor's Supported Branches.
  vendorBranches                 VendorBranch[]
  projectProductions             ProjectProduction[]
  /// Pre Production: the indoor shoots held at this branch.
  preProductionShoots            ProjectPreProduction[]    @relation("ProjectPreProductionShootBranch")
  /// The accounts this branch is paid into, in the studio's own order - see `BranchBankAccount`.
  bankAccounts                   BranchBankAccount[]
  /// The activity-log lines written while a person homed here was signed in - see `UserActivityLog`.
  activityLogs                   UserActivityLog[]       @relation("UserActivityLogBranch")
  payrollCostCentreEntries       PayrollEntry[]            @relation("PayrollEntryCostCentre")
  /// Calendar → Block Period: the hours held in this branch.
  calendarBlocks                 CalendarBlock[]
  /// The holidays declared for this branch alone (`AttendanceHolidayBranch`).
  holidayBranches                AttendanceHolidayBranch[]  @relation("AttendanceHolidayBranch")

  @@index([isActive, name])
  @@map("branch")
}

/// One account a branch is paid into, as Settings -> Organization -> Branches holds it.
///
/// A row of its own rather than four columns on the branch, which is what this replaced: a branch is
/// commonly paid into more than one account - a current account per bank, or one kept for a
/// particular kind of work - and four columns can hold exactly one. The migration that created this
/// table copied each branch's single account into the first row of its list.
///
/// Every field is required, because a payable account is all four of them: a holder, a bank, a number
/// and an IFSC. A row holding three of those is a card a client cannot pay into, and the branch
/// register refused exactly that before this table existed.
///
/// `position` is the studio's own order, and it is what the client's payment page prints in - the
/// first account being the one the branch leads with, the way `Branch.upiIds` leads with its first
/// handle. Rewritten from the list's order on every save, so the order is whatever the form shows.
///
/// The account number is **not** unique in the database. The register refuses one that another branch
/// already holds (`accountClashesOf` in `modules/admin/branches/service.js`) and has since before
/// this table, but that check has only ever been the application's: rows written before it exists may
/// repeat, and a unique index added here would be a migration that fails on production data. The
/// index is for the lookup that check does.
model BranchBankAccount {
  id                Int    @id @default(autoincrement())
  branchId          Int    @map("branch_id")
  accountHolderName String @map("account_holder_name") @db.VarChar(150)
  bankName          String @map("bank_name") @db.VarChar(120)
  accountNumber     String @map("account_number") @db.VarChar(18)
  ifscCode          String @map("ifsc_code") @db.VarChar(11)
  position          Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Owned by the branch: these rows describe it and nothing else points at them, so they go when it
  /// does. In practice nothing ever does - a branch is disabled, never deleted (see the branches
  /// service) - which is why this is the one relation on the row.
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// One branch may not hold the same account twice - a pasted row rather than a second account.
  /// Safe where a global unique is not: a branch held exactly one account before this table existed,
  /// so no branch can already carry a repeat.
  @@unique([branchId, accountNumber])
  @@index([branchId, position])
  @@index([accountNumber])
  @@map("branch_bank_account")
}

model AssetCategory {
  id                    String          @id @default(cuid())
  name                  String          @db.VarChar(150)
  code                  String          @unique @db.VarChar(120)
  parentId              String?         @map("parent_id")
  level                 Int
  moduleType            String          @default("ASSET") @map("module_type") @db.VarChar(30)
  icon                  String?         @db.VarChar(100)
  description           String?         @db.Text
  sortOrder             Int             @default(0) @map("sort_order")
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  parent                AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children              AssetCategory[] @relation("AssetCategoryHierarchy")
  assets                Asset[]
  /// Required inverses of AssetRequest. Add no columns; the links are on the request.
  requestsAsCategory    AssetRequest[]  @relation("AssetRequestCategory")
  requestsAsSubCategory AssetRequest[]  @relation("AssetRequestSubCategory")

  @@unique([parentId, name])
  @@index([parentId])
  @@index([level])
  @@index([isActive])
  @@map("asset_category")
}

enum AssetStatus {
  ACTIVE
  UNDER_REPAIR
  IN_SERVICE
  IN_TRANSIT
  INACTIVE
  LOST
  STOLEN
  SOLD
  DISPOSED
  UNASSIGNED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

model Vendor {
  id                       Int          @id @default(autoincrement())
  vendorId                 String       @unique @map("vendor_id") @db.VarChar(30)
  vendorName               String       @map("vendor_name") @db.VarChar(191)
  /// Several, joined by ", " - "Photographer, Editor" - the way `Employee.skills` holds its list;
  /// the master-data list reads it entry by entry (`match: "csv"`). 500 rather than 100 for room to
  /// name several, and still short enough for the index on it.
  vendorType               String       @map("vendor_type") @db.VarChar(500)
  sourceType               String       @default("EXT") @map("source_type") @db.VarChar(10)
  contactPerson            String?      @map("contact_person") @db.VarChar(150)
  mobileNumber             String?      @map("mobile_number") @db.VarChar(30)
  whatsappNumber           String?      @map("whatsapp_number") @db.VarChar(30)
  alternateNumber          String?      @map("alternate_number") @db.VarChar(30)
  email                    String?      @db.VarChar(191)
  gstNumber                String?      @map("gst_number") @db.VarChar(30)
  panNumber                String?      @map("pan_number") @db.VarChar(20)
  aadhaarNumber            String?      @map("aadhaar_number") @db.VarChar(20)
  businessRegistrationName String?      @map("business_registration_name") @db.VarChar(191)
  address                  String?      @db.Text
  area                     String?      @db.VarChar(150)
  city                     String?      @db.VarChar(100)
  district                 String?      @db.VarChar(100)
  state                    String?      @db.VarChar(100)
  country                  String?      @db.VarChar(100)
  pincode                  String?      @db.VarChar(15)
  bankName                 String?      @map("bank_name") @db.VarChar(150)
  accountNumber            String?      @map("account_number") @db.VarChar(100)
  ifscCode                 String?      @map("ifsc_code") @db.VarChar(30)
  upiId                    String?      @map("upi_id") @db.VarChar(100)
  website                  String?      @db.VarChar(500)
  instagram                String?      @db.VarChar(500)
  facebook                 String?      @db.VarChar(500)
  businessStartYear        Int?         @map("business_start_year")
  preferredLanguages       Json?        @map("preferred_languages")
  skills                   Json?
  /// Capabilities → "Can be a production team member?" - Yes or No, and No unless somebody says Yes:
  /// the form opens on No, and every vendor from before the question reads as No.
  canBeProductionTeamMember Boolean     @default(false) @map("can_be_production_team_member")
  rating                   Int?
  status                   VendorStatus @default(ACTIVE)
  statusReason             String?      @map("status_reason") @db.Text
  referredBy               String?      @map("referred_by") @db.VarChar(191)
  remarks                  String?      @db.Text
  isDeleted                Boolean      @default(false) @map("is_deleted")
  deletedReason            String?      @map("deleted_reason") @db.Text
  deletedAt                DateTime?    @map("deleted_at")
  createdBy                Int?         @map("created_by")
  updatedBy                Int?         @map("updated_by")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  createdByUser       User?                             @relation("VendorCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser       User?                             @relation("VendorUpdatedByUser", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Capabilities → Supported Branches: the studio's branches this vendor works for.
  supportedBranches   VendorBranch[]
  /// The studio's bills to this vendor - Vendor Management reads its payments through this.
  paymentRequests           PaymentRequest[]               @relation("PaymentRequestVendor")
  productionServiceCrew ProjectProductionServiceCrew[] @relation("ProjectProductionServiceCrewVendor")
  productionTeamMemberships ProjectProductionTeamMember[] @relation("ProjectProductionTeamMemberVendor")
  /// What this vendor was last told about each shoot they are confirmed on - Settings → Project
  /// Management → Shoot crew notice, vendor arm.
  shootNotices              ProjectShootVendorNotice[]     @relation("ProjectShootVendorNoticeVendor")
  whatsappActivity          WhatsAppActivity[]             @relation("WhatsAppActivityVendor")

  @@index([vendorName])
  @@index([vendorType])
  @@index([status, isDeleted])
  @@index([createdAt])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("vendor")
}

/// A vendor's Supported Branches - the studio's branches it works for, several each - as a row per
/// vendor and branch rather than names in a column: a branch is an id with a key (Rule 5), so a
/// rename of the branch needs nothing here and a filter by branch is an index read.
///
/// Cascades both ways: a vendor removed takes its rows with it, and so does a branch.
model VendorBranch {
  vendorId Int @map("vendor_id")
  branchId Int @map("branch_id")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([vendorId, branchId])
  @@index([branchId])
  @@map("vendor_branch")
}

/// Client Storage Management. Scaffolded with audit columns only - the domain fields that
/// describe what is stored for a client are still to be defined.
/// One hard disc handed to or held for a client, tied to the shoot whose footage it carries.
/// Shoot ID, Date Created, Client Name, Project Status, Shoot, Main Event Date, Source Branch,
/// CRM and the three coordinators are NOT stored here: they are read through `shoot` so a
/// storage record can never drift from the shoot it belongs to.
model ClientStorage {
  id                     Int       @id @default(autoincrement())
  storageId              String    @unique @map("storage_id") @db.VarChar(30)
  projectId              String?   @map("project_id")
  shootId                String?   @map("shoot_id")
  // Where the record has reached. Allowed moves are declared in client-storage.controller.js;
  // "Footage BackUp not done" is only ever reached by the overdue sweep, never chosen by hand.
  status                 String    @default("Yet to Receive") @db.VarChar(40)
  /// DEPRECATED — no longer read or written. "Shoot Status Pending" is now derived from the
  /// project's own shoots on every read (client-storage.controller.js, pendingShootsByProject):
  /// true while any shoot is still ahead. Kept only so the historic values are not destroyed;
  /// nothing should read this column.
  isShootStatusPending   Boolean   @default(false) @map("is_shoot_status_pending")
  // Who post production handed the disc to. The name is kept alongside the link so the record
  // still reads correctly if the employee is later archived.
  assignedToId           Int?      @map("assigned_to_id")
  assignedToName         String?   @map("assigned_to_name") @db.VarChar(150)
  assignedAt             DateTime? @map("assigned_at")
  assignedById           Int?      @map("assigned_by_id")
  // Recorded when the disc is handed over and starts travelling, mirroring the asset In Transit
  // step. The upload columns hold `{ name, url }` entries the same way Asset.documents does, so
  // the files live in object storage rather than as base64 inside the row.
  // Photographed as the disc goes out, on the move from "Footage Backup Done" to "HDD Out".
  hddOutPhoto            Json?     @map("hdd_out_photo")
  transitCondition       String?   @map("transit_condition") @db.VarChar(40)
  transitDamageRemarks   String?   @map("transit_damage_remarks") @db.Text
  transitCurrentPhoto    Json?     @map("transit_current_photo")
  transferFrom           String?   @map("transfer_from") @db.VarChar(191)
  transferTo             String?   @map("transfer_to") @db.VarChar(191)
  sentBy                 String?   @map("sent_by") @db.VarChar(150)
  sentByPhone            String?   @map("sent_by_phone") @db.VarChar(30)
  receivedBy             String?   @map("received_by") @db.VarChar(150)
  receivedByPhone        String?   @map("received_by_phone") @db.VarChar(30)
  courierService         String?   @map("courier_service") @db.VarChar(150)
  trackingNumber         String?   @map("tracking_number") @db.VarChar(100)
  shipmentDateTime       DateTime? @map("shipment_date_time")
  shipmentEta            DateTime? @map("shipment_eta")
  courierCharge          Decimal?  @map("courier_charge") @db.Decimal(12, 2)
  shipmentType           String?   @map("shipment_type") @db.VarChar(40)
  courierReceipt         Json?     @map("courier_receipt")
  packagePhoto           Json?     @map("package_photo")
  transferReason         String?   @map("transfer_reason") @db.Text
  specialInstructions    String?   @map("special_instructions") @db.Text
  // A disc that is sold rather than delivered. The same details the asset Sold status records,
  // as columns here because a storage record has no status log of its own to hold them.
  soldByName             String?   @map("sold_by_name") @db.VarChar(150)
  soldByEmployeeId       String?   @map("sold_by_employee_id") @db.VarChar(50)
  soldToName             String?   @map("sold_to_name") @db.VarChar(150)
  soldToContact          String?   @map("sold_to_contact") @db.VarChar(50)
  soldDate               DateTime? @map("sold_date") @db.Date
  soldPrice              Decimal?  @map("sold_price") @db.Decimal(12, 2)
  product                String?   @db.VarChar(191)
  type                   String?   @db.VarChar(191)
  wid                    String?   @db.VarChar(100)
  workType               String?   @map("work_type") @db.VarChar(191)
  footageLocation        String?   @map("footage_location") @db.VarChar(191)
  storageType            String?   @map("storage_type") @db.VarChar(100)
  footageLink            String?   @map("footage_link") @db.Text
  remarks                String?   @db.Text
  hardDiscBrand          String?   @map("hard_disc_brand") @db.VarChar(100)
  hardDiscColour         String?   @map("hard_disc_colour") @db.VarChar(80)
  hardDiscCapacity       String?   @map("hard_disc_capacity") @db.VarChar(50)
  items                  String?   @db.VarChar(191)
  footageSize            String?   @map("footage_size") @db.VarChar(50)
  hardDiskIn             String?   @map("hard_disk_in") @db.VarChar(40)
  labeled                Boolean   @default(false)
  footageBackup          Boolean   @default(false) @map("footage_backup")
  finalFilesCopy         Boolean   @default(false) @map("final_files_copy")
  harddiskFootagesBackup Boolean   @default(false) @map("harddisk_footages_backup")
  folderStructureChecked Boolean   @default(false) @map("folder_structure_checked")
  finalRenders           Boolean   @default(false) @map("final_renders")
  otherFilesInHarddisk   Boolean   @default(false) @map("other_files_in_harddisk")
  isDeleted              Boolean   @default(false) @map("is_deleted")
  deletedReason          String?   @map("deleted_reason") @db.Text
  deletedAt              DateTime? @map("deleted_at")
  createdBy              Int?      @map("created_by")
  updatedBy              Int?      @map("updated_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // A storage record belongs to one project. The shoot link is the specific shoot its footage
  // came from and stays optional, so a record created the moment a project starts survives until
  // the project has shoots to attach it to.
  project    SalesProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shoot      ProjectShoot? @relation(fields: [shootId], references: [id], onDelete: SetNull)
  assignedTo Employee?     @relation("ClientStorageAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  assignedByUser User? @relation("ClientStorageAssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)
