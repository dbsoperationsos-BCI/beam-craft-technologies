/// The brand an employee works under, maintained from the Employee Repository's settings.
/// The studio's verticals. Five rows: the three sales verticals (Dum Dum, Qua Qua, Corp) that have a
/// CRM board and a document code, plus Team 33 and General for the employee form, which have
/// neither. A lead may reference only the three - the write path checks `documentCode` is set.
///
/// The two short codes are what the studio actually prints: `documentCode` (WED / QQ / CORP) on
/// projects, quotations, CRD documents and WhatsApp group names, and `identifierCode` (DD / QQ /
/// CORP) inside every identifier - `DBS-EID-DD-ERD-000001`. Both were hard-coded maps
/// (`salesVertical.js`, `identifiers.js`) before they were columns; the maps still answer until
/// the readers move here.
model Vertical {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  documentCode   String?  @unique @map("document_code") @db.VarChar(10)
  identifierCode String?  @unique @map("identifier_code") @db.VarChar(10)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leads              SalesCrmLead[]
  salesProjects      SalesProject[]
  whatsappGroupNames SalesWhatsappGroupName[]
  crdDocuments       SalesProjectCrdDocument[]
  employees          Employee[]

  @@index([isActive, name])
  @@map("vertical")
}

/// The studio's bank accounts, chosen from rather than typed into a cash entry or a payment
/// request. It keeps the plain code/name/description shape the other master-data lists have, plus
/// the details paying into an account actually needs — holder, number, IFSC and type — and who
/// added or last changed it, because money leaves the studio through these columns.
///
/// The details are nullable: accounts recorded before they existed have a name and nothing else,
/// and a half-filled row is better than one that refuses to load. New accounts are asked for all
/// of them by the create schema in `master-data/definitions.js`.
///
/// `created_by` and `updated_by` are plain user ids rather than foreign keys, matching
/// `CashEntry.createdBy`: who did it stays true even once that user is gone.
model BankAccount {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(120)
  description       String?  @db.Text
  accountHolderName String?  @map("account_holder_name") @db.VarChar(191)
  accountNumber     String?  @map("account_number") @db.VarChar(20)
  ifscCode          String?  @map("ifsc_code") @db.VarChar(20)
  accountType       String?  @map("account_type") @db.VarChar(30)
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  createdByUser User? @relation("BankAccountCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("BankAccountUpdatedByUser", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([isActive, name])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("bank_account")
}

