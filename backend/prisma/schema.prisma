  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation("SalesGoogleAccountConnectionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([googleAccountId])
  @@index([googleEmail])
  @@index([status])
  @@map("sales_google_account_connection")
}

model SalesGoogleOAuthState {
