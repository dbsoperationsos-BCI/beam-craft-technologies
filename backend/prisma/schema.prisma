model Branch {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(120)
  description String? @db.Text

  /// Where the branch trades from, in the parts a postal address is actually made of rather than as
  /// one box of text. Kept apart so a document can print the city or the state on its own, and so
  /// two branches in the same city can be told apart by what is above it. Each part is optional,
  /// like everything else here: the parts arrive as they become known.
  addressLine1 String? @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)
  city         String? @db.VarChar(120)
  state        String? @db.VarChar(120)
  postalCode   String? @map("postal_code") @db.VarChar(10)
  isActive     Boolean @default(true) @map("is_active")

  /// The one branch the studio is registered from. At most one branch holds it, which the branches
  /// service keeps rather than a constraint - MySQL has no partial unique index.
  isHeadOffice Boolean @default(false) @map("is_head_office")

  /// What the branch is registered as, and how to reach it. All optional: a branch scoped a record
  /// long before it had any of this, and the register stays usable while it is filled in.
  gstNumber      String? @map("gst_number") @db.VarChar(15)
  panNumber      String? @map("pan_number") @db.VarChar(10)
  phone          String? @db.VarChar(20)
  /// A second number for the same branch - the landline beside the mobile, or whoever answers when
  /// the first does not. Optional like the first, and held to the same format.
  alternatePhone String? @map("alternate_phone") @db.VarChar(20)
  email          String? @db.VarChar(150)
  /// The branch's own web address, for the documents that print one. Optional like the email beside
  /// it, and stored exactly as it is written - the scheme, the case and any path are the studio's.
  websiteUrl     String? @map("website_url") @db.VarChar(255)

  /// Where the branch banks. Held on the branch rather than on the studio, because a studio with
  /// more than one branch may be paid into more than one account.
  bankAccountName   String? @map("bank_account_name") @db.VarChar(150)
  bankName          String? @map("bank_name") @db.VarChar(120)
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(18)
  bankIfsc          String? @map("bank_ifsc") @db.VarChar(11)

  /// The branch's payment QR code, as the link `storeImage` hands back once it has uploaded the
  /// picture - never the picture itself where object storage is configured. Optional like the
  /// account it stands beside: a branch that is paid by transfer alone has no QR to show.
  ///
  /// Text rather than a VarChar(500) because of the one case where it *is* the picture: a machine
  /// with no R2 keys gets the compressed image back as a data URI, which is a couple of hundred
  /// kilobytes and would be truncated by any VarChar. The gallery logo beside it holds a
  /// VarChar(500) and so cannot be saved at all on such a machine; this column does not repeat
  /// that.
  qrCodeUrl String? @map("qr_code_url") @db.MediumText

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  assets             Asset[]
  users              User[]
  employees          Employee[]
  roleBranches       RoleBranch[]
  /// The references added by 20260906150000, each beside a text column still in use.
  crmLeads           SalesCrmLead[]
  salesProjects      SalesProject[]
  quotations         SalesQuotation[]
  cashEntries        CashEntry[]
  paymentRequests    PaymentRequest[]
  tasks              HrmTask[]
  whatsappGroupNames SalesWhatsappGroupName[]
  attendanceOffice   AttendanceOfficeLocation[] @relation("AttendanceOfficeLocations")

  @@index([isActive, name])
  @@map("branch")
}

