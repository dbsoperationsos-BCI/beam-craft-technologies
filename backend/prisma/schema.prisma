model AssetStatusLog {
  id                  Int         @id @default(autoincrement())
  assetId             Int         @map("asset_id")
  previousStatus      AssetStatus @map("previous_status")
  nextStatus          AssetStatus @map("next_status")
  changeType          String      @map("change_type") @db.VarChar(40)
  changedByUserId     Int?        @map("changed_by_user_id")
  changedByEmployeeId String?     @map("changed_by_employee_id") @db.VarChar(50)
  changedByName       String?     @map("changed_by_name") @db.VarChar(150)
  reason              String?     @db.Text
  lostByName          String?     @map("lost_by_name") @db.VarChar(150)
  lostByEmployeeId    String?     @map("lost_by_employee_id") @db.VarChar(50)
  soldByName          String?     @map("sold_by_name") @db.VarChar(150)
  soldByEmployeeId    String?     @map("sold_by_employee_id") @db.VarChar(50)
  soldToName          String?     @map("sold_to_name") @db.VarChar(150)
  soldToContact       String?     @map("sold_to_contact") @db.VarChar(50)
  soldDate            DateTime?   @map("sold_date") @db.Date
  soldPrice           Decimal?    @map("sold_price") @db.Decimal(12, 2)
  // What kind of change this row records. Not mutually exclusive: moving an asset from Unassigned
  // to Active both changes its status and hands it to somebody, so that row sets each of them.
  isStatusChange      Boolean     @default(false) @map("is_status_change")
  isAssigneeChange    Boolean     @default(false) @map("is_assignee_change")
  // Who the asset moved between. Written for every change of custody, whether it came from a
  // status change or from editing the asset, so one query gives an asset's full custody history
  // and the reverse gives everything a person has held. Both null on a row that is only a status
  // change. Kept as columns rather than inside formData so they can be indexed and joined.
  assignedFromId      Int?        @map("assigned_from_id")
  assignedToId        Int?        @map("assigned_to_id")
  formData            Json?       @map("form_data")
  createdAt           DateTime    @default(now()) @map("created_at")
  asset               Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedFrom        Employee?   @relation("AssetLogAssignedFrom", fields: [assignedFromId], references: [id], onDelete: SetNull)
  assignedTo          Employee?   @relation("AssetLogAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  changedByUser User? @relation("AssetStatusLogChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([nextStatus])
  @@index([assignedToId])
  @@index([assignedFromId])
  @@index([assetId, isAssigneeChange])
  @@index([changedByUserId])
  @@map("asset_status_log")
}

