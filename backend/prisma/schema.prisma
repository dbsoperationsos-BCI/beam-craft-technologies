  @@index([createdAt])
  @@index([uploadedByUserId])
  @@map("project_attachment")
}

model ImageSelectionProject {
  id                       String                               @id @default(cuid())
  /// DBS-VCIS-000001 - one run of numbers for the studio. A gallery belongs to the client, and the
  /// sales project behind it already says which branch and vertical it came from, so this carries
  /// neither. Nullable only for the rows that predate it. Minted by `services/identifiers.js`.
  projectCode              String?                              @unique @map("project_code") @db.VarChar(40)
  projectName              String                               @map("project_name") @db.VarChar(500)
  sourceType               String                               @default("Manual") @map("source_type") @db.VarChar(20)
  // Which section of the module owns this project: false = the Projects page, true = Album
  // Proofing. The two sidebars share one table and one API but list disjoint sets, so the
  // Album Proofing page starts empty rather than mirroring every Image Selection project.
  albumProofing            Boolean                              @default(false) @map("album_proofing")
  // Unique per section, not per table: the same Sales Manager project can back one Projects-page
  // project AND one Album Proofing project, which live in disjoint sidebars.
  salesProjectId           String?                              @map("sales_project_id")
  // Client details for a project with no linked Sales Manager project. A "Manual" or
  // "Duplicate" project has no SalesProject to read the client from, so the studio enters
  // the name and WhatsApp number here instead. Both stay null on a "Sales" project, which
  // always reads the linked SalesProject so the two can never disagree.
  clientName               String?                              @map("client_name") @db.VarChar(191)
  clientMainNumber         String?                              @map("client_main_number") @db.VarChar(30)
  status                   String                               @default("New") @db.VarChar(30)
  // Which workspace tabs a manually named project was created with, chosen on the Create New
  // Project form. A linked project earns its tabs from the Post Production Allocation and the
  // Deliverables table instead, so all three stay null there. Null on an older manual project
  // means the default it always had: Photo Selection on, the other two off.
  photoSelectionTab        Boolean?                             @map("photo_selection_tab")
  photoCullingTab          Boolean?                             @map("photo_culling_tab")
  signatureAlbumTab        Boolean?                             @map("signature_album_tab")
  // The AI Editing tab, ticked on the same form. Null - a manual project from before the tab
  // existed, or an older client that never sent the tick - reads as ON, as `photoCullingTab`'s
  // null does: every project walks AI Culling → AI Editing → Photo Selection → Signature Album,
  // and only an explicit untick takes a tab away.
  aiEditingTab             Boolean?                             @map("ai_editing_tab")
  selectionValidUntil      DateTime?                            @map("selection_valid_until")
  selectionValidityEnabled Boolean                              @default(true) @map("selection_validity_enabled")
  allowPhotoSelection      Boolean                              @default(true) @map("allow_photo_selection")
  publicSlug               String?                              @unique @map("public_slug") @db.VarChar(191)
  archivedAt               DateTime?                            @map("archived_at")
  lastOpenedAt             DateTime?                            @map("last_opened_at")
  // When the studio last took the client's selected originals out - the server copying them to
  // the Selected Output Path, or the browser's Download Selected finishing. Read by the dashboard
  // against the latest submission; null on every project from before it existed.
  selectedDownloadedAt     DateTime?                            @map("selected_downloaded_at")
  totalPhotoSize           BigInt                               @default(0) @map("total_photo_size")
  publishVersion           Int                                  @default(1) @map("publish_version")
  // The WhatsApp group the gallery invite is sent into: the group the studio already runs with
  // this client, picked in the Selection Settings rail from the groups the coordinator's own
  // paired WhatsApp is in - by default the one named like the project. The subject is what the
  // group was called when it was linked, kept so the rail can say which group without asking
  // WhatsApp. One live project per group, held by the service rather than a unique index, so an
  // archived or deleted project does not keep a group from its successor.
  whatsappGroupJid         String?                              @map("whatsapp_group_jid") @db.VarChar(64)
  whatsappGroupSubject     String?                              @map("whatsapp_group_subject") @db.VarChar(500)
  whatsappGroupLinkedAt    DateTime?                            @map("whatsapp_group_linked_at")
  createdByUserId          Int?                                 @map("created_by_user_id")
  deletedAt                DateTime?                            @map("deleted_at")
  createdAt                DateTime                             @default(now()) @map("created_at")
  updatedAt                DateTime                             @updatedAt @map("updated_at")
  salesProject             SalesProject?                        @relation(fields: [salesProjectId], references: [id], onDelete: Restrict)
  folders                  ImageSelectionFolder[]
  albumProofs              AlbumProof[]
  uploads                  ImageSelectionUpload[]
  galleryPublication       ImageSelectionGalleryPublication?
  uploadBatches            ImageSelectionUploadBatch[]
  deliverableConfigs       ImageSelectionDeliverableConfig[]
  whatsAppNotifications    ImageSelectionWhatsAppNotification[]
  // The People filter's own rows (faces/). Back-relations only: nothing here changes what a
  // project is, and the rows cascade from the project so a purge can never strand them.
  faceScans                ImageSelectionFaceScan[]
  facePeople               ImageSelectionFacePerson[]
  faceMappings             ImageSelectionFaceMapping[]
  // The project's Signature Album (signature-album/). A back-relation only: the album is a
  // consumer of the project's photos, holds its own status, link and PIN, and cascades from the
  // project so a purge takes it without the delete paths knowing it exists.
  signatureAlbum           SignatureAlbum?
  cullingSessions          ImageSelectionCullingSession[]
  edits                    ImageSelectionEdit[]

  createdByUser User? @relation("ImageSelectionProjectCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Disabled from Expand: while set, the project takes no uploads, is not published, re-published
  /// or sent to the client, and its published link is paused - its photos, selections, URL, PIN and
  /// expiry all kept, and working again the moment it is enabled. One state for everyone; null on
  /// every project until somebody with Project Management Read / Write disables it.
  disabledAt       DateTime? @map("disabled_at")
  disabledByUserId Int?      @map("disabled_by_user_id")
  disabledByUser   User?     @relation("ImageSelectionProjectDisabledByUser", fields: [disabledByUserId], references: [id], onDelete: SetNull)

  whatsappActivities       WhatsAppActivity[]
  // The AI Culling, AI Editing and Signature Album projects made on this photo workspace - one per
  // module at most (`VisualCurationModuleProject`). Photo Selection's project is this row itself.
  moduleProjects           VisualCurationModuleProject[]
  // Pairs of this workspace's modules that were unlinked from each other (`VisualCurationModuleLink`).
  moduleLinks              VisualCurationModuleLink[]

  @@unique([salesProjectId, albumProofing], map: "image_selection_project_sales_section_unique")
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([disabledByUserId])
  @@index([status, archivedAt])
  @@index([whatsappGroupJid])
  @@index([albumProofing], map: "image_selection_project_album_proofing_idx")
  @@map("image_selection_project")
}

/// A Visual Curation module's own project - AI Culling, AI Editing or Signature Album - on the
/// photo workspace it works over (`image_selection_project`, which is also Photo Selection's own
/// project). Each has its own ID (DBS-VCAC / VCAE / VCSA, `services/identifiers.js`), its own name
/// and client - copied from the Create Project form, edited apart afterwards - and is listed,
/// edited and deleted only in its own module. The records on one workspace are the projects created
/// together from one form, linked by that and nothing else: never by a matching name. The photos,
/// runs, edits and album stay on the workspace, so every send between modules works as it did.
/// One per module per workspace; deleting one removes that module from the workspace (its
/// `*_tab` tick) and keeps its photos and results.
model VisualCurationModuleProject {
  id                      String                @id @default(cuid())
  imageSelectionProjectId String                @map("image_selection_project_id")
  /// "culling", "editing" or "album" - `projects/modules.js`.
  module                  String                @db.VarChar(20)
  projectCode             String                @unique @map("project_code") @db.VarChar(40)
  projectName             String                @map("project_name") @db.VarChar(500)
  /// Copies of what the Create Project form was given, this module's own from then on: the
  /// client of a manual project has no record of its own to link to (as `image_selection_project`).
  clientName              String?               @map("client_name") @db.VarChar(191)
  clientMainNumber        String?               @map("client_main_number") @db.VarChar(30)
  createdByUserId         Int?                  @map("created_by_user_id")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  imageSelectionProject   ImageSelectionProject @relation(fields: [imageSelectionProjectId], references: [id], onDelete: Cascade)
  createdByUser           User?                 @relation("VisualCurationModuleProjectCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([imageSelectionProjectId, module], map: "vc_module_project_workspace_module_unique")
  @@index([module], map: "vc_module_project_module_idx")
  @@index([createdByUserId], map: "vc_module_project_created_by_user_id_idx")
  @@map("visual_curation_module_project")
}

/// Whether two modules' projects on one photo workspace are linked - Edit Project's Linked Modules
/// (`projects/moduleLinks.js`). Projects made together are linked, and that needs no row: a row
/// exists once a pair has been unticked, and says so while `unlinkedAt` is set. Ticking the pair
/// again clears it - the same two projects, never a new one. Unlinking stops sends between the two
/// modules and nothing else: every project, photo, run, edit and album stays as it is.
model VisualCurationModuleLink {
  id                      String                @id @default(cuid())
  imageSelectionProjectId String                @map("image_selection_project_id")
  /// The pair, in alphabetical order: two of "album", "culling", "editing", "photos".
  moduleA                 String                @map("module_a") @db.VarChar(20)
  moduleB                 String                @map("module_b") @db.VarChar(20)
  /// When the pair was unlinked, and by whom; null once it is linked again.
  unlinkedAt              DateTime?             @map("unlinked_at")
  unlinkedByUserId        Int?                  @map("unlinked_by_user_id")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  imageSelectionProject   ImageSelectionProject @relation(fields: [imageSelectionProjectId], references: [id], onDelete: Cascade)
  unlinkedByUser          User?                 @relation("VisualCurationModuleLinkUnlinkedByUser", fields: [unlinkedByUserId], references: [id], onDelete: SetNull)

  @@unique([imageSelectionProjectId, moduleA, moduleB], map: "vc_module_link_workspace_pair_unique")
  @@index([unlinkedByUserId], map: "vc_module_link_unlinked_by_user_id_idx")
  @@map("visual_curation_module_link")
}

model ImageSelectionGalleryPublication {
  id                   String                @id @default(cuid())
  projectId            String                @unique @map("project_id")
  tokenHash            String                @unique @map("token_hash") @db.Char(64)
  tokenCipher          String                @map("token_cipher") @db.Text
  // The public identifier in the short client URL (gallery.dontblinkstudioz.com/<code>). Random,
  // never derived from ids, and permanent for the life of the publication row — republishing
  // upserts around it, so a client's saved link keeps working. It is NOT a credential: the PIN,
  // publish status and expiry still gate the gallery exactly as they do for the long token.
  shortCode            String?               @unique @map("short_code") @db.VarChar(8)
  pinHash              String?               @map("pin_hash") @db.Char(64)
  pinCipher            String?               @map("pin_cipher") @db.Text
  status               String                @default("PUBLISHED") @db.VarChar(30)
  publishedByUserId    Int?                  @map("published_by_user_id")
  publishedAt          DateTime              @default(now()) @map("published_at")
  expiresAt            DateTime?             @map("expires_at")
  revokedAt            DateTime?             @map("revoked_at")
  /// Why it was revoked: MANUAL (Publish Status turned off), EXPIRED, or EMPTY (no client-visible photo
  /// left - `publication/availability.js`). Only EMPTY is published again by itself, with its token,
  /// PIN and short code, when a photo is back. Null on a row revoked before this was recorded, which is
  /// never undone automatically; cleared when the gallery is published again.
  revokedReason        String?               @map("revoked_reason") @db.VarChar(20)
  selectionSubmittedAt DateTime?             @map("selection_submitted_at")
  // When the client first and last opened the gallery link (any load of their page), and when
  // they last did something in it — picked or unpicked a photo, or sent a selection item. Stamped
  // by the public gallery routes, read by the Image Selection dashboard's Needs Attention rows.
  // Null on every publication from before they existed, which reads as "not recorded".
  galleryFirstOpenedAt DateTime?             @map("gallery_first_opened_at")
  galleryLastOpenedAt  DateTime?             @map("gallery_last_opened_at")
  lastClientActivityAt DateTime?             @map("last_client_activity_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  project              ImageSelectionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  publishedByUser User? @relation("ImageSelectionGalleryPublicationPublishedByUser", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([publishedByUserId])
  @@map("image_selection_gallery_publication")
}

model ImageSelectionFolder {
  id              String                      @id @default(cuid())
  projectId       String                      @map("project_id")
  parentId        String?                     @map("parent_id")
  projectShootId  String?                     @unique @map("project_shoot_id")
  name            String                      @db.VarChar(191)
  sortOrder       Int                         @default(0) @map("sort_order")
  createdByUserId Int?                        @map("created_by_user_id")
  deletedAt       DateTime?                   @map("deleted_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  project         ImageSelectionProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectShoot    ProjectShoot?               @relation(fields: [projectShootId], references: [id], onDelete: SetNull)
  parent          ImageSelectionFolder?       @relation("ImageSelectionFolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        ImageSelectionFolder[]      @relation("ImageSelectionFolderHierarchy")
  uploads         ImageSelectionUpload[]
  uploadBatches   ImageSelectionUploadBatch[]
  albumProofRoot  AlbumProof?
  cullingSessions ImageSelectionCullingSession[]
  // The typed selection items a manual project files under this root folder as their shoot.
  manualShootItems ImageSelectionDeliverableConfig[] @relation("DeliverableConfigManualShootFolder")

