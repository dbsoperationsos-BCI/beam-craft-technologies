// A persistent sign-in (the desktop app's "stay signed in"): one row per issued refresh token,
// valid for a fixed window from creation — no rolling extension. The raw token exists only in
// the client's OS credential store; only its SHA-256 lands here, so a database read never
// yields a usable credential. Revocation is a stamp, not a delete, so a stolen-token story can
// still be read afterwards.
/// One continuous stretch of somebody actually using the application.
///
/// The usage reports used to infer time on task from the gaps between recorded lead actions, which
/// answers a different question from the one the studio asks: a person who saved a lead, spent
/// twelve minutes in their inbox and saved another read as thirteen minutes of work here. What is
/// wanted is time in *this* application - the tab in front of them, being used.
///
/// So it is measured rather than inferred. The browser beats while the tab is visible and the
/// person has interacted recently; each beat extends the open stretch, and a beat that arrives
/// after too long a silence starts a new one. Nothing is written while the tab is in the
/// background, and nothing is written by a tab left open on an empty desk.
///
/// `context` is what they were using: "app" for the application at large, "whatsapp" while the chat
/// panel is open. One person can have both open at once, which is why they are separate rows rather
/// than one with a label - the WhatsApp usage report reads its own context and the application
/// report reads all of them.
model AppUsageSession {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  context   String   @default("app") @db.VarChar(30)
  startedAt DateTime @map("started_at")
  /// Moved forward by every beat, so the row is the stretch so far rather than a finished one.
  endedAt   DateTime @map("ended_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("AppUsageSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, context, endedAt])
  @@index([endedAt])
  @@map("app_usage_session")
}

/// One request a signed-in person made, for Administration → User Activity Logs.
///
/// Written by `src/middleware/activityLog.js` once the response has finished, and by the sign-in and
/// sign-out handlers for the Auth events (`src/services/activityLog.js`). Never written inside the
/// request it describes, so a failed write cannot slow or break that request.
///
/// `username` is a **snapshot**, not a name copy: the login as it was typed or held at the moment of
/// the request. An audit line says who did something at the time, so it is deliberately absent from
/// `nameCopies.js` (a rename must not rewrite history) and from `RESOLVED_NAMES`; the person's
/// current name is read through `user` instead. A failed sign-in has no `userId` and keeps only the
/// identifier that was typed.
///
/// `branchId` is the person's home branch at the time, which is what the list narrows on for a
/// viewer whose roles reach only some branches. `path` is the matched route pattern
/// (`/api/sales/crm-leads/:id`), never the raw URL: no ids, no query string, nothing typed.
///
/// Rows older than `ACTIVITY_LOG_RETENTION_DAYS` (90 by default) are deleted daily.
model UserActivityLog {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  userId     Int?     @map("user_id")
  username   String?  @db.VarChar(191)
  branchId   Int?     @map("branch_id")
  module     String   @db.VarChar(100)
  action     String   @db.VarChar(150)
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(500)
  statusCode Int      @map("status_code")
  clientIp   String?  @map("client_ip") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  durationMs Int?     @map("duration_ms")
  /// **What the write actually changed**, where the handler said so - "Main Event Date: 20 Nov 2026 →
  /// 22 Nov 2026 · Production Manager: — → Karthik". Null on every line whose handler did not, which
  /// is most of them.
  ///
  /// The log is otherwise an access log: method, route pattern, status, never a body, a query string,
  /// a token or a password (`services/activityLog.js`). That guarantee is kept by making this
  /// **opt-in per handler** - nothing is captured unless a handler hands it over, so an endpoint
  /// carrying a password or a bank account says nothing by default rather than by exclusion.
  ///
  /// It is deleted with its line by Settings → Activity Log Purge, which is why a record whose
  /// history has to outlive a purge keeps its own trail (`project_activity`).
  changes    String?  @db.Text

  user   User?   @relation("UserActivityLogUser", fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation("UserActivityLogBranch", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([branchId, createdAt])
  @@map("user_activity_log")
}

/// One person's attendance for one day.
///
/// ── Why a row exists at all, when the sessions already say ──
///
/// `AppUsageSession` beside this already measures when somebody was working and for how long, and
/// the Work Hours report reads it as a timesheet. That answers "were they in the application", which
/// is most of attendance and none of the rest: it cannot say that a day was approved leave, a public
/// holiday, a half day, or a day somebody spent on a shoot with no laptop open.
///
/// So attendance is *derived* from the sessions by default and this table is what overrides it. A
/// day with no row here reads as whatever the person's own activity says - present, with the hours
/// they worked - and a day with one reads as what somebody wrote down. Nothing has to be entered
/// for the ordinary case, which is what makes the register right rather than merely present.
///
/// ── One row per person per day ──
///
/// `@@unique([userId, day])` is the whole integrity of this table. Attendance answers one question
/// per day, and two rows for one day is two answers with no rule for which wins - so marking a day
/// twice updates the day rather than adding to it.
///
/// `day` is a date and not a moment on purpose. A day is the unit attendance is kept in, and storing
/// a timestamp would make "the 5th" depend on the timezone it was read in.
model EmployeeAttendance {
  id     String   @id @default(cuid())
  userId Int      @map("user_id")
  day    DateTime @db.Date

  /// PRESENT, ABSENT, HALF_DAY, LEAVE, HOLIDAY or WEEK_OFF. Held as text rather than as an enum for
  /// the reason every other status in this schema is: the studio adds one, and an enum is a
  /// migration to do it.
  status String @default("PRESENT") @db.VarChar(20)

  /// When they started and finished, where anybody knows. Filled from the day's measured sessions
  /// when attendance is taken automatically, and editable when it is corrected by hand - somebody
  /// who was on a shoot until six has hours nothing in this application could have measured.
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")

  /// The minutes actually worked, as the register understands them. Stored rather than recomputed so
  /// a corrected day keeps the figure somebody agreed to, and so the register does not have to read
  /// the session table to draw a month.
  workedMinutes Int? @map("worked_minutes")

  /// Why the day reads as it does - "Sick leave", "Site visit". The one field a register is
  /// worthless without: an absence with no reason is a question rather than a record.
  note String? @db.Text

  /// Who wrote it down. Null for a day nobody has corrected, which is how a stored row can still be
  /// told from a derived one after the fact.
  markedByUserId Int?     @map("marked_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation("EmployeeAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)

  markedByUser User? @relation("EmployeeAttendanceMarkedByUser", fields: [markedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, day])
  /// The register reads a month for everybody, and the calendar reads a range - both lead with the
  /// day, so it leads the index.
  @@index([day])
  @@index([markedByUserId])
  @@map("employee_attendance")
}

/// How the application decides somebody has stopped using it.
///
/// One row, keyed "default", the same shape as ImageSelectionSettings and SalesQuotationSettings:
/// these are the studio's settings rather than a user's, so there is nothing to key them by.
///
/// The timeout was a constant compiled into the browser bundle, which meant changing it was a
/// deploy and every tab could disagree with every other until they were all reloaded. Held here it
/// is one number the whole studio reads, and the heartbeat asks for it rather than assuming it.
model AppMonitoringSettings {
  id                  String   @id @default("default") @db.VarChar(30)
  /// How long after somebody's last interaction they still count as using the application.
  /// Minutes, because that is the unit an administrator thinks in and types.
  usageTimeoutMinutes Int      @default(3) @map("usage_timeout_minutes")
  updatedByUserId     Int?     @map("updated_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  updatedByUser User? @relation("AppMonitoringSettingsUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("app_monitoring_settings")
}

model AuthSession {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  client     String    @default("desktop") @db.VarChar(30)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("auth_session")
}

/// How one login has arranged the application for itself: the order its columns were dragged into,
/// which of them it hid, how many it froze, how wide it pulled them, the density it reads at, and
/// the tab each screen was left on.
///
/// This is per user rather than per browser because the studio works from more than one machine
/// and expects the layout it built to be waiting on the next one. It is one row per `key` rather
/// than a single blob on `user` so two tabs arranging two different tables cannot overwrite each
/// other, and so a single table can be reset without rewriting everything else.
///
/// Nothing here is business data. A row lost, or never written because storage was refused, costs
/// the reader a layout and nothing more - which is why every read of it falls back rather than
/// failing.
model UserPreference {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the value describes, namespaced by kind: `table:<slug>` for one table's layout,
  /// `app:compactView` for the density every table follows, `tab:<screen>` for a remembered tab.
  /// The namespaces are the frontend's; this column only holds them.
  key   String @db.VarChar(120)
  /// The preference itself, whatever shape its key implies. Validated on the way in by
  /// `modules/user/preferences/service.js`, never trusted on the way out.
  value Json

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preference")
}

model Employee {
  id                             Int                     @id @default(autoincrement())
  employeeId                     String                  @unique @map("employee_id") @db.VarChar(50)
  employeeName                   String                  @map("employee_name") @db.VarChar(150)
  /// The names this person was called before a rename, as a list of strings, written by
  /// `nameCopies.renameEmployeeCopies` at the moment of the rename. `referenceMatchers` resolves a
  /// former full name to this row unless somebody now holds it, so a sheet's CRM column still
  /// carrying the old name keeps pointing at the same person.
  aliases                        Json?
  /// The login username of the account this employee holds - `User.username`, mirrored onto this
  /// row the moment an account is created (`createLoginCredentials`) or the login changes its own
  /// username (`PATCH /api/user/profile`), the only two places `User.username` is ever written.
  /// NULL until an account exists.
  ///
  /// Not a second place a username is *decided* - it is still created and changed on `User` alone,
  /// which is what keeps one account from having two answers to "what is my username." This is a
  /// read copy, kept in step by the same code that writes the original, so that everything that
  /// only needs to *look up* an employee by their login - the CRM's Google Sheet sync foremost -
  /// reads one table instead of joining to `User` for it. See `referenceMatchers.js`.
  loginUsername                  String?                 @unique @map("login_username") @db.VarChar(50)
  employmentStatus               String                  @default("pending") @map("employment_status") @db.VarChar(30)
  gender                         String?                 @db.VarChar(30)
  contactNumber                  String?                 @map("contact_number") @db.VarChar(30)
  /// The company-issued phone number, where the studio has given this person one - distinct from
  /// `contactNumber`, which is theirs. Optional: most employees are never issued one.
  companyGivenNumber             String?                 @map("company_given_number") @db.VarChar(30)
  emailId                        String?                 @map("email_id") @db.VarChar(191)
  workEmailId                    String?                 @map("work_email_id") @db.VarChar(191)
  dateOfJoining                  DateTime?               @map("date_of_joining")
  designation                    String?                 @db.VarChar(150)
  /// Several, joined by ", " the way `skills` and `languagesKnown` are - the form asks for them
  /// with the same searchable multi-select, and fifteen of them do not fit a VarChar(150).
  department                     String?                 @db.Text
  skills                         String?                 @db.Text
  vertical                       String?                 @db.VarChar(150)
  verticalId                     Int?                    @map("vertical_id")
  /// References beside the master-data text above - designation, work type, gender, blood group,
  /// marital status, emergency-contact relationship and the two work locations - derived on every
  /// write by `services/employeeReferences.js` and backfilled by 20260924120000. NULL where the text
  /// names nothing on the list, or two rows of it. The text stays what the API carries and the
  /// screens print until the readers move (DATA-SCOPE.md D36); the reference is what a rename
  /// follows and a filter can index. Department, skills and languages hold several and are rows of
  /// their own: EmployeeDepartment, EmployeeSkill, EmployeeLanguage.
  designationId                  Int?                    @map("designation_id")
  workTypeId                     Int?                    @map("work_type_id")
  genderId                       Int?                    @map("gender_id")
  bloodGroupId                   Int?                    @map("blood_group_id")
  maritalStatusId                Int?                    @map("marital_status_id")
  emergencyContactRelationshipId Int?                    @map("emergency_contact_relationship_id")
  workBaseLocationId             Int?                    @map("work_base_location_id")
  currentWorkLocationId          Int?                    @map("current_work_location_id")
  workBaseLocation               String?                 @map("work_base_location") @db.VarChar(150)
  currentWorkLocation            String?                 @map("current_work_location") @db.VarChar(150)
  /// The branch as a reference. NULL until the match report decides how the two text columns above
  /// map onto `branch` (DATA-SCOPE.md, Stage 6); readers honour it where set and fall back to the
  /// text where not.
  branchId                       Int?                    @map("branch_id")
  photoShooter                   Boolean?                @map("photo_shooter")
  workType                       String?                 @map("work_type") @db.VarChar(100)
  /// Resident or Non-Resident, as the payslip prints it - asked in Edit Employee → Payslip Details.
  residentialStatus              String?                 @map("residential_status") @db.VarChar(30)
  /// Edit Employee → Payslip Details → Personal Details, typed by HR and printed on the payslip as typed:
  /// `{ empCode, empName, department, designation, location, dateOfBirth, dateOfJoining, pan, bankAccount }`.
  payslipPersonalDetails         Json?                   @map("payslip_personal_details")
  /// Payslip Details → PF Details, typed by HR off the employee's PF and ESI records: the PF and EPS
  /// numbers (TN/MAS/0012345/000/0000123), the twelve-digit UAN, and the ESI number (10 or 17 digits).
  pfNumber                       String?                 @map("pf_number") @db.VarChar(30)
  uanNumber                      String?                 @map("uan_number") @db.VarChar(12)
  epsNumber                      String?                 @map("eps_number") @db.VarChar(30)
  esiNumber                      String?                 @map("esi_number") @db.VarChar(17)
  languagesKnown                 String?                 @map("languages_known") @db.Text
  /// Wide enough for whatever the studio puts on the Blood Groups list, not just the eight the
  /// browser used to offer: the list is maintained in Settings -> Field Settings and a name
  /// there may run to 120 characters, so a ten-character column would have taken "AB Positive"
  /// and stored eleven characters of it. Sized like `marital_status` beside it.
  bloodGroup                     String?                 @map("blood_group") @db.VarChar(50)
  emergencyContactName           String?                 @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactNumber         String?                 @map("emergency_contact_number") @db.VarChar(30)
  emergencyContactRelationship   String?                 @map("emergency_contact_relationship") @db.VarChar(100)
  aadharCardNumber               String?                 @map("aadhar_card_number") @db.VarChar(50)
  panCardNumber                  String?                 @map("pan_card_number") @db.VarChar(50)
  /// The Aadhaar and PAN photographs a candidate uploads during onboarding. Normally a link into
  /// object storage, but wide enough for the compressed data URI that stands in for one when object
  /// storage is not configured, the way the asset photo column does.
  aadharCardImageUrl             String?                 @map("aadhar_card_image_url") @db.MediumText
  panCardImageUrl                String?                 @map("pan_card_image_url") @db.MediumText
  /// The employee's own photograph, taken during onboarding and stored the same way as the two
  /// proofs beside it: a link into object storage, wide enough for the compressed data URI that
  /// stands in when object storage is not configured.
  profilePhotoUrl                String?                 @map("profile_photo_url") @db.MediumText
  fatherName                     String?                 @map("father_name") @db.VarChar(150)
  fatherOccupation               String?                 @map("father_occupation") @db.VarChar(150)
  motherName                     String?                 @map("mother_name") @db.VarChar(150)
  motherOccupation               String?                 @map("mother_occupation") @db.VarChar(150)
  spouseName                     String?                 @map("spouse_name") @db.VarChar(150)
  dateOfBirth                    DateTime?               @map("date_of_birth")
  maritalStatus                  String?                 @map("marital_status") @db.VarChar(50)
  weddingAnniversary             DateTime?               @map("wedding_anniversary")
  currentAddress                 String?                 @map("current_address") @db.Text
  permanentAddress               String?                 @map("permanent_address") @db.Text
  reference1PersonName           String?                 @map("reference1_person_name") @db.VarChar(150)
  reference1PersonPhone          String?                 @map("reference1_person_phone") @db.VarChar(30)
  reference1PersonAddress        String?                 @map("reference1_person_address") @db.Text
  reference2PersonName           String?                 @map("reference2_person_name") @db.VarChar(150)
  reference2PersonPhone          String?                 @map("reference2_person_phone") @db.VarChar(30)
  reference2PersonAddress        String?                 @map("reference2_person_address") @db.Text
  nominee1PersonName             String?                 @map("nominee1_person_name") @db.VarChar(150)
  nominee1PersonPhone            String?                 @map("nominee1_person_phone") @db.VarChar(30)
  nominee2PersonName             String?                 @map("nominee2_person_name") @db.VarChar(150)
  nominee2PersonPhone            String?                 @map("nominee2_person_phone") @db.VarChar(30)
  /// The two colleagues who cover this person's work while they are away. Employees rather than
  /// typed names, unlike the references and nominees above, because the cover is somebody the OS
  /// already holds a record of — and `onDelete: SetNull` so removing one of them empties the slot
  /// rather than refusing the deletion.
  alternative1EmployeeId         Int?                    @map("alternative1_employee_id")
  alternative2EmployeeId         Int?                    @map("alternative2_employee_id")
  /// Up to three colleagues who approve this person's leave requests, in order. Employee
  /// references like the alternatives above, set from the Leave Approval section of the
  /// credential form.
  leaveApprover1EmployeeId       Int?                    @map("leave_approver1_employee_id")
  leaveApprover2EmployeeId       Int?                    @map("leave_approver2_employee_id")
  leaveApprover3EmployeeId       Int?                    @map("leave_approver3_employee_id")
  /// The one colleague who approves this person's permission requests — an hour or two out of a
  /// single day, which the studio settles with one person rather than the queue of three a leave
  /// goes through. Left empty the permission falls to the leave approvers above, so a record nobody
  /// has filled this in on still has somebody who can decide.
  permissionApproverEmployeeId   Int?                    @map("permission_approver_employee_id")
  /// The one colleague who approves this person's Attendance Regularization requests. Left empty, a
  /// regularization goes to the Permission Approver above, as it did before this slot existed.
  regularizationApproverEmployeeId Int?                  @map("regularization_approver_employee_id")
  /// Employee Preference → Exclude → Exclude From Attendance: kept out of the Attendance module
  /// altogether - not listed, not counted, their days and details not shown there.
  excludeFromAttendance            Boolean               @default(false) @map("exclude_from_attendance")
  /// Employee Preference → Attendance → Allow Flexible Shift: offered the Flexible Shift work mode at
  /// login - any start time, the day judged on its hours alone, never Late or Early exit.
  allowFlexibleShift               Boolean               @default(false) @map("allow_flexible_shift")
  /// The person this employee reports to — one manager, which is what makes the reporting map a
  /// tree rather than a graph. A self-relation like the alternatives above, and `onDelete: SetNull`
  /// so removing a manager leaves their reports without one rather than refusing the deletion.
  /// A row with this empty is a root of the chart.
  reportsToEmployeeId            Int?                    @map("reports_to_employee_id")
  bankName                       String?                 @map("bank_name") @db.VarChar(150)
  bankLocation                   String?                 @map("bank_location") @db.VarChar(150)
  accountNumber                  String?                 @map("account_number") @db.VarChar(100)
  ifscCode                       String?                 @map("ifsc_code") @db.VarChar(30)
  bankAccountStatus              String?                 @map("bank_account_status") @db.VarChar(50)
  addedAccounts                  String?                 @map("added_accounts") @db.Text
  companyMentionedName           String?                 @map("company_mentioned_name") @db.VarChar(150)
  dateOfRelieving                DateTime?               @map("date_of_relieving")
  relievingRemarks               String?                 @map("relieving_remarks") @db.Text
  totalSalary                    Decimal?                @map("total_salary") @db.Decimal(12, 2)
  joiningSalary                  Decimal?                @map("joining_salary") @db.Decimal(12, 2)
  lastReviewDate                 DateTime?               @map("last_review_date")
  nextReviewDate                 DateTime?               @map("next_review_date")
  totalIncrement                 Decimal?                @map("total_increment") @db.Decimal(12, 2)
