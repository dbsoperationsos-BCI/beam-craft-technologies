  deletedAt                DateTime?    @map("deleted_at")
  createdBy                Int?         @map("created_by")
  updatedBy                Int?         @map("updated_by")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  @@index([vendorName])
  @@index([vendorType])
  @@index([status, isDeleted])
  @@index([createdAt])
  @@map("vendor")
}

/// Client Storage Management. Scaffolded with audit columns only - the domain fields that
/// describe what is stored for a client are still to be defined.
/// One hard disc handed to or held for a client, tied to the shoot whose footage it carries.
/// Shoot ID, Date Created, Client Name, Project Status, Shoot, Main Event Date, Source Branch,
/// CRM and the three coordinators are NOT stored here: they are read through `shoot` so a
/// storage record can never drift from the shoot it belongs to.
model ClientStorage {
  id                     Int       @id @default(autoincrement())
  storageId              String    @unique @map("storage_id") @db.VarChar(30)
  projectId              String?   @map("project_id")
  shootId                String?   @map("shoot_id")
  // Where the record has reached. Allowed moves are declared in client-storage.controller.js;
  // "Footage BackUp not done" is only ever reached by the overdue sweep, never chosen by hand.
  status                 String    @default("Yet to Receive") @db.VarChar(40)
  isShootStatusPending   Boolean   @default(false) @map("is_shoot_status_pending")
  // Who post production handed the disc to. The name is kept alongside the link so the record
  // still reads correctly if the employee is later archived.
  assignedToId           Int?      @map("assigned_to_id")
  assignedToName         String?   @map("assigned_to_name") @db.VarChar(150)
  assignedAt             DateTime? @map("assigned_at")
  assignedById           Int?      @map("assigned_by_id")
  // Recorded when the disc is handed over and starts travelling, mirroring the asset In Transit
  // step. The upload columns hold `{ name, url }` entries the same way Asset.documents does, so
  // the files live in object storage rather than as base64 inside the row.
  // Photographed as the disc goes out, on the move from "Footage Backup Done" to "HDD Out".
  hddOutPhoto            Json?     @map("hdd_out_photo")
  transitCondition       String?   @map("transit_condition") @db.VarChar(40)
  transitDamageRemarks   String?   @map("transit_damage_remarks") @db.Text
  transitCurrentPhoto    Json?     @map("transit_current_photo")
  transferFrom           String?   @map("transfer_from") @db.VarChar(191)
  transferTo             String?   @map("transfer_to") @db.VarChar(191)
  sentBy                 String?   @map("sent_by") @db.VarChar(150)
  sentByPhone            String?   @map("sent_by_phone") @db.VarChar(30)
  receivedBy             String?   @map("received_by") @db.VarChar(150)
  receivedByPhone        String?   @map("received_by_phone") @db.VarChar(30)
  courierService         String?   @map("courier_service") @db.VarChar(150)
  trackingNumber         String?   @map("tracking_number") @db.VarChar(100)
  shipmentDateTime       DateTime? @map("shipment_date_time")
  shipmentEta            DateTime? @map("shipment_eta")
  courierCharge          Decimal?  @map("courier_charge") @db.Decimal(12, 2)
  shipmentType           String?   @map("shipment_type") @db.VarChar(40)
  courierReceipt         Json?     @map("courier_receipt")
  packagePhoto           Json?     @map("package_photo")
  transferReason         String?   @map("transfer_reason") @db.Text
  specialInstructions    String?   @map("special_instructions") @db.Text
  // A disc that is sold rather than delivered. The same details the asset Sold status records,
  // as columns here because a storage record has no status log of its own to hold them.
  soldByName             String?   @map("sold_by_name") @db.VarChar(150)
  soldByEmployeeId       String?   @map("sold_by_employee_id") @db.VarChar(50)
  soldToName             String?   @map("sold_to_name") @db.VarChar(150)
  soldToContact          String?   @map("sold_to_contact") @db.VarChar(50)
  soldDate               DateTime? @map("sold_date") @db.Date
  soldPrice              Decimal?  @map("sold_price") @db.Decimal(12, 2)
  product                String?   @db.VarChar(191)
  type                   String?   @db.VarChar(191)
  wid                    String?   @db.VarChar(100)
  workType               String?   @map("work_type") @db.VarChar(191)
  footageLocation        String?   @map("footage_location") @db.VarChar(191)
  storageType            String?   @map("storage_type") @db.VarChar(100)
  footageLink            String?   @map("footage_link") @db.Text
  remarks                String?   @db.Text
  hardDiscBrand          String?   @map("hard_disc_brand") @db.VarChar(100)
  hardDiscColour         String?   @map("hard_disc_colour") @db.VarChar(80)
  hardDiscCapacity       String?   @map("hard_disc_capacity") @db.VarChar(50)
  items                  String?   @db.VarChar(191)
  footageSize            String?   @map("footage_size") @db.VarChar(50)
  hardDiskIn             String?   @map("hard_disk_in") @db.VarChar(40)
  labeled                Boolean   @default(false)
  footageBackup          Boolean   @default(false) @map("footage_backup")
  finalFilesCopy         Boolean   @default(false) @map("final_files_copy")
  harddiskFootagesBackup Boolean   @default(false) @map("harddisk_footages_backup")
  folderStructureChecked Boolean   @default(false) @map("folder_structure_checked")
  finalRenders           Boolean   @default(false) @map("final_renders")
  otherFilesInHarddisk   Boolean   @default(false) @map("other_files_in_harddisk")
  isDeleted              Boolean   @default(false) @map("is_deleted")
  deletedReason          String?   @map("deleted_reason") @db.Text
  deletedAt              DateTime? @map("deleted_at")
  createdBy              Int?      @map("created_by")
  updatedBy              Int?      @map("updated_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // A storage record belongs to one project. The shoot link is the specific shoot its footage
  // came from and stays optional, so a record created the moment a project starts survives until
  // the project has shoots to attach it to.
  project    SalesProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shoot      ProjectShoot? @relation(fields: [shootId], references: [id], onDelete: SetNull)
  assignedTo Employee?     @relation("ClientStorageAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([isDeleted])
  @@index([createdAt])
  @@index([projectId])
  @@index([shootId])
  @@index([status])
  @@index([assignedToId])
  @@map("client_storage")
}

model Asset {
  id                                Int                @id @default(autoincrement())
  assetCode                         String             @unique @map("asset_code") @db.VarChar(30)
  assetName                         String             @map("asset_name") @db.VarChar(150)
  specification                     String?            @db.Text
  company                           String?            @db.VarChar(150)
  serialNumber                      String?            @unique @map("serial_number") @db.VarChar(100)
  branchId                          Int                @map("branch_id")
  remarks                           String?            @db.Text
  photoData                         String?            @map("photo_data") @db.MediumText
  assignedPersonId                  Int?               @map("assigned_person_id")
  managerId                         Int?               @map("manager_id")
  categoryId                        String?            @map("category_id")
  color                             String?            @db.VarChar(80)
  purchaseDate                      DateTime?          @map("purchase_date") @db.Date
  inspectionPeriodMonths            Int?               @map("inspection_period_months")
  lastInspectedDate                 DateTime?          @map("last_inspected_date") @db.Date
  nextInspectionDate                DateTime?          @map("next_inspection_date") @db.Date
  purchasePrice                     Decimal?           @map("purchase_price") @db.Decimal(12, 2)
  purchasedFrom                     String?            @map("purchased_from") @db.VarChar(150)
  invoiceNumber                     String?            @map("invoice_number") @db.VarChar(100)
  warrantyMonths                    Int?               @map("warranty_months")
  insuranceDetails                  String?            @map("insurance_details") @db.Text
  insuranceExpiry                   DateTime?          @map("insurance_expiry") @db.Date
  images                            Json?
  documents                         Json?
  status                            AssetStatus        @default(ACTIVE)
  isDeleted                         Boolean            @default(false) @map("is_deleted")
  createdBy                         Int?               @map("created_by")
  updatedBy                         Int?               @map("updated_by")
  createdAt                         DateTime           @default(now()) @map("created_at")
  updatedAt                         DateTime           @updatedAt @map("updated_at")
  branch                            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedPerson                    Employee?          @relation("AssetAssignee", fields: [assignedPersonId], references: [id], onDelete: Restrict)
  manager                           Employee?          @relation("AssetManager", fields: [managerId], references: [id], onDelete: Restrict)
  category                          AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  maintenanceRecords                AssetMaintenance[]
  statusLogs                        AssetStatusLog[]
  requests                          AssetRequest[]     @relation("AssetRequestAsset")
  inspectionCode                    String?            @unique @map("inspection_code") @db.VarChar(30)
  inspectionCondition               String?            @map("inspection_condition") @db.VarChar(30)
  inspectionRemarks                 String?            @map("inspection_remarks") @db.Text
  inspectedOn                       DateTime?          @map("inspected_on")
  inspectedById                     Int?               @map("inspected_by_id")
  inspectedByUserId                 Int?               @map("inspected_by_user_id")
  inspectedByEmployeeId             String?            @map("inspected_by_employee_id") @db.VarChar(50)
  inspectedByName                   String?            @map("inspected_by_name") @db.VarChar(150)
  lastInspectionImages              Json?              @map("last_inspection_images")
  lastInspectionImageMetadata       Json?              @map("last_inspection_image_metadata")
  secondLastInspectionImages        Json?              @map("second_last_inspection_images")
  secondLastInspectionImageMetadata Json?              @map("second_last_inspection_image_metadata")
  currentInspectionImages           Json?              @map("current_inspection_images")
  currentInspectionImageMetadata    Json?              @map("current_inspection_image_metadata")

  @@index([status])
  @@index([isDeleted])
  @@index([branchId])
  @@index([assignedPersonId])
  @@index([managerId])
  @@index([categoryId])
  @@index([nextInspectionDate])
  @@index([inspectedById])
  @@map("asset")
}

model AssetStatusLog {
  id                  Int         @id @default(autoincrement())
  assetId             Int         @map("asset_id")
  previousStatus      AssetStatus @map("previous_status")
  nextStatus          AssetStatus @map("next_status")
  changeType          String      @map("change_type") @db.VarChar(40)
  changedByUserId     Int?        @map("changed_by_user_id")
  changedByEmployeeId String?     @map("changed_by_employee_id") @db.VarChar(50)
  changedByName       String?     @map("changed_by_name") @db.VarChar(150)
  reason              String?     @db.Text
  lostByName          String?     @map("lost_by_name") @db.VarChar(150)
  lostByEmployeeId    String?     @map("lost_by_employee_id") @db.VarChar(50)
  soldByName          String?     @map("sold_by_name") @db.VarChar(150)
  soldByEmployeeId    String?     @map("sold_by_employee_id") @db.VarChar(50)
  soldToName          String?     @map("sold_to_name") @db.VarChar(150)
  soldToContact       String?     @map("sold_to_contact") @db.VarChar(50)
  soldDate            DateTime?   @map("sold_date") @db.Date
  soldPrice           Decimal?    @map("sold_price") @db.Decimal(12, 2)
  // What kind of change this row records. Not mutually exclusive: moving an asset from Unassigned
  // to Active both changes its status and hands it to somebody, so that row sets each of them.
  isStatusChange      Boolean     @default(false) @map("is_status_change")
  isAssigneeChange    Boolean     @default(false) @map("is_assignee_change")
  // Who the asset moved between. Written for every change of custody, whether it came from a
  // status change or from editing the asset, so one query gives an asset's full custody history
  // and the reverse gives everything a person has held. Both null on a row that is only a status
  // change. Kept as columns rather than inside formData so they can be indexed and joined.
  assignedFromId      Int?        @map("assigned_from_id")
  assignedToId        Int?        @map("assigned_to_id")
  formData            Json?       @map("form_data")
  createdAt           DateTime    @default(now()) @map("created_at")
  asset               Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedFrom        Employee?   @relation("AssetLogAssignedFrom", fields: [assignedFromId], references: [id], onDelete: SetNull)
  assignedTo          Employee?   @relation("AssetLogAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([nextStatus])
  @@index([assignedToId])
  @@index([assignedFromId])
  @@index([assetId, isAssigneeChange])
  @@map("asset_status_log")
}

enum AssetMaintenanceStatus {
  TO_REPAIR
  IN_REPAIR
  COMPLETED
  CANCELLED
}

model AssetMaintenance {
  id                     Int                    @id @default(autoincrement())
  assetId                Int                    @map("asset_id")
  maintenanceStatus      AssetMaintenanceStatus @default(TO_REPAIR) @map("maintenance_status")
  openSlot               Int?                   @default(1) @map("open_slot")
  repairReason           String                 @map("repair_reason") @db.Text
  repairedById           Int?                   @map("repaired_by_id")
  repairedDate           DateTime?              @map("repaired_date") @db.Date
  serviceProvider        String?                @map("service_provider") @db.VarChar(200)
  serviceCity            String?                @map("service_city") @db.VarChar(100)
  serviceState           String?                @map("service_state") @db.VarChar(100)
  submittedDate          DateTime?              @map("submitted_date") @db.Date
  eta                    DateTime?              @db.Date
  submittedById          Int?                   @map("submitted_by_id")
  contact                String?                @db.VarChar(150)
  repairCost             Decimal?               @map("repair_cost") @db.Decimal(12, 2)
  completionRemarks      String?                @map("completion_remarks") @db.Text
  receivedAndCheckedById Int?                   @map("received_and_checked_by_id")
  cancellationReason     String?                @map("cancellation_reason") @db.Text
  completedAt            DateTime?              @map("completed_at")
  cancelledAt            DateTime?              @map("cancelled_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  asset                  Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  repairedBy             Employee?              @relation("AssetMaintenanceRepairedBy", fields: [repairedById], references: [id], onDelete: SetNull)
  submittedBy            Employee?              @relation("AssetMaintenanceSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  receivedAndCheckedBy   Employee?              @relation("AssetMaintenanceCheckedBy", fields: [receivedAndCheckedById], references: [id], onDelete: SetNull)

  @@unique([assetId, openSlot])
  @@index([assetId])
  @@index([maintenanceStatus])
  @@map("asset_maintenance")
}

model Skill {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("skill")
}

/// The brand an employee works under, maintained from the Employee Repository's settings.
/// The studio's verticals. Five rows: the three sales verticals (Dum Dum, Qua Qua, Corp) that have a
/// CRM board and a document code, plus Team 33 and General for the employee form, which have
/// neither. A lead may reference only the three - the write path checks `documentCode` is set.
///
/// The two short codes are what the studio actually prints: `documentCode` (WED / QQ / CORP) on
/// projects, quotations, CRD documents and WhatsApp group names, and `identifierCode` (DD / QQ /
/// CORP) inside every identifier - `DBS-EID-DD-ERD-000001`. Both were hard-coded maps
/// (`salesVertical.js`, `identifiers.js`) before they were columns; the maps still answer until
/// the readers move here.
model Vertical {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  documentCode   String?  @unique @map("document_code") @db.VarChar(10)
  identifierCode String?  @unique @map("identifier_code") @db.VarChar(10)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leads              SalesCrmLead[]
  salesProjects      SalesProject[]
  whatsappGroupNames SalesWhatsappGroupName[]
  crdDocuments       SalesProjectCrdDocument[]
  employees          Employee[]

  @@index([isActive, name])
  @@map("vertical")
}

/// The studio's bank accounts, chosen from rather than typed into a cash entry or a payment
/// request. It keeps the plain code/name/description shape the other master-data lists have, plus
/// the details paying into an account actually needs — holder, number, IFSC and type — and who
/// added or last changed it, because money leaves the studio through these columns.
///
/// The details are nullable: accounts recorded before they existed have a name and nothing else,
/// and a half-filled row is better than one that refuses to load. New accounts are asked for all
/// of them by the create schema in `master-data/definitions.js`.
///
/// `created_by` and `updated_by` are plain user ids rather than foreign keys, matching
/// `CashEntry.createdBy`: who did it stays true even once that user is gone.
model BankAccount {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(120)
  description       String?  @db.Text
  accountHolderName String?  @map("account_holder_name") @db.VarChar(191)
  accountNumber     String?  @map("account_number") @db.VarChar(20)
  ifscCode          String?  @map("ifsc_code") @db.VarChar(20)
  accountType       String?  @map("account_type") @db.VarChar(30)
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("bank_account")
}

model Language {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("language")
}

model WorkType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("work_type")
}

model EmployeeStatus {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(120)
  description     String?  @db.Text
  color           String?  @db.VarChar(20)
  sortOrder       Int      @default(0) @map("sort_order")
  /// Whether somebody on this status counts as working here.
  ///
  /// It decides who may be handed an asset, who the CRM lists as a salesperson and who may link a
  /// WhatsApp session. That answer used to be the array `["Active", "in Training", "PIP"]`, written
  /// out in four separate files, so a studio that renamed a status or added one had no way to say
  /// so - the list of statuses was editable and the meaning of them was not. It lives on the row
  /// now, which is what lets the list be edited without the meaning drifting from it.
  countsAsWorking Boolean  @default(false) @map("counts_as_working")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("employee_status")
}

/// What an employee answers for Marital Status, maintained in Settings -> Field Settings.
///
/// `requiresSpouseDetails` is the meaning behind the words: it is what makes the employee and
/// onboarding forms ask for a spouse name and a wedding anniversary, and what makes the public
/// onboarding endpoint require them. That was the literal string "Married" in four places, so
/// renaming the option - or adding "Remarried" - quietly stopped the form asking.
/// The Category column on the payment schedule, when a project is booked on Bookings & Converted.
///
/// It was the array ["Advance", "Partial Payment", "Extras Services", "Final Settlement"] in
/// `SchedulePaymentSection.js`. `settlesBalance` is the meaning behind the last of those: the row
/// that closes the schedule is pinned to the bottom, cannot be removed and is what the remaining
/// percentage is settled against. That was the literal string "Final Settlement" compared against in
/// three places, so renaming it - or adding a second category that also settles - stopped working.
model PaymentScheduleCategory {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  description    String?  @db.Text
  settlesBalance Boolean  @default(false) @map("settles_balance")
  /// Whether a schedule may hold several of these, numbered as they are added - "Partial Payment 1",
  /// "Partial Payment 2". That was the two names matched by a regular expression, so renaming
  /// either stopped the numbering and left two rows reading identically.
  repeatable     Boolean  @default(false)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("payment_schedule_category")
}

/// How money moved, on an Accounts cash entry and on an HRM payment request.
///
/// The three flags are what each way of moving money asks for, and they were three arrays written
/// out twice over - once in `accountsConfig.js` and again in `cash-entries/controller.js`, where
/// they validate the entry. A studio adding a mode of its own got one the server refused.
model PaymentMode {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique @db.VarChar(50)
  name                 String   @db.VarChar(120)
  description          String?  @db.Text
  /// A reference from the payment app or the bank: for a transfer it is the proof it went through.
  asksForTransactionId Boolean  @default(false) @map("asks_for_transaction_id")
  /// Which studio account the money moved through.
  asksForAccount       Boolean  @default(false) @map("asks_for_account")
  /// The way out for anything the named modes do not cover, which then says what it actually was.
  asksForDetails       Boolean  @default(false) @map("asks_for_details")
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("payment_mode")
}

/// The tier a wedding is booked at, which the W/A Group Name generator puts into the name it mints.
/// It was the array ["1t1", "2t2", "3t3", "4t4", "5t5"] inside the dialog that draws it.
model Tier {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("tier")
}

/// How the person enquiring relates to the couple, the child or the company - Relationship on
/// SALES -> CRM -> Add Lead and on the Quotation Generator's Client Details. A suggestion list:
/// the lead stores whatever was typed, and this is what the field offers first.
/// The Categories a quotation may be raised under - one list per brand.
///
/// Maintained in Settings → Field Settings → Sales & CRM → Quotations → Categories, a tab per
/// brand, and shipped **empty**: the studio writes its own lists in its own wording rather than
/// inheriting one. The model and table keep their original name, `religion`, which is also the
/// key the quotation payload stores the answer under; the screens say Category.
///
/// A closed list, unlike Relationship and Referred From beside it. Those are typed-with-suggestions
/// because a relationship the list's author never thought of is still a real answer; a category is
/// picked from what the studio has decided to record, and free text would collect one answer three
/// ways.
///
/// `vertical` is the brand code (DUM_DUM, QUA_QUA, CORP) the row belongs to: Dum Dum's categories
/// are not Qua Qua's, so each brand's quotation is offered its own tab and nothing else. The code
/// is unique within a brand rather than across the table, so two brands may each have a "General".
model LeadReligion {
  id          Int      @id @default(autoincrement())
  vertical    String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([vertical, code])
  @@index([vertical, isActive, name])
  @@map("lead_religion")
}

model LeadRelationship {
