model EmployeeStatus {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(120)
  description     String?  @db.Text
  color           String?  @db.VarChar(20)
  sortOrder       Int      @default(0) @map("sort_order")
  /// Whether somebody on this status counts as working here.
  ///
  /// It decides who may be handed an asset, who the CRM lists as a salesperson and who may link a
  /// WhatsApp session. That answer used to be the array `["Active", "in Training", "PIP"]`, written
  /// out in four separate files, so a studio that renamed a status or added one had no way to say
  /// so - the list of statuses was editable and the meaning of them was not. It lives on the row
  /// now, which is what lets the list be edited without the meaning drifting from it.
  countsAsWorking Boolean  @default(false) @map("counts_as_working")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("employee_status")
}

/// What an employee answers for Marital Status, maintained in Settings -> Field Settings.
///
/// `requiresSpouseDetails` is the meaning behind the words: it is what makes the employee and
/// onboarding forms ask for a spouse name and a wedding anniversary, and what makes the public
/// onboarding endpoint require them. That was the literal string "Married" in four places, so
/// renaming the option - or adding "Remarried" - quietly stopped the form asking.
/// The Category column on the payment schedule, when a project is booked on Bookings & Converted.
///
/// It was the array ["Advance", "Partial Payment", "Extras Services", "Final Settlement"] in
/// `SchedulePaymentSection.js`. `settlesBalance` is the meaning behind the last of those: the row
/// that closes the schedule is pinned to the bottom, cannot be removed and is what the remaining
/// percentage is settled against. That was the literal string "Final Settlement" compared against in
/// three places, so renaming it - or adding a second category that also settles - stopped working.
model PaymentScheduleCategory {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  description    String?  @db.Text
  settlesBalance Boolean  @default(false) @map("settles_balance")
  /// Whether a schedule may hold several of these, numbered as they are added - "Partial Payment 1",
  /// "Partial Payment 2". That was the two names matched by a regular expression, so renaming
  /// either stopped the numbering and left two rows reading identically.
  repeatable     Boolean  @default(false)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  scheduledPayments ProjectPaymentSchedule[]

  @@index([isActive, sortOrder], map: "psc_active_sort_idx")
  @@map("payment_schedule_category")
}

/// Settings → Project Management → Payment reminder: the studio's one row (`id = "default"`). A table of
/// its own rather than a Project Management settings row, which Post Production's branch also creates.
model PaymentReminderSettings {
  id                           String    @id @default("default") @db.VarChar(30)
  /// Who sends the reminder (and the money-received message) is `WhatsAppSenderPolicy` "PAYMENT_REMINDER".
  /// "HH:MM", India time; null is 10:00 am.
  paymentReminderSendAt        String?   @map("payment_reminder_send_at") @db.VarChar(5)
  paymentReminderLastAttemptAt DateTime? @map("payment_reminder_last_attempt_at")
  paymentReminderLastError     String?   @map("payment_reminder_last_error") @db.Text
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  @@map("payment_reminder_settings")
}

/// One payment a project is booked to receive - a row of its Schedule Payment, saved by Create
/// Project and Start / Edit Project and worked in Accounts -> Scheduled Payment.
///
/// What it comes to is a **share** of the signed quotation (`percentage`), so a corrected quotation
/// moves every amount with it - until a part payment splits it, which fixes `amount` on both halves.
/// Cleared is never stored: it is the receipts linked to it (`CashEntry.paymentScheduleId`) reaching
/// what it comes to. Hold is set by hand with its remarks (`holdAt`).
model ProjectPaymentSchedule {
  id               String    @id @default(cuid())
  projectId        String    @map("project_id")
  /// The Field Settings category, when it is one; a category typed by hand has none and keeps its text.
  categoryId       Int?      @map("category_id")
  /// A copy of the category's name (declared in master-data `usedBy`), or the text typed.
  category         String    @db.VarChar(120)
  /// When it falls due. NULL on the row that settles the balance, which has no date of its own.
  dueDate          DateTime? @map("due_date")
  percentage       Decimal?  @db.Decimal(12, 6)
  /// Fixed once a part payment splits the row; NULL while it is a share of the quotation.
  amount           Decimal?  @db.Decimal(12, 2)
  remarks          String?   @db.Text
  sortOrder        Int       @default(0) @map("sort_order")
  /// The row a part payment left this remainder of.
  splitFromId      String?   @map("split_from_id")
  holdAt           DateTime? @map("hold_at")
  holdRemarks      String?   @map("hold_remarks") @db.Text
  holdByUserId     Int?      @map("hold_by_user_id")
  createdByUserId  Int?      @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  /// The due date the two-days-before WhatsApp reminder went out for (Settings → Project Management →
  /// Payment reminder). Kept as the date rather than a flag, so a payment moved to a new date is
  /// reminded once more for it, and never twice for the same date.
  reminderSentFor  DateTime? @map("reminder_sent_for")
  reminderSentAt   DateTime? @map("reminder_sent_at")
  /// "SHOOT" where the due date is not known and follows a shoot instead; null is a date set by hand.
  /// `dueDate` is then worked out from the shoot (`services/shootLinkedDueDates.js`) and kept in step
  /// whenever the shoot's date changes, so everything reading `dueDate` reads it as before.
  dueRule          String?   @map("due_rule") @db.VarChar(10)
  /// The shoot it follows; null follows the project's main event. A shoot removed leaves the payment
  /// without a date until it is set again.
  dueShootId       String?   @map("due_shoot_id")
  /// Days from the shoot: negative before it, 0 on the day, positive after.
  dueOffsetDays    Int?      @map("due_offset_days")

  project        SalesProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryRef    PaymentScheduleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dueShoot       ProjectShoot?            @relation("ProjectPaymentScheduleDueShoot", fields: [dueShootId], references: [id], onDelete: SetNull)
  splitFrom      ProjectPaymentSchedule?  @relation("ProjectPaymentScheduleSplit", fields: [splitFromId], references: [id], onDelete: SetNull)
  splits         ProjectPaymentSchedule[] @relation("ProjectPaymentScheduleSplit")
  holdByUser     User?                    @relation("ProjectPaymentScheduleHeldBy", fields: [holdByUserId], references: [id], onDelete: SetNull)
  createdByUser  User?                    @relation("ProjectPaymentScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receipts       CashEntry[]

  @@index([projectId, deletedAt])
  @@index([dueDate])
  @@index([categoryId])
  @@index([splitFromId])
  @@index([holdByUserId])
  @@index([createdByUserId])
  @@index([dueShootId])
  @@map("project_payment_schedule")
}

/// How money moved, on an Accounts cash entry and on an HRM payment request.
///
/// The three flags are what each way of moving money asks for, and they were three arrays written
/// out twice over - once in `accountsConfig.js` and again in `cash-entries/controller.js`, where
/// they validate the entry. A studio adding a mode of its own got one the server refused.
model PaymentMode {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique @db.VarChar(50)
  name                 String   @db.VarChar(120)
  description          String?  @db.Text
  /// A reference from the payment app or the bank: for a transfer it is the proof it went through.
  asksForTransactionId Boolean  @default(false) @map("asks_for_transaction_id")
  /// Which studio account the money moved through.
  asksForAccount       Boolean  @default(false) @map("asks_for_account")
  /// The way out for anything the named modes do not cover, which then says what it actually was.
  asksForDetails       Boolean  @default(false) @map("asks_for_details")
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  payrollEntries PayrollEntry[] @relation("PayrollEntryPaymentMode")

  @@index([isActive, sortOrder], map: "payment_mode_active_sort_idx")
  @@map("payment_mode")
}

/// The tier a wedding is booked at, which the W/A Group Name generator puts into the name it mints.
/// It was the array ["1t1", "2t2", "3t3", "4t4", "5t5"] inside the dialog that draws it.
model Tier {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "tier_active_sort_idx")
  @@map("tier")
}

/// How the person enquiring relates to the couple, the child or the company - Relationship on
/// SALES -> CRM -> Add Lead and on the Quotation Generator's Client Details. A suggestion list:
/// the lead stores whatever was typed, and this is what the field offers first.
/// The Categories a quotation may be raised under - one list per brand.
///
/// Maintained in Settings → Field Settings → Sales & CRM → Quotations → Categories, a tab per
/// brand, and shipped **empty**: the studio writes its own lists in its own wording rather than
/// inheriting one. The model and table keep their original name, `religion`, which is also the
/// key the quotation payload stores the answer under; the screens say Category.
///
/// A closed list, unlike Relationship and Referred From beside it. Those are typed-with-suggestions
/// because a relationship the list's author never thought of is still a real answer; a category is
/// picked from what the studio has decided to record, and free text would collect one answer three
/// ways.
///
/// `vertical` is the brand code (DUM_DUM, QUA_QUA, CORP) the row belongs to: Dum Dum's categories
/// are not Qua Qua's, so each brand's quotation is offered its own tab and nothing else. The code
/// is unique within a brand rather than across the table, so two brands may each have a "General".
model LeadReligion {
  id          Int      @id @default(autoincrement())
  vertical    String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([vertical, code])
  @@index([vertical, isActive, name])
  @@map("lead_religion")
}

model LeadRelationship {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("lead_relationship")
}

/// Where an enquiry came from - Referred From on the same two screens, suggested the same way.
model ReferralSource {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("referral_source")
}

model MaritalStatus {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique @db.VarChar(50)
  name                  String   @db.VarChar(120)
  description           String?  @db.Text
  requiresSpouseDetails Boolean  @default(false) @map("requires_spouse_details")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  /// Required inverse of the employee reference added by 20260924120000. Adds no column.
  employees Employee[]

  @@index([isActive, name])
  @@map("marital_status")
}

/// Who an emergency contact is to the employee. Offered as a combo box rather than a closed list,
/// so this is the set of common answers rather than the only ones allowed.
model EmergencyContactRelationship {
  id          Int      @id @default(autoincrement())
  code        String   @unique(map: "emergency_contact_rel_code_key") @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Required inverse of the employee reference added by 20260924120000. Adds no column.
  employees Employee[]

  @@index([isActive, name], map: "emergency_contact_rel_active_name_idx")
  @@map("emergency_contact_relationship")
}

/// Where somebody works. One list behind both Work Base Location and Current Work Location, which
/// is how the two fields have always been offered - the branches plus the answers a branch cannot
/// give, Remote, Work From Home, On Field.
model WorkLocation {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Required inverse of the employee reference added by 20260924120000. Adds no column.
  employeesBasedHere   Employee[] @relation("EmployeeWorkBaseLocation")
  employeesWorkingHere Employee[] @relation("EmployeeCurrentWorkLocation")

  @@index([isActive, name])
  @@map("work_location")
}

/// The blood groups an employee record offers.
///
/// The eight the browser held (A+ through O-) until the studio could maintain them, seeded by
/// `20260910160000_blood_group_and_language_lists`. Plain words on the employee record like every
/// other list here - nothing in the application reads a meaning out of the value, so unlike the
/// employee statuses and marital statuses this row carries no flag.
model BloodGroup {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Required inverse of the employee reference added by 20260924120000. Adds no column.
  employees Employee[]

  @@index([isActive, name])
  @@map("blood_group")
}

/// What an employee answers for Gender. A list rather than a fixed enum so a studio can record what
/// its people actually answer; the public onboarding endpoint validates against this table instead
/// of the three values it used to hard-code.
model Gender {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Required inverse of the employee reference added by 20260924120000. Adds no column.
  employees Employee[]

  @@index([isActive, name])
  @@map("gender")
}

/// One movement of cash, in or out, which is what the Accounts Manager lists. `entryType` says which
/// direction it went, and is what decides the few columns that belong to one direction only:
/// `receivedAccount` to money in, `paidTo` to money out. Everything either direction asks for —
/// client, category, branch, amount, mode, description — is one column shared by both, so the list,
/// the filters and the totals read one table rather than joining two.
///
/// The person is stored twice over on purpose. `handlerEmployeeId` links whoever took the money in
/// or paid it out while they are on the payroll, and `handlerName` keeps that person readable even
/// after the employee row is archived — or when it was somebody outside the payroll altogether,
/// which is what `handlerIsOther` marks.
///
/// **Both are null on money received.** The studio stopped being asked who received a payment
/// (20261007100000): a received entry is filed by the person taking the money, and the box was one
/// more required answer on the form that books a project. Nothing is stored in its place - nobody
/// was asked, so the answer is unknown rather than a guess at it - and `handlerName` is nullable for
/// that reason. Money **out** still names who paid it, which is the half the studio asks for. One
/// consequence worth knowing: `handlerEmployeeId` is one of the columns `dataScope` narrows this
/// table by, so a received entry is now reachable through its branch or whoever created it, and no
/// longer through a receiver it does not name. The same reasoning applies to `branch` and
/// `receivedAccount`: they are the names as chosen on the day, not links, so a branch renamed later
/// cannot rewrite what a past entry says.
///
/// `transactionId` belongs only to the modes that carry a reference — UPI, and the bank transfer
/// and net banking whose reference is the proof of the transfer. Cash and a card have none, so it
/// stays null there rather than holding a placeholder.
model CashEntry {
  id                String           @id @default(cuid())
  /// RCP-000001 for money in and PAY-000001 for money out, handed out by AppSequence.
  entryId           String           @unique @map("entry_id") @db.VarChar(30)
  entryType         String           @map("entry_type") @db.VarChar(20)
  /// The client's invoice link (`/i/<token>`), made the first time a receipt is shared. Money in only.
  invoiceToken      String?          @unique @map("invoice_token") @db.VarChar(24)
  /// What the money was against. Money comes in for a project as a whole — an advance, a final
  /// settlement — while money goes out per shoot, so money out carries both and money in carries
  /// only the project. Both stay optional: an office expense belongs to no shoot, and every entry
  /// recorded before this was added has neither.
  projectId         String?          @map("project_id")
  shootId           String?          @map("shoot_id")
  /// NULL only on a branch transfer, which moves the studio's own money and has no client.
  clientName        String?          @map("client_name") @db.VarChar(191)
  category          String           @db.VarChar(60)
  amount            Decimal          @db.Decimal(12, 2)
  entryDate         DateTime         @map("entry_date")
  branch            String           @db.VarChar(120)
  branchId          Int?             @map("branch_id")
  paymentMode       String           @map("payment_mode") @db.VarChar(30)
  transactionId     String?          @map("transaction_id") @db.VarChar(100)
  /// What the payment mode actually was, when it was "Other" — a cheque, an adjustment, a swap.
  /// The five named modes leave it null. Asked for by the form and shown as the table's "Payment
  /// Mode Details" column, both of which were written before the column was; without it every
  /// create and update of an entry was refused by Prisma as an unknown field.
  paymentModeOther  String?          @map("payment_mode_other") @db.VarChar(120)
  /// The account the money moved through, asked only of the modes that use one — a bank transfer,
  /// net banking, a card — and never of cash. Money in names the account it landed in, money out
  /// the account it left from, so they are two columns for the same reason `paidTo` is its own.
  receivedAccount   String?          @map("received_account") @db.VarChar(120)
  paidFromAccount   String?          @map("paid_from_account") @db.VarChar(120)
  /// Money out only: who the payment went to.
  paidTo            String?          @map("paid_to") @db.VarChar(191)
  /// Who received it, or who paid it out, depending on the direction.
  handlerEmployeeId Int?             @map("handler_employee_id")
  handlerName       String?          @map("handler_name") @db.VarChar(191)
  handlerIsOther    Boolean          @default(false) @map("handler_is_other")
  description       String?          @db.Text
  /// The receipt, bill or screenshot proving the payment, and what is known about each file:
  /// where it sits in the bucket, what it is, how large it was before and after compression, and
  /// who added it when. JSON for the same reason an asset's `images` are — a handful of files per
  /// entry, read as a set and never queried one at a time.
  paymentProof      Json?            @map("payment_proof")
  createdBy         Int?             @map("created_by")
  updatedBy         Int?             @map("updated_by")
  /// Entries are withdrawn rather than erased, so a mistaken one leaves a trail — and the proof
  /// stays in the bucket with it, since a withdrawn entry still has to be answerable for.
  deletedAt         DateTime?        @map("deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  handler           Employee?        @relation("CashEntriesHandled", fields: [handlerEmployeeId], references: [id], onDelete: SetNull)
  // The links drop to NULL rather than taking the entry with them: what was spent stays on the
  // books after the shoot it was spent on is removed. `clientName` and `branch` are still the text
  // chosen on the day for the same reason.
  project           SalesProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shoot             ProjectShoot?    @relation(fields: [shootId], references: [id], onDelete: SetNull)
  /// The approved Payment Request that wrote this entry, NULL on every entry recorded by hand.
  ///
  /// The link sits here, on the entry, because one approval writes several: spend is per shoot and
  /// money coming back is per project, so a request naming three shoots is three rows in the books,
  /// each worth what was actually spent on it. It used to sit on the request as `cash_entry_id`,
  /// which could name only one of them - and named none at all the moment the lines disagreed.
  paymentRequestId  Int?             @map("payment_request_id")
  paymentRequest    PaymentRequest?  @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  /// The scheduled payment this receipt clears, when it was recorded from Accounts -> Scheduled Payment.
  paymentScheduleId String?                 @map("payment_schedule_id")
  paymentSchedule   ProjectPaymentSchedule? @relation(fields: [paymentScheduleId], references: [id], onDelete: SetNull)

  /// Where the entry came from: "Manual" (a form - Add Entry, a project's Payments tab, Create
  /// Project's advance, a scheduled payment cleared, an approved payment request), "CSV Import" or
  /// "PDF Import". Null on every entry recorded before it was kept - which of those it was is not known.
  source String? @db.VarChar(20)

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branchRef Branch? @relation("CashEntryBranch", fields: [branchId], references: [id], onDelete: SetNull)

  /// A branch transfer's receiving branch. `branch`/`branchId` above is the branch the money left,
  /// whose books the entry is filed in; this is where it landed. NULL on every other entry. No text
  /// copy beside it: the name is read through the relation.
  toBranchId Int?    @map("to_branch_id")
  toBranch   Branch? @relation("CashEntryToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)

  createdByUser User? @relation("CashEntryCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("CashEntryUpdatedByUser", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([deletedAt, entryDate])
  @@index([entryType, category])
  @@index([clientName])
  @@index([handlerEmployeeId])
  @@index([projectId])
  @@index([branchId])
  @@index([toBranchId])
  @@index([shootId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([paymentScheduleId])
  @@index([paymentRequestId])
  /// Import from PDF looks a statement's references up here to mark the ones already recorded.
  @@index([transactionId])
  @@map("cash_entry")
}

/// A PDF read by Accounts Manager -> Import from PDF, remembered by its contents so the same
/// statement uploaded again - under any file name - is recognised. Only the SHA-256 of the bytes is
/// kept: never the file, never its password. What was recorded from it lives on `cash_entry`, where
/// a transaction ID already there is what marks a re-imported row as a duplicate.
model CashStatementImport {
  id               Int      @id @default(autoincrement())
  fileHash         String   @unique @map("file_hash") @db.Char(64)
  /// The name it had the first time it was read - a copy for the "read before" message, nothing more.
  fileName         String   @map("file_name") @db.VarChar(255)
  transactionCount Int      @default(0) @map("transaction_count")
  uploadedBy       Int?     @map("uploaded_by")
  createdAt        DateTime @default(now()) @map("created_at")
  uploadedByUser   User?    @relation("CashStatementImportUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([uploadedBy])
  @@map("cash_statement_import")
}

/// How far a recording has got through transcription. The webhook never waits for any of this -
/// a call log is saved and the job queued, and the row moves through these states behind it.
enum SalesCallTranscriptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Who is speaking in a segment.
///
/// faster-whisper transcribes but does not diarize, so EMPLOYEE and CLIENT are inferred from the
/// call's direction and the gaps between turns rather than measured from the audio. UNKNOWN is
/// what an inference that cannot be trusted says, and is shown as "Speaker" rather than guessing.
enum SalesCallSpeaker {
  EMPLOYEE
  CLIENT
  UNKNOWN
}

/// One recording, transcribed.
///
/// Keyed on the call log rather than the lead: a lead has many calls, and a redelivered Callyzer
/// batch writes the same call by the same id, so keying here is what stops one call being
/// transcribed twice. The lead is carried as well because the CRM reads transcripts by lead.
model SalesCallTranscript {
  id              String                    @id @default(cuid())
  /// The `sales_crm_call_log` row this came from.
  callLogId       String                    @unique @map("call_log_id") @db.VarChar(191)
  /// The lead the call landed on, as `sales_crm_lead.enquiry_id`.
  enquiryId       String?                   @map("enquiry_id") @db.VarChar(100)
  recordingUrl    String?                   @map("recording_url") @db.Text
  status          SalesCallTranscriptStatus @default(PENDING)
  /// Whole transcript as one block, for search and for handing to the model.
  fullText        String?                   @map("full_text") @db.LongText
  language        String?                   @db.VarChar(20)
  /// Length of the audio actually transcribed, which can differ from the call's reported duration.
  durationSeconds Int                       @default(0) @map("duration_seconds")
  provider        String?                   @db.VarChar(60)
  /// What the model made of the call. Null until the summary step runs; a transcript is useful
  /// on its own, so a missing API key leaves these empty rather than failing the job.
  summary         String?                   @db.Text
  sentiment       String?                   @db.VarChar(30)
  /// What the call achieved, in a sentence or two. Text rather than VarChar(191): it is prose, like
  /// `summary` and `nextAction` beside it, and a model asked for an outcome writes a paragraph as
  /// readily as a phrase. It was VarChar and a longer-than-usual answer failed the whole write with
  /// "The provided value for the column is too long", losing a transcript that had already been made.
  callOutcome     String?                   @map("call_outcome") @db.Text
  nextAction      String?                   @map("next_action") @db.Text
  /// Intent, budget, event type and date, location, follow-up, suggested status - as JSON, so the
  /// shape can grow without a migration. Offered to the user; never written to the lead by itself.
  suggestions     String?                   @db.LongText
  /// Set when a person pressed Apply, with what was applied. Absent means nothing was written.
  appliedAt       DateTime?                 @map("applied_at")
  appliedByUserId Int?                      @map("applied_by_user_id")
  appliedFields   String?                   @map("applied_fields") @db.Text
  errorCode       String?                   @map("error_code") @db.VarChar(60)
  errorMessage    String?                   @map("error_message") @db.Text
  attempts        Int                       @default(0)
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  segments SalesCallTranscriptSegment[]

  appliedByUser User? @relation("SalesCallTranscriptAppliedByUser", fields: [appliedByUserId], references: [id], onDelete: SetNull)

  /// The lead the call was matched to, or none for a call the studio never turned into an enquiry. A key since 20260924150000; a transcript matched to a lead goes with it.
  lead SalesCrmLead? @relation("SalesCallTranscriptLead", fields: [enquiryId], references: [enquiryId], onDelete: Cascade)

  @@index([enquiryId, createdAt])
  @@index([status])
  @@index([appliedByUserId])
  @@map("sales_call_transcript")
}

/// One turn of the conversation.
model SalesCallTranscriptSegment {
  id           String           @id @default(cuid())
  transcriptId String           @map("transcript_id") @db.VarChar(191)
  /// Position in the call, so segments read in order even if two share a start time.
  sequence     Int
  startMs      Int              @map("start_ms")
  endMs        Int              @map("end_ms")
  speaker      SalesCallSpeaker @default(UNKNOWN)
  text         String           @db.Text

  transcript SalesCallTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, sequence])
  @@map("sales_call_transcript_segment")
}

// ============================================
// IAM MODELS (Role-Based Access Control)
// ============================================

model Role {
  id               String   @id @default(cuid())
  name             String   @unique @db.VarChar(100)
  description      String?  @db.Text
  isSystem         Boolean  @default(false) @map("is_system")
  isAdmin          Boolean  @default(false) @map("is_admin")
  isBranchManager  Boolean  @default(false) @map("is_branch_manager")
  isDepartmentLead Boolean  @default(false) @map("is_department_lead")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // A role holds its permissions directly and a group is given as many roles as it needs. There is
  // no layer between the two: the policy layer that used to sit here was folded into roles, so the
  // thing you name and the thing that carries permissions are one object.
  permissions RolePermission[]
  users       UserRole[]
  branches    RoleBranch[]

  @@index([isActive])
  @@index([isSystem])
  @@map("role")
}

model Permission {
  id          String   @id @default(cuid())
  module      String   @db.VarChar(50)
  feature     String   @db.VarChar(100)
  level       String   @db.VarChar(50)
  description String?  @db.Text
  displayName String?  @map("display_name") @db.VarChar(150)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles             RolePermission[]
  // Named sub-actions inside this permission, shown as checkboxes under it. A permission with none
  // is simply a Disabled/Read/Read-Write choice and nothing more.
  scopes            PermissionScope[]
  /// Required inverse of BranchAdminPermission.permission. Adds no column; the link is on that row.
  branchAdminGrants BranchAdminPermission[]

  @@unique([module, feature, level])
  @@index([module])
  @@index([isActive])
  @@map("permission")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  accessLevel  String   @map("access_level") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission            @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scopes     RolePermissionScope[]

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}

// A named sub-action inside a permission - "Import", "Operate Intents" - offered as a checkbox
// under it when a role grants that permission. Scopes are data, not code: a module gains one by
// being seeded, and a permission with no scopes just renders as its access-level choice.
model PermissionScope {
  id           String   @id @default(cuid())
  permissionId String   @map("permission_id")
  name         String   @db.VarChar(100)
  displayName  String?  @map("display_name") @db.VarChar(150)
  description  String?  @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permission Permission            @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  roleGrants RolePermissionScope[]

  @@unique([permissionId, name])
  @@index([permissionId])
  @@index([isActive])
  @@map("permission_scope")
}

// Which scopes a role has ticked for a permission it holds. Hung off the grant rather than the role
// so that withdrawing the permission takes its scopes with it.
model RolePermissionScope {
  id               String @id @default(cuid())
  rolePermissionId String @map("role_permission_id")
  scopeId          String @map("scope_id")

  rolePermission RolePermission  @relation(fields: [rolePermissionId], references: [id], onDelete: Cascade)
  scope          PermissionScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([rolePermissionId, scopeId])
  @@index([rolePermissionId])
  @@index([scopeId])
  @@map("role_permission_scope")
}

// The branches a role reaches. A role with several is how somebody works across branches: the
// permissions it carries apply in every branch listed here, not only in the branch of the group
// that happens to carry the role. A role with none reaches nowhere and grants nothing.
// A role a user carries. Roles used to arrive through a group; they are held directly now, so a
// user's access is the union of every role on this table for them - see the memory note on the
// group layer if that ever needs reinstating.
model UserRole {
  id     String @id @default(cuid())
  userId Int    @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

// The **Admin Permission** set: one studio-wide matrix that every role marked `isBranchManager`
// carries, on top of whatever that role grants in its own right.
//
// There is deliberately one of these and not one per role. A branch administrator in Erode and a
// branch administrator in Bangalore do the same job in two places, and the studio decides once what
// that job may touch; what differs between them is the branch list on their own role, which this
// does not touch. Editing the set therefore changes what **every** branch administrator may do, at
// once and without re-saving a single role - which is the point of it, and why the screen says so
// before it saves.
//
// One row per permission granted, so a permission absent from this table grants nothing here.
// `permission_id` is unique because "one level per permission" is the only sensible reading, and a
// unique index says so in the database rather than in a comment.
//
// Merged in `IAMService.getUserPermissions` through the same `_mergeMostPermissive` every other
// grant goes through, so the strongest wins where a branch administrator's own role already names a
// permission this set also names. It can only ever widen somebody, never narrow them.
model BranchAdminPermission {
  id           String @id @default(cuid())
  permissionId String @unique @map("permission_id")
  accessLevel  String @map("access_level") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId])
  @@map("branch_admin_permission")
}

model RoleBranch {
  id       String @id @default(cuid())
  roleId   String @map("role_id")
  branchId Int    @map("branch_id")

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([roleId, branchId])
  @@index([roleId])
  @@index([branchId])
  @@map("role_branch")
}

model AiActionPlan {
  id          String    @id @default(cuid())
  /// SHA-256 of the token handed to the browser. Unique, so a confirm is a single indexed lookup.
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  /// Whose plan it is. Confirming re-resolves this person's permissions from scratch.
  userId      Int       @map("user_id")
  /// The module the plan was made in. A token is not valid in a different one.
  module      String    @db.VarChar(40)
  tool        String    @db.VarChar(80)
  /// The tool's arguments, as JSON. Cleared once the plan has been carried out - the data has
  /// landed in the module's own tables by then, and a second copy here would outlive it.
  args        String?   @db.Text
  risk        String    @db.VarChar(30)
  /// What a person reads on the confirmation card before deciding.
  summary     String    @db.Text
  /// PENDING, CONFIRMED, FAILED, or CANCELLED. Never deleted on use - a plan that ran is a record
  /// that it ran.
  status      String    @db.VarChar(20)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sweeping expired plans.
  @@index([status, expiresAt])
  @@map("ai_action_plan")
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  /// SALES, HRM, IMAGE_SELECTION, ASSET, ACCOUNTS, or GLOBAL.
  module    String   @db.VarChar(40)
  /// Taken from the opening question, for the conversation list. Never generated by the model.
  title     String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  /// The index every listing uses: this person's threads in this module, most recent first.
  @@index([userId, module, updatedAt])
  @@map("ai_conversation")
}

/// One turn in a conversation.
///
/// Deleted with its conversation, and with its user - an account that goes takes its assistant
/// history with it rather than leaving orphaned rows about clients.
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  /// "user" or "assistant". Tool results are summarised into the assistant turn rather than stored
  /// as their own role, so a replay cannot resurrect data the person may no longer be allowed to see.
  role           String   @db.VarChar(20)
  content        String   @db.Text
  /// Which tools ran, as JSON: names and durations, never their results.
  toolTrace      String?  @map("tool_trace") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_message")
}

/// A document the assistant may draw on - an SOP, a policy, a workflow note.
///
/// `module` and `visibility` together decide who can retrieve from it, and both are filtered in SQL
/// before any embedding is loaded. An HRM policy is never in memory during a CRM question, which is
/// the difference between filtering access and hiding a result after the model has seen it.
model AiDocument {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  /// SALES, HRM, IMAGE_SELECTION, ASSET, ACCOUNTS - or GLOBAL for something every module may read.
  module      String   @db.VarChar(40)
  /// "module" for its own module only, "global" for anything approved company-wide.
  visibility  String   @default("module") @db.VarChar(20)
  /// Where it came from, for someone auditing an answer back to its source.
  source      String?  @db.VarChar(500)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  chunks AiDocumentChunk[]

  createdByUser User? @relation("AiDocumentCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([module, visibility])
  @@index([createdById])
  @@map("ai_document")
}

/// One passage of a document, with its embedding.
///
/// The embedding is JSON rather than a vector column because MySQL has no vector type and the
/// corpus is a studio's own procedures - a few hundred passages, where cosine similarity in Node
/// costs milliseconds. A dedicated vector store would be another service to keep alive on a box
/// already holding several gigabytes of models, for a scale nowhere near needing one.
model AiDocumentChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  /// Position in the document, so retrieved passages can be read back in order.
  ordinal    Int
  content    String   @db.Text
  /// The embedding as a JSON array of floats.
  embedding  String   @db.LongText
  tokenCount Int      @default(0) @map("token_count")
  createdAt  DateTime @default(now()) @map("created_at")

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, ordinal])
  @@map("ai_document_chunk")
}

/// Work agreed on top of what a project was sold for — an extra shoot, an album nobody quoted.
///
/// Its own table rather than a fifth kind of `PaymentRequest`, because it is not one. The four
/// payment requests are the studio paying somebody and approving one writes a cash entry; this
/// agrees work and writes nothing to the books, the money arriving later as an ordinary receipt.
/// It also carries one thing rather than a list of lines, and it is decided by the manager of the
/// project it names rather than by Accounts.
///
/// The project is required and the shoot is not: an extra usually belongs to a shoot, but one
/// agreed for the project as a whole has no shoot to name.
model ProjectExtraQuotation {
  id              String    @id @default(cuid())
  /// EXT-000001, from the counter every generated identifier comes from.
  requestCode     String    @unique @map("request_code") @db.VarChar(30)
  projectId       String    @map("project_id")
  shootId         String?   @map("shoot_id")
  /// The service being added, named from the studio's own service list so an extra names work the
  /// system already knows about rather than free text nobody can total.
  service         String    @db.VarChar(150)
  amount          Decimal   @db.Decimal(12, 2)
  remarks         String?   @db.Text
  /// Who asked. The name is stored beside the link so a decided extra still reads correctly after
  /// the employee is archived, the same reason a cash entry keeps its handler's name.
  requestedById   Int?      @map("requested_by_id")
  requestedByName String    @map("requested_by_name") @db.VarChar(191)
  /// What the client agreed to, in writing: a signed quote, a screenshot of the message. Held the
  /// way every other upload on the site is — the file's place in the bucket and what is known
  /// about it — so one extra can carry a few pages of proof.
  /// When it was added, which is not always when it was typed in — an extra agreed on the shoot day
  /// may be entered the following morning. `createdAt` stays the record's own timestamp.
  addedAt         DateTime  @default(now()) @map("added_at")
  proof           Json?
  status          String    @default("PENDING") @db.VarChar(20)
  decisionRemarks String?   @map("decision_remarks") @db.Text
  decidedById     Int?      @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at")
  createdBy       Int?      @map("created_by")
  /// Withdrawn rather than erased, so a mistaken request leaves a trail.
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project SalesProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot   ProjectShoot? @relation(fields: [shootId], references: [id], onDelete: SetNull)

  createdByUser       User?     @relation("ProjectExtraQuotationCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)
  decidedByUser       User?     @relation("ProjectExtraQuotationDecidedByUser", fields: [decidedById], references: [id], onDelete: SetNull)
  requestedByEmployee Employee? @relation("ProjectExtraQuotationRequestedByEmployee", fields: [requestedById], references: [id], onDelete: SetNull)
  changeRequest ProjectChangeRequest?

  @@index([projectId, status])
  @@index([status])
  @@index([deletedAt])
  @@index([createdBy])
  @@index([decidedById])
  @@index([requestedById])
  @@map("project_extra_quotation")
}

/// Sale Extras: one change made to a booked project's shoots, services or deliverables after its
/// finalized quotation was pushed into it - added, removed, or a scope edit (modified) - priced by hand.
///
/// Lines are written by `sale-extras/reconcile.js`, which compares the project's rows with their
/// baseline snapshot (`saleBaseline`); a DRAFT is the studio's to price, a PUBLISHED line has been
/// carried to the client by a revision and is never edited, a CANCELLED one was undone before it was
/// published. An *included* line (`parentExtraId`) is priced with its parent - a new shoot's services,
/// or the deliverables a service brought - so nothing is counted twice.
model ProjectSaleExtra {
  id                      String    @id @default(cuid())
  /// SXT-000001, from the counter every generated identifier comes from.
  code                    String    @unique @db.VarChar(30)
  projectId               String    @map("project_id")
  /// ADDED, REMOVED or MODIFIED - recorded from the plan - or CORRECTION, typed by the studio to put
  /// right the amount of a published line (`correctsExtraId`).
  kind                    String    @db.VarChar(10)
  /// SHOOT, SERVICE or DELIVERABLE.
  category                String    @db.VarChar(12)
  shootId                 String?   @map("shoot_id")
  serviceAllocationId     String?   @map("service_allocation_id")
  deliverableAllocationId String?   @map("deliverable_allocation_id")
  /// The line this one is priced with; null on a line that carries its own amount.
  parentExtraId           String?   @map("parent_extra_id")
  /// Copies of the names when the change was recorded, so a removed item still reads.
  itemName                String    @map("item_name") @db.VarChar(191)
  shootName               String?   @map("shoot_name") @db.VarChar(191)
  /// MODIFIED: `{ before, after }` scope fields. REMOVED: the row's scope as it was.
  details                 Json?
  /// Signed, before GST, typed by the studio. Null until entered; never set on an included line.
  amount                  Decimal?  @db.Decimal(12, 2)
  remarks                 String?   @db.Text
  /// DRAFT, PUBLISHED or CANCELLED.
  status                  String    @default("DRAFT") @db.VarChar(12)
  /// When the change itself happened - the row's created, deleted or updated time.
  changedAt               DateTime  @map("changed_at")
  publishedRevisionId     String?   @map("published_revision_id")
  /// The published line a CORRECTION corrects; null on every other line.
  correctsExtraId         String?   @map("corrects_extra_id")
  createdBy               Int?      @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  project               SalesProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot                 ProjectShoot?                    @relation(fields: [shootId], references: [id], onDelete: SetNull)
  serviceAllocation     ProjectPostProductionAllocation? @relation(fields: [serviceAllocationId], references: [id], onDelete: SetNull)
  deliverableAllocation ProjectShootDeliverable?         @relation(fields: [deliverableAllocationId], references: [id], onDelete: SetNull)
  parentExtra           ProjectSaleExtra?                @relation("SaleExtraIncluded", fields: [parentExtraId], references: [id], onDelete: SetNull)
  includedExtras        ProjectSaleExtra[]               @relation("SaleExtraIncluded")
  correctsExtra         ProjectSaleExtra?                @relation("SaleExtraCorrection", fields: [correctsExtraId], references: [id], onDelete: SetNull)
  corrections           ProjectSaleExtra[]               @relation("SaleExtraCorrection")
  publishedRevision     ProjectSaleExtraRevision?        @relation(fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  createdByUser         User?                            @relation("ProjectSaleExtraCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([shootId])
  @@index([serviceAllocationId])
  @@index([deliverableAllocationId])
  @@index([parentExtraId])
  @@index([correctsExtraId])
  @@index([publishedRevisionId])
  @@index([createdBy])
  @@map("project_sale_extra")
}

/// One published revision of a booked project's Sale Extras: the original finalized amount, every
/// published line at that moment, and the totals they make. The client's existing quotation link shows
/// the latest one. Immutable: nothing updates or deletes a row here (only a permanent purge of the
/// project takes its revisions); a correction is a new line in the next revision.
model ProjectSaleExtraRevision {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  /// The finalized quotation version the project is booked on; never written by this feature.
  salesQuotationId String   @map("sales_quotation_id")
  /// R1, R2 ... per project; unique, so two publishes racing for one number cannot both land.
  revisionNumber   Int      @map("revision_number")
  originalAmount   Decimal  @map("original_amount") @db.Decimal(12, 2)
  netAdjustment    Decimal  @map("net_adjustment") @db.Decimal(12, 2)
  updatedTotal     Decimal  @map("updated_total") @db.Decimal(12, 2)
  /// The original quotation's GST rate, frozen. Every amount here is before GST.
  gstPercent       Decimal  @map("gst_percent") @db.Decimal(5, 2)
  /// Every published priced line with its included lines under it, as the client reads them.
  lines            Json
  publishedById    Int?     @map("published_by_id")
  publishedByName  String   @map("published_by_name") @db.VarChar(191)
  publishedAt      DateTime @default(now()) @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")

  project         SalesProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesQuotation  SalesQuotation     @relation(fields: [salesQuotationId], references: [id], onDelete: Restrict)
  publishedByUser User?              @relation("ProjectSaleExtraRevisionPublishedByUser", fields: [publishedById], references: [id], onDelete: SetNull)
  extras          ProjectSaleExtra[]

  @@unique([projectId, revisionNumber])
  @@index([salesQuotationId])
  @@index([publishedById])
  @@map("project_sale_extra_revision")
}

/// One job somebody asked somebody else to do, and what became of it.
///
/// Assigning is between *logins*, not between employee records: anybody signed in may give a task
/// to anybody else signed in, and the studio has logins with no employee row behind them (the
/// standalone Super Admin) as well as employees with no login. `User` is the only side both of
/// those are on.
///
/// The two names are stored beside the two ids, the way `CashEntry` keeps `handlerName`: a login
/// can be deleted, and a finished task must still say who did it. That is also why both ids are
/// nullable while both names are not.
///
/// Nothing here is deleted. A task that cannot be done is reverted with a reason, and one that
/// should never have been given is cancelled - both are states with a timestamp, because "who
/// stopped this, and when" is exactly what somebody asks a week later.
model HrmTask {
  id            Int     @id @default(autoincrement())
  /// TSK-000001, from the counter every generated identifier in the application comes from.
  taskCode      String  @unique @map("task_code") @db.VarChar(30)
  /// The one line the list, the bell and the notification all show. The instructions are below it.
  title         String  @db.VarChar(200)
  description   String  @db.Text
  /// Client work, internal work, and the rest of the studio's list; see `TASK_TYPES` in the module.
  taskType      String  @map("task_type") @db.VarChar(60)
  /// What "Other" actually was, typed beside it, because a list of tasks all reading "Other" says
  /// nothing about any of them. Null on every named type - the form clears it when the type changes.
  taskTypeOther String? @map("task_type_other") @db.VarChar(120)
  priority      String  @default("MEDIUM") @db.VarChar(20)
  /// PENDING, IN_PROGRESS, SUBMITTED, COMPLETED, REASSIGNED or CANCELLED. SUBMITTED ("Finish & Send
  /// Back") is work its holder finished and sent back; whoever assigned it marks it completed or revokes it.
  ///
  /// `REASSIGNED` is an **open** status, unlike the `REVERTED` it replaced: a reassigned task has
  /// landed on somebody new and is waiting to be picked up, so it still has to be startable. Only
  /// COMPLETED and CANCELLED close a task now.
  status        String  @default("PENDING") @db.VarChar(20)

  /// Which department the work belongs to and which branch it is for, chosen when the task is given.
  ///
  /// The task's own answer rather than the assignee's: work is regularly handed across a branch or
  /// a department line - Erode's editor finishing a Karim Nagar wedding - and reading them off the
  /// person would file that task under the wrong one of each.
  ///
  /// Names rather than ids, matching how every table but `User` and `Asset` stores its branch (see
  /// CLAUDE.md). Picked from the live `department` and `location` lists, checked against them on
  /// the way in, and kept verbatim afterwards - a department later renamed or retired does not
  /// rewrite the tasks filed under what it was called at the time. Nullable only for the tasks
  /// raised before this was asked for; every task given since carries both.
  department      String? @db.VarChar(120)
  branch          String? @db.VarChar(120)
  branchId        Int?    @map("branch_id")
  /// The employee behind the assignee's login, kept in step on every write; NULL for a login with none.
  ownerEmployeeId Int?    @map("owner_employee_id")
  /// The login that created this task. Usually the giver, but an administrator can raise one on
  /// somebody else's behalf, and then the two differ.
  createdByUserId Int?    @map("created_by_user_id")

  assignedToUserId Int?   @map("assigned_to_user_id")
  assignedToName   String @map("assigned_to_name") @db.VarChar(191)
  assignedByUserId Int?   @map("assigned_by_user_id")
  assignedByName   String @map("assigned_by_name") @db.VarChar(191)

  /// When it is wanted by, where that was asked for. A task with no due date is not late.
  dueOn DateTime? @map("due_on")

  /// Who finished it, and when. The receiver is normally the only one who can, so this is usually
  /// `assignedTo` - stored anyway, because "usually" is not "always" once a task can be reassigned.
  completedAt       DateTime? @map("completed_at")
  completedByUserId Int?      @map("completed_by_user_id")
  completedByName   String?   @map("completed_by_name") @db.VarChar(191)

  /// Why the task last changed hands, and when. Reassigning without a reason is refused: the reason
  /// *is* the reassignment, and it is what the next person needs in order to pick the work up.
  ///
  /// These two were `revert_reason` and `reverted_at`, which held why the receiver handed the task
  /// back to whoever set it. Reassigning replaced rolling back — the same act with a named
  /// destination — so the columns were renamed rather than added beside them: an old rolled-back
  /// task's reason is exactly this field's meaning, and two columns for one fact would leave every
  /// reader deciding which to show.
  reassignReason String?   @map("reassign_reason") @db.Text
  reassignedAt   DateTime? @map("reassigned_at")

  /// Who handed it on, kept because the task itself only ever names who holds it *now*.
  ///
  /// The full chain is in `holders` and in the activity log; this is the last hop, which is what a
  /// row in a list has room to say.
  reassignedFromUserId Int?    @map("reassigned_from_user_id")
  reassignedFromName   String? @map("reassigned_from_name") @db.VarChar(191)

  cancelledAt DateTime? @map("cancelled_at")

  /// When this task was deleted, or NULL for a task that still exists.
  ///
  /// Deleting is the giver's and a Super Admin's, and it is a soft delete: the row stays, the task
  /// leaves My Tasks, Tasks Given and All Tasks alike, and every verb refuses it the same 404 a task
  /// that was never there would get. A task carries a chain of holders, an activity log and the
  /// files handed over with it, and a mistaken delete that took all of that with it would be
  /// unanswerable afterwards - this one is a column somebody can clear.
  ///
  /// Distinct from CANCELLED, which is a status: a cancelled task is a real task that was called
  /// off, still read by both people and still counted. A deleted one is a task the studio is saying
  /// should never have been raised.
  deletedAt DateTime? @map("deleted_at")

  /// The files handed over with the task, as a list of small records - never the bytes.
  ///
  /// A column rather than a table beside it: a task's files are read with the task, always, and
  /// nothing else in the application points at one. Each entry carries an id unique within the
  /// task (so a file can still be addressed by a URL), the name it was picked with, its key in the
  /// private R2 bucket, its type and size, and who added it when.
  ///
  /// A list rewritten whole is the cost of the column, so every write locks this row first - see
  /// `addAttachment` in the module. NULL is a task nobody attached anything to, which is honestly
  /// what every task raised before this existed is.
  attachments Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User?             @relation("HrmTasksReceived", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedBy User?             @relation("HrmTasksGiven", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  holders    HrmTaskHolder[]
  owner      Employee?         @relation("HrmTaskOwner", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  activities HrmTaskActivity[]

  /// The two questions My Tasks and Tasks Given ask, each with the status the tabs filter by.
  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branchRef Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Set when the task is a feedback's Average or Poor review, given to its assignee to answer.
  feedbackIssue ProjectFeedbackIssue?
  /// Set when the task is a speak-up a reviewer approved and assigned.
  speakUp       SpeakUp?

  completedByUser    User? @relation("HrmTaskCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdByUser      User? @relation("HrmTaskCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reassignedFromUser User? @relation("HrmTaskReassignedFromUser", fields: [reassignedFromUserId], references: [id], onDelete: SetNull)
  changeRequest ProjectChangeRequest?

  @@index([assignedToUserId, status])
  @@index([assignedByUserId, status])
  /// All Tasks, newest first.
  @@index([status, createdAt])
  @@index([branchId])
  @@index([dueOn])
  @@index([ownerEmployeeId])
  @@index([createdByUserId])
  @@index([reassignedFromUserId])
  /// Every list this module answers starts "not deleted", so it is the first thing each of them
  /// narrows by.
  @@index([deletedAt])
  @@index([completedByUserId])
  @@map("hrm_task")
}

/// Everybody who has held a task: the person it was given to, and each person it has been passed on
/// to since.
///
/// A table rather than a list on the task, because it is *queried* rather than only displayed: My
/// Tasks asks "which tasks have I ever held", and a JSON array cannot be indexed for that. The row
/// for the current holder is here too, so the question is one uniform lookup instead of a lookup
/// plus a check against `assignedToUserId`.
///
/// It never shrinks. A task passed from B to C keeps B, which is the whole point — B is owed sight
/// of what happened to the work they were asked to do, and the reason C now has it.
model HrmTaskHolder {
  id     Int      @id @default(autoincrement())
  taskId Int      @map("task_id")
  userId Int?     @map("user_id")
  /// The name as it stood when they held it, so a task still reads correctly after a login is renamed
  /// or removed — the same reason the task itself stores `assignedToName` beside the id.
  name   String   @db.VarChar(191)
  /// When the task landed on them. Ordered by this, the rows are the chain in the order it happened.
  heldAt DateTime @default(now()) @map("held_at")

  task HrmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User?   @relation("HrmTaskHolders", fields: [userId], references: [id], onDelete: SetNull)

  /// One row per person per task: being handed a task twice does not make two holders of them.
  @@unique([taskId, userId])
  /// "Which tasks have I ever held", which is My Tasks.
  @@index([userId])
  @@map("hrm_task_holder")
}

/// Everything that has ever happened to a task, in the order it happened.
///
/// A row per event rather than a handful of "changed by / changed at" columns on the task: the
/// history is read as a list, it never stops growing, and a column pair only ever remembers the
/// last thing anybody did. `detail` carries whatever the action needs to be understood on its own -
/// the revert reason, the status it moved from and to - so reading the log needs no second query.
model HrmTaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  /// CREATED, ASSIGNED, STATUS_CHANGED, SUBMITTED, COMPLETED, REASSIGNED, REVOKED, REVERTED or CANCELLED.
  action    String   @db.VarChar(40)
  detail    String?  @db.Text
  userId    Int?     @map("user_id")
  userName  String   @map("user_name") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")

  task HrmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// How the log is always read: one task's events, oldest first.
  @@index([taskId, createdAt])
  @@map("hrm_task_activity")
}

/// One person the studio is considering for a role, and where they have got to.
///
/// HRM's counterpart of a CRM lead, and built the same way: a row is typed in on the Interview
/// screen or arrives from a linked Google Sheet through Settings → Integrations → Interview, and is
/// then worked through statuses - New, Screening, Shortlisted, Interview Scheduled, Interviewed,
/// Selected, On Hold, Rejected, Joined. `status` is text rather than an enum so a sheet's own
/// wording survives the import verbatim: an unknown stage is shown as typed under All rather than
/// refused or silently filed as New.
///
/// The dates are text folded to `YYYY-MM-DD` on the way in, exactly as a lead's are, because they
/// arrive from the same four producers - the form, a sheet, a CSV, a person - and `leadDates.js` is
/// the one list of shapes all of them are read with. The branch is free text beside a reference,
/// matching every table but `User` and `Asset` (see CLAUDE.md); the interviewer likewise.
///
/// The `source_*` columns are the row's own identity on the sheet it came from, so a re-sync is an
/// edit of the same candidate rather than a second one, and deleting a link takes its candidates.
model HrmInterviewCandidate {
  id                    String    @id @default(cuid())
  /// DBS-INTV-000001, from the same counter table every other generated identifier uses.
  candidateCode         String    @unique @map("candidate_code") @db.VarChar(30)
  /// Nullable: a linked sheet stores a cell it cannot read as empty rather than refusing the
  /// whole row, and `name` is one of them. `sales_crm_lead.name` is nullable for the same reason.
  name                  String?   @db.VarChar(191)
  phone                 String?   @db.VarChar(40)
  whatsappNumber        String?   @map("whatsapp_number") @db.VarChar(40)
  email                 String?   @db.VarChar(191)
  /// The role applied for, picked from the designation list or typed as the sheet has it.
  position              String?   @db.VarChar(150)
  department            String?   @db.VarChar(120)
  experience            String?   @db.VarChar(60)
  currentCompany        String?   @map("current_company") @db.VarChar(191)
  currentCtc            String?   @map("current_ctc") @db.VarChar(60)
  /// The lowest the candidate would actually accept, beside what they are asking for. Two numbers
  /// rather than one because they answer different questions: `expectedCtc` is the opening ask, and
  /// this is the floor that decides whether a conversation is worth having at all.
  minExpectedCtc        String?   @map("min_expected_ctc") @db.VarChar(60)
  expectedCtc           String?   @map("expected_ctc") @db.VarChar(60)
  noticePeriod          String?   @map("notice_period") @db.VarChar(60)
  city                  String?   @db.VarChar(120)
  state                 String?   @db.VarChar(120)
  /// Where the candidate is **from**, and where they are **now** - the two questions the screening
  /// form asks in place of State and a postal Address.
  ///
  /// A studio hiring for a shoot floor wants to know whether somebody is local and whether they
  /// would be moving, and neither `state` nor a street address answered that: a state is too coarse
  /// to say "can they be here on Saturday", and an address is more than the studio needs of somebody
  /// it has not hired. Both stay on the record, because a linked sheet and the CSV import still fill
  /// them for candidates who arrived that way.
  nativePlace           String?   @map("native_place") @db.VarChar(191)
  currentLocation       String?   @map("current_location") @db.VarChar(191)
  /// The branch the candidate is being interviewed for, as text, with the reference beside it.
  branch                String?   @db.VarChar(120)
  branchId              Int?      @map("branch_id")
  /// Where the application came from - Naukri, LinkedIn, a referral, or "Google sheet integration".
  source                String?   @db.VarChar(120)
  referredBy            String?   @map("referred_by") @db.VarChar(191)
  /// Which paid ad the application came from, named as a Meta (Facebook/Instagram) lead export
  /// names them. Three columns rather than one, because a studio reads them at three different
  /// widths: the campaign says which hiring push, the ad set which audience, the ad which creative.
  /// Only a linked sheet or a CSV ever fills these in - nobody types an ad name by hand.
  campaignName          String?   @map("campaign_name") @db.VarChar(191)
  adsetName             String?   @map("adset_name") @db.VarChar(191)
  adName                String?   @map("ad_name") @db.VarChar(191)
  resumeUrl             String?   @map("resume_url") @db.VarChar(1000)
  /// Anything the candidate attached besides the résumé - certificates, an award letter, a scanned
  /// portfolio - as a JSON array of `{ name, url }`, the shape `storeDocument` returns. One column
  /// rather than a table for the reason the two entry lists beside it are: nothing reads an
  /// attachment apart from the candidate it belongs to.
  attachments           String?   @map("attachments") @db.LongText
  /// What an application form in a corporate or a studio asks beyond the contact card: the kind of
  /// engagement applied for, who the person is, what they know and where they have worked. Filled
  /// by HR on Add Application, or by the candidate on the public application form.
  employmentType        String?   @map("employment_type") @db.VarChar(40)
  gender                String?   @db.VarChar(30)
  dateOfBirth           String?   @map("date_of_birth") @db.VarChar(40)
  address               String?   @db.Text
  currentDesignation    String?   @map("current_designation") @db.VarChar(150)
  highestQualification  String?   @map("highest_qualification") @db.VarChar(191)
  skills                String?   @db.Text
  languagesKnown        String?   @map("languages_known") @db.Text
  /// The candidate's own links - a portfolio, an Instagram, a Drive folder - as a JSON array of up
  /// to three URL strings. `portfolioUrl` beside it is the **first** of them, kept as a plain column
  /// because the register's table, the linked sheets and the CSV importer all read a single link and
  /// none of them has a place to show three.
  portfolioLinks        String?   @map("portfolio_links") @db.LongText
  portfolioUrl          String?   @map("portfolio_url") @db.VarChar(1000)
  availableFrom         String?   @map("available_from") @db.VarChar(40)
  /// JSON arrays: the qualifications and the jobs the candidate listed on the application form,
  /// in the shape `RepeatableDetailsField` holds them - one column each rather than two tables,
  /// because nothing reads them apart from the record they belong to.
  educationEntries      String?   @map("education_entries") @db.LongText
  experienceEntries     String?   @map("experience_entries") @db.LongText
  status                String    @default("Yet to Connect") @db.VarChar(40)
  /// Who is handling the candidate: an employee's name, the way a lead's `crm` column holds one,
  /// filled by hand or by a linked sheet's assignment rules. The reference is refreshed on write.
  interviewer           String?   @db.VarChar(150)
  interviewerEmployeeId Int?      @map("interviewer_employee_id")
  /// Every round this candidate has been called for, as a JSON array of
  /// `{ round, interviewDate, interviewTime, interviewMode, meetLink }`.
  ///
  /// The four flat columns below are the **latest** round, which is what keeps the register's own
  /// table, the linked sheets and the CSV importer reading the one interview they always have. The
  /// array is what a second round stopped destroying: scheduling one used to overwrite the first,
  /// so nobody could say when a candidate had already been seen.
  ///
  /// Which round they are on is not a column: it is the length of this list, derived on read, so
  /// the count and the rounds cannot disagree.
  interviewRounds       String?   @map("interview_rounds") @db.LongText
  interviewDate         String?   @map("interview_date") @db.VarChar(40)
  interviewTime         String?   @map("interview_time") @db.VarChar(40)
  /// In Person, Google Meet or Phone.
  interviewMode         String?   @map("interview_mode") @db.VarChar(40)
  meetLink              String?   @map("meet_link") @db.VarChar(1000)
  appliedDate           String?   @map("applied_date") @db.VarChar(40)
  addedTime             String?   @map("added_time") @db.VarChar(40)
  lastFollowUpDate      String?   @map("last_follow_up_date") @db.VarChar(40)
  nextFollowUpDate      String?   @map("next_follow_up_date") @db.VarChar(40)
  remarks               String?   @db.Text
  /// Why a candidate was selected, put on hold or turned down, as a JSON array of
  /// `{ status, note, at }` - one entry per decision, newest last.
  ///
  /// Apart from `remarks` above, which is HR's running note on the person. A decision and a note
  /// are different things: a candidate can be held in March and rejected in May, and each has its
  /// own reason that the other must not overwrite. Folding them into `remarks` meant either losing
  /// the earlier one or appending until nobody could tell which sentence went with which stage.
  statusNotes           String?   @map("status_notes") @db.LongText
  /// The candidate's own two answers about the studio, asked on the application form.
  ///
  /// `howYouKnowUs` is deliberately **not** `source` above. That column is the studio's own answer
  /// to where an application came from - "Meta Ads", set by a linked sheet's rules - and letting a
  /// candidate write into it would let one submission overwrite what the import established, which
  /// is exactly why the form stopped sending `department`. The two answers different questions:
  /// where the row came from, and how the person says they heard of the place.
  howYouKnowUs          String?   @map("how_you_know_us") @db.VarChar(1000)
  aboutUs               String?   @map("about_us") @db.Text
  /// The row's identity on the sheet that imported it: the sheet's own Candidate ID column where it
  /// has one, `<spreadsheet>:<tab>:row:<n>` where it does not. NULL for a candidate typed in.
  sourceRowId           String?   @map("source_row_id") @db.VarChar(255)
  sourceRowNumber       Int?      @map("source_row_number")
  spreadsheetId         String?   @map("spreadsheet_id") @db.VarChar(191)
  gid                   String?   @db.VarChar(40)
  targetTab             String?   @map("target_tab") @db.VarChar(191)
  systemTableId         String?   @map("system_table_id") @db.VarChar(191)
  lastSourceSyncAt      DateTime? @map("last_source_sync_at")
  /// JSON object, for answers to fields a later Table Settings may add - one column rather than an
  /// ALTER TABLE per field, the same reasoning as the lead's.
  customFields          String?   @map("custom_fields") @db.LongText
  createdByUserId       Int?      @map("created_by_user_id")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  createdByUser       User?     @relation("HrmInterviewCandidateCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  interviewerEmployee Employee? @relation("HrmInterviewCandidateInterviewerEmployee", fields: [interviewerEmployeeId], references: [id], onDelete: SetNull)
  branchRef           Branch?   @relation("HrmInterviewCandidateBranchRef", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([phone])
  @@index([email])
  @@index([spreadsheetId, targetTab])
  @@index([sourceRowId])
  @@index([interviewerEmployeeId])
  @@index([branchId])
  @@index([createdByUserId])
  @@map("hrm_interview_candidate")
}

/// Where an application came from - Naukri, LinkedIn, Meta Ads, a referral, a walk-in.
///
/// A list the studio maintains (Settings → Fields → Interview → Sources) rather than an array in
/// the code, which is what it was: the same eleven values written out in
/// `hrm/interview/candidates.js` and again in `constants/interviewConfig.js`, so a studio that
/// started advertising somewhere new could not say so, and the two copies could disagree about
/// what the picker offered. Seeded by `prisma/seeds/interview-sources.seed.js` and by the migration
/// beside it, since the seed cannot be run on the VPS.
///
/// `sortOrder` because the order is the answer's own: the job boards the studio actually uses come
/// first and **Other** belongs last, which is not what sorting the words alphabetically gives.
///
/// The two sources the *application* writes for itself - "Application Form" and "Google sheet
/// integration" - are deliberately not rows here. They are what the public form and the sheet
/// importer stamp on a candidate and compare against, so they stay named in `candidates.js`: a
/// studio renaming a row must not change what the importer writes.
/// The positions the Interview register offers beyond the studio's designation list.
///
/// Position Applied For reads the designations, because most applications are for a role the studio
/// actually has. What it could not offer is a position nobody is ever *employed* as - "General",
/// the answer to a hiring ad that names no role - and putting that in `designation` would put it in
/// every employee's designation picker, which is a different question with a different answer.
model InterviewPosition {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("interview_position")
}

model InterviewSource {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("interview_source")
}

/// The link a candidate fills their application form in from - the Interview module's counterpart
/// of `EmployeeOnboardingInvite`, and built the same way: a hashed token, a short code the shared
/// link carries, an expiry, and the candidate's own email or phone as the gate to opening it.
///
/// `candidateId` is the register row the form writes into. Sending the form is what moves a
/// candidate to **Form Submission Pending**; the candidate submitting it moves them to **Form
/// Submitted** and stamps `submittedAt`. No foreign key, matching the tables beside it.
model HrmInterviewApplicationInvite {
  id              String    @id @default(cuid())
  candidateId     String?   @map("candidate_id") @db.VarChar(191)
  candidateName   String    @map("candidate_name") @db.VarChar(150)
  candidateEmail  String    @map("candidate_email") @db.VarChar(191)
  candidatePhone  String    @map("candidate_phone") @db.VarChar(30)
  position        String?   @db.VarChar(150)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  tokenPreview    String?   @map("token_preview") @db.VarChar(32)
  /// The raw token, kept so the link can be emailed again; an application token opens one form.
  token           String?   @db.VarChar(64)
  shortCode       String?   @unique @map("short_code") @db.VarChar(8)
  /// Created, Verified, Submitted, Expired or Cancelled - the onboarding invite's own states.
  status          String    @default("Created") @db.VarChar(20)
  expiresAt       DateTime  @map("expires_at")
  verifiedAt      DateTime? @map("verified_at")
  submittedAt     DateTime? @map("submitted_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdByUser User? @relation("HrmInterviewApplicationInviteCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([status, expiresAt])
  @@index([candidateEmail])
  @@index([createdAt])
  @@index([createdByUserId])
  @@map("hrm_interview_application_invite")
}

/// A Google Sheet linked to the Interview module: the same record `SalesGoogleSheetLink` is for
/// the CRM, kept as its own table so Settings → Integrations → Interview lists, syncs and deletes
/// its own sheets without ever touching the CRM's. Written through Prisma rather than raw SQL -
/// this table was born under a migration and needs no bootstrap.
model HrmInterviewGoogleSheetLink {
  id                        String    @id @default(cuid())
  /// The `sales_google_account_connection` row the sheet is read through. One Google account per
  /// login serves both integrations; the connection table is not duplicated.
  googleAccountConnectionId String?   @map("google_account_connection_id") @db.VarChar(191)
  systemTableName           String    @map("system_table_name") @db.VarChar(191)
  systemTableId             String    @default("") @map("system_table_id") @db.VarChar(191)
  sheetUrl                  String    @map("sheet_url") @db.VarChar(1000)
  spreadsheetId             String?   @map("spreadsheet_id") @db.VarChar(191)
  spreadsheetName           String?   @map("spreadsheet_name") @db.VarChar(255)
  targetedTab               String    @map("targeted_tab") @db.VarChar(191)
  status                    String    @default("ACTIVE") @db.VarChar(30)
  lastSyncedAt              DateTime? @map("last_synced_at")
  lastSyncStatus            String?   @map("last_sync_status") @db.VarChar(30)
  lastSyncSummary           String?   @map("last_sync_summary") @db.Text
  createdByUserId           Int?      @map("created_by_user_id")
  deletedAt                 DateTime? @map("deleted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  createdByUser User? @relation("HrmInterviewGoogleSheetLinkCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([googleAccountConnectionId])
  @@index([systemTableId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([createdByUserId])
  @@map("hrm_interview_google_sheet_link")
}

/// Whose candidate a sheet row is - one column matching one value - the same rule shape the CRM's
/// linked sheets use (`SalesGoogleSheetAssignmentRule`), pointed at an interviewer instead.
model HrmInterviewGoogleSheetAssignmentRule {
  id           String   @id @default(cuid())
  linkId       String   @map("link_id") @db.VarChar(191)
  priority     Int      @default(0)
  columnHeader String   @default("") @map("column_header") @db.VarChar(255)
  matchValue   String   @default("") @map("match_value") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([linkId])
  @@map("hrm_interview_google_sheet_assignment_rule")
}

/// One person on an interview assignment rule and the share of its candidates they take; see
/// `SalesGoogleSheetAssignmentRuleTarget` for why the share is a running count.
model HrmInterviewGoogleSheetAssignmentRuleTarget {
  id            String   @id @default(cuid())
  ruleId        String   @map("rule_id") @db.VarChar(191)
  position      Int      @default(0)
  employeeId    Int?     @map("employee_id")
  employeeName  String   @default("") @map("employee_name") @db.VarChar(150)
  percent       Int      @default(100)
  assignedCount Int      @default(0) @map("assigned_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee Employee? @relation("HrmInterviewGoogleSheetAssignmentRuleTargetEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([ruleId, employeeId], map: "hrm_interview_sheet_rule_target_rule_employee")
  @@index([ruleId])
  @@index([employeeId])
  @@map("hrm_interview_google_sheet_assignment_rule_target")
}

/// A sheet row the Interview module has already imported, kept apart from the candidate it made so
/// a candidate the studio deleted stays deleted on the next pass - see `SalesGoogleSheetRow`.
model HrmInterviewGoogleSheetRow {
  id            String   @id @default(cuid())
  linkId        String   @map("link_id") @db.VarChar(191)
  rowKey        String   @map("row_key") @db.VarChar(255)
  candidateCode String?  @map("candidate_code") @db.VarChar(30)
  firstSeenAt   DateTime @default(now()) @map("first_seen_at")

  @@unique([linkId, rowKey], map: "hrm_interview_google_sheet_row_link_key")
  @@index([candidateCode])
  @@map("hrm_interview_google_sheet_row")
}

/// One thing the application has to tell one person, waiting on the bell in the top bar.
///
/// General on purpose, though tasks are the only thing writing rows today: `type`, `entityType` and
/// `entityId` say what a notice is about, and `link` says where pressing it goes. A second module
/// that needs to tell somebody something adds a `type` and writes here rather than growing a bell
/// of its own - which is what the studio's meetings ended up doing, and why the bar used to have
/// one notification panel that only ever knew about meetings.
///
/// `readAt` rather than a boolean, because "when did they see it" is the question that gets asked.
model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  /// TASK_ASSIGNED, TASK_COMPLETED, TASK_REVERTED or TASK_CANCELLED.
  type       String    @db.VarChar(40)
  title      String    @db.VarChar(200)
  body       String?   @db.Text
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.VarChar(64)
  link       String?   @db.VarChar(300)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The only question the bell asks: this reader's notices, unread first, newest first.
  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// What state an asset is in - Condition on Assets, and on an inspection.
/// Client Storage keeps its own list beside this one: the words match today, but a hard disk
/// travelling to a client is not judged the way a camera on the shelf is, and the studio asked
/// for the two to be able to part company.
model AssetCondition {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "asset_condition_active_sort_idx")
  @@map("asset_condition")
}

/// How badly an asset is broken - Severity when a repair is raised on Assets.
model AssetRepairSeverity {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "asset_repair_severity_active_sort_idx")
  @@map("asset_repair_severity")
}

/// How an asset travels - Shipment Type when one is moved on Assets.
model AssetShipmentType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "asset_shipment_type_active_sort_idx")
  @@map("asset_shipment_type")
}

/// What state a client's hard disk is in on the way - Current Condition on Client Storage.
/// Its own list rather than the assets' one, by the studio's choice; see `AssetCondition`.
model StorageCondition {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "storage_condition_active_sort_idx")
  @@map("storage_condition")
}

/// How a client's hard disk travels - Shipment Type on Client Storage. Its own list; see above.
model StorageShipmentType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "storage_shipment_type_active_sort_idx")
  @@map("storage_shipment_type")
}

/// What a vendor is engaged for - Vendor Type on Vendors.
model VendorType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "vendor_type_active_sort_idx")
  @@map("vendor_type")
}

/// What kind of account the studio's money sits in - Account Type on Accounts Manager's bank
/// accounts. It was written out twice, once in the browser and once as a `z.enum` in the
/// master-data definition that validates it, so the two could disagree.
model BankAccountType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "bank_account_type_active_sort_idx")
  @@map("bank_account_type")
}

/// What a lead is being quoted for - Offer Type on Add Lead and on the Quotation Generator.
model OfferType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "offer_type_active_sort_idx")
  @@map("offer_type")
}

/// What kind of work a task is - Task Type on HRM -> Tasks.
///
/// `asks_for_details` is the meaning behind "Other": the type the list does not cover, which
/// then says what it actually was. It was the literal string `OTHER_TASK_TYPE` in the browser
/// and again in the service, so renaming it stopped the form asking.
model TaskType {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  description    String?  @db.Text
  asksForDetails Boolean  @default(false) @map("asks_for_details")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "task_type_active_sort_idx")
  @@map("task_type")
}

/// How a payment request settles up - Settlement on Accounts -> Payment Requests.
///
/// `means_excess` is the meaning behind "Expense Excess": the settlement where the studio spent
/// less than it advanced, so money comes back rather than goes out. It was the literal string
/// `SETTLEMENT_EXCESS`, written on both sides.
model PaymentSettlement {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  meansExcess Boolean  @default(false) @map("means_excess")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "payment_settlement_active_sort_idx")
  @@map("payment_settlement")
}

// ============================================================================================
// AI Feature (Visual Curation → AI Feature): event photo galleries with face recognition.
//
// Every table here is the AI Feature's own. None references an Image Selection or Album Proofing
// row, and none of those modules reference these: the two galleries the studio runs are separate
// products that happen to share a menu heading. `Ai*` alone is Nebula, the assistant; everything
// belonging to this module is prefixed `AiEvent` and mapped to `ai_event_*`.
//
// Staff user ids are bare `Int?` columns without a relation, as the Image Selection tables hold
// them, so a login going away never cascades into a gallery. Everything inside an event cascades
// from the event, which is the one delete the studio may ask for.
// ============================================================================================

model AiEvent {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(191)
  /// One of the event types the defaults list, or whatever the studio typed under "Other".
  eventType       String    @map("event_type") @db.VarChar(60)
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  timezone        String    @default("Asia/Kolkata") @db.VarChar(64)
  location        String?   @db.VarChar(255)
  description     String?   @db.Text
  /// R2 key of the cover picture, under `ai-feature/event-<id>/cover/`.
  coverKey        String?   @map("cover_key") @db.VarChar(1024)
  /// UPCOMING, ACTIVE, COMPLETED or ARCHIVED. Moved by the service and by the dates.
  status          String    @default("UPCOMING") @db.VarChar(20)
  /// Free text, as every module but Users and Assets holds it; carried for reporting, never filtered on.
  branch          String?   @db.VarChar(191)
  branchId        Int?      @map("branch_id")
  createdByUserId Int?      @map("created_by_user_id")
  archivedAt      DateTime? @map("archived_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  setting     AiEventSetting?
  subEvents   AiEventSubEvent[]
  guestGroups AiEventGuestGroup[]
  guests      AiEventGuest[]
  folders     AiEventMediaFolder[]
  media       AiEventMedia[]
  faces       AiEventFace[]
  embeddings  AiEventFaceEmbedding[]
  people      AiEventPerson[]
  guestFaces  AiEventGuestFace[]
  matches     AiEventFaceMatch[]
  share       AiEventShare?
  activities  AiEventActivity[]
  processingRuns AiEventProcessingRun[]
  notifications  AiEventNotification[]

  createdByUser User?   @relation("AiEventCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  branchRef     Branch? @relation("AiEventBranchRef", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([status, archivedAt])
  @@index([startDate])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([branchId])
  @@map("ai_event")
}

model AiEventSubEvent {
  id          String               @id @default(cuid())
  eventId     String               @map("event_id")
  name        String               @db.VarChar(191)
  date        DateTime?
  /// "HH:MM", or null. Text rather than a time column so an empty answer is not midnight.
  startTime   String?              @map("start_time") @db.VarChar(5)
  endTime     String?              @map("end_time") @db.VarChar(5)
  location    String?              @db.VarChar(255)
  description String?              @db.Text
  sortOrder   Int                  @default(0) @map("sort_order")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  event       AiEvent              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  folders     AiEventMediaFolder[]

  @@index([eventId, sortOrder])
  @@map("ai_event_sub_event")
}

/// The studio-wide template a new event is copied from. One row, keyed "default"; a null group
/// means the code's own defaults, so nothing has to be seeded.
model AiEventDefaultSetting {
  id              String   @id @default("default") @db.VarChar(30)
  general         Json?
  guestAccess     Json?    @map("guest_access")
  ai              Json?
  media           Json?
  gallery         Json?
  privacy         Json?
  notifications   Json?
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("AiEventDefaultSettingUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("ai_event_default_setting")
}

/// A watermark the studio saved once and picks for any event (AI Feature → Watermark Presets).
/// An event never points at a row here for rendering: choosing a preset copies it, logo included,
/// into the event's `gallery.watermarkSnapshot`, so editing or deleting a preset leaves every event
/// that already uses it as it was. The geometry is resolution-free - see watermarks/geometry.js.
model AiWatermarkPreset {
  id              String   @id @default(cuid())
  name            String   @unique @db.VarChar(80)
  /// LOGO or TEXT.
  type            String   @db.VarChar(10)
  /// R2 key of the logo (public bucket, `ai-feature-watermarks/`), a WebP that keeps transparency. Null for TEXT.
  logoKey         String?  @map("logo_key") @db.VarChar(1024)
  logoWidth       Int?     @map("logo_width")
  logoHeight      Int?     @map("logo_height")
  /// TEXT only: the words, their colour (#RRGGBB) and REGULAR or BOLD Montserrat.
  text            String?  @db.VarChar(120)
  textColor       String?  @map("text_color") @db.VarChar(7)
  fontWeight      String?  @map("font_weight") @db.VarChar(10)
  /// One of the nine anchors: TOP_LEFT ... BOTTOM_RIGHT.
  position        String   @db.VarChar(20)
  /// The mark's width as a percentage of the photo's shorter side.
  size            Int
  /// 5-100.
  opacity         Int
  /// Nudges from the anchor, as a percentage of the photo's width and height.
  offsetX         Int      @default(0) @map("offset_x")
  offsetY         Int      @default(0) @map("offset_y")
  createdByUserId Int?     @map("created_by_user_id")
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdByUser User? @relation("AiWatermarkPresetCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("AiWatermarkPresetUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  /// Photo Selling's own default watermark choice (photo_sale_setting); the preset is a studio-wide design.
  photoSaleSettingDefault PhotoSaleSetting[] @relation("PhotoSaleSettingWatermarkPreset")

  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("ai_watermark_preset")
}

/// One photo drawn with one watermark: the preview and thumbnail a guest is handed while the event's
/// watermark is on. `configHash` names the watermark it was drawn with, so a changed watermark is a
/// new row and an old row is never served for it. The photo's own keys are never touched.
model AiEventMediaWatermark {
  id           String       @id @default(cuid())
  mediaId      String       @map("media_id")
  configHash   String       @map("config_hash") @db.Char(64)
  previewKey   String       @map("preview_key") @db.VarChar(1024)
  thumbnailKey String?      @map("thumbnail_key") @db.VarChar(1024)
  createdAt    DateTime     @default(now()) @map("created_at")
  media        AiEventMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, configHash])
  @@map("ai_event_media_watermark")
}

/// Photo Selling (Visual Curation → Photo Selling): a studio's own galleries of photos sold to guests.
/// Independent of every other module: a gallery is created here, its photos are uploaded here (each
/// original byte for byte to the private originals bucket, its web-size copies to the public one), and everything
/// commercial - prices, orders, payments, entitlements - lives in these tables alone.
/// See docs/project-state/PHOTO-SELLING.md.
model PhotoSaleGallery {
  id                  String    @id @default(cuid())
  title               String    @db.VarChar(191)
  description         String?   @db.Text
  eventDate           DateTime? @map("event_date")
  venue               String?   @db.VarChar(255)
  /// One of this gallery's photos, shown as its cover; null shows the first photo.
  coverPhotoId        String?   @map("cover_photo_id")
  /// DRAFT, PUBLISHED or UNPUBLISHED. Only PUBLISHED, not archived and not past `expiresAt` opens publicly.
  status              String    @default("DRAFT") @db.VarChar(20)
  publishedAt         DateTime? @map("published_at")
  expiresAt           DateTime? @map("expires_at")
  archivedAt          DateTime? @map("archived_at")
  /// Set when a gallery that has orders is deleted: its photos, files and guests are gone, and the
  /// row stays only so its orders and payments keep their gallery. Hidden everywhere; its link is dead.
  deletedAt           DateTime? @map("deleted_at")
  /// ISO 4217. Amounts are whole minor units (paise) everywhere in this module.
  currency            String    @default("INR") @db.Char(3)
  /// The price of one photo - its untouched original, downloaded once paid - before any photo's own;
  /// null until set (publishing needs it).
  pricePaise          Int?      @map("price_paise")
  /// GST or other tax in basis points (1800 = 18%), and whether the prices above already include it.
  taxRateBps          Int       @default(0) @map("tax_rate_bps")
  pricesIncludeTax    Boolean   @default(true) @map("prices_include_tax")
  /// `#RRGGBB` for the store's buttons; null uses the house colour.
  accentColor         String?   @map("accent_color") @db.VarChar(9)
  /// The watermark the store's previews carry: a copy of a Watermark Preset, logo and all, kept here.
  watermarkSnapshot   Json?     @map("watermark_snapshot")
  /// How close a face must be to the guest's selfie to count as a match: STANDARD, STRICTER or
  /// BROADER - a level, turned into each face engine's own validated threshold (faces/thresholds.js).
  matchStrictness     String    @default("STANDARD") @map("match_strictness") @db.VarChar(12)
  /// The studio's client for this event - a contact typed here, not a link to another module's record.
  clientName          String?   @map("client_name") @db.VarChar(191)
  clientPhone         String?   @map("client_phone") @db.VarChar(20)
  /// The printed QR poster: one of the shared designs (lib/qrPoster.mjs) and Photo Selling's own words.
  qrTemplateId        String?   @map("qr_template_id") @db.VarChar(40)
  qrText              Json?     @map("qr_text")
  shareTokenHash      String    @unique @map("share_token_hash") @db.Char(64)
  shareTokenCipher    String    @map("share_token_cipher") @db.Text
  shortCode           String    @unique @map("short_code") @db.VarChar(12)
  pinHash             String?   @map("pin_hash") @db.VarChar(191)
  pinCipher           String?   @map("pin_cipher") @db.Text
  /// Store sessions opened - the denominator of the conversion rate.
  visitCount          Int       @default(0) @map("visit_count")
  /// Whether guests may search this gallery with a selfie (on: the store as it always was).
  selfieSearchEnabled Boolean   @default(true) @map("selfie_search_enabled")
  /// Whether a guest who left a WhatsApp number and agreed is told when later uploads match them.
  /// Off by default; nothing is sent unless the server's PHOTO_SELLING_WHATSAPP_ENABLED is "true" too.
  whatsappNotify      Boolean   @default(false) @map("whatsapp_notify")
  createdByUserId     Int?      @map("created_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  coverPhoto    PhotoSalePhoto?         @relation("PhotoSaleGalleryCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  createdByUser User?                   @relation("PhotoSaleGalleryCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  photos        PhotoSalePhoto[]        @relation("PhotoSaleGalleryPhotos")
  faces         PhotoSaleFace[]
  packages      PhotoSalePackage[]
  orders        PhotoSaleOrder[]
  searches      PhotoSaleSelfieSearch[]
  guests        PhotoSaleGuest[]
  guestSelfies  PhotoSaleGuestSelfie[]
  guestMatches  PhotoSaleGuestMatch[]
  notifications PhotoSaleNotification[]

  @@index([status, archivedAt])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([coverPhotoId])
  @@map("photo_sale_gallery")
}

/// A photo uploaded into a gallery: the untouched original in the private originals bucket (what a
/// buyer downloads), and its web-size preview and thumbnail in the public bucket (what is shown).
model PhotoSalePhoto {
  id                String           @id @default(cuid())
  galleryId         String           @map("gallery_id")
  /// The original's file name and its path inside the folder the uploader picked.
  fileName          String           @map("file_name") @db.VarChar(500)
  relativePath      String?          @map("relative_path") @db.VarChar(1024)
  mimeType          String           @map("mime_type") @db.VarChar(191)
  /// The original's size and type as stored; `sourceSizeBytes` is what the uploader's disk said it was.
  sizeBytes         BigInt           @map("size_bytes")
  sourceSizeBytes   BigInt?          @map("source_size_bytes")
  width             Int?
  height            Int?
  capturedAt        DateTime?        @map("captured_at")
  /// SHA-256 of the original's bytes; one photo per gallery, so a retried upload is the same row.
  contentHash       String           @map("content_hash") @db.Char(64)
  /// Where the untouched original sits in the private originals bucket - never sent to a browser.
  /// Null only for a photo uploaded before originals were stored, which cannot be bought.
  originalKey       String?          @map("original_key") @db.VarChar(1024)
  previewKey        String           @map("preview_key") @db.VarChar(1024)
  thumbnailKey      String           @map("thumbnail_key") @db.VarChar(1024)
  available         Boolean          @default(true)
  /// Overrides the gallery's price for this photo; null uses the gallery's.
  pricePaise        Int?             @map("price_paise")
  sortOrder         Int              @default(0) @map("sort_order")
  /// Face indexing for selfie search: NONE (no engine yet), QUEUED, PROCESSING, DONE or FAILED. Only
  /// a DONE photo can ever be returned to a guest.
  faceStatus        String           @default("NONE") @map("face_status") @db.VarChar(12)
  faceCount         Int              @default(0) @map("face_count")
  faceError         String?          @map("face_error") @db.VarChar(255)
  faceIndexedAt     DateTime?        @map("face_indexed_at")
  /// Set when a photo that has been sold is taken off: its files stay for the buyers who paid.
  removedAt         DateTime?        @map("removed_at")
  uploadedByUserId  Int?             @map("uploaded_by_user_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  gallery           PhotoSaleGallery @relation("PhotoSaleGalleryPhotos", fields: [galleryId], references: [id], onDelete: Cascade)
  uploadedByUser    User?            @relation("PhotoSalePhotoUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  coverOf           PhotoSaleGallery[] @relation("PhotoSaleGalleryCover")
  faces             PhotoSaleFace[]
  orderItems        PhotoSaleOrderItem[]
  watermarks        PhotoSaleWatermark[]
  guestMatches      PhotoSaleGuestMatch[]

  @@unique([galleryId, contentHash])
  @@index([galleryId, removedAt, available, sortOrder])
  @@index([galleryId, faceStatus])
  @@index([faceStatus, updatedAt])
  @@index([uploadedByUserId])
  @@map("photo_sale_photo")
}

/// A face found in a gallery photo, for selfie search: the engine's unit vector (base64 float32).
/// Never serialised to a browser; goes with its photo.
model PhotoSaleFace {
  id             String           @id @default(cuid())
  galleryId      String           @map("gallery_id")
  photoId        String           @map("photo_id")
  /// Which engine found it (insightface); a search reads only its own engine's faces.
  engine         String           @db.VarChar(20)
  dimension      Int?
  vector         String?          @db.Text
  quality        Float
  createdAt DateTime         @default(now()) @map("created_at")
  gallery   PhotoSaleGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photo     PhotoSalePhoto   @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([galleryId, engine])
  @@index([photoId])
  @@map("photo_sale_face")
}

/// A bundle: any `photoCount` photos for `pricePaise`. The cheapest combination is applied by
/// the server at checkout; the buyer never picks or submits one.
model PhotoSalePackage {
  id         String           @id @default(cuid())
  galleryId  String           @map("gallery_id")
  name       String           @db.VarChar(120)
  photoCount Int              @map("photo_count")
  pricePaise Int              @map("price_paise")
  isActive   Boolean          @default(true) @map("is_active")
  sortOrder  Int              @default(0) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  gallery    PhotoSaleGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, isActive])
  @@map("photo_sale_package")
}

/// A guest's order. Every amount is computed by the server and frozen here and on its items when the
/// order is made, so a later price change never alters it.
model PhotoSaleOrder {
  id               String           @id @default(cuid())
  /// The studio's and the buyer's reference, PS-XXXXXXXXXX; each payment attempt adds its own suffix.
  orderRef         String           @unique @map("order_ref") @db.VarChar(20)
  /// Restrict: a gallery that has taken orders is archived, never deleted.
  galleryId        String           @map("gallery_id")
  buyerName        String           @map("buyer_name") @db.VarChar(120)
  buyerPhone       String           @map("buyer_phone") @db.VarChar(20)
  buyerEmail       String?          @map("buyer_email") @db.VarChar(191)
  /// SHA-256 of the store session's id, so the buyer's own device lists its orders.
  buyerSessionHash String           @map("buyer_session_hash") @db.Char(64)
  /// SHA-256 of the order key handed to the buyer once, which opens the order on any device.
  accessKeyHash    String           @map("access_key_hash") @db.Char(64)
  /// PENDING (awaiting payment), PAID, FAILED (last attempt failed; retryable) or CANCELLED.
  status           String           @default("PENDING") @db.VarChar(20)
  currency         String           @db.Char(3)
  subtotalPaise    Int              @map("subtotal_paise")
  discountPaise    Int              @map("discount_paise")
  taxPaise         Int              @map("tax_paise")
  totalPaise       Int              @map("total_paise")
  /// The rules the total was computed with: tax rate, inclusive or not, packages applied.
  pricingSnapshot  Json             @map("pricing_snapshot")
  paidAt           DateTime?        @map("paid_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  gallery          PhotoSaleGallery @relation(fields: [galleryId], references: [id], onDelete: Restrict)
  items            PhotoSaleOrderItem[]
  payments         PhotoSalePayment[]
  paymentEvents    PhotoSalePaymentEvent[]

  @@index([galleryId, status])
  @@index([status, createdAt])
  @@index([buyerSessionHash])
  @@map("photo_sale_order")
}

/// One photo bought: its original, downloaded by the buyer once the order is paid. Items of kind DIGITAL
/// (a web-size copy) and the delivery columns are only on orders made before originals were sold.
model PhotoSaleOrderItem {
  id                String          @id @default(cuid())
  orderId           String          @map("order_id")
  /// Restrict: a photo that has been ordered can never be deleted - only taken off sale - so every
  /// buyer keeps what they paid for.
  photoId           String          @map("photo_id")
  /// ORIGINAL - the untouched file. DIGITAL (a web-size copy) is only on orders made before originals were sold.
  kind              String          @default("ORIGINAL") @db.VarChar(10)
  /// Frozen at purchase: the original's file name, folder path and fingerprint.
  fileName          String          @map("file_name") @db.VarChar(500)
  relativePath      String?         @map("relative_path") @db.VarChar(1024)
  contentHash       String?         @map("content_hash") @db.Char(64)
  unitPricePaise    Int             @map("unit_price_paise")
  /// What this line was charged after any package; the lines add up to the order's net amount.
  chargedPaise      Int             @map("charged_paise")
  /// PENDING_PAYMENT, READY (download open) or UNAVAILABLE. AWAITING_STUDIO and DELIVERED are only on
  /// orders made while originals were delivered by hand; the four delivery columns below are theirs.
  fulfilment        String          @default("PENDING_PAYMENT") @db.VarChar(20)
  deliveredAt       DateTime?       @map("delivered_at")
  deliveredByUserId Int?            @map("delivered_by_user_id")
  /// What the studio told the buyer when it delivered an original by hand, and the link it used.
  deliveryNote      String?         @map("delivery_note") @db.VarChar(500)
  deliveryUrl       String?         @map("delivery_url") @db.VarChar(1024)
  downloadCount     Int             @default(0) @map("download_count")
  lastDownloadedAt  DateTime?       @map("last_downloaded_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  order             PhotoSaleOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photo             PhotoSalePhoto  @relation(fields: [photoId], references: [id], onDelete: Restrict)
  deliveredByUser   User?           @relation("PhotoSaleOrderItemDeliveredByUser", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  downloads         PhotoSaleDownload[]

  @@unique([orderId, photoId, kind])
  @@index([photoId])
  @@index([fulfilment])
  @@index([deliveredByUserId])
  @@map("photo_sale_order_item")
}

/// One attempt to pay an order through Cashfree. `providerOrderId` is the order id Cashfree knows
/// (orderRef + attempt), so a retry is a new Cashfree order and can never double-charge the old one.
model PhotoSalePayment {
  id               String         @id @default(cuid())
  orderId          String         @map("order_id")
  attempt          Int
  provider         String         @default("CASHFREE") @db.VarChar(20)
  /// SANDBOX or PRODUCTION, from the server's configuration when the attempt was made.
  environment      String         @db.VarChar(12)
  providerOrderId  String         @unique @map("provider_order_id") @db.VarChar(45)
  cfOrderId        String?        @map("cf_order_id") @db.VarChar(64)
  paymentSessionId String?        @map("payment_session_id") @db.Text
  /// CREATED, PENDING, SUCCESS, FAILED, CANCELLED, EXPIRED or MISMATCH (paid an amount other than the order's).
  status           String         @default("CREATED") @db.VarChar(20)
  amountPaise      Int            @map("amount_paise")
  cfPaymentId      String?        @map("cf_payment_id") @db.VarChar(64)
  paymentGroup     String?        @map("payment_group") @db.VarChar(40)
  failureReason    String?        @map("failure_reason") @db.VarChar(255)
  expiresAt        DateTime?      @map("expires_at")
  verifiedAt       DateTime?      @map("verified_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  order            PhotoSaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events           PhotoSalePaymentEvent[]

  @@unique([orderId, attempt])
  @@index([status, createdAt])
  @@map("photo_sale_payment")
}

/// The audit trail of every payment notification and verification. `dedupeKey` is unique, so a
/// notification delivered twice is recorded - and acted on - once.
model PhotoSalePaymentEvent {
  id             String            @id @default(cuid())
  orderId        String?           @map("order_id")
  paymentId      String?           @map("payment_id")
  /// WEBHOOK, VERIFY (the server asked Cashfree) or RETRY.
  source         String            @db.VarChar(10)
  eventType      String            @map("event_type") @db.VarChar(60)
  dedupeKey      String            @unique @map("dedupe_key") @db.VarChar(191)
  signatureValid Boolean           @default(false) @map("signature_valid")
  providerStatus String?           @map("provider_status") @db.VarChar(30)
  amountPaise    Int?              @map("amount_paise")
  /// A small, sanitised summary - never card, UPI or customer details.
  summary        Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  order          PhotoSaleOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment        PhotoSalePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([paymentId])
  @@map("photo_sale_payment_event")
}

/// Each download of a purchased file, so a failed or repeated one can be seen and answered.
model PhotoSaleDownload {
  id          String             @id @default(cuid())
  orderItemId String             @map("order_item_id")
  /// STARTED while it streams, then SERVED or FAILED.
  status      String             @db.VarChar(10)
  error       String?            @db.VarChar(255)
  /// SHA-256 of the address it came from, never the address itself.
  clientHash  String?            @map("client_hash") @db.Char(64)
  /// SHA-256 of the download ticket's id: unique, so one ticket serves one download and no more.
  ticketHash  String?            @unique @map("ticket_hash") @db.Char(64)
  createdAt   DateTime           @default(now()) @map("created_at")
  orderItem   PhotoSaleOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId, createdAt])
  @@map("photo_sale_download")
}

/// A guest's selfie search: what it matched, for this device only. The selfie is never stored; its
/// face vector is kept only on a registered guest who agreed to WhatsApp messages (PhotoSaleGuest). These matches are the only photos
/// the guest may see or buy; the row goes when `expiresAt` passes, or when the guest deletes it.
model PhotoSaleSelfieSearch {
  id           String           @id @default(cuid())
  galleryId    String           @map("gallery_id")
  sessionHash  String           @map("session_hash") @db.Char(64)
  /// COMPLETED (matches found) or NO_MATCH.
  status       String           @db.VarChar(20)
  consentAt    DateTime         @map("consent_at")
  engine       String           @db.VarChar(20)
  threshold    Float
  matchCount   Int              @default(0) @map("match_count")
  /// `[{ photoId, score }]` best first - this gallery's indexed photos on sale, nothing else.
  matches      Json?
  expiresAt    DateTime         @map("expires_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  gallery      PhotoSaleGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sessionHash, expiresAt])
  @@index([expiresAt])
  @@index([galleryId, createdAt])
  @@map("photo_sale_selfie_search")
}

/// A guest who left their name and WhatsApp number in a store, before their selfie search - one per
/// gallery per store session (the device). With their consent (`whatsappOptInAt`), the face from their
/// latest selfie is kept (`faceVector`, the engine's unit vector, never serialised to a browser) so
/// that photos the studio uploads later can be matched to them and they can be told on WhatsApp.
/// Without consent no face is kept. Withdrawing consent clears the face; the gallery's deletion
/// removes the row. The number is E.164, as typed by the guest - no code proves it.
model PhotoSaleGuest {
  id               String    @id @default(cuid())
  galleryId        String    @map("gallery_id")
  sessionHash      String    @map("session_hash") @db.Char(64)
  name             String    @db.VarChar(191)
  phone            String    @db.VarChar(20)
  whatsappOptInAt  DateTime? @map("whatsapp_opt_in_at")
  whatsappOptOutAt DateTime? @map("whatsapp_opt_out_at")
  /// The single face kept before guests could keep several selfies: copied into PhotoSaleGuestSelfie
  /// by migration 20261030130000 and no longer read or written.
  faceEngine       String?   @map("face_engine") @db.VarChar(20)
  faceDimension    Int?      @map("face_dimension")
  faceVector       String?   @map("face_vector") @db.Text
  faceAt           DateTime? @map("face_at")
  /// Active selfies plus any being added right now - the 10-selfie limit as one conditional UPDATE.
  selfieCount      Int       @default(0) @map("selfie_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  gallery       PhotoSaleGallery        @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  matches       PhotoSaleGuestMatch[]
  notifications PhotoSaleNotification[]
  selfies       PhotoSaleGuestSelfie[]

  @@unique([galleryId, sessionHash])
  @@index([galleryId, faceAt])
  @@map("photo_sale_guest")
}

/// One of a guest's selfies (up to ten per gallery): the face engine's unit vector, searched with on
/// every later upload, and a small private thumbnail the guest sees in "Your Selfies" (in the private
/// originals bucket, under the gallery's folder). Never serialised to a browser but by its id. Removing
/// it deletes the vector and the thumbnail and drops the matches only it supported; the selfie itself
/// is never stored. `searchId` is the search it was taken in, removed with it.
model PhotoSaleGuestSelfie {
  id           String           @id @default(cuid())
  galleryId    String           @map("gallery_id")
  guestId      String           @map("guest_id")
  searchId     String?          @map("search_id")
  engine       String           @db.VarChar(20)
  dimension    Int
  vector       String           @db.Text
  thumbnailKey String?          @map("thumbnail_key") @db.VarChar(1024)
  createdAt    DateTime         @default(now()) @map("created_at")
  gallery      PhotoSaleGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  guest        PhotoSaleGuest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([galleryId])
  @@map("photo_sale_guest_selfie")
}

/// A photo matched to a registered guest. SELFIE: found by the guest's own search (on their screen
/// already, never messaged about). NEW_PHOTO: a photo uploaded later whose face matched the kept
/// selfie - reported once, by the message that claims it (`notificationId`). These are photos the
/// guest's device may see and buy, as a search's matches are.
model PhotoSaleGuestMatch {
  id             String                 @id @default(cuid())
  galleryId      String                 @map("gallery_id")
  guestId        String                 @map("guest_id")
  photoId        String                 @map("photo_id")
  score          Float
  source         String                 @db.VarChar(12)
  notificationId String?                @map("notification_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  gallery        PhotoSaleGallery       @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  guest          PhotoSaleGuest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  photo          PhotoSalePhoto         @relation(fields: [photoId], references: [id], onDelete: Cascade)
  notification   PhotoSaleNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([guestId, photoId])
  @@index([galleryId, source, notificationId])
  @@index([photoId])
  @@index([notificationId])
  @@map("photo_sale_guest_match")
}

/// One WhatsApp photo-match message to one guest, and what became of it (QUEUED, SENDING, SENT,
/// MOCK_SENT, FAILED, SKIPPED, UNCERTAIN). Only the masked number is kept. A message whose outcome is
/// unknown (UNCERTAIN) is never sent again, so a guest is never told twice.
model PhotoSaleNotification {
  id                String                @id @default(cuid())
  galleryId         String                @map("gallery_id")
  guestId           String                @map("guest_id")
  kind              String                @db.VarChar(30)
  channel           String                @db.VarChar(20)
  status            String                @db.VarChar(20)
  matchCount        Int                   @default(0) @map("match_count")
  recipientMasked   String?               @map("recipient_masked") @db.VarChar(40)
  template          String?               @db.VarChar(191)
  provider          String?               @db.VarChar(20)
  providerMessageId String?               @map("provider_message_id") @db.VarChar(191)
  attempts          Int                   @default(0)
  errorCode         String?               @map("error_code") @db.VarChar(80)
  errorMessage      String?               @map("error_message") @db.VarChar(500)
  sentAt            DateTime?             @map("sent_at")
  deliveredAt       DateTime?             @map("delivered_at")
  readAt            DateTime?             @map("read_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  gallery           PhotoSaleGallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  guest             PhotoSaleGuest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  matches           PhotoSaleGuestMatch[]

  @@index([galleryId, status])
  @@index([status, updatedAt])
  @@index([guestId])
  @@index([providerMessageId])
  @@map("photo_sale_notification")
}

/// The store's watermarked previews, one per photo per look.
model PhotoSaleWatermark {
  id           String         @id @default(cuid())
  photoId      String         @map("photo_id")
  configHash   String         @map("config_hash") @db.Char(64)
  previewKey   String         @map("preview_key") @db.VarChar(1024)
  thumbnailKey String?        @map("thumbnail_key") @db.VarChar(1024)
  createdAt    DateTime       @default(now()) @map("created_at")
  photo        PhotoSalePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, configHash])
  @@map("photo_sale_watermark")
}

/// Photo Selling's own studio-wide settings - one row, id "default". What a new gallery starts with
/// (copied on at creation, so a later change never alters an existing gallery), the QR poster
/// defaults, and the download policy each new order is sold under. Read and written only by Photo
/// Selling; no AI Feature setting is ever read in its place.
model PhotoSaleSetting {
  id                String    @id @default("default") @db.VarChar(20)
  pricePaise        Int?      @map("price_paise")
  taxRateBps        Int       @default(0) @map("tax_rate_bps")
  pricesIncludeTax  Boolean   @default(true) @map("prices_include_tax")
  requirePin        Boolean   @default(false) @map("require_pin")
  matchStrictness   String    @default("STANDARD") @map("match_strictness") @db.VarChar(12)
  accentColor       String?   @map("accent_color") @db.VarChar(9)
  /// The watermark design new galleries copy on; null leaves a new gallery to choose one.
  watermarkPresetId String?   @map("watermark_preset_id")
  qrTemplateId      String    @default("ivory") @map("qr_template_id") @db.VarChar(40)
  qrText            Json?     @map("qr_text")
  downloadLimit     Int       @default(20) @map("download_limit")
  downloadDays      Int       @default(365) @map("download_days")
  /// What a new gallery starts with for guest selfie search and WhatsApp photo-match messages.
  selfieSearchEnabled Boolean @default(true) @map("selfie_search_enabled")
  whatsappNotify      Boolean @default(false) @map("whatsapp_notify")
  updatedByUserId   Int?      @map("updated_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  watermarkPreset AiWatermarkPreset? @relation("PhotoSaleSettingWatermarkPreset", fields: [watermarkPresetId], references: [id], onDelete: SetNull)
  updatedByUser   User?              @relation("PhotoSaleSettingUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([watermarkPresetId])
  @@index([updatedByUserId])
  @@map("photo_sale_setting")
}

/// A file Photo Selling still has to delete from R2: written in the same transaction that deletes the
/// rows owning it, and removed only once the file is gone (shared/cleanup.js). `galleryId` is the id of
/// a gallery that may no longer exist - a record of whose folder the key lies in, so it is not a
/// relation. KEY is one object; PREFIX the sweep of that gallery's own folder.
model PhotoSaleStorageCleanup {
  id            String   @id @default(cuid())
  galleryId     String   @map("gallery_id") @db.VarChar(191)
  /// PUBLIC (R2_BUCKET_NAME) or ORIGINALS (the private originals bucket).
  target        String   @db.VarChar(10)
  /// KEY or PREFIX.
  kind          String   @db.VarChar(10)
  objectKey     String   @map("object_key") @db.VarChar(1024)
  /// SHA-256 of target, kind and key: one row per file however often a deletion is asked for.
  keyHash       String   @unique @map("key_hash") @db.Char(64)
  attempts      Int      @default(0)
  lastError     String?  @map("last_error") @db.VarChar(255)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([nextAttemptAt])
  @@index([galleryId, kind])
  @@map("photo_sale_storage_cleanup")
}

/// An event's own copy of the defaults, taken when it was created and edited on its own since. A
/// later change to the defaults never reaches a row here.
model AiEventSetting {
  id              String   @id @default(cuid())
  eventId         String   @unique @map("event_id")
  guestAccess     Json     @map("guest_access")
  ai              Json
  media           Json
  gallery         Json
  privacy         Json
  notifications   Json
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  event           AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  updatedByUser User? @relation("AiEventSettingUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("ai_event_setting")
}

model AiEventGuestGroup {
  id          String         @id @default(cuid())
  eventId     String         @map("event_id")
  name        String         @db.VarChar(120)
  /// The sub-event ids this group may see, as a JSON list. Null or empty means every sub-event.
  subEventIds Json?          @map("sub_event_ids")
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  event       AiEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests      AiEventGuest[]

  @@index([eventId, sortOrder])
  @@map("ai_event_guest_group")
}

model AiEventGuest {
  id              String             @id @default(cuid())
  eventId         String             @map("event_id")
  groupId         String?            @map("group_id")
  name            String             @db.VarChar(191)
  phone           String?            @db.VarChar(30)
  email           String?            @db.VarChar(191)
  /// PENDING, ACCEPTED or DECLINED.
  rsvp            String             @default("PENDING") @db.VarChar(20)
  /// NONE, UPLOADED or FAILED - whether a usable selfie is on file.
  selfieStatus    String             @default("NONE") @map("selfie_status") @db.VarChar(20)
  matchedCount    Int                @default(0) @map("matched_count")
  /// Selfies this guest has had accepted for the event; capped at SELFIE_LIMIT in public/service.js.
  selfieUploads   Int                @default(0) @map("selfie_uploads")
  /// When the guest asked for their photo summary on WhatsApp, set only once the number passed a
  /// code check. Null means no consent: never asked, or withdrawn (see whatsappOptOutAt).
  whatsappOptInAt  DateTime?         @map("whatsapp_opt_in_at")
  /// When the guest last withdrew that consent.
  whatsappOptOutAt DateTime?         @map("whatsapp_opt_out_at")
  /// The number, as `+<digits>`, that passed the code check. The guest counts as verified only while
  /// it equals their current phone, so a phone changed by staff is unverified again.
  verifiedPhone    String?           @map("verified_phone") @db.VarChar(30)
  phoneVerifiedAt  DateTime?         @map("phone_verified_at")
  /// Carried in every guest session as `v`; a session whose `v` differs is refused. Raised when the
  /// guest proves their phone at join, which ends every other session for them. Sessions issued
  /// before this existed carry no `v` and count as 0, so they stay valid until it is first raised.
  sessionVersion   Int               @default(0) @map("session_version")
  /// SHA-256 of the guest's own session secret, issued when they join from the event link.
  sessionHash     String?            @unique @map("session_hash") @db.Char(64)
  /// ADMIN for a guest the studio entered or imported, LINK for one who joined from the link.
  source          String             @default("ADMIN") @db.VarChar(20)
  joinedAt        DateTime?          @map("joined_at")
  lastSeenAt      DateTime?          @map("last_seen_at")
  notes           String?            @db.Text
  createdByUserId Int?               @map("created_by_user_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  event           AiEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group           AiEventGuestGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  faces           AiEventGuestFace[]
  matches         AiEventFaceMatch[]
  people          AiEventPerson[]
  uploads         AiEventMedia[]
  phoneOtps       AiEventGuestPhoneOtp[]
  notifications   AiEventNotification[]

  createdByUser User? @relation("AiEventGuestCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, name])
  @@index([eventId, phone])
  @@index([eventId, groupId])
  @@index([createdByUserId])
  @@map("ai_event_guest")
}

model AiEventMediaFolder {
  id         String           @id @default(cuid())
  eventId    String           @map("event_id")
  subEventId String?          @map("sub_event_id")
  name       String           @db.VarChar(191)
  sortOrder  Int              @default(0) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  event      AiEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subEvent   AiEventSubEvent? @relation(fields: [subEventId], references: [id], onDelete: SetNull)
  media      AiEventMedia[]

  @@index([eventId, sortOrder])
  @@index([subEventId])
  @@map("ai_event_media_folder")
}

model AiEventMedia {
  id                String              @id @default(cuid())
  eventId           String              @map("event_id")
  folderId          String?             @map("folder_id")
  /// PHOTO or VIDEO.
  kind              String              @default("PHOTO") @db.VarChar(10)
  fileName          String              @map("file_name") @db.VarChar(500)
  mimeType          String              @map("mime_type") @db.VarChar(191)
  sizeBytes         BigInt              @map("size_bytes")
  /// The photo's size on the uploader's disk when the client optimized it before sending; null when the bytes stored are the bytes the uploader had.
  sourceSizeBytes   BigInt?             @map("source_size_bytes")
  /// Where the photo sat inside the folder the uploader picked (Wedding/Bride/DSC_1001.JPG); null for single-file uploads and older rows.
  relativePath      String?             @map("relative_path") @db.VarChar(1024)
  width             Int?
  height            Int?
  capturedAt        DateTime?           @map("captured_at")
  /// SHA-256 of the source photo - the bytes the uploader had on disk - so the same frame uploaded twice, from the web or a desktop, optimized or not, is one row.
  contentHash       String?             @map("content_hash") @db.Char(64)
  /// R2 keys. The original is kept only when the event's media setting asks for it.
  originalKey       String?             @map("original_key") @db.VarChar(1024)
  previewKey        String?             @map("preview_key") @db.VarChar(1024)
  thumbnailKey      String?             @map("thumbnail_key") @db.VarChar(1024)
  /// QUEUED, PROCESSING, COMPLETED, FAILED or SKIPPED (a video, or face recognition off).
  aiStatus          String              @default("QUEUED") @map("ai_status") @db.VarChar(20)
  aiAttempts        Int                 @default(0) @map("ai_attempts")
  aiError           String?             @map("ai_error") @db.Text
  aiStartedAt       DateTime?           @map("ai_started_at")
  aiCompletedAt     DateTime?           @map("ai_completed_at")
  faceCount         Int                 @default(0) @map("face_count")
  /// The processing run this photo was queued under (processing/runs.js); null for rows queued before runs existed.
  runId             String?             @map("run_id")
  uploadedByUserId  Int?                @map("uploaded_by_user_id")
  uploadedByGuestId String?             @map("uploaded_by_guest_id")
  deletedAt         DateTime?           @map("deleted_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  event             AiEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  folder            AiEventMediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedByGuest   AiEventGuest?       @relation(fields: [uploadedByGuestId], references: [id], onDelete: SetNull)
  faces             AiEventFace[]
  matches           AiEventFaceMatch[]
  watermarks        AiEventMediaWatermark[]
  run               AiEventProcessingRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  uploadedByUser User? @relation("AiEventMediaUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, folderId, aiStatus])
  @@index([eventId, aiStatus])
  @@index([eventId, createdAt])
  @@index([eventId, contentHash])
  @@index([eventId, deletedAt])
  @@index([uploadedByUserId])
  @@index([runId, aiStatus])
  @@map("ai_event_media")
}

/// One face found in one photo. The vector lives in the table beside it so that no listing of
/// faces ever carries an embedding by accident.
model AiEventFace {
  id           String                @id @default(cuid())
  eventId      String                @map("event_id")
  mediaId      String                @map("media_id")
  personId     String?               @map("person_id")
  /// `{ x, y, w, h }` as fractions of the frame, so the box survives any resize.
  box          Json
  /// The detector's own confidence and a 0-1 quality score (size, sharpness, pose) used for gating.
  detScore     Float                 @map("det_score")
  quality      Float
  thumbnailKey String?               @map("thumbnail_key") @db.VarChar(1024)
  createdAt    DateTime              @default(now()) @map("created_at")
  event        AiEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media        AiEventMedia          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person       AiEventPerson?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  embedding    AiEventFaceEmbedding?
  matches      AiEventFaceMatch[]

  @@index([eventId, personId])
  @@index([mediaId])
  @@map("ai_event_face")
}

model AiEventFaceEmbedding {
  id        String      @id @default(cuid())
  faceId    String      @unique @map("face_id")
  eventId   String      @map("event_id")
  model     String      @db.VarChar(60)
  dimension Int
  /// The unit-normalised vector as base64 of little-endian float32. Never serialised to a browser.
  vector    String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  face      AiEventFace @relation(fields: [faceId], references: [id], onDelete: Cascade)
  event     AiEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("ai_event_face_embedding")
}

/// A cluster of faces the module believes are one person. Named by the studio, or linked to a guest.
model AiEventPerson {
  id          String             @id @default(cuid())
  eventId     String             @map("event_id")
  label       String?            @db.VarChar(120)
  guestId     String?            @map("guest_id")
  faceCount   Int                @default(0) @map("face_count")
  mediaCount  Int                @default(0) @map("media_count")
  /// Running mean of the member vectors, same encoding as the embeddings.
  centroid    String?            @db.Text
  coverFaceId String?            @map("cover_face_id")
  hidden      Boolean            @default(false)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  event       AiEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       AiEventGuest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)
  faces       AiEventFace[]
  matches     AiEventFaceMatch[]

  @@index([eventId, hidden])
  @@index([guestId])
  @@map("ai_event_person")
}

/// A guest's selfie, as the face found in it. The selfie itself is a private object.
model AiEventGuestFace {
  id           String       @id @default(cuid())
  eventId      String       @map("event_id")
  guestId      String       @map("guest_id")
  selfieKey    String       @map("selfie_key") @db.VarChar(1024)
  thumbnailKey String?      @map("thumbnail_key") @db.VarChar(1024)
  model        String       @db.VarChar(60)
  dimension    Int
  vector       String       @db.Text
  quality      Float
  createdAt    DateTime     @default(now()) @map("created_at")
  event        AiEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest        AiEventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, guestId])
  @@map("ai_event_guest_face")
}

/// "This photo has this guest in it", with how sure the module is and what was decided about it.
model AiEventFaceMatch {
  id                String         @id @default(cuid())
  eventId           String         @map("event_id")
  guestId           String         @map("guest_id")
  mediaId           String         @map("media_id")
  faceId            String?        @map("face_id")
  personId          String?        @map("person_id")
  similarity        Float
  /// HIGH, MEDIUM or LOW, against the event's thresholds at the time.
  band              String         @db.VarChar(10)
  /// MATCHED, CONFIRMED, REJECTED or REVIEW_REQUIRED.
  status            String         @default("MATCHED") @db.VarChar(20)
  /// SELFIE_SEARCH, AUTO, PERSON_LINK or MANUAL - how the match came about.
  source            String         @default("AUTO") @db.VarChar(20)
  reviewedByUserId  Int?           @map("reviewed_by_user_id")
  rejectedByGuestAt DateTime?      @map("rejected_by_guest_at")
  /// The guest summary that reported this match. Claimed once, in one transaction, so a match is
  /// never counted in two summaries.
  notificationId    String?        @map("notification_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  event             AiEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest             AiEventGuest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  media             AiEventMedia   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  face              AiEventFace?   @relation(fields: [faceId], references: [id], onDelete: SetNull)
  person            AiEventPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)
  notification      AiEventNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  reviewedByUser User? @relation("AiEventFaceMatchReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([guestId, mediaId], map: "ai_event_face_match_guest_media_unique")
  @@index([eventId, guestId, status])
  @@index([eventId, status])
  @@index([mediaId])
  @@index([reviewedByUserId])
  @@index([guestId, notificationId, status])
  @@index([notificationId])
  @@map("ai_event_face_match")
}

/// One six-digit code sent by SMS to prove a guest holds the phone their WhatsApp summary goes to.
/// Only the code's sha256 is kept. Spent on success, on expiry, or after too many wrong tries.
model AiEventGuestPhoneOtp {
  id        String       @id @default(cuid())
  guestId   String       @map("guest_id")
  /// The number the code went to, as `+<digits>`. Verifying proves this number, not whatever the guest's phone is later.
  phone     String       @db.VarChar(30)
  /// LOGIN (proving the phone to join as this guest) or WHATSAPP (proving it to receive the summary).
  /// A code only ever answers its own purpose; the send limits count both together.
  purpose   String       @default("WHATSAPP") @db.VarChar(20)
  codeHash  String       @map("code_hash") @db.Char(64)
  attempts  Int          @default(0)
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  guest     AiEventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, createdAt])
  @@index([phone, createdAt])
  @@map("ai_event_guest_phone_otp")
}

/// A stretch of AI processing for one event: opened when work arrives, settled once nothing in it is
/// queued or processing and nothing new has arrived for a quiet spell (processing/runs.js). At most
/// one run per event is OPEN, held by the unique `openKey` (the event id while open, null after).
model AiEventProcessingRun {
  id             String    @id @default(cuid())
  eventId        String    @map("event_id")
  /// OPEN, then COMPLETED, PARTIAL (some photos failed), FAILED (every photo failed) or STALLED (still waiting after the longest a run may take).
  status         String    @default("OPEN") @db.VarChar(20)
  openKey        String?   @unique @map("open_key") @db.VarChar(191)
  openedAt       DateTime  @default(now()) @map("opened_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  settledAt      DateTime? @map("settled_at")
  mediaTotal     Int       @default(0) @map("media_total")
  mediaCompleted Int       @default(0) @map("media_completed")
  mediaFailed    Int       @default(0) @map("media_failed")
  mediaSkipped   Int       @default(0) @map("media_skipped")
  mediaPending   Int       @default(0) @map("media_pending")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  event          AiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media          AiEventMedia[]
  notifications  AiEventNotification[]

  @@index([eventId, status])
  @@index([status, openedAt])
  @@map("ai_event_processing_run")
}

/// One message to one guest about one settled run. `idempotencyKey` is unique, so the same run never
/// produces two for the same guest. The guest's number is never stored here, only its masked form.
model AiEventNotification {
  id                String                @id @default(cuid())
  eventId           String                @map("event_id")
  guestId           String                @map("guest_id")
  runId             String?               @map("run_id")
  /// GUEST_PHOTO_SUMMARY.
  kind              String                @db.VarChar(40)
  /// WHATSAPP.
  channel           String                @db.VarChar(20)
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(191)
  /// QUEUED, SENDING, SENT, MOCK_SENT, FAILED, SKIPPED, or UNCERTAIN (the provider may have taken it; never resent);
  /// DELIVERED / READ / FAILED after SENT come from Meta's delivery webhook.
  status            String                @default("QUEUED") @db.VarChar(20)
  recipientMasked   String?               @map("recipient_masked") @db.VarChar(30)
  matchCount        Int                   @default(0) @map("match_count")
  provider          String?               @db.VarChar(20)
  template          String?               @db.VarChar(191)
  providerMessageId String?               @map("provider_message_id") @db.VarChar(191)
  attempts          Int                   @default(0)
  errorCode         String?               @map("error_code") @db.VarChar(80)
  errorMessage      String?               @map("error_message") @db.VarChar(500)
  sentAt            DateTime?             @map("sent_at")
  deliveredAt       DateTime?             @map("delivered_at")
  readAt            DateTime?             @map("read_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  event             AiEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest             AiEventGuest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  run               AiEventProcessingRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  matches           AiEventFaceMatch[]

  @@index([eventId, createdAt])
  @@index([guestId])
  @@index([runId])
  @@index([status])
  @@index([providerMessageId])
  @@map("ai_event_notification")
}

/// The guest-facing link: token by hash, short code in the URL, an optional PIN.
model AiEventShare {
  id              String    @id @default(cuid())
  eventId         String    @unique @map("event_id")
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  tokenCipher     String    @map("token_cipher") @db.Text
  shortCode       String?   @unique @map("short_code") @db.VarChar(8)
  pinHash         String?   @map("pin_hash") @db.VarChar(191)
  pinCipher       String?   @map("pin_cipher") @db.Text
  /// ACTIVE or REVOKED.
  status          String    @default("ACTIVE") @db.VarChar(20)
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  accessCount     Int       @default(0) @map("access_count")
  lastAccessAt    DateTime? @map("last_access_at")
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  event           AiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdByUser User? @relation("AiEventShareCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdByUserId])
  @@map("ai_event_share")
}

/// The event's timeline. Face vectors and secrets are never written here by construction.
model AiEventActivity {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  /// STAFF, GUEST or SYSTEM.
  actorType   String   @default("STAFF") @map("actor_type") @db.VarChar(20)
  actorUserId Int?     @map("actor_user_id")
  actorLabel  String?  @map("actor_label") @db.VarChar(191)
  event       String   @db.VarChar(50)
  detail      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  aiEvent     AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  actorUser User? @relation("AiEventActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([createdAt])
  @@index([actorUserId])
  @@map("ai_event_activity")
}

/// One photographer action on a culling run, kept for training-label quality: how a decision was
/// made (`source`: KEY, CLICK, PREVIEW_PANEL, BULK, COMPARE_DIALOG), a best-of-group change with
/// the group's new order, and sampled VIEWED marks. Append-only; never read by a culling run.
model ImageSelectionCullingDecisionEvent {
  id              String                        @id @default(cuid())
  sessionId       String                        @map("session_id")
  resultId        String?                       @map("result_id")
  groupId         String?                       @map("group_id")
  userId          Int?                          @map("user_id")
  kind            String                        @db.VarChar(20)
  fromDecision    String?                       @map("from_decision") @db.VarChar(20)
  toDecision      String?                       @map("to_decision") @db.VarChar(20)
  source          String                        @default("UNKNOWN") @db.VarChar(20)
  /// Which app the review happened in (WEB | DESKTOP). Metadata only: never a feature or a weight.
  platform        String                        @default("WEB") @db.VarChar(10)
  batchSize       Int                           @default(1) @map("batch_size")
  groupOrder      Json?                         @map("group_order")
  msSincePrevious Int?                          @map("ms_since_previous")
  createdAt       DateTime                      @default(now()) @map("created_at")
  session         ImageSelectionCullingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  result          ImageSelectionCullingResult?  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  group           ImageSelectionCullingGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  user            User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt], map: "image_selection_culling_decision_event_session_id_created_at_idx")
  @@index([resultId], map: "image_selection_culling_decision_event_result_id_idx")
  @@index([groupId], map: "image_selection_culling_decision_event_group_id_idx")
  @@index([userId, createdAt], map: "image_selection_culling_decision_event_user_id_created_at_idx")
  @@map("image_selection_culling_decision_event")
}

/// The learned-ranker registry: one bundle per row (global ranker, burst ranker, personalization,
/// thresholds), its checksummed artifact, the dataset and feature-set versions it was trained on,
/// its evaluation and its status: CANDIDATE, SHADOW, CANARY, PRODUCTION or RETIRED.
model ImageSelectionCullingModel {
  id                String                              @id @default(cuid())
  name              String                              @db.VarChar(80)
  version           String                              @db.VarChar(40)
  datasetVersion    String                              @map("dataset_version") @db.VarChar(80)
  featureSetVersion String                              @map("feature_set_version") @db.VarChar(40)
  engineVersion     String                              @map("engine_version") @db.VarChar(40)
  artifactPath      String                              @map("artifact_path") @db.VarChar(500)
  artifactSha256    String                              @map("artifact_sha256") @db.Char(64)
  artifactBytes     Int                                 @map("artifact_bytes")
  metrics           Json?
  hyperparameters   Json?
  status            String                              @default("CANDIDATE") @db.VarChar(20)
  notes             String?                             @db.Text
  /// The person who made the last move (a login named to the promote command).
  promotedByUserId  Int?                                @map("promoted_by_user_id")
  promotedAt        DateTime?                           @map("promoted_at")
  createdAt         DateTime                            @default(now()) @map("created_at")
  updatedAt         DateTime                            @updatedAt @map("updated_at")
  shadowResults     ImageSelectionCullingShadowResult[]
  promotedByUser    User?                               @relation("ImageSelectionCullingModelPromotedBy", fields: [promotedByUserId], references: [id], onDelete: SetNull)

  @@unique([name, version], map: "image_selection_culling_model_name_version_key")
  @@index([status], map: "image_selection_culling_model_status_idx")
  @@index([promotedByUserId], map: "image_selection_culling_model_promoted_by_user_id_idx")
  @@map("image_selection_culling_model")
}

/// What a shadow model would have said about one photo of one run. Never shown or used to decide.
model ImageSelectionCullingShadowResult {
  id          String                       @id @default(cuid())
  sessionId   String                       @map("session_id")
  resultId    String                       @map("result_id")
  modelId     String                       @map("model_id")
  score       Float
  decision    String?                      @db.VarChar(20)
  groupRank   Int?                         @map("group_rank")
  isGroupBest Boolean                      @default(false) @map("is_group_best")
  createdAt   DateTime                     @default(now()) @map("created_at")
  session     ImageSelectionCullingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  result      ImageSelectionCullingResult  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  model       ImageSelectionCullingModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([sessionId, resultId, modelId], map: "image_selection_culling_shadow_result_unique")
  @@index([modelId, sessionId], map: "image_selection_culling_shadow_result_model_session_idx")
  @@index([resultId], map: "image_selection_culling_shadow_result_result_id_idx")
  @@map("image_selection_culling_shadow_result")
}

/// A remark left when somebody updated one stage of a project from its Status tab - the project
/// started, its pre production or its production. The edit itself is written to that stage's own
/// records; this keeps why, by whom and when. `userName` is the name at the time, as a log keeps it.
model ProjectStageUpdate {
  id        Int      @id @default(autoincrement())
  projectId String   @map("project_id")
  /// STARTED, PRE_PRODUCTION or PRODUCTION (sales/projects/stage.js).
  stage     String   @db.VarChar(30)
  remark    String   @db.Text
  userId    Int?     @map("user_id")
  userName  String   @map("user_name") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")

  project SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?        @relation("ProjectStageUpdateUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("project_stage_update")
}

/// HRM → Payroll → Recovery: money an employee owes the studio, taken back from their salary over a
/// run of months. Only what is entered is stored. The monthly deduction (total ÷ months), the start
/// date (the 1st of the start month), the end date (the start plus the months) and the status
/// (Completed once the end date has passed, Active until then) are worked out on read
/// (`payroll-recovery/service.js`), so they can never disagree with what was entered.
///
/// The employee is the link, never a copy of their name or ID: a renamed employee reads under their
/// new name. Removed rows are kept (`deletedAt`, with who and why) for the audit trail.
model PayrollRecovery {
  id           Int       @id @default(autoincrement())
  /// `RECO-ID-0001` - one studio-wide run, minted on create (`identifiers.js`, PAYROLL_RECOVERY).
  recoveryId   String    @unique @map("recovery_id") @db.VarChar(20)
  employeeId   Int       @map("employee_id")
  totalAmount  Decimal   @map("total_amount") @db.Decimal(12, 2)
  /// 1 (January) to 12.
  startMonth   Int       @map("start_month")
  startYear    Int       @map("start_year")
  /// How many monthly deductions it is taken back over.
  months       Int
  reason       String?   @db.Text
  createdById  Int?      @map("created_by_id")
  updatedById  Int?      @map("updated_by_id")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  Int?      @map("deleted_by_id")
  deleteReason String?   @map("delete_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee  Employee @relation("PayrollRecoveryEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("PayrollRecoveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("PayrollRecoveryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy User?    @relation("PayrollRecoveryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  /// The advances converted into this recovery on Advance Salary (Convert to Recovery), if any.
  convertedAdvances PayrollAdvance[] @relation("PayrollAdvanceConvertedRecovery")
  /// The payroll months skipped on the Main Page: no instalment from them, the run one month longer each.
  skips             PayrollRecoverySkip[]

  @@index([employeeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@index([deletedAt])
  @@map("payroll_recovery")
}

/// HRM → Payroll → Advance Salary: money paid to an employee ahead of their salary, taken back in
/// full from one month's payroll - the deduction month - as that month's Salary Advance.
///
/// Only what is entered is stored: the date it was given, the employee (an id with its key, never a
/// copy of the name), the amount, the deduction month and year, and the reason. The status is worked
/// out on read. Removed rows are kept with who removed them and why.
model PayrollAdvance {
  id           Int       @id @default(autoincrement())
  /// `ADV-ID-0001` - one studio-wide run, minted on create (`identifiers.js`, PAYROLL_ADVANCE).
  advanceId    String    @unique @map("advance_id") @db.VarChar(20)
  employeeId   Int       @map("employee_id")
  /// The day the advance was given.
  advanceDate  DateTime  @map("advance_date") @db.Date
  amount       Decimal   @db.Decimal(12, 2)
  /// The payroll month it is taken back from: 1 (January) to 12.
  deductMonth  Int       @map("deduct_month")
  deductYear   Int       @map("deduct_year")
  reason       String?   @db.Text
  createdById  Int?      @map("created_by_id")
  updatedById  Int?      @map("updated_by_id")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  Int?      @map("deleted_by_id")
  deleteReason String?   @map("delete_reason") @db.Text
  /// Set once the advance is converted into a recovery (Advance Salary -> Convert to Recovery): it is
  /// then taken back by that recovery's instalments, never in its own month. Undoing the conversion
  /// clears it.
  convertedRecoveryId Int?      @map("converted_recovery_id")
  convertedAt         DateTime? @map("converted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// The approved Payment Request that asked for this advance, NULL on one entered by hand.
  ///
  /// A salary advance used to be two unconnected records: the request that asked for the money and
  /// was approved, and this row, which is what actually takes it back off a payslip - and nothing
  /// joined them, so an approved advance reached payroll only if somebody remembered to retype it
  /// here. Approving one writes this row now, and this is the link back. `@unique`, so approving the
  /// same request twice cannot leave two deductions behind it.
  paymentRequestId Int? @unique @map("payment_request_id")
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)

  employee  Employee @relation("PayrollAdvanceEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  convertedRecovery PayrollRecovery? @relation("PayrollAdvanceConvertedRecovery", fields: [convertedRecoveryId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("PayrollAdvanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("PayrollAdvanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy User?    @relation("PayrollAdvanceDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  /// The payroll months skipped on the Main Page: it comes off the next month not skipped instead.
  skips     PayrollAdvanceSkip[]

  @@index([employeeId, deductYear, deductMonth])
  @@index([convertedRecoveryId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@index([deletedAt])
  @@map("payroll_advance")
}

/// A payroll month an advance was skipped in, from the Main Page's Salary Advance cell: the advance
/// is not taken back that month but from the next month not skipped. Deleting the row undoes the skip.
model PayrollAdvanceSkip {
  id              Int      @id @default(autoincrement())
  advanceId       Int      @map("advance_id")
  year            Int
  /// 1 (January) to 12.
  month           Int
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  advance       PayrollAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("PayrollAdvanceSkipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([advanceId, year, month])
  @@index([createdByUserId])
  @@map("payroll_advance_skip")
}

/// A payroll month a recovery's instalment was skipped in, from the Main Page's Recovery Deduction
/// cell: nothing is taken that month, and the run takes one month longer - same instalment, later end.
/// Deleting the row undoes the skip.
model PayrollRecoverySkip {
  id              Int      @id @default(autoincrement())
  recoveryId      Int      @map("recovery_id")
  year            Int
  /// 1 (January) to 12.
  month           Int
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  recovery      PayrollRecovery @relation(fields: [recoveryId], references: [id], onDelete: Cascade)
  createdByUser User?           @relation("PayrollRecoverySkipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([recoveryId, year, month])
  @@index([createdByUserId])
  @@map("payroll_recovery_skip")
}

/// HRM → Payroll → Policy Breach: an amount an employee is fined for breaking a studio policy, taken
/// from their salary over a run of months - the Main Page's Policy Breach Deduction. Kept apart from
/// the register's Policy Breach Leaves, which are loss-of-pay days typed on one month's row.
///
/// Stored and read exactly as a recovery is (`payroll-policy-breach/service.js` reuses its run): only
/// what is entered - the employee (an id with its key, never a copy of the name), the total, the start
/// month and year, the number of months and the reason. The monthly deduction, the start and end dates
/// and the status are worked out on read. Removed rows are kept with who removed them and why.
model PayrollPolicyBreach {
  id             Int       @id @default(autoincrement())
  /// `PB-ID-0001` - one studio-wide run, minted on create (`identifiers.js`, PAYROLL_POLICY_BREACH).
  policyBreachId String    @unique @map("policy_breach_id") @db.VarChar(20)
  employeeId     Int       @map("employee_id")
  /// AMOUNT - a fine in rupees, `totalAmount` over the months - or LOP - `totalDays` of loss of pay
  /// spread over the months in half days, each month's share counted as LOP days on the Main Page.
  deductBy       String    @default("AMOUNT") @map("deduct_by") @db.VarChar(10)
  /// 0 on an LOP breach, which takes no amount of its own: its days are priced at each month's day rate.
  totalAmount    Decimal   @map("total_amount") @db.Decimal(12, 2)
  /// The loss-of-pay days of an LOP breach, in half days; NULL on an AMOUNT one.
  totalDays      Decimal?  @map("total_days") @db.Decimal(6, 1)
  /// 1 (January) to 12.
  startMonth     Int       @map("start_month")
  startYear      Int       @map("start_year")
  /// How many monthly deductions it is taken over.
  months         Int
  reason         String?   @db.Text
  createdById    Int?      @map("created_by_id")
  updatedById    Int?      @map("updated_by_id")
  deletedAt      DateTime? @map("deleted_at")
  deletedById    Int?      @map("deleted_by_id")
  deleteReason   String?   @map("delete_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employee  Employee @relation("PayrollPolicyBreachEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("PayrollPolicyBreachCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("PayrollPolicyBreachUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy User?    @relation("PayrollPolicyBreachDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  /// The payroll months skipped on the Main Page: no instalment from them, the run one month longer each.
  skips     PayrollPolicyBreachSkip[]

  @@index([employeeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@index([deletedAt])
  @@map("payroll_policy_breach")
}

/// A payroll month a policy breach's instalment was skipped in, from the Main Page's Policy Breach
/// Deduction cell: nothing is taken that month, and the run takes one month longer. Deleting the row
/// undoes the skip.
model PayrollPolicyBreachSkip {
  id              Int      @id @default(autoincrement())
  policyBreachId  Int      @map("policy_breach_id")
  year            Int
  /// 1 (January) to 12.
  month           Int
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  policyBreach  PayrollPolicyBreach @relation(fields: [policyBreachId], references: [id], onDelete: Cascade)
  createdByUser User?               @relation("PayrollPolicyBreachSkipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([policyBreachId, year, month])
  @@index([createdByUserId])
  @@map("payroll_policy_breach_skip")
}

/// HRM → Payroll → Main Page: one employee's pay for one month - the studio's payroll sheet, as a
/// register. One row per employee per month (`@@unique`).
///
/// What is entered or brought in is stored: the base salary and the attendance leaves as they stood
/// when the row was generated or refreshed (their source changes; a month already worked out must
/// not move under it), the pay cycle's working and calendar days (the loss-of-pay divisor), the
/// recovery due that month from Payroll → Recovery, and what is typed - incentive, policy breach
/// leaves, salary advance, other deductions, remarks and the payment. Everything else - total
/// earned, total leaves, the loss-of-pay deduction, total deductions, net and rounded salary - is
/// worked out on read under Settings → Payroll rules (`payroll-register/service.js`), to the paisa -
/// a paid row under the rules it was paid under (`paidLopDivisor`, `paidRounding`).
///
/// `paymentFrom` is the paying account's label as it read when the salary was paid - a record of the
/// payment, the way Accounts' cash entries keep it - because branch bank accounts are edited as a
/// list and do not keep their ids.
model PayrollEntry {
  id                 Int       @id @default(autoincrement())
  employeeId         Int       @map("employee_id")
  year               Int
  /// 1 (January) to 12.
  month              Int
  /// The pay cycle the attendance was read over: the cycle day of the month before to the day before
  /// it in this month (25 May - 24 June for June, with the cycle on the 25th).
  periodFrom         DateTime  @map("period_from") @db.Date
  periodTo           DateTime  @map("period_to") @db.Date
  baseSalary         Decimal   @map("base_salary") @db.Decimal(12, 2)
  incentive          Decimal   @default(0) @db.Decimal(12, 2)
  /// What HRM → Employee Referral has due this month to this employee as the **referrer**, brought in
  /// on generate and refresh - never typed here. An earning: it adds to Total Earned Salary. Only
  /// where both the referrer and the employee they referred were working when the month was read
  /// (`referrals/service.js` `referralBonusDueIn`); paying the month settles the instalment.
  referralBonus      Decimal   @default(0) @map("referral_bonus") @db.Decimal(12, 2)
  /// Loss-of-pay days from attendance: absences, and half days as half.
  attendanceLeaves   Decimal   @default(0) @map("attendance_leaves") @db.Decimal(6, 2)
  /// Typed by hand on the Main Page: the register's automatic update leaves this figure as typed.
  baseSalaryTyped       Boolean @default(false) @map("base_salary_typed")
  attendanceLeavesTyped Boolean @default(false) @map("attendance_leaves_typed")
  /// Casual Leave Taken over the cycle, brought in with the rest: the leave days the Casual Leave
  /// balance covered. Paid - Total Leaves is Attendance Leaves and Policy Breach Leaves less these.
  casualLeaveDays    Decimal   @default(0) @map("casual_leave_days") @db.Decimal(6, 2)
  /// Comp-Off Taken over the cycle, brought in with the rest and shown only: the approved comp-off days
  /// off. Never paid for, never taken off - the day off is paid like any working day.
  compOffTakenDays   Decimal   @default(0) @map("comp_off_taken_days") @db.Decimal(6, 2)
  /// The pay cycle's days before the employee joined, in the unit a day's pay is counted in - working
  /// days under WORKING_DAYS, calendar days otherwise. Unpaid: Total Leaves adds them, so the LOP
  /// deduction takes them off and a part month is paid as a part month.
  daysBeforeJoining  Decimal   @default(0) @map("days_before_joining") @db.Decimal(6, 2)
  /// The pay cycle's days after the employee's relieving date (their last working day), counted the
  /// same way as `daysBeforeJoining` and unpaid the same way - a leaver is paid up to their last day.
  daysAfterRelieving Decimal   @default(0) @map("days_after_relieving") @db.Decimal(6, 2)
  policyBreachLeaves Decimal   @default(0) @map("policy_breach_leaves") @db.Decimal(6, 2)
  /// Attendance Rules' irregularity penalty over the cycle: its days for every day still Absent,
  /// brought in from attendance as the month updates. Added to Total Leaves, so it is loss of pay.
  irregularityPenaltyDays Decimal   @default(0) @map("irregularity_penalty_days") @db.Decimal(6, 2)
  workingDays        Int       @map("working_days")
  periodDays         Int       @map("period_days")
  /// What Payroll → Advance Salary takes back this month, brought in - never typed here.
  salaryAdvance      Decimal   @default(0) @map("salary_advance") @db.Decimal(12, 2)
  /// What Payroll → Recovery has due this month, brought in on generate and refresh.
  recoveryDeduction  Decimal   @default(0) @map("recovery_deduction") @db.Decimal(12, 2)
  /// What Payroll → Policy Breach has due this month, brought in on generate and refresh.
  policyBreachDeduction Decimal  @default(0) @map("policy_breach_deduction") @db.Decimal(12, 2)
  /// The days an LOP policy breach takes this month, brought in on generate and refresh like the
  /// deduction above. Added to Total Leaves, so it is loss of pay - apart from the typed Policy Breach Leaves.
  policyBreachLopDays Decimal  @default(0) @map("policy_breach_lop_days") @db.Decimal(6, 2)
  otherDeductions    Decimal   @default(0) @map("other_deductions") @db.Decimal(12, 2)
  remarks            String?   @db.Text
  /// Pending | Paid | On Hold.
  paymentStatus      String    @default("Pending") @map("payment_status") @db.VarChar(20)
  paymentModeId      Int?      @map("payment_mode_id")
  paymentFrom        String?   @map("payment_from") @db.VarChar(120)
  paymentDate        DateTime? @map("payment_date") @db.Date
  paymentRemarks     String?   @map("payment_remarks") @db.Text
  /// The Payroll rules a row was paid under - set when it is marked Paid, cleared when it is set back
  /// to Pending - so changing the rules never moves a month already paid. Null on an unpaid row,
  /// which is worked out under the rules as they are now.
  paidLopDivisor     String?   @map("paid_lop_divisor") @db.VarChar(20)
  paidRounding       String?   @map("paid_rounding") @db.VarChar(20)
  /// Frozen on the Main Page (Payment → Freeze): settled like a paid row before it is paid - nothing
  /// that happens later (Refresh, an advance, a recovery, a skip, a rules change) changes its figures,
  /// and its rules are kept in `paid_lop_divisor` / `paid_rounding` from the moment it is frozen.
  /// Its payment can still be recorded. Unfreezing opens it again.
  frozen             Boolean   @default(false)
  frozenAt           DateTime? @map("frozen_at")
  /// A month held for the employee's notice, once the full and final settlement that paid it is paid:
  /// that settlement's row. Set and cleared with the settlement row's payment, never by hand.
  settledInEntryId   Int?      @map("settled_in_entry_id")
  frozenByUserId     Int?      @map("frozen_by_user_id")
  /// Payment → Cost Centre: the branch this row's pay is booked to, chosen from every active branch.
  /// Empty until chosen; cleared if the branch is removed.
  costCentreBranchId Int?      @map("cost_centre_branch_id")
  /// Removed from the month on the Main Page: kept rather than deleted, so the month's update does not
  /// add the employee back. Restore clears it.
  removedAt          DateTime? @map("removed_at")
  removedByUserId    Int?      @map("removed_by_user_id")
  removedReason      String?   @map("removed_reason") @db.VarChar(500)
  createdByUserId    Int?      @map("created_by_user_id")
  updatedByUserId    Int?      @map("updated_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  employee      Employee     @relation("PayrollEntryEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  paymentMode   PaymentMode? @relation("PayrollEntryPaymentMode", fields: [paymentModeId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("PayrollEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("PayrollEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  frozenByUser  User?        @relation("PayrollEntryFrozenBy", fields: [frozenByUserId], references: [id], onDelete: SetNull)
  settledInEntry PayrollEntry?  @relation("PayrollEntrySettledIn", fields: [settledInEntryId], references: [id], onDelete: SetNull)
  settlesEntries PayrollEntry[] @relation("PayrollEntrySettledIn")
  removedByUser User?        @relation("PayrollEntryRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)
  costCentreBranch Branch?   @relation("PayrollEntryCostCentre", fields: [costCentreBranchId], references: [id], onDelete: SetNull)
  components    PayrollEntryComponent[] @relation("PayrollEntryComponentEntry")
  /// The referral instalments this month paid, which is how a paid row finds them again.
  referralPayouts EmployeeReferralPayout[]

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([paymentModeId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([frozenByUserId])
  @@index([settledInEntryId])
  @@index([costCentreBranchId])
  @@index([removedByUserId])
  @@map("payroll_entry")
}

/// Settings → Payroll rules → Edit Payslip: a detail the studio adds to the payslip under Personal
/// details or PF details - a field Edit Employee → Payslip Details then asks for, each employee's
/// answer kept in `EmployeePayslipValue`. (Earnings and Deductions added there are `PayrollComponent`.)
model PayslipField {
  id              Int       @id @default(autoincrement())
  /// `PERSONAL` or `PF` - which part of Payslip Details, and of the payslip, it sits in.
  section         String    @db.VarChar(20)
  label           String    @db.VarChar(60)
  /// What is typed into it: `TEXT` (no digits), `NUMBER`, `ALNUM` (letters and numbers), `ANY` (any
  /// character, symbols included), `DATE`, or
  /// `DROPDOWN` (one of `options`).
  inputType       String    @map("input_type") @db.VarChar(10)
  /// A `DROPDOWN`'s choices, as typed in Edit Payslip - `["A+", "B+", ...]`; null for every other type.
  options         Json?
  sortOrder       Int       @default(0) @map("sort_order")
  /// Edit Payslip's toggle: off, it is neither asked for nor printed; the answers are kept.
  shownOnPayslip  Boolean   @default(true) @map("shown_on_payslip")
  /// Archived: no longer asked for or printed; the answers already given are kept.
  archivedAt      DateTime? @map("archived_at")
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdByUser User?                  @relation("PayslipFieldCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  values        EmployeePayslipValue[] @relation("EmployeePayslipValueField")

  @@unique([section, label])
  @@index([createdByUserId])
  @@map("payslip_field")
}

/// One employee's answer to one `PayslipField`, as typed in Edit Employee → Payslip Details.
model EmployeePayslipValue {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  fieldId    Int      @map("field_id")
  value      String   @db.VarChar(500)
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee     @relation("EmployeePayslipValueEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  field    PayslipField @relation("EmployeePayslipValueField", fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fieldId])
  @@index([fieldId])
  @@map("employee_payslip_value")
}

/// A birthday or wedding-anniversary wish sent into the Attendance WhatsApp Report's group - one row
/// a person, a kind and a day, which is what stops anybody being wished twice, and which of the ten
/// Settings → Wishes messages was picked for them.
model EmployeeWish {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  /// `BIRTHDAY`, `WEDDING_ANNIVERSARY` or `WORK_ANNIVERSARY`.
  kind         String   @db.VarChar(30)
  /// The studio's day it was sent for.
  wishedOn     DateTime @map("wished_on") @db.Date
  templateKey  String?  @map("template_key") @db.VarChar(60)
  sentByUserId Int?     @map("sent_by_user_id")
  sentAt       DateTime @default(now()) @map("sent_at")

  employee     Employee         @relation("EmployeeWishEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  template     MessageTemplate? @relation("EmployeeWishTemplate", fields: [templateKey], references: [key], onDelete: SetNull)
  sentByUser   User?            @relation("EmployeeWishSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, kind, wishedOn])
  @@index([templateKey])
  @@index([sentByUserId])
  @@map("employee_wish")
}

/// Settings → Payroll rules → Extra columns: a column the studio adds to Payroll → Main Page under
/// Earnings or Deductions - an allowance, a fine - beside the built-in ones. Its amounts are typed per
/// row (`PayrollEntryComponent`); an earning adds to Total Earned, a deduction to Total Deductions.
/// Archived, it is offered no longer, but stays on the months that hold an amount for it.
model PayrollComponent {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(60)
  /// EARNING | DEDUCTION - fixed once made, since the months that hold it were worked out by it.
  kind            String    @db.VarChar(20)
  sortOrder       Int       @default(0) @map("sort_order")
  archivedAt      DateTime? @map("archived_at")
  /// Settings → Payroll rules → Edit Payslip's toggle: off, the payslip leaves it off; the Main Page keeps it.
  shownOnPayslip  Boolean   @default(true) @map("shown_on_payslip")
  createdByUserId Int?      @map("created_by_user_id")
  updatedByUserId Int?      @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdByUser User?                   @relation("PayrollComponentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?                   @relation("PayrollComponentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  values        PayrollEntryComponent[] @relation("PayrollEntryComponentComponent")

  @@unique([name])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("payroll_component")
}

/// One row's amount for one extra column. No row means nothing (0) - a cleared amount is deleted.
model PayrollEntryComponent {
  id          Int      @id @default(autoincrement())
  entryId     Int      @map("entry_id")
  componentId Int      @map("component_id")
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entry     PayrollEntry     @relation("PayrollEntryComponentEntry", fields: [entryId], references: [id], onDelete: Cascade)
  component PayrollComponent @relation("PayrollEntryComponentComponent", fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([entryId, componentId])
  @@index([componentId])
  @@map("payroll_entry_component")
}

/// Settings → Payroll rules (the salary rules and the Attendance calculator's days), by the payroll
/// month they apply from. A month is worked out under the
/// latest version effective on or before it, so changing the rules moves the current month and later
/// ones only - earlier months, generated or not, keep the rules they had. (A paid row is settled
/// further still, under `paid_lop_divisor` / `paid_rounding`.) The first change also records the rules
/// as they stood before it, from January 2000, so every earlier month has a version to read.
model PayrollRuleVersion {
  id              Int      @id @default(autoincrement())
  effectiveYear   Int      @map("effective_year")
  /// 1 (January) to 12.
  effectiveMonth  Int      @map("effective_month")
  lopDivisor      String   @map("lop_divisor") @db.VarChar(20)
  rounding        String   @db.VarChar(20)
  /// The Attendance calculator's two days: the cycle turns over on `cycleDay` (1 is the calendar
  /// month), and the month is payable on `paybackDay` of the following month. A month starts the day
  /// after the one before it ended, so a change of cycle day neither skips nor repeats a day.
  cycleDay        Int      @default(25) @map("cycle_day")
  paybackDay      Int      @default(10) @map("payback_day")
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdByUser User? @relation("PayrollRuleVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([effectiveYear, effectiveMonth])
  @@index([createdByUserId])
  @@map("payroll_rule_version")
}

/// Calendar → Block Period: a branch's hours on one day held with nothing booked in them - a repair, a
/// walkthrough, a client still deciding - from `startTime` to `endTime` ("HH:MM", end after start),
/// and why. Two blocks in one branch on one day never overlap. Removing one frees the hours.
model CalendarBlock {
  id              Int      @id @default(autoincrement())
  branchId        Int      @map("branch_id")
  blockDate       DateTime @map("block_date") @db.Date
  startTime       String   @map("start_time") @db.VarChar(5)
  endTime         String   @map("end_time") @db.VarChar(5)
  reason          String   @db.VarChar(300)
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  branch        Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByUser User?  @relation("CalendarBlockCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([branchId, blockDate])
  @@index([blockDate])
  @@index([createdByUserId])
  @@map("calendar_block")
}

/// What was done to a project, by whom and when - the Activity tab of a project on Projects (area
/// PROJECT) and on Pre Production (area PRE_PRODUCTION), newest first. Production keeps its own log per
/// shoot (`project_production_activity`). A line names its shoot when it was about one.
model ProjectActivity {
  id        String        @id @default(cuid())
  projectId String        @map("project_id")
  shootId   String?       @map("shoot_id")
  /// PROJECT or PRE_PRODUCTION - which screen's Activity tab it belongs to.
  area      String        @db.VarChar(20)
  action    String        @db.VarChar(40)
  /// What changed, in words - the fields, the status and its remarks.
  detail    String?       @db.Text
  userId    Int?          @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  project   SalesProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot     ProjectShoot? @relation(fields: [shootId], references: [id], onDelete: SetNull)
  user      User?         @relation("ProjectActivityBy", fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, area, createdAt])
  @@index([shootId])
  @@index([userId])
  @@map("project_activity")
}

/// A role handed from a leaver to the person taking over, at offboarding: a project's role (`role` is
/// its field, `projectManagerEmployeeId`), a shoot's Production Coordinator, or a crew place. Screens
/// show the holder as "New (Old)" while the role is still held by `toEmployee` - a later change by
/// hand ends it, with nothing to clear.
model EmployeeHandover {
  id             Int      @id @default(autoincrement())
  projectId      String?  @map("project_id")
  productionId   String?  @map("production_id")
  crewId         String?  @map("crew_id")
  /// A project role field (the keys of `PROJECT_ROLE_NAMES` in services/handoverNames.js),
  /// `productionCoordinatorEmployeeId`, or `crew` - written by hrm/separations/handover.js.
  role           String   @db.VarChar(60)
  fromEmployeeId Int?     @map("from_employee_id")
  toEmployeeId   Int?     @map("to_employee_id")
  createdAt      DateTime @default(now()) @map("created_at")

  project      SalesProject?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  production   ProjectProduction?            @relation(fields: [productionId], references: [id], onDelete: Cascade)
  crew         ProjectProductionServiceCrew? @relation(fields: [crewId], references: [id], onDelete: Cascade)
  fromEmployee Employee?                     @relation("EmployeeHandoverFrom", fields: [fromEmployeeId], references: [id], onDelete: SetNull)
  toEmployee   Employee?                     @relation("EmployeeHandoverTo", fields: [toEmployeeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([productionId])
  @@index([crewId])
  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@map("employee_handover")
}

/// Settings → WhatsApp Activity Log: one row per logical WhatsApp message the app tried to send,
/// manual (a staff button) or automatic (a scheduler or a business event), over either transport.
/// Written only by `src/services/whatsappActivity.js` - every send path goes through its `track`.
/// `logicalKey` is what makes an automatic event send once: a second `track` for a key already
/// SENT is answered from the row. `recipientAddress` is the raw phone or group jid, kept so a
/// failed message can be sent again to the same place; the API returns `recipientMasked` only.
/// `body` is kept only while the message may be resent - credentials are recorded as a redacted
/// preview and never resent from here.
model WhatsAppActivity {
  id                      String                    @id @default(cuid())
  logicalKey              String                    @unique @map("logical_key") @db.VarChar(191)
  /// MANUAL or AUTOMATIC.
  mode                    String                    @db.VarChar(12)
  /// baileys, meta or mock.
  provider                String                    @db.VarChar(20)
  sourceModule            String                    @map("source_module") @db.VarChar(40)
  trigger                 String                    @db.VarChar(80)
  /// The business event this message answers for: "production:<id>:STARTED_FROM_STUDIO",
  /// "attendance-report:2026-10-17", "onboarding-invite:<id>" ... A reference, not a link.
  eventRef                String?                   @map("event_ref") @db.VarChar(191)
  initiatedByUserId       Int?                      @map("initiated_by_user_id")
  senderUserId            Int?                      @map("sender_user_id")
  salesProjectId          String?                   @map("sales_project_id")
  crmLeadId               String?                   @map("crm_lead_id") @db.VarChar(100)
  employeeId              Int?                      @map("employee_id")
  imageSelectionProjectId String?                   @map("image_selection_project_id")
  /// The vendor a shoot notice went to, so the log can be filtered and resent by vendor rather than
  /// holding only a masked number.
  vendorId                Int?                      @map("vendor_id")
  /// The production shoot whose step message this is, and the Image Selection notification row
  /// (Meta template or group invite) this is the log of - so a Resend here can mark that module's
  /// own row, by its key, rather than reading an id back out of `eventRef`.
  productionId            String?                   @map("production_id")
  imageSelectionNotificationId String?              @map("image_selection_notification_id")
  /// PERSON, GROUP, LEAD or VENDOR.
  recipientKind           String                    @map("recipient_kind") @db.VarChar(10)
  recipientMasked         String                    @map("recipient_masked") @db.VarChar(191)
  /// A snapshot of the name as it read when the message went (or the group's subject) - an audit
  /// row, deliberately not a copy in `nameCopies.js`: the linked lead, employee or project carries
  /// the live name.
  recipientName           String?                   @map("recipient_name") @db.VarChar(191)
  /// Null when nothing could be addressed (no group linked, no sender) - such a row is never resendable.
  recipientAddress        String?                   @map("recipient_address") @db.VarChar(191)
  templateKey             String?                   @map("template_key") @db.VarChar(60)
  bodyPreview             String?                   @map("body_preview") @db.VarChar(500)
  body                    String?                   @db.Text
  resendable              Boolean                   @default(false)
  /// QUEUED, PROCESSING, SENT, DELIVERED, READ or FAILED.
  status                  String                    @default("QUEUED") @db.VarChar(12)
  failureCode             String?                   @map("failure_code") @db.VarChar(60)
  failureReason           String?                   @map("failure_reason") @db.VarChar(255)
  attemptCount            Int                       @default(0) @map("attempt_count")
  providerMessageId       String?                   @map("provider_message_id") @db.VarChar(191)
  createdAt               DateTime                  @default(now()) @map("created_at")
  attemptedAt             DateTime?                 @map("attempted_at")
  sentAt                  DateTime?                 @map("sent_at")
  deliveredAt             DateTime?                 @map("delivered_at")
  readAt                  DateTime?                 @map("read_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  initiatedByUser       User?                     @relation("WhatsAppActivityInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  senderUser            User?                     @relation("WhatsAppActivitySender", fields: [senderUserId], references: [id], onDelete: SetNull)
  salesProject          SalesProject?             @relation(fields: [salesProjectId], references: [id], onDelete: SetNull)
  crmLead               SalesCrmLead?             @relation(fields: [crmLeadId], references: [enquiryId], onDelete: SetNull)
  employee              Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  imageSelectionProject ImageSelectionProject?    @relation(fields: [imageSelectionProjectId], references: [id], onDelete: SetNull)
  vendor                Vendor?                   @relation("WhatsAppActivityVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  template              MessageTemplate?          @relation(fields: [templateKey], references: [key], onDelete: SetNull)
  production            ProjectProduction?        @relation(fields: [productionId], references: [id], onDelete: SetNull)
  imageSelectionNotification ImageSelectionWhatsAppNotification? @relation(fields: [imageSelectionNotificationId], references: [id], onDelete: SetNull)
  attempts              WhatsAppActivityAttempt[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([mode, createdAt])
  @@index([sourceModule, createdAt])
  @@index([trigger, createdAt])
  @@index([providerMessageId])
  @@index([initiatedByUserId])
  @@index([senderUserId])
  @@index([salesProjectId])
  @@index([crmLeadId])
  @@index([employeeId])
  @@index([imageSelectionProjectId])
  @@index([vendorId])
  @@index([templateKey])
  @@index([productionId])
  @@index([imageSelectionNotificationId])
  @@map("whatsapp_activity")
}

/// One try at sending a `WhatsAppActivity`: the first attempt, a scheduler's or queue's retry, or a
/// Resend from the activity log. The original failure is never overwritten - a resend is a new row.
/// `errorMessage` is the raw error and leaves the database only when `errorSafe` is true (the
/// message was one this app wrote, not whatever the WhatsApp library threw).
model WhatsAppActivityAttempt {
  id                String           @id @default(cuid())
  activityId        String           @map("activity_id")
  attemptNo         Int              @map("attempt_no")
  /// INITIAL, RETRY or RESEND.
  kind              String           @db.VarChar(10)
  requestedByUserId Int?             @map("requested_by_user_id")
  senderUserId      Int?             @map("sender_user_id")
  /// PROCESSING, SENT or FAILED.
  status            String           @default("PROCESSING") @db.VarChar(12)
  providerMessageId String?          @map("provider_message_id") @db.VarChar(191)
  errorCode         String?          @map("error_code") @db.VarChar(60)
  errorMessage      String?          @map("error_message") @db.Text
  errorSafe         Boolean          @default(false) @map("error_safe")
  /// The send threw after the message may already have left - a retry could send it twice.
  ambiguous         Boolean          @default(false)
  startedAt         DateTime         @default(now()) @map("started_at")
  finishedAt        DateTime?        @map("finished_at")

  activity        WhatsAppActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  requestedByUser User?            @relation("WhatsAppActivityAttemptRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  senderUser      User?            @relation("WhatsAppActivityAttemptSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([activityId, attemptNo])
  @@index([requestedByUserId])
  @@index([senderUserId])
  @@index([providerMessageId])
  @@map("whatsapp_activity_attempt")
}

/// A Meta delivery report not applied when it arrived: the webhook beat the send to storing Meta's
/// message id, or a handler failed on it. Kept only from a signed webhook, applied once the id is
/// stored (or by the sweep), and deleted 7 days after it arrived either way -
/// services/whatsappPendingStatus.js.
/// `providerMessageId` is Meta's id, not a link to a row here: it may name a WhatsApp Activity,
/// AI Feature or Photo Selling message, or none of them.
model WhatsAppPendingStatus {
  id                String    @id @default(cuid())
  providerMessageId String    @map("provider_message_id") @db.VarChar(191)
  /// sent, delivered, read or failed, as Meta wrote it.
  status            String    @db.VarChar(20)
  errorCode         String?   @map("error_code") @db.VarChar(40)
  errorMessage      String?   @map("error_message") @db.VarChar(255)
  /// Meta's own timestamp for the status: reports are applied in this order.
  occurredAt        DateTime  @map("occurred_at")
  /// sha256 of id, status, error code and timestamp: a webhook Meta sends twice is kept once.
  eventKey          String    @unique @map("event_key") @db.Char(64)
  processedAt       DateTime? @map("processed_at")
  /// When the sweep last looked for its message: the least recently looked at go first.
  checkedAt         DateTime? @map("checked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([providerMessageId, processedAt])
  @@index([processedAt, checkedAt])
  @@index([createdAt])
  @@map("whatsapp_pending_status")
}

/// An offer the studio shows its clients on the Home page of their app - Sales -> Client Offers.
/// Shown while active, not withdrawn, and today falls between its dates (either may be open). A
/// picture (1200 x 675) is shown whole; without one the card is drawn from the words, dark or light.
model ClientOffer {
  id         Int       @id @default(autoincrement())
  tag        String?   @db.VarChar(40)
  title      String    @db.VarChar(120)
  note       String?   @db.VarChar(300)
  imageUrl   String?   @map("image_url") @db.Text
  imageKey   String?   @map("image_key") @db.VarChar(255)
  /// The poster's size as stored: square, portrait or story (see client-offers/service.js).
  imageWidth  Int?     @map("image_width")
  imageHeight Int?     @map("image_height")
  /// Where the clients' app shows it: "home" (the Home page) or "referral" (the Referrals page).
  placement  String    @default("home") @db.VarChar(20)
  tone       String    @default("dark") @db.VarChar(10)
  validFrom  DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  createdBy  Int?      @map("created_by")
  updatedBy  Int?      @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([isActive, deletedAt, sortOrder], map: "client_offer_live_idx")
  @@index([placement, isActive, deletedAt], map: "client_offer_placement_idx")
  @@map("client_offer")
}

/// A client's request about what their booking includes, raised from their app (Bookings -> Services /
/// Deliverables): to add something from the studio's list, to change something they have, or a
/// question. The team answers it on Client Management -> Client Requests; one accepted at a price
/// becomes an extra quotation on the booking (`extraQuotationId`).
model ClientServiceRequest {
  id                Int       @id @default(autoincrement())
  projectId         String    @map("project_id")
  shootId           String?   @map("shoot_id")
  clientUserId      Int?      @map("client_user_id")
  /// "add", "change" or "question".
  kind              String    @db.VarChar(10)
  /// "service", "deliverable" or "other".
  itemType          String    @map("item_type") @db.VarChar(15)
  /// The studio's list entry (ProjectServiceDefinition / ProjectDeliverableDefinition), or the booked
  /// item a change or question is about.
  catalogId         String?   @map("catalog_id") @db.VarChar(64)
  itemRefId         String?   @map("item_ref_id") @db.VarChar(64)
  itemName          String    @map("item_name") @db.VarChar(191)
  quantity          Int       @default(1)
  note              String?   @db.Text
  /// "pending", "accepted", "declined" or "answered".
  status            String    @default("pending") @db.VarChar(12)
  price             Decimal?  @db.Decimal(12, 2)
  reply             String?   @db.Text
  extraQuotationId  String?   @map("extra_quotation_id") @db.VarChar(64)
  decidedBy         Int?      @map("decided_by")
  decidedAt         DateTime? @map("decided_at")
  /// When the client last looked at it after the studio answered: until then it waits in their Action Needed.
  clientSeenAt      DateTime? @map("client_seen_at")
  /// The studio's quotation this request was priced in (sent to the client as one), and whether it is given free.
  quoteCode         String?   @map("quote_code") @db.VarChar(40)
  complimentary     Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  project           SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt], map: "client_service_request_project_idx")
  @@index([status, createdAt], map: "client_service_request_status_idx")
  @@index([quoteCode], map: "client_service_request_quote_idx")
  @@map("client_service_request")
}

/// Client Management -> Client Requests -> Raised Requests: the studio asking, for a booked project, a
/// new shoot (with its services and deliverables), services or deliverables for one of its shoots, or a
/// correction. Raised without prices behind `CLIENT / Client Requests`; priced and decided item by item
/// behind `CLIENT / Request Approval`; and only then written into the project - the approved items
/// alone, in the decision's own transaction. The request and its items are never edited by the person
/// who raised it, and `ProjectChangeRequestEvent` keeps every step.
model ProjectChangeRequest {
  id                 Int       @id @default(autoincrement())
  /// CRQ-000001, from the counter every generated identifier comes from.
  requestCode        String    @unique @map("request_code") @db.VarChar(30)
  projectId          String    @map("project_id")
  /// SHOOT, SERVICE, DELIVERABLE or OTHER.
  requestType        String    @map("request_type") @db.VarChar(15)
  /// The project's own shoot a SERVICE or DELIVERABLE request is for, or an OTHER request names.
  shootId            String?   @map("shoot_id")
  /// A SHOOT request's shoot as it was asked for - the Add Shoot dialog's fields (`projectShootSchema`).
  shootDetails       Json?     @map("shoot_details")
  /// An OTHER request's kind of correction: Album, Photo, Video, Client information, Project detail or Other.
  correctionCategory String?   @map("correction_category") @db.VarChar(60)
  /// The requester's remarks - for a correction, what is to be corrected.
  remarks            String?   @db.Text
  /// Reference files, as `uploadMetadata.attachFiles` stores them.
  attachments        Json?
  /// WAITING, IN_PROGRESS, ACCEPTED, PARTIALLY_ACCEPTED or DECLINED.
  status             String    @default("WAITING") @db.VarChar(20)
  /// Raised by every write, so a reviewer saving over somebody else's newer decisions is refused.
  version            Int       @default(0)
  requestedById      Int       @map("requested_by_id")
  requestedAt        DateTime  @default(now()) @map("requested_at")
  /// Who last reviewed it, and when the final decision was submitted.
  reviewedById       Int?      @map("reviewed_by_id")
  decidedAt          DateTime? @map("decided_at")
  decisionRemarks    String?   @map("decision_remarks") @db.Text
  /// What the final decision wrote: the new shoot, the extra quotation carrying the approved amounts,
  /// the correction's task.
  createdShootId     String?   @unique @map("created_shoot_id")
  extraQuotationId   String?   @unique @map("extra_quotation_id")
  taskId             Int?      @unique @map("task_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project        SalesProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot          ProjectShoot?               @relation("ProjectChangeRequestShoot", fields: [shootId], references: [id], onDelete: SetNull)
  createdShoot   ProjectShoot?               @relation("ProjectChangeRequestCreatedShoot", fields: [createdShootId], references: [id], onDelete: SetNull)
  extraQuotation ProjectExtraQuotation?      @relation(fields: [extraQuotationId], references: [id], onDelete: SetNull)
  task           HrmTask?                    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  requestedBy    User                        @relation("ProjectChangeRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                       @relation("ProjectChangeRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items          ProjectChangeRequestItem[]
  events         ProjectChangeRequestEvent[]

  @@index([projectId, createdAt], map: "project_change_request_project_idx")
  @@index([status, createdAt], map: "project_change_request_status_idx")
  @@index([shootId], map: "project_change_request_shoot_idx")
  @@index([requestedById], map: "project_change_request_requested_by_idx")
  @@index([reviewedById], map: "project_change_request_reviewed_by_idx")
  @@map("project_change_request")
}

/// One thing a change request asks for - the shoot itself, a service, a deliverable, or the correction -
/// and the reviewer's decision on it: approved (at an amount, ₹0 for complimentary, and a quantity) or
/// rejected with a reason. `appliedRecordId` is the project row the approval wrote.
model ProjectChangeRequestItem {
  id                      Int       @id @default(autoincrement())
  requestId               Int       @map("request_id")
  /// SHOOT, SERVICE, DELIVERABLE or CORRECTION.
  itemType                String    @map("item_type") @db.VarChar(15)
  serviceDefinitionId     String?   @map("service_definition_id")
  deliverableDefinitionId String?   @map("deliverable_definition_id")
  /// The item's name when it was asked for, so the request reads as it was raised after a rename in Settings.
  itemName                String    @map("item_name") @db.VarChar(191)
  quantity                Int       @default(1)
  /// The line as it was asked for (`projectShootServiceInputSchema` / `projectShootDeliverableInputSchema`).
  config                  Json?
  sortOrder               Int       @default(0) @map("sort_order")
  /// APPROVED or REJECTED; null until reviewed.
  decision                String?   @db.VarChar(10)
  approvedAmount          Decimal?  @map("approved_amount") @db.Decimal(12, 2)
  approvedQuantity        Int?      @map("approved_quantity")
  managerRemarks          String?   @map("manager_remarks") @db.Text
  rejectionReason         String?   @map("rejection_reason") @db.Text
  decidedById             Int?      @map("decided_by_id")
  decidedAt               DateTime? @map("decided_at")
  /// The project row the approval wrote: a service allocation, a shoot deliverable, the shoot, or the
  /// correction's task.
  appliedRecordId         String?   @map("applied_record_id") @db.VarChar(191)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  request               ProjectChangeRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceDefinition     ProjectServiceDefinition?     @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  deliverableDefinition ProjectDeliverableDefinition? @relation(fields: [deliverableDefinitionId], references: [id], onDelete: SetNull)
  decidedBy             User?                         @relation("ProjectChangeRequestItemDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  events                ProjectChangeRequestEvent[]

  @@index([requestId, sortOrder], map: "project_change_request_item_request_idx")
  @@index([serviceDefinitionId], map: "project_change_request_item_service_idx")
  @@index([deliverableDefinitionId], map: "project_change_request_item_deliverable_idx")
  @@index([decidedById], map: "project_change_request_item_decided_by_idx")
  @@map("project_change_request_item")
}

/// A change request's history, one line per step: raised, reviewed, an item's decision or amount
/// changed (with what it was before), more information asked for and given, decided, and what the
/// decision created. Written once and never changed.
model ProjectChangeRequestEvent {
  id          Int      @id @default(autoincrement())
  requestId   Int      @map("request_id")
  itemId      Int?     @map("item_id")
  /// RAISED, REVIEWED, ITEM_DECIDED, INFO_REQUESTED, INFO_GIVEN, DECIDED or APPLIED.
  action      String   @db.VarChar(30)
  detail      String?  @db.Text
  /// The values before and after, for a decision or amount that changed.
  changes     Json?
  actorUserId Int?     @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  request ProjectChangeRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    ProjectChangeRequestItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  actor   User?                     @relation("ProjectChangeRequestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt], map: "project_change_request_event_request_idx")
  @@index([itemId], map: "project_change_request_event_item_idx")
  @@index([actorUserId], map: "project_change_request_event_actor_idx")
  @@map("project_change_request_event")
}

/// An invitation design the studio offers its clients in their app - Client Management -> Invitation
/// Cards. `shootTypes` is the shoot names it is for (Settings -> Fields -> Shoot Types); `style` is
/// the animated theme it plays in (see client/invitations/styles.js); `coverUrl` the studio's artwork.
model InvitationTemplate {
  id          Int                @id @default(autoincrement())
  title       String             @db.VarChar(120)
  shootTypes  Json               @map("shoot_types")
  style       String             @default("royal") @db.VarChar(30)
  accent      String?            @db.VarChar(9)
  /// The names' typeface (script, serif, playful, modern) and the colour the words are set in.
  font        String             @default("script") @db.VarChar(20)
  ink         String?            @db.VarChar(9)
  coverUrl    String?            @map("cover_url") @db.Text
  coverKey    String?            @map("cover_key") @db.VarChar(255)
  /// "image" (a still or animated picture) or "video" (an animation the design team exported as a
  /// video, played silent on a loop); a video's first frame is kept as its poster for where it cannot play.
  coverType   String             @default("image") @map("cover_type") @db.VarChar(10)
  posterUrl   String?            @map("poster_url") @db.Text
  posterKey   String?            @map("poster_key") @db.VarChar(255)
  /// Optional see-through artwork that moves over the background: a piece along the top (clouds,
  /// a garland) and one along the bottom (palms, an elephant), each coming in on its own.
  topUrl      String?            @map("top_url") @db.Text
  topKey      String?            @map("top_key") @db.VarChar(255)
  bottomUrl   String?            @map("bottom_url") @db.Text
  bottomKey   String?            @map("bottom_key") @db.VarChar(255)
  /// What a client pays (in rupees) to share an invitation made from it, and to edit it past the free
  /// edits; 0 is not set yet (the studio tells the client).
  price       Int                @default(0)
  /// Free to clients on purpose (no payment, no edit limit). Not free is the default: a design with no
  /// price yet still asks for payment, at the price the studio then tells the client.
  isFree      Boolean            @default(false) @map("is_free")
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdBy   Int?               @map("created_by")
  updatedBy   Int?               @map("updated_by")
  deletedAt   DateTime?          @map("deleted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  invitations ClientInvitation[]

  @@index([isActive, deletedAt, sortOrder], map: "invitation_template_live_idx")
  @@map("invitation_template")
}

/// A song a client may set on their invitation - Client Management -> Invitation Cards -> Songs. The
/// invitation plays ten seconds of it, from the second the client picks, on a loop.
model InvitationSong {
  id          Int                @id @default(autoincrement())
  title       String             @db.VarChar(120)
  artist      String?            @db.VarChar(120)
  audioUrl    String             @map("audio_url") @db.Text
  audioKey    String?            @map("audio_key") @db.VarChar(255)
  shootTypes  Json               @map("shoot_types")
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdBy   Int?               @map("created_by")
  updatedBy   Int?               @map("updated_by")
  deletedAt   DateTime?          @map("deleted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  invitations ClientInvitation[]

  @@index([isActive, deletedAt, sortOrder], map: "invitation_song_live_idx")
  @@map("invitation_song")
}

/// A client's own invitation, made from a design for one of their shoots and opened by guests at
/// `/i/<token>`. `content` is what the client wrote (names, line, date, venue, events); `songStart` the
/// second its ten seconds of song begin at.
model ClientInvitation {
  id         Int                @id @default(autoincrement())
  token      String             @unique @db.VarChar(24)
  projectId  String             @map("project_id")
  templateId Int                @map("template_id")
  songId     Int?               @map("song_id")
  songStart  Int                @default(0) @map("song_start")
  shootName  String             @map("shoot_name") @db.VarChar(191)
  content    Json
  photoUrl   String?            @map("photo_url") @db.Text
  photoKey   String?            @map("photo_key") @db.VarChar(255)
  /// The client's saves so far: a priced design gives a few free, then asks for payment.
  editCount  Int                @default(0) @map("edit_count")
  /// Set by the studio for this one client (Payments -> Edit): their price, and how many free edits they
  /// get. Empty uses the design's price and the usual free edits.
  price      Int?
  editLimit  Int?               @map("edit_limit")
  /// When the client asked the studio to unlock it (sharing and unlimited edits), and when the studio
  /// recorded it paid - by whom, and for how much (the design's price that day).
  unlockRequestedAt DateTime?   @map("unlock_requested_at")
  paidAt     DateTime?          @map("paid_at")
  paidBy     Int?               @map("paid_by")
  paidAmount Int?               @map("paid_amount")
  createdBy  Int?               @map("created_by")
  deletedAt  DateTime?          @map("deleted_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  project    SalesProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template   InvitationTemplate @relation(fields: [templateId], references: [id])
  song       InvitationSong?    @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([projectId, deletedAt], map: "client_invitation_project_idx")
  @@index([templateId], map: "client_invitation_template_idx")
  @@index([songId], map: "client_invitation_song_idx")
  @@map("client_invitation")
}

/// A client's conversation with the studio from their app, one per topic they open - Sales -> Client
/// Chats. `clientReadAt` / `staffReadAt`: when each side last read it, for the unread marks.
model ClientChatThread {
  id            Int                 @id @default(autoincrement())
  projectId     String              @map("project_id") @db.VarChar(191)
  clientUserId  Int?                @map("client_user_id")
  topic         String              @db.VarChar(30)
  status        String              @default("open") @db.VarChar(10)
  lastMessageAt DateTime            @default(now()) @map("last_message_at")
  clientReadAt  DateTime?           @map("client_read_at")
  staffReadAt   DateTime?           @map("staff_read_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  messages      ClientChatMessage[]
  project       SalesProject        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "client_chat_thread_project_fk")

  @@index([projectId, lastMessageAt], map: "client_chat_thread_project_idx")
  @@index([lastMessageAt], map: "client_chat_thread_last_idx")
  @@map("client_chat_thread")
}

/// One message in a client chat: the client's (`fromClient`), or a team member's (`authorName`).
model ClientChatMessage {
  id           Int              @id @default(autoincrement())
  threadId     Int              @map("thread_id")
  fromClient   Boolean          @map("from_client")
  authorUserId Int?             @map("author_user_id")
  authorName   String?          @map("author_name") @db.VarChar(191)
  body         String           @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  thread       ClientChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt], map: "client_chat_message_thread_idx")
  @@map("client_chat_message")
}

/// The client app's settings, one row (id 1): the WhatsApp number offers are asked about on, the
/// coins a booked referral earns. Sales -> Client Offers.
model ClientAppSetting {
  id              Int      @id
  offersWhatsapp  String?  @map("offers_whatsapp") @db.VarChar(20)
  coinsPerBooking Int      @default(20) @map("coins_per_booking")
  updatedBy       Int?     @map("updated_by")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("client_app_setting")
}

/// Coins a client earned: one row per referral of theirs that became a booking, never paid twice.
model ClientCoinEntry {
  id                Int          @id @default(autoincrement())
  projectId         String       @map("project_id") @db.VarChar(191)
  referralEnquiryId String       @unique(map: "client_coin_entry_referral_key") @map("referral_enquiry_id") @db.VarChar(191)
  referralName      String?      @map("referral_name") @db.VarChar(120)
  coins             Int
  createdAt         DateTime     @default(now()) @map("created_at")
  project           SalesProject @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "client_coin_entry_project_fk")

  @@index([projectId], map: "client_coin_entry_project_idx")
  @@map("client_coin_entry")
}

/// Settings → Project Management → Shoot crew notice: the studio's one row (`id = "default"`). A
/// table of its own rather than a Project Management settings row, as Payment reminder's is.
model ShootCrewNoticeSettings {
  id                   String    @id @default("default") @db.VarChar(30)
  /// Off until the studio switches it on: nothing is sent before somebody says so.
  enabled              Boolean   @default(false)
  /// The **vendor** arm, switched on separately so vendors can go live without touching what already
  /// works for employees. Each arm keeps its own claim and its own last trouble, so one arm's sweep
  /// never overwrites the other's reason for waiting.
  vendorEnabled        Boolean   @default(false) @map("vendor_enabled")
  /// Who sends it is no longer a setting: the employee arm sends from each project's Pre-Production
  /// Coordinator and the vendor arm from its Production Manager (`projectSender.js`).
  lastAttemptAt        DateTime? @map("last_attempt_at")
  lastError            String?   @map("last_error") @db.Text
  vendorLastAttemptAt  DateTime? @map("vendor_last_attempt_at")
  vendorLastError      String?   @map("vendor_last_error") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("shoot_crew_notice_settings")
}

/// How an automatic WhatsApp message picks the number it goes from: `SAME` ("Sender") - the one
/// `senderUserId` first every time, then its fallback order; `ROTATE` ("Rotation") - each message
/// from the next in the rotation order after the one that sent the last.
enum WhatsAppSenderMode {
  SAME
  ROTATE
}

/// Which of a message's two dragged orders a `WhatsAppSenderPolicyMember` place belongs to.
enum WhatsAppSenderOrder {
  FALLBACK
  ROTATION
}

/// Who an automatic WhatsApp message goes from, one row a message (`messageKey`, the keys in
/// `automatic-whatsapp/senderPolicy.js`). `SAME` sends from `senderUserId`, and where they cannot,
/// from everybody else with Allow WhatsApp ticked in the `FALLBACK` order. `ROTATE` takes turns
/// through everybody with Allow WhatsApp ticked in the `ROTATION` order. Each order is
/// `WhatsAppSenderPolicyMember` rows, anyone not in it yet after them by name. Each mode keeps its
/// own setting, so switching between them loses neither. `lastSenderUserId` is who sent the last
/// one, where `ROTATE` takes the next turn from.
model WhatsAppSenderPolicy {
  messageKey       String             @id @map("message_key") @db.VarChar(40)
  mode             WhatsAppSenderMode @default(SAME)
  senderUserId     Int?               @map("sender_user_id")
  lastSenderUserId Int?               @map("last_sender_user_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  sender     User?                        @relation("WhatsAppSenderPolicySender", fields: [senderUserId], references: [id], onDelete: SetNull)
  lastSender User?                        @relation("WhatsAppSenderPolicyLastSender", fields: [lastSenderUserId], references: [id], onDelete: SetNull)
  members    WhatsAppSenderPolicyMember[]

  @@index([senderUserId])
  @@index([lastSenderUserId])
  @@map("whatsapp_sender_policy")
}

/// One place in one of a message's dragged orders (`list`): `position` 1 is tried, or takes its
/// turn, first. A login deleted leaves the order with it.
model WhatsAppSenderPolicyMember {
  id         Int                 @id @default(autoincrement())
  messageKey String              @map("message_key") @db.VarChar(40)
  list       WhatsAppSenderOrder @default(ROTATION)
  userId     Int                 @map("user_id")
  position   Int

  policy WhatsAppSenderPolicy @relation(fields: [messageKey], references: [messageKey], onDelete: Cascade)
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageKey, list, userId])
  @@index([userId])
  @@map("whatsapp_sender_policy_member")
}

/// What one person was last told about one shoot, so a later sweep messages only what changed.
///
/// One row per person per shoot, written as the message goes. `digest` is what the message said -
/// their services, the day, the times and the places - so an edit somewhere else in the plan tells
/// nobody again, and a changed seat tells only the person whose seat it is. A row whose person has
/// left the crew is what makes the "you are off this shoot" message possible; it is deleted once
/// that has been sent.
model ProjectShootCrewNotice {
  id                  String   @id @default(cuid())
  productionId        String   @map("production_id")
  employeeId          Int      @map("employee_id")
  /// The service they were told they are on, where it was one; null once it is retired, and on
  /// somebody who holds several (the digest carries them all).
  serviceDefinitionId String?  @map("service_definition_id")
  digest              String   @db.VarChar(64)
  sentAt              DateTime @default(now()) @map("sent_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  production        ProjectProduction         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  employee          Employee                  @relation("ProjectShootCrewNoticeEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  serviceDefinition ProjectServiceDefinition? @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)

  @@unique([productionId, employeeId])
  @@index([employeeId])
  @@index([serviceDefinitionId])
  @@map("project_shoot_crew_notice")
}

/// What a **vendor** confirmed on a shoot was last told about it - the vendor arm of Settings →
/// Project Management → Shoot crew notice, and the sibling of `ProjectShootCrewNotice`.
///
/// One row per vendor per shoot, whatever they hold on it: a vendor on two services of one shoot is
/// told once, as an employee on two is.
///
/// **Three digests, not one.** The employee arm keeps a single digest and re-tells somebody when it
/// differs; that cannot say *what* differed, and the vendor arm has a wording per kind of change. So
/// the day and times, the places, and the services are hashed apart: comparing each names the change
/// and therefore the message. Where two differ at once the more disruptive one is sent, alone.
///
/// **The `last*` columns are a snapshot of what was said**, not name copies: they are what makes a
/// "do not travel" message possible once the plan that would have composed it is withdrawn, the
/// shoot deleted or the seat gone. Deliberately **not** in `nameCopies.js` - a rename must not
/// rewrite them, because they record what the vendor was actually told.
model ProjectShootVendorNotice {
  id                  String    @id @default(cuid())
  productionId        String    @map("production_id")
  vendorId            Int       @map("vendor_id")
  /// The service they were told they are on, where it was one; null on a vendor holding several (the
  /// service digest carries them all) and once the service is retired.
  serviceDefinitionId String?   @map("service_definition_id")
  /// The shoot's day and times, its places, and their services - hashed apart. See the note above.
  shootDigest         String    @map("shoot_digest") @db.VarChar(64)
  placeDigest         String    @map("place_digest") @db.VarChar(64)
  serviceDigest       String    @map("service_digest") @db.VarChar(64)
  /// When the confirm message went, and when the two-days-before reminder did. Both, in that order:
  /// a vendor told on confirming is still owed the reminder. Null on a row seeded at switch-on,
  /// which is "already told" without any message having gone.
  confirmedSentAt     DateTime? @map("confirmed_sent_at")
  reminderSentAt      DateTime? @map("reminder_sent_at")
  /// The vendor has no usable WhatsApp or mobile number: marked once, not retried, and shown in
  /// Settings until somebody saves a number - then cleared, and the message goes.
  needsNumber         Boolean   @default(false) @map("needs_number")
  /// The snapshot: what this vendor was last told, for a removal message composed after the plan has
  /// gone. `lastDate` is the shoot's day; `lastTime` its words for when it runs.
  lastShoot           String?   @map("last_shoot") @db.VarChar(191)
  lastShootCode       String?   @map("last_shoot_code") @db.VarChar(60)
  lastProject         String?   @map("last_project") @db.VarChar(191)
  lastDate            DateTime? @map("last_date") @db.Date
  lastTime            String?   @map("last_time") @db.VarChar(80)
  lastPlace           String?   @map("last_place") @db.VarChar(500)
  lastDistrict        String?   @map("last_district") @db.VarChar(300)
  lastService         String?   @map("last_service") @db.VarChar(500)
  sentAt              DateTime  @default(now()) @map("sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  production        ProjectProduction         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  vendor            Vendor                    @relation("ProjectShootVendorNoticeVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  serviceDefinition ProjectServiceDefinition? @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)

  @@unique([productionId, vendorId])
  @@index([vendorId])
  @@index([serviceDefinitionId])
  @@index([needsNumber])
  @@map("project_shoot_vendor_notice")
}

/// A link sent to a company that wants one of Beam Craft's products (SUBSCRIBE in the sidebar): the
/// client counterpart of `EmployeeOnboardingInvite`. Expired is read from `expiresAt`, not stored.
model ClientOnboardingInvite {
  id           String    @id @default(cuid())
  /// `MEDIA_STUDIO_OPERATIONS` or `ACCOUNT_MANAGER` - null on invites made without one.
  product      String?   @db.VarChar(40)
  contactName  String?   @map("contact_name") @db.VarChar(150)
  contactEmail String?   @map("contact_email") @db.VarChar(191)
  contactPhone String?   @map("contact_phone") @db.VarChar(30)
  /// The contact person's role at the company, asked on Create Onboarding Invite.
  contactDesignation String? @map("contact_designation") @db.VarChar(150)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  token        String?   @db.VarChar(64)
  shortCode    String?   @unique @map("short_code") @db.VarChar(8)
  /// Created, Verified, Submitted or Cancelled.
  status       String    @default("Created") @db.VarChar(20)
  expiresAt    DateTime  @map("expires_at")
  verifiedAt   DateTime? @map("verified_at")
  submittedAt  DateTime? @map("submitted_at")
  cancelledAt  DateTime? @map("cancelled_at")
  clientId     String?   @map("client_id")
  /// Whatever company details the team filled in on the invite (images already stored); the client's
  /// form opens with them, completes the rest and submits.
  company      Json?
  createdBy    String?   @map("created_by") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client SubscriptionClient?

  @@index([product, status])
  @@index([createdAt])
  @@map("client_onboarding_invite")
}

/// A company onboarded for one product, written once when its onboarding form is submitted.
model SubscriptionClient {
  id                          String   @id @default(cuid())
  product                     String?  @db.VarChar(40)
  companyName                 String   @map("company_name") @db.VarChar(150)
  address                     String   @db.VarChar(500)
  gstNumber                   String   @map("gst_number") @db.VarChar(15)
  panNumber                   String   @map("pan_number") @db.VarChar(10)
  logoUrl                     String   @map("logo_url") @db.VarChar(500)
  faviconUrl                  String   @map("favicon_url") @db.VarChar(500)
  usersNeeded                 Int      @map("users_needed")
  mainContactName             String   @map("main_contact_name") @db.VarChar(150)
  mainContactPhone            String   @map("main_contact_phone") @db.VarChar(30)
  mainContactDesignation      String   @map("main_contact_designation") @db.VarChar(150)
  secondaryContactName        String   @map("secondary_contact_name") @db.VarChar(150)
  secondaryContactPhone       String   @map("secondary_contact_phone") @db.VarChar(30)
  secondaryContactDesignation String   @map("secondary_contact_designation") @db.VarChar(150)
  contactEmail                String?  @map("contact_email") @db.VarChar(191)
  /// The account Beam Craft set up for it (Client Details -> Set up account). Null until then.
  subdomain                   String?   @unique @db.VarChar(40)
  usersAllowed                Int?      @map("users_allowed")
  adminUsername               String?   @map("admin_username") @db.VarChar(60)
  /// bcrypt; the password itself is shown once and never stored.
  adminPasswordHash           String?   @map("admin_password_hash") @db.VarChar(100)
  /// When Beam Craft last made the Admin's password (setup, Reset password); the client's site takes a newer one.
  adminPasswordSetAt          DateTime? @map("admin_password_set_at")
  /// SHA-256 of the key the client's server reads its subscription with; the key itself is shown once.
  siteKeyHash                 String?   @map("site_key_hash") @db.Char(64)
  validFrom                  DateTime? @map("valid_from") @db.Date
  validUntil                  DateTime? @map("valid_until") @db.Date
  /// Module keys from `MODULES_BY_PRODUCT` for its product.
  modules                     Json?
  activatedAt                 DateTime? @map("activated_at")
  /// The version live on the client's site: 1 at setup, +1 each time Update site publishes a change.
  liveVersion                 Int       @default(0) @map("live_version")
  /// A change saved in Edit subscription and not yet published with Update site; null when none.
  pendingChanges              Json?     @map("pending_changes")
  publishedAt                 DateTime? @map("published_at")
  inviteId                    String   @unique @map("invite_id")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  invite ClientOnboardingInvite @relation(fields: [inviteId], references: [id])
  versions SubscriptionVersion[]
  healthChecks SiteHealthCheck[]

  @@index([product])
  @@map("subscription_client")
}

/// Each version of a client's subscription as it went live - what Update site published, and when.
model SubscriptionVersion {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  version     Int
  snapshot    Json
  publishedAt DateTime @default(now()) @map("published_at")
  publishedBy String?  @map("published_by") @db.VarChar(50)

  client SubscriptionClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, version])
  @@map("subscription_version")
}

/// One look at a live client's site: did `/api/health` answer, how fast, and with which version. Kept a week.
model SiteHealthCheck {
  id         String   @id @default(cuid())
  clientId   String   @map("client_id")
  checkedAt  DateTime @default(now()) @map("checked_at")
  ok         Boolean
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  version    String?  @db.VarChar(40)
  error      String?  @db.VarChar(300)

  client SubscriptionClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, checkedAt])
  @@index([checkedAt])
  @@map("site_health_check")
}

/// The roles a client's contact person can hold (Owner, Managing Director, ...), offered by Client Details ->
/// Create Onboarding Invite and kept by the team in Settings -> Field Settings, as Designations are for staff.
model ClientDesignation {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("client_designation")
}
