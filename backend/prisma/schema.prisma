generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectServiceQuantityMode {
  NONE
  INTEGER
}

enum ProjectServiceTimingMode {
  NONE
  HALF_SESSION
  FULL_SESSION
  HOURS_MINUTES
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  /// Null for a client login (Create Project → Client Credentials), which signs in by username alone.
  email    String? @unique
  username String? @unique @db.VarChar(50)
  /// The number a password-reset code is sent to, for a login with no employee record behind it.
  ///
  /// Recovery is by OTP, and the number normally comes from the employee's own `contact_number` -
  /// the one given during onboarding. An account with no employee has none, and the studio's Super
  /// Admin is exactly that: without somewhere to put a number it would be permanently unable to
  /// reset its own password. Set on the login instead, from Admin -> User Management.
  ///
  /// The employee's number wins where there is one, so this is not a second copy to keep in step.
  mobile   String? @db.VarChar(30)
  password String

  // BRANCH ASSIGNMENT (for IAM system)
  branchId        Int?                 @map("branch_id")
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  aiConversations AiConversation[]
  aiActionPlans   AiActionPlan[]
  /// The days this person's attendance has been written down for. Derived from their measured
  /// sessions where there is no row; see `EmployeeAttendance`.
  attendance      EmployeeAttendance[] @relation("EmployeeAttendanceUser")

  // Legacy role support (deprecated after 3 months)
  role String @default("SUPER_ADMIN")

  status             String    @default("ACTIVE")
  linkedEmployeeId   Int?      @unique @map("linked_employee_id")
  /// A client's sign-in (`role` "CLIENT"): the project it was created for, from Create Project →
  /// Client Credentials. One login per project. Null for every studio account.
  clientProjectId    String?   @unique @map("client_project_id")
  /// When deleting the client's project switched this login from ACTIVE to INACTIVE - the project's
  /// own `deletedAt`. Recycling Bin → Restore turns back on only a login carrying its project's
  /// deletion time and still INACTIVE, never one somebody switched off on their own. NULL otherwise.
  deactivatedWithProjectAt DateTime? @map("deactivated_with_project_at")
  accessDepartment   String?   @map("access_department") @db.VarChar(100)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// Whether this login must have WhatsApp linked before it may use the application.
  ///
  /// Off for every account, and switched on per person: an administrator ticks **Allow WhatsApp** in
  /// Login Credentials -> WhatsApp for the people who should be held to it. Nobody is held until
  /// somebody says so, which is what makes it safe to ship - and unticking releases a person whose
  /// phone is lost or broken, with no deploy and no code change.
  ///
  /// An administrator - a Super Admin, or any role carrying the Administrator tick - is never held
  /// whatever this says, so the studio cannot be locked out of the screen that would let it back in.
  ///
  /// See `whatsappStanding()` in the WhatsApp chat module.
  whatsappRequired   Boolean   @default(false) @map("whatsapp_required")
  /// The bcrypt hashes of the passwords this login has had before the current one, newest first
  /// and capped by `passwordHistory.js`, so a password change can refuse one used before.
  passwordHistory    Json?     @map("password_history")
  /// When this account's password was last changed. Every access token minted before it is refused
  /// (`authMiddleware`), which is what signs the account out of every device on a change - a token
  /// is good for days and carries no password, so nothing else could end a session already issued.
  passwordChangedAt  DateTime? @map("password_changed_at")
  /// The login's own photograph, for accounts with no employee record to keep one on (the
  /// standalone Super Admin). A linked employee's photo lives on the employee row instead.
  profilePhotoUrl    String?   @map("profile_photo_url") @db.MediumText
  credentialsSentAt  DateTime? @map("credentials_sent_at")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // IAM Relations
  roles UserRole[]

  passwordResetTokens           PasswordResetToken[]
  passwordResetOtps             PasswordResetOtp[]
  authSessions                  AuthSession[]
  preferences                   UserPreference[]
  /// Required inverse; the link lives on the follow-up row.
  preProductionFollowupsUpdated ProjectPreProductionFollowup[]      @relation("ProjectPreProductionFollowupUpdatedBy")
