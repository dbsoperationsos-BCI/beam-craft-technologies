  salesProjectPreProductionCoordinatorEmployee        SalesProject[]                                @relation("SalesProjectPreProductionCoordinatorEmployee")
  salesProjectCreativeManagerEmployee                 SalesProject[]                                @relation("SalesProjectCreativeManagerEmployee")
  salesProjectPostProductionCoordinatorEmployee       SalesProject[]                                @relation("SalesProjectPostProductionCoordinatorEmployee")
  salesProjectProductionManagerEmployee               SalesProject[]                                @relation("SalesProjectProductionManagerEmployee")
  salesProjectWelcomeGiftEmployee                     SalesProject[]                                @relation("SalesProjectWelcomeGiftEmployee")
