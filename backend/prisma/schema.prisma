  @@index([isActive, name])
  @@map("gender")
}

/// One movement of cash, in or out, which is what the Accounts Manager lists. `entryType` says which
/// direction it went, and is what decides the few columns that belong to one direction only:
/// `receivedAccount` to money in, `paidTo` to money out. Everything either direction asks for —
/// client, category, branch, amount, mode, description — is one column shared by both, so the list,
/// the filters and the totals read one table rather than joining two.
///
/// The person is stored twice over on purpose. `handlerEmployeeId` links whoever took the money in
/// or paid it out while they are on the payroll, and `handlerName` keeps that person readable even
/// after the employee row is archived — or when it was somebody outside the payroll altogether,
/// which is what `handlerIsOther` marks. The same reasoning applies to `branch` and
/// `receivedAccount`: they are the names as chosen on the day, not links, so a branch renamed later
/// cannot rewrite what a past entry says.
///
/// `transactionId` belongs only to the modes that carry a reference — UPI, and the bank transfer
/// and net banking whose reference is the proof of the transfer. Cash and a card have none, so it
/// stays null there rather than holding a placeholder.
model CashEntry {
  id                String           @id @default(cuid())
  /// RCP-000001 for money in and PAY-000001 for money out, handed out by AppSequence.
  entryId           String           @unique @map("entry_id") @db.VarChar(30)
  entryType         String           @map("entry_type") @db.VarChar(20)
  /// What the money was against. Money comes in for a project as a whole — an advance, a final
  /// settlement — while money goes out per shoot, so money out carries both and money in carries
  /// only the project. Both stay optional: an office expense belongs to no shoot, and every entry
  /// recorded before this was added has neither.
  projectId         String?          @map("project_id")
  shootId           String?          @map("shoot_id")
  clientName        String           @map("client_name") @db.VarChar(191)
  category          String           @db.VarChar(60)
  amount            Decimal          @db.Decimal(12, 2)
  entryDate         DateTime         @map("entry_date")
  branch            String           @db.VarChar(120)
  branchId          Int?             @map("branch_id")
  paymentMode       String           @map("payment_mode") @db.VarChar(30)
  transactionId     String?          @map("transaction_id") @db.VarChar(100)
  /// What the payment mode actually was, when it was "Other" — a cheque, an adjustment, a swap.
  /// The five named modes leave it null. Asked for by the form and shown as the table's "Payment
  /// Mode Details" column, both of which were written before the column was; without it every
  /// create and update of an entry was refused by Prisma as an unknown field.
  paymentModeOther  String?          @map("payment_mode_other") @db.VarChar(120)
  /// The account the money moved through, asked only of the modes that use one — a bank transfer,
  /// net banking, a card — and never of cash. Money in names the account it landed in, money out
  /// the account it left from, so they are two columns for the same reason `paidTo` is its own.
  receivedAccount   String?          @map("received_account") @db.VarChar(120)
  paidFromAccount   String?          @map("paid_from_account") @db.VarChar(120)
  /// Money out only: who the payment went to.
  paidTo            String?          @map("paid_to") @db.VarChar(191)
  /// Who received it, or who paid it out, depending on the direction.
  handlerEmployeeId Int?             @map("handler_employee_id")
  handlerName       String           @map("handler_name") @db.VarChar(191)
  handlerIsOther    Boolean          @default(false) @map("handler_is_other")
  description       String?          @db.Text
  /// The receipt, bill or screenshot proving the payment, and what is known about each file:
  /// where it sits in the bucket, what it is, how large it was before and after compression, and
  /// who added it when. JSON for the same reason an asset's `images` are — a handful of files per
  /// entry, read as a set and never queried one at a time.
  paymentProof      Json?            @map("payment_proof")
  createdBy         Int?             @map("created_by")
  updatedBy         Int?             @map("updated_by")
  /// Entries are withdrawn rather than erased, so a mistaken one leaves a trail — and the proof
  /// stays in the bucket with it, since a withdrawn entry still has to be answerable for.
  deletedAt         DateTime?        @map("deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  handler           Employee?        @relation("CashEntriesHandled", fields: [handlerEmployeeId], references: [id], onDelete: SetNull)
  // The links drop to NULL rather than taking the entry with them: what was spent stays on the
  // books after the shoot it was spent on is removed. `clientName` and `branch` are still the text
  // chosen on the day for the same reason.
  project           SalesProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shoot             ProjectShoot?    @relation(fields: [shootId], references: [id], onDelete: SetNull)
  paymentRequests   PaymentRequest[]

  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branchRef Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([deletedAt, entryDate])
  @@index([entryType, category])
  @@index([clientName])
  @@index([handlerEmployeeId])
  @@index([projectId])
  @@index([branchId])
  @@index([shootId])
  @@map("cash_entry")
}

/// How far a recording has got through transcription. The webhook never waits for any of this -
/// a call log is saved and the job queued, and the row moves through these states behind it.
enum SalesCallTranscriptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Who is speaking in a segment.
///
/// faster-whisper transcribes but does not diarize, so EMPLOYEE and CLIENT are inferred from the
/// call's direction and the gaps between turns rather than measured from the audio. UNKNOWN is
/// what an inference that cannot be trusted says, and is shown as "Speaker" rather than guessing.
enum SalesCallSpeaker {
  EMPLOYEE
  CLIENT
  UNKNOWN
}

/// One recording, transcribed.
///
/// Keyed on the call log rather than the lead: a lead has many calls, and a redelivered Callyzer
/// batch writes the same call by the same id, so keying here is what stops one call being
/// transcribed twice. The lead is carried as well because the CRM reads transcripts by lead.
model SalesCallTranscript {
  id              String                    @id @default(cuid())
  /// The `sales_crm_call_log` row this came from.
  callLogId       String                    @unique @map("call_log_id") @db.VarChar(191)
  /// The lead the call landed on, as `sales_crm_lead.enquiry_id`.
  enquiryId       String                    @map("enquiry_id") @db.VarChar(100)
  recordingUrl    String?                   @map("recording_url") @db.Text
  status          SalesCallTranscriptStatus @default(PENDING)
  /// Whole transcript as one block, for search and for handing to the model.
  fullText        String?                   @map("full_text") @db.LongText
  language        String?                   @db.VarChar(20)
  /// Length of the audio actually transcribed, which can differ from the call's reported duration.
  durationSeconds Int                       @default(0) @map("duration_seconds")
  provider        String?                   @db.VarChar(60)
  /// What the model made of the call. Null until the summary step runs; a transcript is useful
  /// on its own, so a missing API key leaves these empty rather than failing the job.
  summary         String?                   @db.Text
  sentiment       String?                   @db.VarChar(30)
  /// What the call achieved, in a sentence or two. Text rather than VarChar(191): it is prose, like
  /// `summary` and `nextAction` beside it, and a model asked for an outcome writes a paragraph as
  /// readily as a phrase. It was VarChar and a longer-than-usual answer failed the whole write with
  /// "The provided value for the column is too long", losing a transcript that had already been made.
  callOutcome     String?                   @map("call_outcome") @db.Text
  nextAction      String?                   @map("next_action") @db.Text
  /// Intent, budget, event type and date, location, follow-up, suggested status - as JSON, so the
  /// shape can grow without a migration. Offered to the user; never written to the lead by itself.
  suggestions     String?                   @db.LongText
  /// Set when a person pressed Apply, with what was applied. Absent means nothing was written.
  appliedAt       DateTime?                 @map("applied_at")
  appliedByUserId Int?                      @map("applied_by_user_id")
  appliedFields   String?                   @map("applied_fields") @db.Text
  errorCode       String?                   @map("error_code") @db.VarChar(60)
  errorMessage    String?                   @map("error_message") @db.Text
  attempts        Int                       @default(0)
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  segments SalesCallTranscriptSegment[]

  @@index([enquiryId, createdAt])
  @@index([status])
  @@map("sales_call_transcript")
}

/// One turn of the conversation.
model SalesCallTranscriptSegment {
  id           String           @id @default(cuid())
  transcriptId String           @map("transcript_id") @db.VarChar(191)
  /// Position in the call, so segments read in order even if two share a start time.
  sequence     Int
  startMs      Int              @map("start_ms")
  endMs        Int              @map("end_ms")
  speaker      SalesCallSpeaker @default(UNKNOWN)
  text         String           @db.Text

  transcript SalesCallTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, sequence])
  @@map("sales_call_transcript_segment")
}

// ============================================
// IAM MODELS (Role-Based Access Control)
// ============================================

model Role {
  id               String   @id @default(cuid())
  name             String   @unique @db.VarChar(100)
  description      String?  @db.Text
  isSystem         Boolean  @default(false) @map("is_system")
  isAdmin          Boolean  @default(false) @map("is_admin")
  isBranchManager  Boolean  @default(false) @map("is_branch_manager")
  isDepartmentLead Boolean  @default(false) @map("is_department_lead")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // A role holds its permissions directly and a group is given as many roles as it needs. There is
  // no layer between the two: the policy layer that used to sit here was folded into roles, so the
  // thing you name and the thing that carries permissions are one object.
  permissions RolePermission[]
  users       UserRole[]
  branches    RoleBranch[]

  @@index([isActive])
  @@index([isSystem])
  @@map("role")
}

model Permission {
  id          String   @id @default(cuid())
  module      String   @db.VarChar(50)
  feature     String   @db.VarChar(100)
  level       String   @db.VarChar(50)
  description String?  @db.Text
  displayName String?  @map("display_name") @db.VarChar(150)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles  RolePermission[]
  // Named sub-actions inside this permission, shown as checkboxes under it. A permission with none
  // is simply a Disabled/Read/Read-Write choice and nothing more.
  scopes PermissionScope[]
  /// Required inverse of BranchAdminPermission.permission. Adds no column; the link is on that row.
  branchAdminGrants BranchAdminPermission[]

  @@unique([module, feature, level])
  @@index([module])
  @@index([isActive])
  @@map("permission")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  accessLevel  String   @map("access_level") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission            @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scopes     RolePermissionScope[]

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}

// A named sub-action inside a permission - "Import", "Operate Intents" - offered as a checkbox
// under it when a role grants that permission. Scopes are data, not code: a module gains one by
// being seeded, and a permission with no scopes just renders as its access-level choice.
model PermissionScope {
  id           String   @id @default(cuid())
  permissionId String   @map("permission_id")
  name         String   @db.VarChar(100)
  displayName  String?  @map("display_name") @db.VarChar(150)
  description  String?  @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permission Permission            @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  roleGrants RolePermissionScope[]

  @@unique([permissionId, name])
  @@index([permissionId])
  @@index([isActive])
  @@map("permission_scope")
}

// Which scopes a role has ticked for a permission it holds. Hung off the grant rather than the role
// so that withdrawing the permission takes its scopes with it.
model RolePermissionScope {
  id               String @id @default(cuid())
  rolePermissionId String @map("role_permission_id")
  scopeId          String @map("scope_id")

  rolePermission RolePermission  @relation(fields: [rolePermissionId], references: [id], onDelete: Cascade)
  scope          PermissionScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([rolePermissionId, scopeId])
  @@index([rolePermissionId])
  @@index([scopeId])
  @@map("role_permission_scope")
}

// The branches a role reaches. A role with several is how somebody works across branches: the
// permissions it carries apply in every branch listed here, not only in the branch of the group
// that happens to carry the role. A role with none reaches nowhere and grants nothing.
// A role a user carries. Roles used to arrive through a group; they are held directly now, so a
// user's access is the union of every role on this table for them - see the memory note on the
// group layer if that ever needs reinstating.
model UserRole {
  id     String @id @default(cuid())
  userId Int    @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

// The **Admin Permission** set: one studio-wide matrix that every role marked `isBranchManager`
// carries, on top of whatever that role grants in its own right.
//
// There is deliberately one of these and not one per role. A branch administrator in Erode and a
// branch administrator in Bangalore do the same job in two places, and the studio decides once what
// that job may touch; what differs between them is the branch list on their own role, which this
// does not touch. Editing the set therefore changes what **every** branch administrator may do, at
// once and without re-saving a single role - which is the point of it, and why the screen says so
// before it saves.
//
// One row per permission granted, so a permission absent from this table grants nothing here.
// `permission_id` is unique because "one level per permission" is the only sensible reading, and a
// unique index says so in the database rather than in a comment.
//
// Merged in `IAMService.getUserPermissions` through the same `_mergeMostPermissive` every other
// grant goes through, so the strongest wins where a branch administrator's own role already names a
// permission this set also names. It can only ever widen somebody, never narrow them.
model BranchAdminPermission {
  id           String @id @default(cuid())
  permissionId String @unique @map("permission_id")
  accessLevel  String @map("access_level") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId])
  @@map("branch_admin_permission")
}

model RoleBranch {
  id       String @id @default(cuid())
  roleId   String @map("role_id")
  branchId Int    @map("branch_id")

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([roleId, branchId])
  @@index([roleId])
  @@index([branchId])
  @@map("role_branch")
}

model AiActionPlan {
  id          String    @id @default(cuid())
  /// SHA-256 of the token handed to the browser. Unique, so a confirm is a single indexed lookup.
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  /// Whose plan it is. Confirming re-resolves this person's permissions from scratch.
  userId      Int       @map("user_id")
  /// The module the plan was made in. A token is not valid in a different one.
  module      String    @db.VarChar(40)
  tool        String    @db.VarChar(80)
  /// The tool's arguments, as JSON. Cleared once the plan has been carried out - the data has
  /// landed in the module's own tables by then, and a second copy here would outlive it.
  args        String?   @db.Text
  risk        String    @db.VarChar(30)
  /// What a person reads on the confirmation card before deciding.
  summary     String    @db.Text
  /// PENDING, CONFIRMED, FAILED, or CANCELLED. Never deleted on use - a plan that ran is a record
  /// that it ran.
  status      String    @db.VarChar(20)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sweeping expired plans.
  @@index([status, expiresAt])
  @@map("ai_action_plan")
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  /// SALES, HRM, IMAGE_SELECTION, ASSET, ACCOUNTS, or GLOBAL.
  module    String   @db.VarChar(40)
  /// Taken from the opening question, for the conversation list. Never generated by the model.
  title     String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  /// The index every listing uses: this person's threads in this module, most recent first.
  @@index([userId, module, updatedAt])
  @@map("ai_conversation")
}

/// One turn in a conversation.
///
/// Deleted with its conversation, and with its user - an account that goes takes its assistant
/// history with it rather than leaving orphaned rows about clients.
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  /// "user" or "assistant". Tool results are summarised into the assistant turn rather than stored
  /// as their own role, so a replay cannot resurrect data the person may no longer be allowed to see.
  role           String   @db.VarChar(20)
  content        String   @db.Text
  /// Which tools ran, as JSON: names and durations, never their results.
  toolTrace      String?  @map("tool_trace") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_message")
}

/// A document the assistant may draw on - an SOP, a policy, a workflow note.
///
/// `module` and `visibility` together decide who can retrieve from it, and both are filtered in SQL
/// before any embedding is loaded. An HRM policy is never in memory during a CRM question, which is
/// the difference between filtering access and hiding a result after the model has seen it.
model AiDocument {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  /// SALES, HRM, IMAGE_SELECTION, ASSET, ACCOUNTS - or GLOBAL for something every module may read.
  module      String   @db.VarChar(40)
  /// "module" for its own module only, "global" for anything approved company-wide.
  visibility  String   @default("module") @db.VarChar(20)
  /// Where it came from, for someone auditing an answer back to its source.
  source      String?  @db.VarChar(500)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  chunks AiDocumentChunk[]

  @@index([module, visibility])
  @@map("ai_document")
}

/// One passage of a document, with its embedding.
///
/// The embedding is JSON rather than a vector column because MySQL has no vector type and the
/// corpus is a studio's own procedures - a few hundred passages, where cosine similarity in Node
/// costs milliseconds. A dedicated vector store would be another service to keep alive on a box
/// already holding several gigabytes of models, for a scale nowhere near needing one.
model AiDocumentChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  /// Position in the document, so retrieved passages can be read back in order.
  ordinal    Int
  content    String   @db.Text
  /// The embedding as a JSON array of floats.
  embedding  String   @db.LongText
  tokenCount Int      @default(0) @map("token_count")
  createdAt  DateTime @default(now()) @map("created_at")

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, ordinal])
  @@map("ai_document_chunk")
}

/// Work agreed on top of what a project was sold for — an extra shoot, an album nobody quoted.
///
/// Its own table rather than a fifth kind of `PaymentRequest`, because it is not one. The four
/// payment requests are the studio paying somebody and approving one writes a cash entry; this
/// agrees work and writes nothing to the books, the money arriving later as an ordinary receipt.
/// It also carries one thing rather than a list of lines, and it is decided by the manager of the
/// project it names rather than by Accounts.
///
/// The project is required and the shoot is not: an extra usually belongs to a shoot, but one
/// agreed for the project as a whole has no shoot to name.
model ProjectExtraQuotation {
  id              String    @id @default(cuid())
  /// EXT-000001, from the counter every generated identifier comes from.
  requestCode     String    @unique @map("request_code") @db.VarChar(30)
  projectId       String    @map("project_id")
  shootId         String?   @map("shoot_id")
  /// The service being added, named from the studio's own service list so an extra names work the
  /// system already knows about rather than free text nobody can total.
  service         String    @db.VarChar(150)
  amount          Decimal   @db.Decimal(12, 2)
  remarks         String?   @db.Text
  /// Who asked. The name is stored beside the link so a decided extra still reads correctly after
  /// the employee is archived, the same reason a cash entry keeps its handler's name.
  requestedById   Int?      @map("requested_by_id")
  requestedByName String    @map("requested_by_name") @db.VarChar(191)
  /// What the client agreed to, in writing: a signed quote, a screenshot of the message. Held the
  /// way every other upload on the site is — the file's place in the bucket and what is known
  /// about it — so one extra can carry a few pages of proof.
  /// When it was added, which is not always when it was typed in — an extra agreed on the shoot day
  /// may be entered the following morning. `createdAt` stays the record's own timestamp.
  addedAt         DateTime  @default(now()) @map("added_at")
  proof           Json?
  status          String    @default("PENDING") @db.VarChar(20)
  decisionRemarks String?   @map("decision_remarks") @db.Text
  decidedById     Int?      @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at")
  createdBy       Int?      @map("created_by")
  /// Withdrawn rather than erased, so a mistaken request leaves a trail.
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project SalesProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shoot   ProjectShoot? @relation(fields: [shootId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([status])
  @@index([deletedAt])
  @@map("project_extra_quotation")
}

/// One job somebody asked somebody else to do, and what became of it.
///
/// Assigning is between *logins*, not between employee records: anybody signed in may give a task
/// to anybody else signed in, and the studio has logins with no employee row behind them (the
/// standalone Super Admin) as well as employees with no login. `User` is the only side both of
/// those are on.
///
/// The two names are stored beside the two ids, the way `CashEntry` keeps `handlerName`: a login
/// can be deleted, and a finished task must still say who did it. That is also why both ids are
/// nullable while both names are not.
///
/// Nothing here is deleted. A task that cannot be done is reverted with a reason, and one that
/// should never have been given is cancelled - both are states with a timestamp, because "who
/// stopped this, and when" is exactly what somebody asks a week later.
model HrmTask {
  id            Int     @id @default(autoincrement())
  /// TSK-000001, from the counter every generated identifier in the application comes from.
  taskCode      String  @unique @map("task_code") @db.VarChar(30)
  /// The one line the list, the bell and the notification all show. The instructions are below it.
  title         String  @db.VarChar(200)
  description   String  @db.Text
  /// Client work, internal work, and the rest of the studio's list; see `TASK_TYPES` in the module.
  taskType      String  @map("task_type") @db.VarChar(60)
  /// What "Other" actually was, typed beside it, because a list of tasks all reading "Other" says
  /// nothing about any of them. Null on every named type - the form clears it when the type changes.
  taskTypeOther String? @map("task_type_other") @db.VarChar(120)
  priority      String  @default("MEDIUM") @db.VarChar(20)
  /// PENDING, IN_PROGRESS, COMPLETED, REASSIGNED or CANCELLED.
  ///
  /// `REASSIGNED` is an **open** status, unlike the `REVERTED` it replaced: a reassigned task has
  /// landed on somebody new and is waiting to be picked up, so it still has to be startable. Only
  /// COMPLETED and CANCELLED close a task now.
  status        String  @default("PENDING") @db.VarChar(20)

  /// Which department the work belongs to and which branch it is for, chosen when the task is given.
  ///
  /// The task's own answer rather than the assignee's: work is regularly handed across a branch or
  /// a department line - Erode's editor finishing a Karim Nagar wedding - and reading them off the
  /// person would file that task under the wrong one of each.
  ///
  /// Names rather than ids, matching how every table but `User` and `Asset` stores its branch (see
  /// CLAUDE.md). Picked from the live `department` and `location` lists, checked against them on
  /// the way in, and kept verbatim afterwards - a department later renamed or retired does not
  /// rewrite the tasks filed under what it was called at the time. Nullable only for the tasks
  /// raised before this was asked for; every task given since carries both.
  department      String? @db.VarChar(120)
  branch          String? @db.VarChar(120)
  branchId        Int?    @map("branch_id")
  /// The employee behind the assignee's login, kept in step on every write; NULL for a login with none.
  ownerEmployeeId Int?    @map("owner_employee_id")
  /// The login that created this task. Usually the giver, but an administrator can raise one on
  /// somebody else's behalf, and then the two differ.
  createdByUserId Int?    @map("created_by_user_id")

  assignedToUserId Int?   @map("assigned_to_user_id")
  assignedToName   String @map("assigned_to_name") @db.VarChar(191)
  assignedByUserId Int?   @map("assigned_by_user_id")
  assignedByName   String @map("assigned_by_name") @db.VarChar(191)

  /// When it is wanted by, where that was asked for. A task with no due date is not late.
  dueOn DateTime? @map("due_on")

  /// Who finished it, and when. The receiver is normally the only one who can, so this is usually
  /// `assignedTo` - stored anyway, because "usually" is not "always" once a task can be reassigned.
  completedAt       DateTime? @map("completed_at")
  completedByUserId Int?      @map("completed_by_user_id")
  completedByName   String?   @map("completed_by_name") @db.VarChar(191)

  /// Why the task last changed hands, and when. Reassigning without a reason is refused: the reason
  /// *is* the reassignment, and it is what the next person needs in order to pick the work up.
  ///
  /// These two were `revert_reason` and `reverted_at`, which held why the receiver handed the task
  /// back to whoever set it. Reassigning replaced rolling back — the same act with a named
  /// destination — so the columns were renamed rather than added beside them: an old rolled-back
  /// task's reason is exactly this field's meaning, and two columns for one fact would leave every
  /// reader deciding which to show.
  reassignReason String?   @map("reassign_reason") @db.Text
  reassignedAt   DateTime? @map("reassigned_at")

  /// Who handed it on, kept because the task itself only ever names who holds it *now*.
  ///
  /// The full chain is in `holders` and in the activity log; this is the last hop, which is what a
  /// row in a list has room to say.
  reassignedFromUserId Int?    @map("reassigned_from_user_id")
  reassignedFromName   String? @map("reassigned_from_name") @db.VarChar(191)

  cancelledAt DateTime? @map("cancelled_at")

  /// When this task was deleted, or NULL for a task that still exists.
  ///
  /// Deleting is the giver's and a Super Admin's, and it is a soft delete: the row stays, the task
  /// leaves My Tasks, Tasks Given and All Tasks alike, and every verb refuses it the same 404 a task
  /// that was never there would get. A task carries a chain of holders, an activity log and the
  /// files handed over with it, and a mistaken delete that took all of that with it would be
  /// unanswerable afterwards - this one is a column somebody can clear.
  ///
  /// Distinct from CANCELLED, which is a status: a cancelled task is a real task that was called
  /// off, still read by both people and still counted. A deleted one is a task the studio is saying
  /// should never have been raised.
  deletedAt DateTime? @map("deleted_at")

  /// The files handed over with the task, as a list of small records - never the bytes.
  ///
  /// A column rather than a table beside it: a task's files are read with the task, always, and
  /// nothing else in the application points at one. Each entry carries an id unique within the
  /// task (so a file can still be addressed by a URL), the name it was picked with, its key in the
  /// private R2 bucket, its type and size, and who added it when.
  ///
  /// A list rewritten whole is the cost of the column, so every write locks this row first - see
  /// `addAttachment` in the module. NULL is a task nobody attached anything to, which is honestly
  /// what every task raised before this existed is.
  attachments Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User?             @relation("HrmTasksReceived", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedBy User?             @relation("HrmTasksGiven", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  holders    HrmTaskHolder[]
  owner      Employee?         @relation("HrmTaskOwner", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  activities HrmTaskActivity[]

  /// The two questions My Tasks and Tasks Given ask, each with the status the tabs filter by.
  /// Reference beside the text column, NULL until the match report is approved (DATA-SCOPE.md D9).
  branchRef Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([assignedToUserId, status])
  @@index([assignedByUserId, status])
  /// All Tasks, newest first.
  @@index([status, createdAt])
  @@index([branchId])
  @@index([dueOn])
  @@index([ownerEmployeeId])
  @@index([createdByUserId])
  @@index([reassignedFromUserId])
  /// Every list this module answers starts "not deleted", so it is the first thing each of them
  /// narrows by.
  @@index([deletedAt])
  @@map("hrm_task")
}

/// Everybody who has held a task: the person it was given to, and each person it has been passed on
/// to since.
///
/// A table rather than a list on the task, because it is *queried* rather than only displayed: My
/// Tasks asks "which tasks have I ever held", and a JSON array cannot be indexed for that. The row
/// for the current holder is here too, so the question is one uniform lookup instead of a lookup
/// plus a check against `assignedToUserId`.
///
/// It never shrinks. A task passed from B to C keeps B, which is the whole point — B is owed sight
/// of what happened to the work they were asked to do, and the reason C now has it.
model HrmTaskHolder {
  id     Int      @id @default(autoincrement())
  taskId Int      @map("task_id")
  userId Int?     @map("user_id")
  /// The name as it stood when they held it, so a task still reads correctly after a login is renamed
  /// or removed — the same reason the task itself stores `assignedToName` beside the id.
  name   String   @db.VarChar(191)
  /// When the task landed on them. Ordered by this, the rows are the chain in the order it happened.
  heldAt DateTime @default(now()) @map("held_at")

  task HrmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User?   @relation("HrmTaskHolders", fields: [userId], references: [id], onDelete: SetNull)

  /// One row per person per task: being handed a task twice does not make two holders of them.
  @@unique([taskId, userId])
  /// "Which tasks have I ever held", which is My Tasks.
  @@index([userId])
  @@map("hrm_task_holder")
}

/// Everything that has ever happened to a task, in the order it happened.
///
/// A row per event rather than a handful of "changed by / changed at" columns on the task: the
/// history is read as a list, it never stops growing, and a column pair only ever remembers the
/// last thing anybody did. `detail` carries whatever the action needs to be understood on its own -
/// the revert reason, the status it moved from and to - so reading the log needs no second query.
model HrmTaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  /// CREATED, ASSIGNED, STATUS_CHANGED, COMPLETED, REVERTED or CANCELLED.
  action    String   @db.VarChar(40)
  detail    String?  @db.Text
  userId    Int?     @map("user_id")
  userName  String   @map("user_name") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")

  task HrmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// How the log is always read: one task's events, oldest first.
  @@index([taskId, createdAt])
  @@map("hrm_task_activity")
}

/// One person the studio is considering for a role, and where they have got to.
///
/// HRM's counterpart of a CRM lead, and built the same way: a row is typed in on the Interview
/// screen or arrives from a linked Google Sheet through Settings → Integrations → Interview, and is
/// then worked through statuses - New, Screening, Shortlisted, Interview Scheduled, Interviewed,
/// Selected, On Hold, Rejected, Joined. `status` is text rather than an enum so a sheet's own
/// wording survives the import verbatim: an unknown stage is shown as typed under All rather than
/// refused or silently filed as New.
///
/// The dates are text folded to `YYYY-MM-DD` on the way in, exactly as a lead's are, because they
/// arrive from the same four producers - the form, a sheet, a CSV, a person - and `leadDates.js` is
/// the one list of shapes all of them are read with. The branch is free text beside a reference,
/// matching every table but `User` and `Asset` (see CLAUDE.md); the interviewer likewise.
///
/// The `source_*` columns are the row's own identity on the sheet it came from, so a re-sync is an
/// edit of the same candidate rather than a second one, and deleting a link takes its candidates.
model HrmInterviewCandidate {
  id                    String    @id @default(cuid())
  /// DBS-INTV-000001, from the same counter table every other generated identifier uses.
  candidateCode         String    @unique @map("candidate_code") @db.VarChar(30)
  name                  String    @db.VarChar(191)
  phone                 String?   @db.VarChar(40)
  whatsappNumber        String?   @map("whatsapp_number") @db.VarChar(40)
  email                 String?   @db.VarChar(191)
  /// The role applied for, picked from the designation list or typed as the sheet has it.
  position              String?   @db.VarChar(150)
  department            String?   @db.VarChar(120)
  experience            String?   @db.VarChar(60)
  currentCompany        String?   @map("current_company") @db.VarChar(191)
  currentCtc            String?   @map("current_ctc") @db.VarChar(60)
  /// The lowest the candidate would actually accept, beside what they are asking for. Two numbers
  /// rather than one because they answer different questions: `expectedCtc` is the opening ask, and
  /// this is the floor that decides whether a conversation is worth having at all.
  minExpectedCtc        String?   @map("min_expected_ctc") @db.VarChar(60)
  expectedCtc           String?   @map("expected_ctc") @db.VarChar(60)
  noticePeriod          String?   @map("notice_period") @db.VarChar(60)
  city                  String?   @db.VarChar(120)
  state                 String?   @db.VarChar(120)
  /// Where the candidate is **from**, and where they are **now** - the two questions the screening
  /// form asks in place of State and a postal Address.
  ///
  /// A studio hiring for a shoot floor wants to know whether somebody is local and whether they
  /// would be moving, and neither `state` nor a street address answered that: a state is too coarse
  /// to say "can they be here on Saturday", and an address is more than the studio needs of somebody
  /// it has not hired. Both stay on the record, because a linked sheet and the CSV import still fill
  /// them for candidates who arrived that way.
  nativePlace           String?   @map("native_place") @db.VarChar(191)
  currentLocation       String?   @map("current_location") @db.VarChar(191)
  /// The branch the candidate is being interviewed for, as text, with the reference beside it.
  branch                String?   @db.VarChar(120)
  branchId              Int?      @map("branch_id")
  /// Where the application came from - Naukri, LinkedIn, a referral, or "Google sheet integration".
  source                String?   @db.VarChar(120)
  referredBy            String?   @map("referred_by") @db.VarChar(191)
  /// Which paid ad the application came from, named as a Meta (Facebook/Instagram) lead export
  /// names them. Three columns rather than one, because a studio reads them at three different
  /// widths: the campaign says which hiring push, the ad set which audience, the ad which creative.
  /// Only a linked sheet or a CSV ever fills these in - nobody types an ad name by hand.
  campaignName          String?   @map("campaign_name") @db.VarChar(191)
  adsetName             String?   @map("adset_name") @db.VarChar(191)
  adName                String?   @map("ad_name") @db.VarChar(191)
  resumeUrl             String?   @map("resume_url") @db.VarChar(1000)
  /// Anything the candidate attached besides the résumé - certificates, an award letter, a scanned
  /// portfolio - as a JSON array of `{ name, url }`, the shape `storeDocument` returns. One column
  /// rather than a table for the reason the two entry lists beside it are: nothing reads an
  /// attachment apart from the candidate it belongs to.
  attachments           String?   @map("attachments") @db.LongText
  /// What an application form in a corporate or a studio asks beyond the contact card: the kind of
  /// engagement applied for, who the person is, what they know and where they have worked. Filled
  /// by HR on Add Application, or by the candidate on the public application form.
  employmentType        String?   @map("employment_type") @db.VarChar(40)
  gender                String?   @db.VarChar(30)
  dateOfBirth           String?   @map("date_of_birth") @db.VarChar(40)
  address               String?   @db.Text
  currentDesignation    String?   @map("current_designation") @db.VarChar(150)
  highestQualification  String?   @map("highest_qualification") @db.VarChar(191)
  skills                String?   @db.Text
  languagesKnown        String?   @map("languages_known") @db.Text
  /// The candidate's own links - a portfolio, an Instagram, a Drive folder - as a JSON array of up
  /// to three URL strings. `portfolioUrl` beside it is the **first** of them, kept as a plain column
  /// because the register's table, the linked sheets and the CSV importer all read a single link and
  /// none of them has a place to show three.
  portfolioLinks        String?   @map("portfolio_links") @db.LongText
  portfolioUrl          String?   @map("portfolio_url") @db.VarChar(1000)
  availableFrom         String?   @map("available_from") @db.VarChar(40)
  /// JSON arrays: the qualifications and the jobs the candidate listed on the application form,
  /// in the shape `RepeatableDetailsField` holds them - one column each rather than two tables,
  /// because nothing reads them apart from the record they belong to.
  educationEntries      String?   @map("education_entries") @db.LongText
  experienceEntries     String?   @map("experience_entries") @db.LongText
  status                String    @default("Yet to Connect") @db.VarChar(40)
  /// Who is handling the candidate: an employee's name, the way a lead's `crm` column holds one,
  /// filled by hand or by a linked sheet's assignment rules. The reference is refreshed on write.
  interviewer           String?   @db.VarChar(150)
  interviewerEmployeeId Int?      @map("interviewer_employee_id")
  /// Every round this candidate has been called for, as a JSON array of
  /// `{ round, interviewDate, interviewTime, interviewMode, meetLink }`.
  ///
  /// The four flat columns below are the **latest** round, which is what keeps the register's own
  /// table, the linked sheets and the CSV importer reading the one interview they always have. The
  /// array is what a second round stopped destroying: scheduling one used to overwrite the first,
  /// so nobody could say when a candidate had already been seen.
  ///
  /// Which round they are on is not a column: it is the length of this list, derived on read, so
  /// the count and the rounds cannot disagree.
  interviewRounds       String?   @map("interview_rounds") @db.LongText
  interviewDate         String?   @map("interview_date") @db.VarChar(40)
  interviewTime         String?   @map("interview_time") @db.VarChar(40)
  /// In Person, Google Meet or Phone.
  interviewMode         String?   @map("interview_mode") @db.VarChar(40)
  meetLink              String?   @map("meet_link") @db.VarChar(1000)
  appliedDate           String?   @map("applied_date") @db.VarChar(40)
  addedTime             String?   @map("added_time") @db.VarChar(40)
  lastFollowUpDate      String?   @map("last_follow_up_date") @db.VarChar(40)
  nextFollowUpDate      String?   @map("next_follow_up_date") @db.VarChar(40)
  remarks               String?   @db.Text
  /// Why a candidate was selected, put on hold or turned down, as a JSON array of
  /// `{ status, note, at }` - one entry per decision, newest last.
  ///
  /// Apart from `remarks` above, which is HR's running note on the person. A decision and a note
  /// are different things: a candidate can be held in March and rejected in May, and each has its
  /// own reason that the other must not overwrite. Folding them into `remarks` meant either losing
  /// the earlier one or appending until nobody could tell which sentence went with which stage.
  statusNotes           String?   @map("status_notes") @db.LongText
  /// The candidate's own two answers about the studio, asked on the application form.
  ///
  /// `howYouKnowUs` is deliberately **not** `source` above. That column is the studio's own answer
  /// to where an application came from - "Meta Ads", set by a linked sheet's rules - and letting a
  /// candidate write into it would let one submission overwrite what the import established, which
  /// is exactly why the form stopped sending `department`. The two answers different questions:
  /// where the row came from, and how the person says they heard of the place.
  howYouKnowUs          String?   @map("how_you_know_us") @db.VarChar(1000)
  aboutUs               String?   @map("about_us") @db.Text
  /// The row's identity on the sheet that imported it: the sheet's own Candidate ID column where it
  /// has one, `<spreadsheet>:<tab>:row:<n>` where it does not. NULL for a candidate typed in.
  sourceRowId           String?   @map("source_row_id") @db.VarChar(255)
  sourceRowNumber       Int?      @map("source_row_number")
  spreadsheetId         String?   @map("spreadsheet_id") @db.VarChar(191)
  gid                   String?   @db.VarChar(40)
  targetTab             String?   @map("target_tab") @db.VarChar(191)
  systemTableId         String?   @map("system_table_id") @db.VarChar(191)
  lastSourceSyncAt      DateTime? @map("last_source_sync_at")
  /// JSON object, for answers to fields a later Table Settings may add - one column rather than an
  /// ALTER TABLE per field, the same reasoning as the lead's.
  customFields          String?   @map("custom_fields") @db.LongText
  createdByUserId       Int?      @map("created_by_user_id")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([phone])
  @@index([email])
  @@index([spreadsheetId, targetTab])
  @@index([sourceRowId])
  @@index([interviewerEmployeeId])
  @@index([branchId])
  @@map("hrm_interview_candidate")
}

/// Where an application came from - Naukri, LinkedIn, Meta Ads, a referral, a walk-in.
///
/// A list the studio maintains (Settings → Fields → Interview → Sources) rather than an array in
/// the code, which is what it was: the same eleven values written out in
/// `hrm/interview/candidates.js` and again in `constants/interviewConfig.js`, so a studio that
/// started advertising somewhere new could not say so, and the two copies could disagree about
/// what the picker offered. Seeded by `prisma/seeds/interview-sources.seed.js` and by the migration
/// beside it, since the seed cannot be run on the VPS.
///
/// `sortOrder` because the order is the answer's own: the job boards the studio actually uses come
/// first and **Other** belongs last, which is not what sorting the words alphabetically gives.
///
/// The two sources the *application* writes for itself - "Application Form" and "Google sheet
/// integration" - are deliberately not rows here. They are what the public form and the sheet
/// importer stamp on a candidate and compare against, so they stay named in `candidates.js`: a
/// studio renaming a row must not change what the importer writes.
/// The positions the Interview register offers beyond the studio's designation list.
///
/// Position Applied For reads the designations, because most applications are for a role the studio
/// actually has. What it could not offer is a position nobody is ever *employed* as - "General",
/// the answer to a hiring ad that names no role - and putting that in `designation` would put it in
/// every employee's designation picker, which is a different question with a different answer.
model InterviewPosition {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("interview_position")
}

model InterviewSource {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("interview_source")
}

/// The link a candidate fills their application form in from - the Interview module's counterpart
/// of `EmployeeOnboardingInvite`, and built the same way: a hashed token, a short code the shared
/// link carries, an expiry, and the candidate's own email or phone as the gate to opening it.
///
/// `candidateId` is the register row the form writes into. Sending the form is what moves a
/// candidate to **Form Submission Pending**; the candidate submitting it moves them to **Form
/// Submitted** and stamps `submittedAt`. No foreign key, matching the tables beside it.
model HrmInterviewApplicationInvite {
  id              String    @id @default(cuid())
  candidateId     String?   @map("candidate_id") @db.VarChar(191)
  candidateName   String    @map("candidate_name") @db.VarChar(150)
  candidateEmail  String    @map("candidate_email") @db.VarChar(191)
  candidatePhone  String    @map("candidate_phone") @db.VarChar(30)
  position        String?   @db.VarChar(150)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  tokenPreview    String?   @map("token_preview") @db.VarChar(32)
  /// The raw token, kept so the link can be emailed again; an application token opens one form.
  token           String?   @db.VarChar(64)
  shortCode       String?   @unique @map("short_code") @db.VarChar(8)
  /// Created, Verified, Submitted, Expired or Cancelled - the onboarding invite's own states.
  status          String    @default("Created") @db.VarChar(20)
  expiresAt       DateTime  @map("expires_at")
  verifiedAt      DateTime? @map("verified_at")
  submittedAt     DateTime? @map("submitted_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([candidateId])
  @@index([status, expiresAt])
  @@index([candidateEmail])
  @@index([createdAt])
  @@map("hrm_interview_application_invite")
}

/// A Google Sheet linked to the Interview module: the same record `SalesGoogleSheetLink` is for
/// the CRM, kept as its own table so Settings → Integrations → Interview lists, syncs and deletes
/// its own sheets without ever touching the CRM's. Written through Prisma rather than raw SQL -
/// this table was born under a migration and needs no bootstrap.
model HrmInterviewGoogleSheetLink {
  id                        String    @id @default(cuid())
  /// The `sales_google_account_connection` row the sheet is read through. One Google account per
  /// login serves both integrations; the connection table is not duplicated.
  googleAccountConnectionId String?   @map("google_account_connection_id") @db.VarChar(191)
  systemTableName           String    @map("system_table_name") @db.VarChar(191)
  systemTableId             String    @default("") @map("system_table_id") @db.VarChar(191)
  sheetUrl                  String    @map("sheet_url") @db.VarChar(1000)
  spreadsheetId             String?   @map("spreadsheet_id") @db.VarChar(191)
  spreadsheetName           String?   @map("spreadsheet_name") @db.VarChar(255)
  targetedTab               String    @map("targeted_tab") @db.VarChar(191)
  status                    String    @default("ACTIVE") @db.VarChar(30)
  lastSyncedAt              DateTime? @map("last_synced_at")
  lastSyncStatus            String?   @map("last_sync_status") @db.VarChar(30)
  lastSyncSummary           String?   @map("last_sync_summary") @db.Text
  createdByUserId           Int?      @map("created_by_user_id")
  deletedAt                 DateTime? @map("deleted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@index([googleAccountConnectionId])
  @@index([systemTableId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("hrm_interview_google_sheet_link")
}

/// Whose candidate a sheet row is - one column matching one value - the same rule shape the CRM's
/// linked sheets use (`SalesGoogleSheetAssignmentRule`), pointed at an interviewer instead.
model HrmInterviewGoogleSheetAssignmentRule {
  id           String   @id @default(cuid())
  linkId       String   @map("link_id") @db.VarChar(191)
  priority     Int      @default(0)
  columnHeader String   @default("") @map("column_header") @db.VarChar(255)
  matchValue   String   @default("") @map("match_value") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([linkId])
  @@map("hrm_interview_google_sheet_assignment_rule")
}

/// One person on an interview assignment rule and the share of its candidates they take; see
/// `SalesGoogleSheetAssignmentRuleTarget` for why the share is a running count.
model HrmInterviewGoogleSheetAssignmentRuleTarget {
  id            String   @id @default(cuid())
  ruleId        String   @map("rule_id") @db.VarChar(191)
  position      Int      @default(0)
  employeeId    Int?     @map("employee_id")
  employeeName  String   @default("") @map("employee_name") @db.VarChar(150)
  percent       Int      @default(100)
  assignedCount Int      @default(0) @map("assigned_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([ruleId, employeeId], map: "hrm_interview_sheet_rule_target_rule_employee")
  @@index([ruleId])
  @@index([employeeId])
  @@map("hrm_interview_google_sheet_assignment_rule_target")
}

/// A sheet row the Interview module has already imported, kept apart from the candidate it made so
/// a candidate the studio deleted stays deleted on the next pass - see `SalesGoogleSheetRow`.
model HrmInterviewGoogleSheetRow {
  id            String   @id @default(cuid())
  linkId        String   @map("link_id") @db.VarChar(191)
  rowKey        String   @map("row_key") @db.VarChar(255)
  candidateCode String?  @map("candidate_code") @db.VarChar(30)
  firstSeenAt   DateTime @default(now()) @map("first_seen_at")

  @@unique([linkId, rowKey], map: "hrm_interview_google_sheet_row_link_key")
  @@index([candidateCode])
  @@map("hrm_interview_google_sheet_row")
}

/// One thing the application has to tell one person, waiting on the bell in the top bar.
///
/// General on purpose, though tasks are the only thing writing rows today: `type`, `entityType` and
/// `entityId` say what a notice is about, and `link` says where pressing it goes. A second module
/// that needs to tell somebody something adds a `type` and writes here rather than growing a bell
/// of its own - which is what the studio's meetings ended up doing, and why the bar used to have
/// one notification panel that only ever knew about meetings.
///
/// `readAt` rather than a boolean, because "when did they see it" is the question that gets asked.
model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  /// TASK_ASSIGNED, TASK_COMPLETED, TASK_REVERTED or TASK_CANCELLED.
  type       String    @db.VarChar(40)
  title      String    @db.VarChar(200)
  body       String?   @db.Text
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.VarChar(64)
  link       String?   @db.VarChar(300)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The only question the bell asks: this reader's notices, unread first, newest first.
  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// What state an asset is in - Condition on Assets, and on an inspection.
/// Client Storage keeps its own list beside this one: the words match today, but a hard disk
/// travelling to a client is not judged the way a camera on the shelf is, and the studio asked
/// for the two to be able to part company.
model AssetCondition {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("asset_condition")
}

/// How badly an asset is broken - Severity when a repair is raised on Assets.
model AssetRepairSeverity {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("asset_repair_severity")
}

/// How an asset travels - Shipment Type when one is moved on Assets.
model AssetShipmentType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("asset_shipment_type")
}

/// What state a client's hard disk is in on the way - Current Condition on Client Storage.
/// Its own list rather than the assets' one, by the studio's choice; see `AssetCondition`.
model StorageCondition {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("storage_condition")
}

/// How a client's hard disk travels - Shipment Type on Client Storage. Its own list; see above.
model StorageShipmentType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("storage_shipment_type")
}

/// What a vendor is engaged for - Vendor Type on Vendors.
model VendorType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("vendor_type")
}

/// What kind of account the studio's money sits in - Account Type on Accounts Manager's bank
/// accounts. It was written out twice, once in the browser and once as a `z.enum` in the
/// master-data definition that validates it, so the two could disagree.
model BankAccountType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("bank_account_type")
}

/// What a lead is being quoted for - Offer Type on Add Lead and on the Quotation Generator.
model OfferType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("offer_type")
}

/// What kind of work a task is - Task Type on HRM -> Tasks.
///
/// `asks_for_details` is the meaning behind "Other": the type the list does not cover, which
/// then says what it actually was. It was the literal string `OTHER_TASK_TYPE` in the browser
/// and again in the service, so renaming it stopped the form asking.
model TaskType {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  description    String?  @db.Text
  asksForDetails Boolean  @default(false) @map("asks_for_details")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("task_type")
}

/// How a payment request settles up - Settlement on Accounts -> Payment Requests.
///
/// `means_excess` is the meaning behind "Expense Excess": the settlement where the studio spent
/// less than it advanced, so money comes back rather than goes out. It was the literal string
/// `SETTLEMENT_EXCESS`, written on both sides.
model PaymentSettlement {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  meansExcess Boolean  @default(false) @map("means_excess")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("payment_settlement")
}

// ============================================================================================
// AI Feature (Visual Curation → AI Feature): event photo galleries with face recognition.
//
// Every table here is the AI Feature's own. None references an Image Selection or Album Proofing
// row, and none of those modules reference these: the two galleries the studio runs are separate
// products that happen to share a menu heading. `Ai*` alone is Nebula, the assistant; everything
// belonging to this module is prefixed `AiEvent` and mapped to `ai_event_*`.
//
// Staff user ids are bare `Int?` columns without a relation, as the Image Selection tables hold
// them, so a login going away never cascades into a gallery. Everything inside an event cascades
// from the event, which is the one delete the studio may ask for.
// ============================================================================================

model AiEvent {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(191)
  /// One of the event types the defaults list, or whatever the studio typed under "Other".
  eventType       String    @map("event_type") @db.VarChar(60)
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  timezone        String    @default("Asia/Kolkata") @db.VarChar(64)
  location        String?   @db.VarChar(255)
  description     String?   @db.Text
  /// R2 key of the cover picture, under `ai-feature/event-<id>/cover/`.
  coverKey        String?   @map("cover_key") @db.VarChar(1024)
  /// UPCOMING, ACTIVE, COMPLETED or ARCHIVED. Moved by the service and by the dates.
  status          String    @default("UPCOMING") @db.VarChar(20)
  /// Free text, as every module but Users and Assets holds it; carried for reporting, never filtered on.
  branch          String?   @db.VarChar(191)
  branchId        Int?      @map("branch_id")
  createdByUserId Int?      @map("created_by_user_id")
  archivedAt      DateTime? @map("archived_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  setting     AiEventSetting?
  subEvents   AiEventSubEvent[]
  guestGroups AiEventGuestGroup[]
  guests      AiEventGuest[]
  folders     AiEventMediaFolder[]
  media       AiEventMedia[]
  faces       AiEventFace[]
  embeddings  AiEventFaceEmbedding[]
  people      AiEventPerson[]
  guestFaces  AiEventGuestFace[]
  matches     AiEventFaceMatch[]
  share       AiEventShare?
  activities  AiEventActivity[]

  @@index([status, archivedAt])
  @@index([startDate])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@map("ai_event")
}

model AiEventSubEvent {
  id          String    @id @default(cuid())
  eventId     String    @map("event_id")
  name        String    @db.VarChar(191)
  date        DateTime?
  /// "HH:MM", or null. Text rather than a time column so an empty answer is not midnight.
  startTime   String?   @map("start_time") @db.VarChar(5)
  endTime     String?   @map("end_time") @db.VarChar(5)
  location    String?   @db.VarChar(255)
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  event       AiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  folders     AiEventMediaFolder[]

  @@index([eventId, sortOrder])
  @@map("ai_event_sub_event")
}

/// The studio-wide template a new event is copied from. One row, keyed "default"; a null group
/// means the code's own defaults, so nothing has to be seeded.
model AiEventDefaultSetting {
  id              String   @id @default("default") @db.VarChar(30)
  general         Json?
  guestAccess     Json?    @map("guest_access")
  ai              Json?
  media           Json?
  gallery         Json?
  privacy         Json?
  notifications   Json?
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ai_event_default_setting")
}

/// An event's own copy of the defaults, taken when it was created and edited on its own since. A
/// later change to the defaults never reaches a row here.
model AiEventSetting {
  id              String   @id @default(cuid())
  eventId         String   @unique @map("event_id")
  guestAccess     Json     @map("guest_access")
  ai              Json
  media           Json
  gallery         Json
  privacy         Json
  notifications   Json
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  event           AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("ai_event_setting")
}

model AiEventGuestGroup {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  name        String   @db.VarChar(120)
  /// The sub-event ids this group may see, as a JSON list. Null or empty means every sub-event.
  subEventIds Json?    @map("sub_event_ids")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  event       AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests      AiEventGuest[]

  @@index([eventId, sortOrder])
  @@map("ai_event_guest_group")
}

model AiEventGuest {
  id            String    @id @default(cuid())
  eventId       String    @map("event_id")
  groupId       String?   @map("group_id")
  name          String    @db.VarChar(191)
  phone         String?   @db.VarChar(30)
  email         String?   @db.VarChar(191)
  /// PENDING, ACCEPTED or DECLINED.
  rsvp          String    @default("PENDING") @db.VarChar(20)
  /// NONE, UPLOADED or FAILED - whether a usable selfie is on file.
  selfieStatus  String    @default("NONE") @map("selfie_status") @db.VarChar(20)
  matchedCount  Int       @default(0) @map("matched_count")
  /// SHA-256 of the guest's own session secret, issued when they join from the event link.
  sessionHash   String?   @unique @map("session_hash") @db.Char(64)
  /// ADMIN for a guest the studio entered or imported, LINK for one who joined from the link.
  source        String    @default("ADMIN") @db.VarChar(20)
  joinedAt      DateTime? @map("joined_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  notes         String?   @db.Text
  createdByUserId Int?    @map("created_by_user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  event         AiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group         AiEventGuestGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  faces         AiEventGuestFace[]
  matches       AiEventFaceMatch[]
  people        AiEventPerson[]
  uploads       AiEventMedia[]

  @@index([eventId, name])
  @@index([eventId, phone])
  @@index([eventId, groupId])
  @@map("ai_event_guest")
}

model AiEventMediaFolder {
  id         String   @id @default(cuid())
  eventId    String   @map("event_id")
  subEventId String?  @map("sub_event_id")
  name       String   @db.VarChar(191)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  event      AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subEvent   AiEventSubEvent? @relation(fields: [subEventId], references: [id], onDelete: SetNull)
  media      AiEventMedia[]

  @@index([eventId, sortOrder])
  @@index([subEventId])
  @@map("ai_event_media_folder")
}

model AiEventMedia {
  id                String    @id @default(cuid())
  eventId           String    @map("event_id")
  folderId          String?   @map("folder_id")
  /// PHOTO or VIDEO.
  kind              String    @default("PHOTO") @db.VarChar(10)
  fileName          String    @map("file_name") @db.VarChar(500)
  mimeType          String    @map("mime_type") @db.VarChar(191)
  sizeBytes         BigInt    @map("size_bytes")
  width             Int?
  height            Int?
  capturedAt        DateTime? @map("captured_at")
  /// SHA-256 of the bytes, so the same frame uploaded twice is one row.
  contentHash       String?   @map("content_hash") @db.Char(64)
  /// R2 keys. The original is kept only when the event's media setting asks for it.
  originalKey       String?   @map("original_key") @db.VarChar(1024)
  previewKey        String?   @map("preview_key") @db.VarChar(1024)
  thumbnailKey      String?   @map("thumbnail_key") @db.VarChar(1024)
  /// QUEUED, PROCESSING, COMPLETED, FAILED or SKIPPED (a video, or face recognition off).
  aiStatus          String    @default("QUEUED") @map("ai_status") @db.VarChar(20)
  aiAttempts        Int       @default(0) @map("ai_attempts")
  aiError           String?   @map("ai_error") @db.Text
  aiStartedAt       DateTime? @map("ai_started_at")
  aiCompletedAt     DateTime? @map("ai_completed_at")
  faceCount         Int       @default(0) @map("face_count")
  uploadedByUserId  Int?      @map("uploaded_by_user_id")
  uploadedByGuestId String?   @map("uploaded_by_guest_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  event             AiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  folder            AiEventMediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedByGuest   AiEventGuest? @relation(fields: [uploadedByGuestId], references: [id], onDelete: SetNull)
  faces             AiEventFace[]
  matches           AiEventFaceMatch[]

  @@index([eventId, folderId, aiStatus])
  @@index([eventId, aiStatus])
  @@index([eventId, createdAt])
  @@index([eventId, contentHash])
  @@index([eventId, deletedAt])
  @@map("ai_event_media")
}

/// One face found in one photo. The vector lives in the table beside it so that no listing of
/// faces ever carries an embedding by accident.
model AiEventFace {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  mediaId      String   @map("media_id")
  personId     String?  @map("person_id")
  /// `{ x, y, w, h }` as fractions of the frame, so the box survives any resize.
  box          Json
  /// The detector's own confidence and a 0-1 quality score (size, sharpness, pose) used for gating.
  detScore     Float    @map("det_score")
  quality      Float
  thumbnailKey String?  @map("thumbnail_key") @db.VarChar(1024)
  createdAt    DateTime @default(now()) @map("created_at")
  event        AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media        AiEventMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person       AiEventPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)
  embedding    AiEventFaceEmbedding?
  matches      AiEventFaceMatch[]

  @@index([eventId, personId])
  @@index([mediaId])
  @@map("ai_event_face")
}

model AiEventFaceEmbedding {
  id        String   @id @default(cuid())
  faceId    String   @unique @map("face_id")
  eventId   String   @map("event_id")
  model     String   @db.VarChar(60)
  dimension Int
  /// The unit-normalised vector as base64 of little-endian float32. Never serialised to a browser.
  vector    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  face      AiEventFace @relation(fields: [faceId], references: [id], onDelete: Cascade)
  event     AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("ai_event_face_embedding")
}

/// A cluster of faces the module believes are one person. Named by the studio, or linked to a guest.
model AiEventPerson {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  label       String?  @db.VarChar(120)
  guestId     String?  @map("guest_id")
  faceCount   Int      @default(0) @map("face_count")
  mediaCount  Int      @default(0) @map("media_count")
  /// Running mean of the member vectors, same encoding as the embeddings.
  centroid    String?  @db.Text
  coverFaceId String?  @map("cover_face_id")
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  event       AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       AiEventGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  faces       AiEventFace[]
  matches     AiEventFaceMatch[]

  @@index([eventId, hidden])
  @@index([guestId])
  @@map("ai_event_person")
}

/// A guest's selfie, as the face found in it. The selfie itself is a private object.
model AiEventGuestFace {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  guestId      String   @map("guest_id")
  selfieKey    String   @map("selfie_key") @db.VarChar(1024)
  thumbnailKey String?  @map("thumbnail_key") @db.VarChar(1024)
  model        String   @db.VarChar(60)
  dimension    Int
  vector       String   @db.Text
  quality      Float
  createdAt    DateTime @default(now()) @map("created_at")
  event        AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest        AiEventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, guestId])
  @@map("ai_event_guest_face")
}

/// "This photo has this guest in it", with how sure the module is and what was decided about it.
model AiEventFaceMatch {
  id               String    @id @default(cuid())
  eventId          String    @map("event_id")
  guestId          String    @map("guest_id")
  mediaId          String    @map("media_id")
  faceId           String?   @map("face_id")
  personId         String?   @map("person_id")
  similarity       Float
  /// HIGH, MEDIUM or LOW, against the event's thresholds at the time.
  band             String    @db.VarChar(10)
  /// MATCHED, CONFIRMED, REJECTED or REVIEW_REQUIRED.
  status           String    @default("MATCHED") @db.VarChar(20)
  /// SELFIE_SEARCH, AUTO, PERSON_LINK or MANUAL - how the match came about.
  source           String    @default("AUTO") @db.VarChar(20)
  reviewedByUserId Int?      @map("reviewed_by_user_id")
  rejectedByGuestAt DateTime? @map("rejected_by_guest_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  event            AiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest            AiEventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  media            AiEventMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  face             AiEventFace? @relation(fields: [faceId], references: [id], onDelete: SetNull)
  person           AiEventPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([guestId, mediaId], map: "ai_event_face_match_guest_media_unique")
  @@index([eventId, guestId, status])
  @@index([eventId, status])
  @@index([mediaId])
  @@map("ai_event_face_match")
}

/// The guest-facing link: token by hash, short code in the URL, an optional PIN.
model AiEventShare {
  id              String    @id @default(cuid())
  eventId         String    @unique @map("event_id")
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  tokenCipher     String    @map("token_cipher") @db.Text
  shortCode       String?   @unique @map("short_code") @db.VarChar(8)
  pinHash         String?   @map("pin_hash") @db.VarChar(191)
  pinCipher       String?   @map("pin_cipher") @db.Text
  /// ACTIVE or REVOKED.
  status          String    @default("ACTIVE") @db.VarChar(20)
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  accessCount     Int       @default(0) @map("access_count")
  lastAccessAt    DateTime? @map("last_access_at")
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  event           AiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("ai_event_share")
}

/// The event's timeline. Face vectors and secrets are never written here by construction.
model AiEventActivity {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  /// STAFF, GUEST or SYSTEM.
  actorType   String   @default("STAFF") @map("actor_type") @db.VarChar(20)
  actorUserId Int?     @map("actor_user_id")
  actorLabel  String?  @map("actor_label") @db.VarChar(191)
  event       String   @db.VarChar(50)
  detail      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  aiEvent     AiEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([createdAt])
  @@map("ai_event_activity")
}

/// A link sent to a company that wants one of Beam Craft's products (SUBSCRIBE in the sidebar): the
/// client counterpart of `EmployeeOnboardingInvite`. Expired is read from `expiresAt`, not stored.
model ClientOnboardingInvite {
  id           String    @id @default(cuid())
  /// `MEDIA_STUDIO_OPERATIONS` or `ACCOUNT_MANAGER` - null on invites made without one.
  product      String?   @db.VarChar(40)
  contactName  String?   @map("contact_name") @db.VarChar(150)
  contactEmail String?   @map("contact_email") @db.VarChar(191)
  contactPhone String?   @map("contact_phone") @db.VarChar(30)
  /// The contact person's role at the company, asked on Create Onboarding Invite.
  contactDesignation String? @map("contact_designation") @db.VarChar(150)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  token        String?   @db.VarChar(64)
  shortCode    String?   @unique @map("short_code") @db.VarChar(8)
  /// Created, Verified, Submitted or Cancelled.
  status       String    @default("Created") @db.VarChar(20)
  expiresAt    DateTime  @map("expires_at")
  verifiedAt   DateTime? @map("verified_at")
  submittedAt  DateTime? @map("submitted_at")
  cancelledAt  DateTime? @map("cancelled_at")
  clientId     String?   @map("client_id")
  /// Whatever company details the team filled in on the invite (images already stored); the client's
  /// form opens with them, completes the rest and submits.
  company      Json?
  createdBy    String?   @map("created_by") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client SubscriptionClient?

  @@index([product, status])
  @@index([createdAt])
  @@map("client_onboarding_invite")
}

/// A company onboarded for one product, written once when its onboarding form is submitted.
model SubscriptionClient {
  id                          String   @id @default(cuid())
  product                     String?  @db.VarChar(40)
  companyName                 String   @map("company_name") @db.VarChar(150)
  address                     String   @db.VarChar(500)
  gstNumber                   String   @map("gst_number") @db.VarChar(15)
  panNumber                   String   @map("pan_number") @db.VarChar(10)
  logoUrl                     String   @map("logo_url") @db.VarChar(500)
  faviconUrl                  String   @map("favicon_url") @db.VarChar(500)
  usersNeeded                 Int      @map("users_needed")
  mainContactName             String   @map("main_contact_name") @db.VarChar(150)
  mainContactPhone            String   @map("main_contact_phone") @db.VarChar(30)
  mainContactDesignation      String   @map("main_contact_designation") @db.VarChar(150)
  secondaryContactName        String   @map("secondary_contact_name") @db.VarChar(150)
  secondaryContactPhone       String   @map("secondary_contact_phone") @db.VarChar(30)
  secondaryContactDesignation String   @map("secondary_contact_designation") @db.VarChar(150)
  contactEmail                String?  @map("contact_email") @db.VarChar(191)
  /// The account Beam Craft set up for it (Client Details -> Set up account). Null until then.
  subdomain                   String?   @unique @db.VarChar(40)
  usersAllowed                Int?      @map("users_allowed")
  adminUsername               String?   @map("admin_username") @db.VarChar(60)
  /// bcrypt; the password itself is shown once and never stored.
  adminPasswordHash           String?   @map("admin_password_hash") @db.VarChar(100)
  /// When Beam Craft last made the Admin's password (setup, Reset password); the client's site takes a newer one.
  adminPasswordSetAt          DateTime? @map("admin_password_set_at")
  /// SHA-256 of the key the client's server reads its subscription with; the key itself is shown once.
  siteKeyHash                 String?   @map("site_key_hash") @db.Char(64)
  validFrom                  DateTime? @map("valid_from") @db.Date
  validUntil                  DateTime? @map("valid_until") @db.Date
  /// Module keys from `MODULES_BY_PRODUCT` for its product.
  modules                     Json?
  activatedAt                 DateTime? @map("activated_at")
  /// The version live on the client's site: 1 at setup, +1 each time Update site publishes a change.
  liveVersion                 Int       @default(0) @map("live_version")
  /// A change saved in Edit subscription and not yet published with Update site; null when none.
  pendingChanges              Json?     @map("pending_changes")
  publishedAt                 DateTime? @map("published_at")
  inviteId                    String   @unique @map("invite_id")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  invite ClientOnboardingInvite @relation(fields: [inviteId], references: [id])
  versions SubscriptionVersion[]
  healthChecks SiteHealthCheck[]

  @@index([product])
  @@map("subscription_client")
}

/// Each version of a client's subscription as it went live - what Update site published, and when.
model SubscriptionVersion {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  version     Int
  snapshot    Json
  publishedAt DateTime @default(now()) @map("published_at")
  publishedBy String?  @map("published_by") @db.VarChar(50)

  client SubscriptionClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, version])
  @@map("subscription_version")
}

/// One look at a live client's site: did `/api/health` answer, how fast, and with which version. Kept a week.
model SiteHealthCheck {
  id         String   @id @default(cuid())
  clientId   String   @map("client_id")
  checkedAt  DateTime @default(now()) @map("checked_at")
  ok         Boolean
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  version    String?  @db.VarChar(40)
  error      String?  @db.VarChar(300)

  client SubscriptionClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, checkedAt])
  @@index([checkedAt])
  @@map("site_health_check")
}

/// The roles a client's contact person can hold (Owner, Managing Director, ...), offered by Client Details ->
/// Create Onboarding Invite and kept by the team in Settings -> Field Settings, as Designations are for staff.
model ClientDesignation {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("client_designation")
}
