NODE_ENV=development
DATABASE_URL="mysql://root@127.0.0.1:3307/dbs_hrm"
PORT=5001
JWT_SECRET="local-dev-secret-change-later"
# Where this backend's emails point people back to. It is what builds the Change Password link in a
# password reset, so it must be the address a browser can actually reach: http://localhost:3000 in
# development, https://operations.dontblinkstudioz.com on the VPS.
FRONTEND_URL="http://localhost:3000"

# Mail delivery. Without all four of HOST, PORT, USER and PASSWORD nothing is sent - password
# resets, employee credentials and onboarding invites all go quiet together, and the reason is
# logged rather than shown, so run `npm run check:smtp` after changing any of these.
#
# For Gmail: SMTP_PASSWORD is a 16-character App Password, not the account password. Google stopped
# accepting the latter. Generate one at Google Account > Security > 2-Step Verification >
# App passwords, which requires 2-Step Verification to be on.
SMTP_HOST="smtp.gmail.com"
# Public base of the short client-gallery URL, no trailing slash. Leave blank in development and
# links resolve to FRONTEND_URL/g/<code>; production sets the dedicated gallery subdomain, e.g.
# GALLERY_PUBLIC_URL="https://gallery.dontblinkstudioz.com"
GALLERY_PUBLIC_URL=""
SMTP_HOST=""
SMTP_PORT="587"
# false for port 587, which upgrades with STARTTLS. Only port 465 is TLS from the first byte.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# The address people see the mail come from. For Gmail this has to be the SMTP_USER account (or an
# alias it is allowed to send as), or Google rewrites it and replies go to the wrong place.
SMTP_FROM=""

# How often one address, or one caller, may ask for a password reset. The two are counted against
# their own budgets, because they protect different things: PER_WINDOW guards one inbox from being
# flooded (each request emails somebody and spends their previous link), while PER_IP guards the
# server. Behind nginx - and on localhost - the caller's address is one value for everybody, so
# holding it to the inbox's three meant the fourth person in the office to forget their password
# inside the window was refused because three colleagues had asked first, and no mail was attempted.
# ── Resetting a password by mobile ───────────────────────────────────────────────────────────
# The forgot-password screen sends a six-digit code to the number on somebody's employee record and
# keeps the email link as a fallback (a login with no employee record - the Super Admin - has no
# number anywhere). Nothing is sent until a gateway is configured here; until then the screen behaves
# correctly and the server logs "SMS is not configured." against every attempt.
#
# LOCALLY that would mean the code goes nowhere and no screen past the code box can be reached, so
# with NODE_ENV="development" and no gateway the code is printed on the server console instead, in a
# box that says plainly that nothing was sent. It is the only place in the application allowed to
# print a live code, it refuses to run under any other NODE_ENV - including an unset one - and
# SMS_DEV_ECHO="false" turns it off. A configured gateway is always used in preference to it.
#
# NEVER route these over the WhatsApp integration. That is a QR-paired personal account, and
# automated sending from it is what gets the studio's number banned.
#
# SMS_PROVIDER="msg91"   -> MSG91's OTP endpoint. Needs SMS_API_KEY (the authkey) and
#                           SMS_TEMPLATE_ID (an approved DLT template with an `otp` variable);
#                           SMS_SENDER_ID is the six-character header.
# SMS_PROVIDER="http"    -> any gateway taking a key, a number and a message as query parameters.
#                           Needs SMS_BASE_URL, and SMS_KEY_PARAM / SMS_TO_PARAM /
#                           SMS_MESSAGE_PARAM / SMS_SENDER_PARAM where its names differ from the
#                           defaults (apikey / to / message / sender).
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_TEMPLATE_ID=""
SMS_BASE_URL=""
# "false" silences the development console echo described above. Ignored anywhere but development.
SMS_DEV_ECHO=""

PASSWORD_RESET_MAX_PER_WINDOW="3"
PASSWORD_RESET_MAX_PER_IP_WINDOW="30"
PASSWORD_RESET_WINDOW_MINUTES="15"
# Set to "true" only where nginx (or another proxy) sits in front, so the rate limiter reads the
# caller's own address from X-Forwarded-For instead of counting the whole studio as one. Leave it
# off otherwise: the header is writable by anyone, and trusting it without a proxy would let a
# caller give themselves a fresh allowance per request.
TRUST_PROXY_HEADER=""
CRM_WEBHOOK_URL=""
GOOGLE_SHEETS_SPREADSHEET_IDS=""
# Optional. Leave it blank and the Callyzer webhook accepts any request that reaches its URL,
# which is how it is run today - Callyzer is configured with the URL alone. Set it, and the same
# value has to be set in Callyzer > Configure Webhook > Secret or deliveries are refused.
CALLYZER_WEBHOOK_SECRET=""
# Set to 1 for one delivery when a Callyzer signature will not verify: the refusal then logs the
# signature that arrived, the body it was made over, and every candidate this server computed, so
# the two can be compared. Never logs the secret. Leave empty otherwise.
CALLYZER_DEBUG_SIGNATURE=""

# Which vertical a call belongs to, when the call itself does not say.
#
# The studio runs three businesses on three CRM boards - Dum Dum (weddings), Qua Qua (newborn and
# maternity), Corp (corporate) - and a Callyzer call carries no vertical. The webhook reads the
# call's own labels and note first; most calls have neither, so in practice this map is what routes
# them, because the CRM staff work on one business each.
#
# Employees by number or by name, one per entry. Numbers match on their last ten digits, so the
# country code is optional. An entry naming anything other than Dum Dum, Qua Qua or Corp (or the
# WED / QQ / CORP shorthands) is ignored rather than guessed at. Leave blank and calls that say
# nothing about the work are filed with no vertical, which the CRM shows on the Dum Dum tab.
CALLYZER_EMPLOYEE_VERTICALS=""
# Staff phone numbers Callyzer does not report as employees. One employee ringing another arrives
# as a call to a number that looks exactly like a client's, so the server keeps a directory of every
# number Callyzer has ever named as an employee's own and refuses to make a lead out of it. This is
# for the colleagues whose phones are not tracked but who the tracked staff still ring.
CALLYZER_STAFF_NUMBERS=""
# Numbers that are never a lead however often they are called: a second personal phone, a supplier,
# the office landline. Comma separated.
#
# The CRM manages this list itself now - Settings > Exclude Phone Numbers, which writes to
# `sales_crm_excluded_number` and is where the studio should add them, since the people who know
# whose number is whose are the CRM staff rather than whoever has shell access here. Anything set
# below is simply added to that list, so an existing value keeps working and needs no migration.
CALLYZER_IGNORE_NUMBERS=""

# --- Callyzer Call Log API (outbound) ------------------------------------------------------------
# Separate from CALLYZER_WEBHOOK_SECRET above, which authenticates deliveries coming IN. These are
# the AccessKey and SecretKey from the Callyzer dashboard, used to READ their reports. Without them
# the /api/sales/callyzer routes answer "not configured" and nothing else changes.
CALLYZER_API_BASE_URL=""
CALLYZER_API_KEY=""
CALLYZER_API_SECRET=""
# How the two are carried: bearer (default) | header | body. Set it to whatever Callyzer's
# Authentication section specifies - it is configuration so the code does not have to guess.
CALLYZER_API_AUTH_STYLE=""
CALLYZER_API_KEY_HEADER=""
CALLYZER_API_SECRET_HEADER=""

# --- AI (Ollama) -------------------------------------------------------------------------------
# ollama only. Nebula is self-hosted: no paid provider or client conversation leaves the machine.
# The master switch for every AI feature. "false" leaves the rest of the CRM working exactly as it
# does now, minus the assistant - AI is an enhancement and must never be a dependency for ordinary
# work. Anything other than "false" is on.
AI_ENABLED="true"

AI_PROVIDER="ollama"
# The address is configuration, never hardcoded - it is the one thing that differs between a
# laptop and the VPS. Ollama must listen on loopback only; port 11434 is never exposed publicly.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# qwen3:1.7b is the default because the production box has 2 cores and no swap - an 8B model there
# takes minutes per answer and starves faster-whisper. On a larger machine set qwen3:8b here; no
# code changes either way.
OLLAMA_MODEL="qwen3:1.7b"
OLLAMA_TIMEOUT_MS="120000"

# How long Ollama keeps a model in memory after answering. Its own default is 5 minutes, which is
# most of why Nebula felt slow: loading the model and evaluating the system prompt from cold costs
# ~45s on a laptop CPU against ~0.5s once cached. Ask two questions a minute apart and both are
# fast; come back after lunch and the first takes a minute.
OLLAMA_KEEP_ALIVE="1h"

# Touch both models every few minutes so neither is evicted. keep_alive holds a model for an hour
# until memory gets tight - with two loaded (4.8GB against 5.4GB free on a 16GB laptop) one gets
# pushed out, and the next question in that language waits ~47s for a reload. Set "false" on a box
# that is short of memory and would rather pay that occasionally than hold both.
OLLAMA_KEEP_WARM=""

# --- Limits on the assistant ---------------------------------------------------------------------
# Ollama runs on the same cores as the CRM and one generation holds a core for the better part of a
# minute, so these protect the machine rather than tune throughput. Past AI_MAX_CONCURRENT_REQUESTS
# a request waits; past AI_MAX_QUEUED_REQUESTS it is refused quickly, which is kinder than a spinner
# that times out. The rate limit is per user and deliberately generous - it stops a runaway browser
# tab, not normal work.
AI_MAX_CONCURRENT_REQUESTS="2"
AI_MAX_QUEUED_REQUESTS="8"
AI_MAX_REQUESTS_PER_MINUTE="20"

# How many times the model may ask for a tool before it has to answer from what it has. Each step is
# a whole generation, so a loop is expensive as well as useless.
AI_MAX_TOOL_STEPS="5"

# Ceiling on the length of an answer, in tokens. Generation is the other half of the wait - this
# model writes about sixteen tokens a second on CPU, so a long answer is a slow one. Normal answers
# sit well under this; the cap is here to stop a runaway.
OLLAMA_MAX_TOKENS="260"
# most of why Nebula felt slow: the Tanglish model carries the studio's examples baked in, and
# evaluating that prefix from cold costs ~45s on a laptop CPU against ~0.5s once cached. Ask two
# questions a minute apart and both are fast; come back after lunch and the first takes a minute.
OLLAMA_KEEP_ALIVE="1h"

# Ceiling on the length of an answer, in tokens. Generation is the other half of the wait - the
# Tanglish model writes about six tokens a second on CPU, so a long answer is a slow one. Normal
# answers sit well under this; the cap is here to stop a runaway.
OLLAMA_MAX_TOKENS="320"
# qwen3 reasons before answering, and that reasoning is not streamed - it showed as thirty seconds
# of blank panel before the first word. Off by default; set true where the reasoning earns its keep.
OLLAMA_THINK=""

# Whether Nebula may answer in Tanglish (Tamil in English letters).
# Needs a model that can actually write it. qwen3:1.7b cannot - it answers in English, recites a
# prompt example at the wrong question, or emits repeating Tamil script - so leave this off if that
# is the only model installed. Detection always runs regardless of this setting.
NEBULA_TANGLISH="true"

# The model used ONLY for Tanglish answers. English keeps OLLAMA_MODEL, which is several times
# faster: a 1.7B writes English well in about five seconds and cannot write Tanglish at all, while a
# 4B writes real Tanglish and takes twenty to thirty. Leave empty on a box running one model that
# can do both. Build it with the studio's own Tanglish examples baked in:
#   NEBULA_BASE_MODEL=gemma3:4b NEBULA_MODEL_NAME=nebula-g node scripts/build-nebula-model.js
OLLAMA_MODEL_TANGLISH="nebula-g"
# Reserved for compatibility with older deployments; external providers are not supported.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# --- Call transcripts -------------------------------------------------------------------------
# Off by default. Set to "true" only where Python and faster-whisper are installed - see
# backend/README.md, Call Transcripts. The webhook queues jobs regardless; nothing transcribes
# until a worker is running, and the queued calls are picked up when one starts.
CALL_TRANSCRIPTION_ENABLED=""
# tiny | base | small | medium | large-v3. "small" is the balance point on a CPU-only server.
# The model used for call transcripts. Defaults to "medium".
#
# Measured on 25 seconds of Tamil whose content was known: "small" returned "your child's pregnancy"
# and "I am Kairam Rubak" - not a poor translation, a wrong one about things nobody said. "medium"
# returned "take your child's picture" and "4000 rupees", which is the call. It costs about three
# times the time - 11s against 31s on two cores - and is roughly real-time either way.
#
# "small" is only worth setting on a box that genuinely cannot afford the time, and it should not be
# trusted for a language other than English.
WHISPER_MODEL=""

# The model used for dictation into the assistant, which is a different job from transcribing a call
# recording. "small" takes about nine seconds on a few words; "base" takes under four and is easily
# good enough for a question somebody reads back before sending. A call is transcribed once in the
# background and keeps WHISPER_MODEL.
WHISPER_VOICE_MODEL="base"
WHISPER_MODEL=""
# "auto" lets Whisper decide per call, which is what Tamil-English code-switching needs.
WHISPER_LANGUAGE=""
# translate (default) | transcribe. "translate" returns English whatever language was spoken, so
# the CRM reads one language; Whisper only translates INTO English, which is the direction wanted.
# "transcribe" keeps the spoken language instead. Model size matters more here than for English:
# "small" translates Tamil roughly, "medium" noticeably better.
WHISPER_TASK=""
WHISPER_COMPUTE_TYPE=""
PYTHON_BIN=""
# One at a time by default: whisper saturates the cores it is given and this box also serves the API.
CALL_TRANSCRIBE_CONCURRENCY=""
# Transcript summaries now go through AI_PROVIDER above. Without a working engine the transcript
# is still made and shown; it simply carries no summary.
CALL_TRANSCRIPT_MAX_CHARS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:5001/api/sales/google-oauth/callback"
GOOGLE_OAUTH_FRONTEND_REDIRECT_URI="http://localhost:3000/sales/crm"
GOOGLE_OAUTH_ENCRYPTION_KEY=""
GOOGLE_OAUTH_STATE_TTL_MINUTES="15"
GOOGLE_PICKER_API_KEY=""
GOOGLE_PICKER_APP_ID=""
# Background CRM sync of every linked Google Sheet. Set to "false" to disable.
GOOGLE_SHEETS_AUTO_SYNC="true"
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS="120"

# Cloudflare R2 object storage (asset + inspection images)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public read base URL for the bucket - r2.dev subdomain or your custom domain, no trailing slash
R2_PUBLIC_BASE_URL=""
# A SECOND bucket, with NO public access, for objects that must not be reachable by link.
#
# Attendance selfies are the case this exists for: a photograph of a named person at a place at a
# time, served only through GET /api/hrm/attendance/selfie/:eventId after a permission check.
# R2_PUBLIC_BASE_URL serves the whole of R2_BUCKET_NAME, so writing them there would leave them
# fetchable by anyone who learns the key.
#
# Optional. Left blank they fall back to the main bucket, guarded only by an unguessable UUID key,
# and the server warns once at startup. Set this before relying on attendance photos being private.
R2_PRIVATE_BUCKET_NAME=""

# Turning attendance coordinates into an address (OpenStreetMap Nominatim).
#
# Resolved once, after a check-in is safely recorded, and never on the critical path: a geocoder
# that is slow or unreachable costs an address, never an attendance record. Rate limited in-process
# to one request per second, which is what Nominatim's usage policy asks for.
#
# GEOCODING_CONTACT_EMAIL goes in the User-Agent. The policy asks for a contact address; without
# one the request still names the application and the server warns once at startup.
# Set GEOCODING_ENABLED="false" to stop coordinates leaving this server entirely — the screens then
# show coordinates, the office and the distance, which need no external call.
GEOCODING_ENABLED="true"
GEOCODING_CONTACT_EMAIL=""
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODING_TIMEOUT_MS="5000"

# CRM WhatsApp chat. The CRM pairs their own WhatsApp by scanning a QR in the lead popup.
#
# WHATSAPP_SESSION_ENCRYPTION_KEY is required before any session can be stored. What Baileys
# persists is the private key material of a linked WhatsApp device, not a password - anyone
# holding a copy can send as that number, and the only revocation is unlinking from the phone. It
# is sealed with AES-256-GCM under this key, which must live in the environment and nowhere else.
# Generate one per environment and never reuse the development key in production:
#   openssl rand -hex 32
# Rotating it makes existing pairings unreadable, so every CRM has to scan a fresh QR code.
WHATSAPP_SESSION_ENCRYPTION_KEY=

# Where the encrypted pairing credentials are kept. In production put this on private storage
# outside the repository, owned by the service account and chmod 700 - the app tightens what it
# creates, but it cannot fix a parent directory the world can read.
WHATSAPP_SESSION_DIR=

# Where conversation media is kept. Separate from the credentials on purpose: logging out deletes
# the credentials and must never delete a client's photos. Defaults to a `media` folder beside the
# session directory when unset. Never expose either directory as static files.
WHATSAPP_MEDIA_DIR=

# Socket diagnostics. Writes why each incoming message was stored or dropped, with phone numbers
# and chat ids replaced by per-process digests and no message content at all. Keep it 0 in
# production - the file is still an operational record of who was messaged and when.
WHATSAPP_DEBUG=0

WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Per-CRM usage limits, guarding the studio's number against looking like a broadcaster.
#
# These are now the middle of three answers, and the least used: Settings -> User Settings ->
# WhatsApp sets them per studio, and a number saved there overrules anything here. These stay for a
# server already carrying them, and for setting a limit before anybody can reach the screen. Left
# blank the code uses its own conservative defaults (25 different clients an hour, 60 messages an
# hour, 300 a day).
WHATSAPP_HOURLY_CHAT_LIMIT=
WHATSAPP_HOURLY_MESSAGE_LIMIT=
WHATSAPP_DAILY_MESSAGE_LIMIT=

# How long a proposed change stays confirmable. A token is a standing authority to change something,
# so how long it may sit in a browser tab is a function of what it can do.
AI_ACTION_TTL_MS="300000"
AI_ACTION_HIGH_RISK_TTL_MS="90000"

# =================================================================================================
# Settings the code reads that were not listed here.
#
# Every one of these has a working default, so a server starts without them - but a default is a
# decision somebody else made, and on a machine that is not the one this was written on it is often
# the wrong one. Listed so a deployment can see what it is inheriting.
# =================================================================================================

# --- Infrastructure ------------------------------------------------------------------------------
# Redis backs the image, transcript and WhatsApp queues. Defaults to localhost; set it when Redis is
# not on the same box.
REDIS_URL=""
# How long a signed-in session lasts. Longer is friendlier and a longer window for a stolen token.
JWT_EXPIRES_IN=""
# Largest JSON body accepted. Raise it only if a real request is being rejected.
JSON_BODY_LIMIT=""

# --- Storage -------------------------------------------------------------------------------------
# Where uploaded originals are written. An absolute path on the machine that serves them - the
# default is inside the repo, which is fine locally and wrong on a server where the repo is replaced
# on each deploy.
IMAGE_SELECTION_UPLOAD_ROOT=""
# Keep the untouched original alongside the processed copies. Off saves a great deal of disk.
STORE_ORIGINAL_IMAGES=""
R2_BUCKET=""

# --- Workers -------------------------------------------------------------------------------------
# How many images are processed at once. Match it to the cores the box can spare, not the cores it
# has: this competes with the API and with Ollama.
IMAGE_PROCESSING_CONCURRENCY=""
# Run the workers inside the API process. Set "false" where they run as their own service.
IMAGE_PROCESSING_EMBEDDED_WORKER=""
WHATSAPP_EMBEDDED_WORKER=""

# --- Email ---------------------------------------------------------------------------------------
SMTP_PASS=""
# "true" for an implicit TLS port, usually 465.
SMTP_SECURE=""
# The address in an onboarding invitation. Must be reachable by the person receiving it, so it is
# the public URL rather than the one the server knows itself by.
EMPLOYEE_LOGIN_URL=""

# --- Google ---------------------------------------------------------------------------------------
# Accepted under three spellings, in this order: GOOGLE_CLIENT_ID, GOOGLE_OAUTH_CLIENT_ID,
# GOOGLE_OAUTH_CLIENTID. Set whichever one your deployment already uses.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Where Google returns the person after they approve. Must match the console exactly, including the
# scheme and any trailing path.
GOOGLE_OAUTH_CALLBACK_URL=""
# The sheet poller's interval, in minutes. GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS wins if both are set.
GOOGLE_SHEETS_SYNC_INTERVAL_MINUTES=""

# --- Gallery links ---------------------------------------------------------------------------------
# Encrypts the tokens in published gallery links. Changing it invalidates every link already sent.
PUBLISH_TOKEN_ENCRYPTION_KEY=""

# --- WhatsApp (Meta Cloud API) ----------------------------------------------------------------------
META_WHATSAPP_TEMPLATE_NAME=""
META_WHATSAPP_TEMPLATE_LANGUAGE=""

# --- CRM -------------------------------------------------------------------------------------------
# Where lead-webhook payloads are forwarded, if anywhere.
CRM_LEADS_WEBHOOK_URL=""

# --- Call recordings and transcripts -----------------------------------------------------------------
CALLYZER_API_TIMEOUT_MS=""
CALL_RECORDING_DOWNLOAD_TIMEOUT_MS=""
# Largest recording accepted. A cap here is what stops one enormous file occupying the worker.
CALL_RECORDING_MAX_BYTES=""
# How long one transcription may take before it is killed. Generous by default, because a long call
# on two cores is genuinely slow.
CALL_TRANSCRIBE_TIMEOUT_MS=""
# How long a gap between segments counts as the other person starting, in ms. Defaults to 350, which
# was measured. Raise it for recordings where one person talks at length with pauses in them.
CALL_TRANSCRIPT_TURN_GAP_MS=""

# --- Nebula ------------------------------------------------------------------------------------------
# The embedding model for the knowledge base. Changing it invalidates every stored embedding, which
# have to be re-ingested.
AI_EMBEDDING_MODEL=""
# Ceiling on an answer's length, in tokens.
AI_MAX_ANSWER_TOKENS=""
# How many turns of a browser-supplied conversation are kept. The client decides what to remember;
# this decides how much of the model's context it may occupy.
AI_MAX_SUPPLIED_TURNS=""

# ── AI Feature (Visual Curation → AI Feature) ─────────────────────────────────────────────────
# Face recognition runs in a Python sidecar (backend/src/modules/ai-feature/face-engine/face_engine.py)
# using InsightFace's open-source SCRFD + ArcFace models fetched from the Hugging Face Hub. Off by
# default: photos still upload and derive, and face jobs wait until this is "true" and the packages
# from backend/requirements-face.txt are installed for the interpreter below.
AI_FACE_ENGINE_ENABLED=""
# Interpreter for the face engine; searched (backend/.venv, python3, ...) when empty.
AI_FACE_PYTHON_BIN=""
# Hugging Face repository laid out as models/<name>/*.onnx, and the model folder name.
AI_FACE_MODEL_REPO=""
AI_FACE_MODEL_NAME=""
# Parallel media jobs (default 2 - the engine answers one frame at a time). "false" to run the
# worker as its own process with `npm run worker:ai-events` instead of inside the API.
AI_FEATURE_PROCESSING_CONCURRENCY=""
AI_FEATURE_EMBEDDED_WORKER=""
# Where guest links point; empty means FRONTEND_URL/e/<code>.
AI_EVENT_PUBLIC_URL=""
# The BullMQ queue name (default ai-feature-media). Give a second server on the same Redis its own,
# or the two take each other's photos. How long a photo is parked when the engine is down (ms).
AI_FEATURE_QUEUE_NAME=""
AI_FACE_ENGINE_RETRY_MS=""
# ── Image Selection → client gallery People filter ───────────────────────────────────────────
# Faces in a gallery's photos, grouped into "Person 1, Person 2, ..." that the client can filter
# the folder by. Runs on the same face engine as the AI Feature and follows its switch: on when
# AI_FACE_ENGINE_ENABLED=true (with the packages from backend/requirements-face.txt), off
# otherwise. Set this to "false" to keep the engine for the AI Feature alone, or "true" to
# insist. Off, nothing is queued, no worker starts and the gallery has no People row; on but the
# engine not answering, scans wait rather than fail. A gallery is queued the first time a client
# opens one of its folders.
IMAGE_SELECTION_FACE_RECOGNITION_ENABLED=""
# Parallel scans (default 2). "false" runs the worker as its own process with `npm run worker:faces`.
IMAGE_SELECTION_FACE_CONCURRENCY=""
IMAGE_SELECTION_FACE_EMBEDDED_WORKER=""
# How alike two faces must be to be one person (cosine similarity, default 0.55) and how usable a
# face must be to count at all (default 0.35) - the AI Feature's own defaults.
IMAGE_SELECTION_FACE_CLUSTER_THRESHOLD=""
IMAGE_SELECTION_FACE_MIN_QUALITY=""
# The BullMQ queue name (default image-selection-faces) and how long a scan is parked when the
# engine is down (ms, default AI_FACE_ENGINE_RETRY_MS or 60000).
IMAGE_SELECTION_FACE_QUEUE_NAME=""
IMAGE_SELECTION_FACE_ENGINE_RETRY_MS=""
